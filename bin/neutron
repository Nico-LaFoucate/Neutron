# --- small helpers ---------------------------------------------------------

def log(msg):
    """Human-readable log -> stderr (never pollutes the JSON on stdout)."""
    print(f"[neutron] {msg}", file=sys.stderr)


def event(args, **kw):
    """Emit one newline-delimited progress event, when the caller asked for a stream.

    Shape matches Mud Hut's NDJSON contract so Collider can consume both with the same reader:
      {"event": "progress", "stage": <str>, "pct": <0-100>, "msg": <str>}
      {"event": "note",     "msg": <str>}
    The terminal object is emitted by emit() and carries "event": "result".

    Silent unless BOTH --json and --progress: a long operation's steps are useless noise in human
    mode, and streaming unconditionally would corrupt Mud Hut's stream (see --progress help)."""
    if getattr(args, "progress", False) and getattr(args, "json", False):
        sys.stdout.write(json.dumps(kw) + "\n")
        sys.stdout.flush()


def emit(obj, as_json, streaming=False):
    """Emit the result. JSON object to stdout in --json mode."""
    if as_json:
        # A streamed run's consumer scans for the terminal event; tag it so it is unambiguous
        # among the progress lines that preceded it.
        if streaming:
            obj = {"event": "result", **obj}
        print(json.dumps(obj))
    else:
        # Human mode: a compact readable rendering, still on stdout.
        for k, v in obj.items():
            print(f"{k}: {v}")


def die(obj, code, as_json):
    """Emit a structured error and exit with a meaningful code."""
    obj.setdefault("ok", False)
    obj.setdefault("error_code", code)
    emit(obj, as_json)
    sys.exit(code)


def premiere_is_running():
    """True if any Adobe Premiere process is alive (pref edits are unsafe then).

    ⛔ Matches the EXECUTABLE, never the command line. This used to be
    `pgrep -f "Adobe Premiere"`, which matches any process whose full cmdline merely CONTAINS
    that string — a terminal sitting in the install folder, a file manager, an editor with the
    path open, or the very shell running this check. A false positive made
    `prefix apply-display-fix` return exit 3 "Premiere is running; cannot edit prefs", which
    (before the display fix was made best-effort) aborted the launch of every app in the prefix.
    Same self-match trap as `_prefix_procs`, which documents the rule."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        # cmdline[0] is the exe the process was started with; argv[1..] is ignored on purpose.
        if _proc_win_exe(int(pid)).lower().endswith("/adobe premiere pro.exe"):
            return True
    return False


def collider_selected_prefix():
    """The prefix Collider is pointed at, from ~/.config/collider/config.json.

    One link in default_prefix()'s chain. This used to be the ONLY defence against a hardcoded
    `$HOME/.premiere2025`, and it never got a chance to run because every argparse default was
    pre-filled with that path. Testers following our own documented command --
    `neutron launch premiere > pp.log` -- got `invalid prefix` and could produce no log at all, so
    a build-test bug went two rounds with no diagnostics (2026-08-08). Removed for good 2026-08-25."""
    try:
        with open(os.path.join(HOME, ".config", "collider", "config.json"),
                  encoding="utf-8") as f:
            sel = json.load(f).get("selected_prefix")
        if sel and os.path.isdir(os.path.join(sel, "drive_c")):
            return sel
    except Exception:
        pass
    return None


def discover_prefixes():
    """Every wine prefix we can see, newest-first. A prefix is a dir containing `drive_c`."""
    seen, out = set(), []
    roots = [HOME, os.path.join(HOME, "Games"), os.path.join(HOME, ".local", "share", "wineprefixes")]
    env = os.environ.get("WINEPREFIX")
    if env:
        roots.insert(0, os.path.dirname(os.path.abspath(os.path.expanduser(env))))
    for root in roots:
        if not os.path.isdir(root):
            continue
        try:
            entries = os.listdir(root)
        except OSError:
            continue
        for name in entries:
            d = os.path.join(root, name)
            if d in seen:
                continue
            if os.path.isdir(os.path.join(d, "drive_c")):
                seen.add(d)
                out.append(d)
    out.sort(key=lambda d: os.path.getmtime(d), reverse=True)
    return out


def default_prefix():
    """The prefix to use when the caller did not name one.

    ⛔ THERE IS NO HARDCODED PREFIX NAME. `$HOME/.premiere2025` is one developer's directory, and
    baking it in as the default has burned the build tester repeatedly: our own documented
    commands (`neutron launch premiere > pp.log`) answered `invalid prefix` on their machine, so a
    build-test bug went two rounds with no diagnostics at all (2026-08-08) — and it kept coming
    back because the fix was added as a *helper* while every argparse default still pointed at the
    hardcoded path and short-circuited it.

    Resolution order, most explicit first:
      1. `$WINEPREFIX`                     — the caller said so
      2. Collider's selected prefix        — the GUI's current choice
      3. discovery, if UNAMBIGUOUS         — exactly one prefix on the machine

    Ambiguity is not resolved by guessing: with several candidates and no selection, return None
    so the caller can fail with the list. A wrong prefix silently provisions or tears down the
    wrong installation.
    """
    env = os.environ.get("WINEPREFIX")
    if env:
        p = os.path.abspath(os.path.expanduser(env))
        if os.path.isdir(os.path.join(p, "drive_c")):
            return p
    sel = collider_selected_prefix()
    if sel:
        return sel
    found = discover_prefixes()
    if len(found) == 1:
        return found[0]
    return None


def bad_prefix_reason(given):
    """Why we have no prefix, and what the caller can do — never a bare "invalid prefix".

    A tester following our own documented command hit exactly that message, with no indication
    that a prefix even had to be chosen, and produced no diagnostics for two rounds. If we cannot
    resolve one, the error must carry the candidates."""
    if given:
        return {"reason": "invalid prefix (no drive_c): %s" % given}
    found = discover_prefixes()
    if not found:
        return {"reason": "no wine prefix found",
                "hint": "pass one explicitly, set $WINEPREFIX, or select one in Collider",
                "candidates": []}
    return {"reason": "several wine prefixes found and none selected — refusing to guess",
            "hint": "pass the path, set $WINEPREFIX, or pick one in Collider "
                    "(a wrong prefix would provision or tear down the wrong installation)",
            "candidates": found[:10]}


def resolve_prefix(path):
    """Validate a prefix path; return the absolute, real path or None.

    With no path, falls back to default_prefix() — never to a hardcoded name."""
    if not path:
        path = default_prefix()
    if not path:
        return None
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(os.path.join(p, "drive_c")):
        return None
    return p


def prefix_user(prefix):
    """The in-prefix Wine username (the dir under drive_c/users that isn't Public)."""
    users_dir = os.path.join(prefix, "drive_c", "users")
    if not os.path.isdir(users_dir):
        return None
    candidates = [
        d for d in os.listdir(users_dir)
        if d != "Public" and os.path.isdir(os.path.join(users_dir, d))
    ]
    if not candidates:
        return None
    # Prefer the Linux $USER if present, else the first real user dir.
    linux_user = os.environ.get("USER")
    if linux_user in candidates:
        return linux_user
    return candidates[0]


def documents_paths(prefix, user):
    """Return (symlink_path, real_path) for the in-prefix Documents dir.

    real_path is the symlink-resolved target — the canonical real Documents dir.
    This encodes the symlink lesson so Collider never computes paths itself.
    """
    link = os.path.join(prefix, "drive_c", "users", user, "Documents")
    real = os.path.realpath(link) if os.path.exists(link) else None
    return link, real


def find_debug_database(prefix, user):
    """Locate the LIVE Debug Database.txt (the pref file apply-display-fix writes).

    Globs the versioned Premiere Pro dir; excludes the .bak copy and the
    Team Projects Local Hub copy, which are not the live prefs.
    """
    base = os.path.join(
        prefix, "drive_c", "users", user, "AppData", "Roaming", "Adobe"
    )
    hits = glob.glob(os.path.join(base, "Premiere Pro", "*", "Debug Database.txt"))
    # Exclude non-live copies defensively (glob above already avoids .bak,
    # but be explicit in case of odd layouts).
    hits = [h for h in hits if ".bak" not in h and "Team Projects" not in h]
    if not hits:
        return None
    # If multiple version dirs exist, pick the highest version number.
    def vkey(p):
        ver = os.path.basename(os.path.dirname(p))
        try:
            return tuple(int(x) for x in ver.split("."))
        except ValueError:
            return (0,)
    hits.sort(key=vkey, reverse=True)
    return hits[0]


def find_debug_databases(prefix, user):
    """Every DVA app's live Debug Database.txt, plus whether that app is installed.

    Returns a list of (label, path_or_None, installed). `path` is None when the app has
    never been run (Adobe writes this file itself on a clean exit) or is not installed.
    See DISPLAY_FIX_APPS for why this is not Premiere-only.
    """
    base = os.path.join(prefix, "drive_c", "users", user, "AppData", "Roaming", "Adobe")
    appsdir = os.path.join(prefix, "drive_c", "Program Files", "Adobe")
    out = []
    for label, subdir, instglob in DISPLAY_FIX_APPS:
        installed = bool(glob.glob(os.path.join(appsdir, instglob)))
        hits = glob.glob(os.path.join(base, subdir, "*", "Debug Database.txt"))
        hits = [h for h in hits if ".bak" not in h and "Team Projects" not in h]

        def vkey(p):
            ver = os.path.basename(os.path.dirname(p))
            try:
                return tuple(int(x) for x in ver.split("."))
            except ValueError:
                return (0,)

        hits.sort(key=vkey, reverse=True)
        out.append((label, hits[0] if hits else None, installed))
    return out


def _display_fix_pref_dir(prefix, user, label):
    """Versioned prefs dir for an app that has never written a Debug Database.

    Prefers a version dir the app has already created (it usually writes other prefs before
    it ever writes this one); falls back to deriving it from the install directory's year,
    which is how Adobe names these (Adobe Media Encoder 2025 -> 25.0). None if undecidable.
    """
    entry = next((e for e in DISPLAY_FIX_APPS if e[0] == label), None)
    if not entry:
        return None
    _, subdir, instglob = entry
    base = os.path.join(prefix, "drive_c", "users", user, "AppData", "Roaming", "Adobe", subdir)
    existing = [d for d in glob.glob(os.path.join(base, "*")) if os.path.isdir(d)]
    if existing:
        def vkey(p):
            try:
                return tuple(int(x) for x in os.path.basename(p).split("."))
            except ValueError:
                return (0,)
        existing.sort(key=vkey, reverse=True)
        return existing[0]
    inst = glob.glob(os.path.join(prefix, "drive_c", "Program Files", "Adobe", instglob))
    for d in inst:
        m = re.search(r"\b(20\d\d)\b", os.path.basename(d))
        if m:
            return os.path.join(base, f"{int(m.group(1)) - 2000}.0")
    return None


def _apply_display_fix_to(dbg):
    """Set DISPLAY_FIX_KEY=true in one Debug Database, preserving every other byte.

    Returns "already" | "changed". Raises OSError on read/write failure.
    Adobe writes these lines as key\\tcurrent\\tdefault terminated by CR CR LF; we write a
    single CRLF, which the apps accept and rewrite in their own style on a clean exit.
    """
    with open(dbg, "r", encoding="utf-8", errors="replace", newline="") as f:
        raw = f.read()
    if _display_fix_is_on(raw):
        return "already"
    new_line = f"{DISPLAY_FIX_KEY}\t{DISPLAY_FIX_CURRENT}\t{DISPLAY_FIX_DEFAULT}\r\n"
    out_lines, found = [], False
    for ln in raw.splitlines(keepends=True):
        if ln.lstrip("﻿").startswith(DISPLAY_FIX_KEY + "\t"):
            found = True
            out_lines.append(new_line)   # replace ONLY this line
        else:
            out_lines.append(ln)         # preserve byte-for-byte
    if not found:
        if out_lines and not out_lines[-1].endswith(("\n", "\r")):
            out_lines[-1] = out_lines[-1] + "\r\n"
        out_lines.append(new_line)
    with open(dbg, "w", encoding="utf-8", newline="") as f:
        f.write("".join(out_lines))
    return "changed"


def have(cmd):
    return shutil.which(cmd) is not None


def resolve_wine():
    """The Neutron-owned wine binary (Phase 1). Returns (path, is_neutron).
    Falls back to system wine (is_neutron=False) only if no Neutron wine exists."""
    for c in NEUTRON_WINE_CANDIDATES:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c, True
    sysw = shutil.which("wine")
    return sysw, False


def _prefix_stamp(prefix):
    """The runtime stamp a prefix is currently booted onto, or None.

    Wine writes its `share/wine/wine.inf` mtime into `<prefix>/.update-timestamp` at wineboot and
    compares the two on every launch: DIFFERENT stamp => it runs `wineboot -u`. That update is
    what reverts our patched natives (dwrite/dcomp/dxcore) and reads as a mass regression with no
    code change behind it.

    ⚠️ The stamp file is CRLF. A naive read keeps the \\r and never matches -- the trap that cost
    `preserved-fixes/harnesses/runtime_for_prefix.sh` its comment block.
    """
    try:
        with open(os.path.join(prefix, ".update-timestamp")) as f:
            digits = "".join(c for c in f.read() if c.isdigit())
        return int(digits) if digits else None
    except (OSError, ValueError):
        return None


def _runtime_stamp(wine_path):
    """The stamp a given wine would impose on a prefix (its wine.inf mtime), or None."""
    if not wine_path:
        return None
    root = os.path.dirname(os.path.dirname(os.path.realpath(wine_path)))
    try:
        return int(os.path.getmtime(os.path.join(root, "share", "wine", "wine.inf")))
    except OSError:
        return None


def _runtimes_matching_stamp(stamp):
    """Installed runtime versions whose wine.inf mtime equals `stamp`.

    ⚠️ Deliberately a LIST, not a single answer. We pin wine.inf mtimes across releases on purpose
    so that a prefix does not re-stamp, which means several runtimes routinely share one stamp
    (11.10-45/58/59/60/62 all did). Resolving a runtime FROM the stamp therefore cannot be trusted
    to pick the newest -- `adobe-smoke.sh` did exactly that and silently launched Animate on
    11.10-23, voiding the test. So this is used to EXPLAIN a mismatch, never to choose.
    """
    out = []
    try:
        names = sorted(os.listdir(NEUTRON_RUNTIMES_DIR))
    except OSError:
        return out
    for name in names:
        if not name.startswith("neutron-wine-"):
            continue
        inf = os.path.join(NEUTRON_RUNTIMES_DIR, name, "share", "wine", "wine.inf")
        try:
            if int(os.path.getmtime(inf)) == stamp:
                out.append(name[len("neutron-wine-"):])
        except OSError:
            continue
    return out


def stamp_mismatch(prefix, wine_path):
    r"""None if this wine can launch into this prefix without re-stamping it; else an explanation.

    🚨 THIS IS THE CLOBBER, MADE LOUD. Launching a prefix on a different-stamp runtime fires
    `wineboot -u` and reverts the patched natives. It has happened repeatedly and has never once
    announced itself -- the user sees seven apps regress at once and goes looking for a code
    change that does not exist (2026-07-19, 2026-07-29/30, and again 2026-08-25 when generated
    .desktop entries shipped unpinned for a few hours).

    Predicted independently by the build tester 2026-08-25 as the next occurrence: install a newer
    runtime, the wrapper's default moves, the prefix stays stamped to the old one, and every
    launch surface that is not an explicitly pinned .desktop entry clobbers the prefix.

    ⛔ Both values must be READABLE before we complain. A prefix with no stamp is a prefix that has
    never been booted, and refusing to launch it would be inventing a problem -- the same
    "render unknown as an answer" mistake that put "X11" in Collider's UI on a Wayland session.
    Failing open also happens to be exactly right for wine's own opt-out: a `.update-timestamp`
    containing the word `disable` turns wine's update check off permanently
    (`programs/wineboot/wineboot.c:update_timestamp`). That file has no digits, so we read None and
    stay quiet -- which is correct, because wine will not re-stamp such a prefix either.

    ⭐ WHERE THE CLOBBER CAN ACTUALLY HAPPEN, read out of wine's source 2026-08-26 rather than
    guessed (the build tester asked, and the honest answer needed the code, not an experiment on
    the only working installation):
      * `wine <prog>` with no wine parent -> `build_initial_params()` -> `run_wineboot()`
        UNCONDITIONALLY (`dlls/ntdll/unix/env.c`).
      * `run_wineboot()` first does `NtCreateEvent(\KernelObjects\__wineboot_event, OBJ_OPENIF)`.
        If that event ALREADY EXISTS it jumps straight to `wait` and **never launches
        wineboot.exe**.
      * wineboot creates that event with `OBJ_INHERIT` "to be inherited by services.exe", and
        services.exe lives as long as the wine session.
      * Only wineboot.exe compares `.update-timestamp` and reinstalls wine.inf.
    => **A prefix can only be re-stamped by the FIRST wine process into a COLD prefix.** Once a
    session is up, no later `wine` invocation can clobber it. That makes `launch` (cold) and
    `provision` (deliberate) the complete set of entry points, which is exactly where the
    handling is.
    """
    want = _prefix_stamp(prefix)
    have = _runtime_stamp(wine_path)
    if want is None or have is None or want == have:
        return None
    return {"prefix_stamp": want, "runtime_stamp": have,
            "runtime": os.path.dirname(os.path.dirname(os.path.realpath(wine_path))),
            "prefix_runtimes": _runtimes_matching_stamp(want)}


def resolve_runtime():
    """The Neutron runtime DLL bundle dir (has overrides.json + dlls/), or None."""
    for c in NEUTRON_RUNTIME_CANDIDATES:
        if c and os.path.isdir(c) and os.path.isfile(os.path.join(c, "overrides.json")):
            return c
    return None


def _sha256_file(path):
    """Content digest. Used to report which staged builtins actually changed --
    ⛔ never compare sizes for this: two different builds of the same DLL routinely
    come out byte-for-byte the same LENGTH."""
    import hashlib
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
    except OSError:
        return None
    return h.hexdigest()


def _is_wine_builtin(path):
    """True if `path` is a Wine-BUILT PE. Wine stamps every builtin it compiles with
    "Wine builtin DLL" in the DOS stub, so this is provenance, not a guess -- and the
    guess is what there was before: `runtime/dlls/` mixes DXVK, vkd3d-proton, Microsoft's
    real VC++ redist and our own wine builtins under names that collide with Wine's
    (d3d11, dxgi, msvcp140, msxml3 ...). Staging the wrong one either downgrades a fix or
    replaces a third-party native with a Wine stub; both look like a mass regression.
    ⛔ Do NOT substitute a name/size test. `msvcp140_2.dll` in the current bundle is
    byte-different from 11.10-61's and EXACTLY the same size (61709). """
    try:
        with open(path, "rb") as f:
            return b"Wine builtin DLL" in f.read(512)
    except OSError:
        return False


def session_is_wayland():
    return (os.environ.get("XDG_SESSION_TYPE") == "wayland"
            and bool(os.environ.get("WAYLAND_DISPLAY")))


def reg_set(wine, prefix, key, name, vtype, data):
    """Best-effort registry write via the Neutron wine. Shared-prefix safe: uses
    the prefix's existing wineserver, never kills it, and only affects newly
    started processes (so it can't disturb an already-running suite app)."""
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")   # reg.exe needs a driver to init (Xwayland ok)
        subprocess.run([wine, "reg", "add", key, "/v", name, "/t", vtype, "/d", data, "/f"],
                       env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=30)
    except Exception as e:
        log(f"reg set {key}\\{name} failed (non-fatal): {e}")


def wineserver_wait(wine, prefix, timeout=240):
    """Block until the prefix's wineserver quiesces, so pending registry/file
    writes are flushed to disk. wineboot/reg.exe detach work onto the server and
    return early; without this the .reg files aren't updated yet. Best-effort."""
    srv = os.path.join(os.path.dirname(wine), "wineserver")
    if not os.path.isfile(srv):
        srv = shutil.which("wineserver") or "wineserver"
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")
        subprocess.run([srv, "-w"], env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=timeout)
    except Exception as e:
        log(f"wineserver -w failed (non-fatal): {e}")


def resolve_webview2():
    """The staged Microsoft Edge WebView2 registered-runtime source dir (has an
    Application/<version>/msedgewebview2.exe), or None. This tree is copied into
    the prefix's 'Program Files (x86)\\Microsoft\\EdgeWebView'. Resolution order:
    $NEUTRON_WEBVIEW2 -> the runtime DLL bundle's webview2/ (so it ships with
    `neutron runtime capture`) -> dist/ -> repo-local artifact."""
    rt = resolve_runtime()
    cands = list(WEBVIEW2_CANDIDATES)
    if rt:
        cands.insert(1, os.path.join(rt, "webview2"))
    for c in cands:
        if c and os.path.isdir(os.path.join(c, "Application")):
            return c
    return None


def _webview2_version(appdir):
    """Highest x.y.z.w version subdir under an EdgeWebView\\Application that
    actually contains msedgewebview2.exe, or None."""
    import re
    if not os.path.isdir(appdir):
        return None
    vers = [d for d in os.listdir(appdir)
            if re.match(r'^\d+\.\d+\.\d+\.\d+$', d)
            and os.path.isfile(os.path.join(appdir, d, "msedgewebview2.exe"))]
    return max(vers, default=None)


def _adopt_adobe_webview2(prefix, app_dir):
    """Offline-installed prefixes: adopt the WebView2 runtime the ADOBE installer already put in the
    prefix, instead of demanding an external source dir we may not have.

    Adobe drops a complete runtime at
        Program Files\\Common Files\\Adobe\\Microsoft\\EdgeWebView\\
    but does NOT register it, and its layout is FLAT -- the DLLs sit directly in that directory with
    a sibling '<version>.manifest' naming the build, rather than the
    'Application/<version>/...' layout the loader expects. So the files are right there and the app
    still gets a blank sign-in / blank UXP panel purely because nothing points at them.

    We bridge it with a SYMLINK (Application/<version> -> Adobe's dir) rather than a copy: that tree
    is ~558 MB and duplicating it per prefix is pure waste. Returns the version, or None.

    Discovered the hard way: this had to be done by hand on ~/.premiere2025 during the Animate
    home-screen investigation, and every offline-installed prefix hits it."""
    adobe = os.path.join(prefix, "drive_c", "Program Files", "Common Files", "Adobe",
                         "Microsoft", "EdgeWebView")
    if not os.path.isdir(adobe):
        return None
    # version from '<version>.manifest'; fall back to a versioned subdir if the layout ever changes
    version = None
    try:
        for name in os.listdir(adobe):
            if name.endswith(".manifest") and name[:1].isdigit():
                version = name[: -len(".manifest")]
                break
    except OSError:
        return None
    if not version:
        return None
    # sanity: it must actually look like a runtime
    if not os.path.isfile(os.path.join(adobe, "msedgewebview2.exe")) and \
       not os.path.isfile(os.path.join(adobe, "WebView2Loader.dll")):
        log(f"webview2: Adobe copy at {adobe} has no loader/exe, not adopting")
        return None
    link = os.path.join(app_dir, version)
    try:
        os.makedirs(app_dir, exist_ok=True)
        if os.path.islink(link) or os.path.exists(link):
            return version                      # already adopted; idempotent
        os.symlink(adobe, link)
    except OSError as e:
        log(f"webview2: could not adopt Adobe copy: {e}")
        return None
    log(f"webview2: adopted Adobe's in-prefix runtime {version} (symlink, no copy)")
    return version


def register_webview2(wine, prefix):
    """Stage + register the WebView2 runtime so Adobe's in-app web sign-in (IMS)
    renders instead of a blank window. Idempotent. Returns the registered version
    string, or None if no runtime is present and no source was available.

    The loader finds the runtime via HKLM ...\\EdgeUpdate\\Clients\\{GUID} "pv"
    + the standard path %ProgramFiles(x86)%\\Microsoft\\EdgeWebView\\Application\\
    <pv> — BOTH the files (at that path) and the key are required, and the key
    must exist in the 64-bit view AND Wow6432Node (the licensing helper is 32-bit).
    The Adobe installer's Common Files copy is NOT registered, hence blank sign-in."""
    ew = os.path.join(prefix, "drive_c", "Program Files (x86)", "Microsoft", "EdgeWebView")
    app = os.path.join(ew, "Application")
    version = _webview2_version(app)                 # already staged?
    if not version:
        version = _adopt_adobe_webview2(prefix, app)  # offline installs: use Adobe's own copy
    if not version:
        src = resolve_webview2()
        if not src:
            return None
        version = _webview2_version(os.path.join(src, "Application"))
        if not version:
            return None
        try:
            os.makedirs(os.path.dirname(ew), exist_ok=True)
            shutil.copytree(src, ew, dirs_exist_ok=True)
        except OSError as e:
            log(f"webview2 stage failed: {e}")
            return None
    # Register in both registry views so the 32-bit + 64-bit loaders find it.
    for clients in (r"HKLM\Software\Microsoft\EdgeUpdate\Clients",
                    r"HKLM\Software\Wow6432Node\Microsoft\EdgeUpdate\Clients"):
        key = clients + "\\" + WEBVIEW2_CLIENT_GUID
        reg_set(wine, prefix, key, "name", "REG_SZ", "Microsoft Edge WebView2 Runtime")
        reg_set(wine, prefix, key, "pv", "REG_SZ", version)
    return version


def _mono_bases():
    """MONO source bases, with the runtime DLL bundle's mono/ inserted so a
    captured/shipped bundle carries wine-mono (like the WebView2 runtime)."""
    rt = resolve_runtime()
    bases = list(MONO_CANDIDATES)
    if rt:
        bases.insert(1, os.path.join(rt, "mono"))
    return bases


def _gecko_bases():
    """GECKO source bases, with the runtime DLL bundle's gecko/ inserted."""
    rt = resolve_runtime()
    bases = list(GECKO_CANDIDATES)
    if rt:
        bases.insert(1, os.path.join(rt, "gecko"))
    return bases


def _resolve_mono_support_msi():
    """Absolute path to the version-matched wine-mono support MSI
    (<tree>/wine-mono-<MONO_VERSION>/support/winemono-support.msi), or None."""
    for base in _mono_bases():
        if not base:
            continue
        msi = os.path.join(base, f"wine-mono-{MONO_VERSION}",
                           "support", "winemono-support.msi")
        if os.path.isfile(msi):
            return msi
    return None


def _resolve_gecko_tree(arch):
    """Absolute path to the version-matched extracted wine-gecko tree for an arch
    ('x86' or 'x86_64'): <tree>/wine-gecko-<GECKO_VERSION>-<arch>, or None."""
    for base in _gecko_bases():
        if not base:
            continue
        d = os.path.join(base, f"wine-gecko-{GECKO_VERSION}-{arch}")
        if os.path.isdir(d):
            return d
    return None


def install_mono_gecko(wine, prefix):
    """Install the matching Wine Mono + Gecko INTO the prefix so wineboot never
    prompts the user for them at launch and nothing (mscoree/mshtml) is disabled.
    Idempotent. This is the correct, non-clobbering handling: a complete Adobe
    prefix HAS mono+gecko installed (the proven mudhut-accc2 does) — we never
    suppress mscoree/mshtml on the launch path (that leaves gecko missing and
    blanks Adobe's mshtml-backed web content). Returns a dict describing what ran.

    - Gecko: copy the extracted tree into system32/gecko/<ver>/wine_gecko (x86)
      and syswow64/gecko/<ver>/wine_gecko (x86_64) — the exact layout wine's
      mshtml produces (matches accc2). No MSI/prompt needed.
    - Mono: run the tree's winemono-support.msi via msiexec (this is what wine's
      own installer runs; it creates the c:\\windows\\mono links + registry)."""
    res = {"mono": None, "gecko": None}
    win = os.path.join(prefix, "drive_c", "windows")

    # --- Gecko: place both arch trees where mshtml looks (idempotent). ----------
    gecko_done = []
    for arch, scope in (("x86", "system32"), ("x86_64", "syswow64")):
        dst = os.path.join(win, scope, "gecko", GECKO_VERSION, "wine_gecko")
        if os.path.isdir(dst) and os.listdir(dst):
            gecko_done.append(f"{scope}:present")
            continue
        src = _resolve_gecko_tree(arch)
        if not src:
            gecko_done.append(f"{scope}:no-source")
            continue
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copytree(src, dst, dirs_exist_ok=True)
            gecko_done.append(f"{scope}:installed")
        except OSError as e:
            log(f"gecko {scope} install failed: {e}")
            gecko_done.append(f"{scope}:error")
    res["gecko"] = {"version": GECKO_VERSION, "arches": gecko_done}

    # --- Mono: install via the support MSI unless already installed. ------------
    # Modern wine-mono's support MSI references the extracted tree in place (no
    # c:\windows\mono copy); its install artifact is syswow64\monodebg.vxd + the
    # "Wine Mono Windows Support" uninstall record (matches the proven accc2 prefix).
    mono_marker = os.path.join(win, "syswow64", "monodebg.vxd")
    if os.path.isfile(mono_marker):
        res["mono"] = {"version": MONO_VERSION, "status": "present"}
    else:
        msi = _resolve_mono_support_msi()
        if not msi:
            res["mono"] = {"version": MONO_VERSION, "status": "no-source"}
        else:
            try:
                env = dict(os.environ)
                env["WINEPREFIX"] = prefix
                env.setdefault("DISPLAY", ":0")
                # mscoree/mshtml must be ENABLED here so the MSI's mono setup runs;
                # this is the install path, never the launch path.
                env.pop("WINEDLLOVERRIDES", None)
                winpath = "z:" + msi.replace("/", "\\")
                subprocess.run([wine, "msiexec", "/i", winpath, "/qn"],
                               env=env, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=240)
                wineserver_wait(wine, prefix)
                res["mono"] = {"version": MONO_VERSION,
                               "status": "installed" if os.path.isfile(mono_marker)
                               else "ran"}
            except Exception as e:
                log(f"mono install failed (non-fatal): {e}")
                res["mono"] = {"version": MONO_VERSION, "status": "error"}
    return res


# Font-type suffix Wine uses in the HKLM Fonts value name, by extension.
_FONT_REG_SUFFIX = {".otf": " (OpenType)", ".ttf": " (TrueType)",
                    ".ttc": " (TrueType)", ".fon": ""}


def _host_font_files():
    """The host machine's installed font files, via fontconfig. Portable: reads
    THIS machine's fonts, so it self-populates correctly on any build-tester's
    box (never a hardcoded list). Returns absolute Linux paths."""
    try:
        out = subprocess.run(["fc-list", ":", "file"], capture_output=True,
                             text=True, timeout=30).stdout
    except Exception as e:
        log(f"fc-list unavailable ({e}); host fonts NOT registered")
        return []
    files = []
    for line in out.splitlines():
        # fc-list ": file" prints "<path>: " — strip the trailing ": ".
        p = line.strip()
        if p.endswith(":"):
            p = p[:-1].strip()
        if os.path.isabs(p) and os.path.isfile(p):
            files.append(p)
    return files


def font_postscript_names(path):
    """EVERY nameID 6 (PostScript name) in a TrueType/OpenType `name` table, as a
    set. Dependency-free — this has to run on a build tester's box.

    ⚠️ Returns a SET, and reads every record, because the real Microsoft core
    fonts carry TWO nameID 6 entries (a Macintosh-platform one whose bytes are
    UTF-16 anyway, then the Windows one) while Wine's substitutes carry only the
    Windows one. An earlier version returned the first match and therefore
    decoded the genuine times.ttf as '\\x00T\\x00i\\x00m...' and reported the
    HEALTHY dev-box prefix as faked — a check that condemns working machines is
    worse than no check. Both decodings of every record are collected.

    Why the PostScript name and not the family name: Wine's replacement fonts
    carry the REAL family ("Times New Roman") under the REAL filename
    (times.ttf) but a Wine-specific PostScript name ("WineTimesNewRoman").
    Adobe's CoolType resolves the per-script default face by PostScript name, so
    family-name and filename checks both come back clean on a prefix that is
    fatally broken. See _roman_default_status()."""
    names = set()
    try:
        with open(path, "rb") as f:
            d = f.read()
        # collection: first font only — the Roman defaults are never .ttc anyway
        off = struct.unpack(">I", d[12:16])[0] if d[:4] == b"ttcf" else 0
        name_off = None
        for i in range(struct.unpack(">H", d[off + 4:off + 6])[0]):
            e = off + 12 + 16 * i
            if d[e:e + 4] == b"name":
                name_off = struct.unpack(">II", d[e + 8:e + 16])[0]
                break
        if name_off is None:
            return names
        count, str_off = struct.unpack(">HH", d[name_off + 2:name_off + 6])
        for i in range(count):
            r = name_off + 6 + 12 * i
            _pid, _eid, _lid, nid, ln, o = struct.unpack(">HHHHHH", d[r:r + 12])
            if nid != 6:
                continue
            raw = d[name_off + str_off + o:name_off + str_off + o + ln]
            for enc in ("utf-16-be", "latin1"):
                try:
                    s = raw.decode(enc).strip("\x00").strip()
                except UnicodeDecodeError:
                    continue
                if s:
                    names.add(s)
    except Exception:
        return names
    return names


# 🚨 The three faces Adobe's CoolType tries, in order, when it picks the default
# Roman face. Wine ships a substitute for EVERY one of them
# under the same Microsoft filename, so a prefix can hold all three files, pass
# every presence check, and still contain none of the PostScript names CoolType
# is looking for.
_ROMAN_DEFAULTS = {"times.ttf": "TimesNewRomanPSMT",
                   "arial.ttf": "ArialMT",
                   "cour.ttf": "CourierNewPSMT"}

# FamilyName as CoolType records it, per PostScript name. Needed to find the
# right record in AdobeFnt_OSFonts.lst -- see _stale_roman_cache_records().
_ROMAN_FAMILY = {"TimesNewRomanPSMT": "Times New Roman",
                 "ArialMT": "Arial",
                 "CourierNewPSMT": "Courier New"}


def _roman_default_status(prefix):
    """Per-file authenticity of the fonts CoolType needs for its default Roman
    face. Returns [(filename, state, detail)] with state in
    real | wine-substitute | missing | unreadable.

    ⭐ 2026-08-11 — THIS IS THE AFTER EFFECTS `IEggApp failed` BUG, reproduced on the dev
    box in the clean room. Replace times.ttf, arial.ttf and cour.ttf with Wine's
    substitutes and AE dies at startup with `EGG Constructor IEggApp failed` and
    the boilerplate "check you have the appropriate permissions" message; restore
    them and it starts. Confirmed at the exception level: 81 CoolType throws +1
    TXT.dll +1 aelib.dll on the failing run vs 80 +0 +0 on the working one, and
    the AE internal log is a 93-line normalized match for the build tester's.
    CoolType throws when NONE of the three resolves; it
    falls back gracefully as long as ONE survives, which is why swapping only
    times.ttf changes the log line to ArialMT and nothing breaks.

    ⛔ Do NOT replace this with a filename or family-name check. The existing
    msttcorefonts check tests six Wine-UNIQUE names (georgia/verdana/impact/
    trebuc/comic/andalemo) precisely because they cannot collide — which is
    exactly why it reports 6/6 on a prefix with all three Roman defaults faked."""
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    rows = []
    for fn, want in _ROMAN_DEFAULTS.items():
        path = os.path.join(fd, fn)
        if not os.path.isfile(path):
            rows.append((fn, "missing", f"{fn} not in windows/Fonts"))
            continue
        ps = font_postscript_names(path)
        if want in ps:
            rows.append((fn, "real", want))
        elif not ps:
            rows.append((fn, "unreadable", "no PostScript name in the font's name table"))
        else:
            # Report the shortest pure-ASCII name: the UTF-16 record decoded as
            # latin1 also lands in the set as "W i n e A r i a l", which is noise.
            ascii_names = [n for n in ps if all(0x20 <= ord(c) < 0x7f for c in n)]
            best = min(ascii_names or sorted(ps), key=len)
            rows.append((fn, "wine-substitute",
                         f"PostScript name is {best!r}, not {want!r}"))
    return rows


def _prune_app_logs(log_dir, app, keep=20):
    """Keep only the newest `keep` logs for this app; delete the rest.

    Bounded per-app so a chatty app can't starve a quiet one out of its history.
    ⚠️ Size matters here: an Adobe wine log with debug channels on reaches
    hundreds of MB (this box has a 5.4 GB one), so an unbounded log dir would
    quietly become the biggest thing on the disk. Best-effort — a failure to
    prune must never stop a launch."""
    try:
        mine = sorted(
            (e.path for e in os.scandir(log_dir)
             if e.is_file() and e.name.startswith(app + "-") and e.name.endswith(".log")),
            key=os.path.getmtime, reverse=True)
        for old in mine[keep - 1:]:      # -1: we are about to create one more
            try:
                os.remove(old)
            except OSError:
                pass
    except OSError:
        pass


def _cooltype_cache_dirs(prefix):
    """CoolType's per-app `Typesupport` cache dirs inside a prefix (they hold
    AdobeFnt_OSFonts.lst / AdobeFnt_CMaps.lst)."""
    out = []
    users = os.path.join(prefix, "drive_c", "users")
    for root, dirs, _files in os.walk(users):
        if os.path.basename(root).lower() == "typesupport":
            out.append(root)
            dirs[:] = []
    return out


def _stale_roman_cache_records(prefix):
    """The Roman-default families whose CACHED record still names a Wine
    substitute, as [(family, cached FontName, cache path)].

    🚨 2026-08-12, from the build tester — THIS, not the files, is what actually
    kept After Effects down. Their times/arial/cour were all genuine (installed
    by `winetricks corefonts`), every file-level check passed, and AE still died
    for three more days: `AdobeFnt_OSFonts.lst` was still serving
    `WineTimesNewRoman`/`WineArial`/`WineCourierNew` with the SUBSTITUTES' file
    lengths. We had hit the same trap mirrored (our cache kept serving the real
    font's length after we installed a substitute), so this is symmetric and it
    invalidates a files-only check in BOTH directions.

    ⭐ The staleness is PER RECORD, keyed on filename: corefonts introduced new
    filenames (georgia, verdana, impact, trebuc, comic, andalemo) and those were
    read fresh, and the Bold/Italic faces of Times/Arial/Courier refreshed too
    — because Wine ships substitutes for exactly times/arial/cour REGULAR and
    nothing else. So the only stale records are the three Regular faces, which
    are exactly and only what CoolType looks up for its default. Everything else
    refreshing correctly is what made this so well hidden.

    ⚠️ Two rules this must obey, both learned by getting them wrong (2026-08-12,
    caught by the build tester on a prefix where AE starts):

    * **At least one genuine is enough**, exactly like the file-level rule —
      CoolType falls back. An earlier version appended an entry for each of the
      three whose genuine name was absent and failed on any of them, so a prefix
      with a substitute `times.ttf` but genuine `arial`/`cour` — files and cache
      faithful to each other, AE starting fine on ArialMT — was reported FAIL and
      the user told to delete a correct cache. That is the false PASS mirrored.
    * **Scope the lookup to the right record.** Searching the whole file for
      `FontName:Wine\\w*` reports the first Wine record anywhere, and every real
      prefix legitimately carries several (msyh, symbol, tahoma, tahomabd,
      wingding) — it blamed `WineYahei`, a CJK face with nothing to do with Roman
      defaults. Match on FamilyName + StyleName:Regular, because the Bold/Italic
      records share the FamilyName and are genuine.
    """
    stale = []
    for d in _cooltype_cache_dirs(prefix):
        lst = os.path.join(d, "AdobeFnt_OSFonts.lst")
        if not os.path.isfile(lst):
            continue
        try:
            with open(lst, "rb") as f:
                text = f.read().decode("latin1")
        except OSError:
            continue
        # Records are "%BeginFont ... FontName:X ... %EndFont" blocks.
        recs = re.findall(r"%BeginFont(.*?)%EndFont", text, re.S)
        per_file, found_genuine = [], False
        for want in _ROMAN_DEFAULTS.values():
            fam = _ROMAN_FAMILY[want]
            blk = next((r for r in recs
                        if re.search(r"FamilyName:%s\s" % re.escape(fam), r)
                        and re.search(r"StyleName:Regular\s", r)), None)
            if blk and ("FontName:%s" % want) in blk:
                found_genuine = True        # one is enough, same as the files
            else:
                m = re.search(r"FontName:(Wine\w*)", blk or "")
                per_file.append((want, m.group(1) if m else "absent", lst))
        if not found_genuine:
            stale.extend(per_file)
    return stale


# ⭐ 2026-08-15 — CEP PANEL CEF FLAGS, and why they must be re-applied rather than set once.
#
# Chromium inside CEPHtmlEngine splits its output into DirectComposition layers; under Wine the
# textured tile quads fail to draw (ANGLE->D3D11->DXVK tile-texture interop) and the panel renders
# as blank/banded solid quads. `--disable-direct-composition` makes Chromium abandon layer
# splitting and draw one composited frame into a single CreateSwapChainForHwnd swapchain, which
# our DXVK-hook -> shared-mem -> winewayland transport already delivers. That, with the two
# sandbox flags, is what made the Captioneer panel render at all (memory
# `neutron-cep-panel-sandbox`, 2026-07-04).
#
# 🚨 The flags live in the EXTENSION'S OWN manifest, which its updater overwrites. Captioneer
# 1.8.1 (2026-08-15) shipped a manifest with 5 parameters where the working one had 10, and the
# panel stopped rendering. The 2026-07-04 note already said these should become "Neutron's
# standard CEP command-line set (manifest patcher)" -- that patcher was never built, so the fix
# survived only as a hand edit in a file an installer replaces. This is that patcher.
#
# ⚠️ Scoped deliberately. `--disable-direct-composition` changes how a panel composites, and
# Adobe's own panels (com.adobe.ccx.* Home screen) currently render fine WITHOUT it. Applying it
# suite-wide would be changing working panels on a hunch, so we touch only vendors we have
# actually validated. Add a prefix here when a panel is confirmed broken without the flags.
NEUTRON_CEP_FLAGS = ("--no-sandbox", "--disable-gpu-sandbox", "--disable-direct-composition")
NEUTRON_CEP_VENDORS = ("com.aescripts.",)
CEP_MANIFEST_BACKUP_SUFFIX = ".pre-neutron-cepflags"


def _cep_manifests(prefix):
    """Every installed CEP extension manifest, as (extension_id, path)."""
    user = prefix_user(prefix) or "nuck"
    roots = [
        os.path.join(prefix, "drive_c", "Program Files (x86)", "Common Files",
                     "Adobe", "CEP", "extensions"),
        os.path.join(prefix, "drive_c", "users", user, "AppData", "Roaming",
                     "Adobe", "CEP", "extensions"),
    ]
    out = []
    for root in roots:
        if not os.path.isdir(root):
            continue
        try:
            entries = sorted(os.listdir(root))
        except OSError:
            continue
        for name in entries:
            man = os.path.join(root, name, "CSXS", "manifest.xml")
            if os.path.isfile(man):
                out.append((name, man))
    return out


def cep_flag_status(prefix):
    """Which in-scope manifests are missing Neutron's CEF flags.

    Returns [(extension_id, manifest_path, [missing flags])]; empty when all are correct.
    """
    missing = []
    for ext_id, man in _cep_manifests(prefix):
        if not ext_id.startswith(NEUTRON_CEP_VENDORS):
            continue
        try:
            with open(man, "r", encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        # A manifest with no <CEFCommandLine> at all declares no flags; that still counts as
        # missing, but we cannot safely invent the element, so report it and skip repair.
        present = set(re.findall(r"<Parameter>([^<]*)</Parameter>", text))
        absent = [f for f in NEUTRON_CEP_FLAGS if f not in present]
        if absent:
            missing.append((ext_id, man, absent))
    return missing


def ensure_cep_flags(prefix, log_fn=None):
    """Re-add Neutron's CEF flags to in-scope CEP manifests. Returns the list repaired."""
    repaired = []
    for ext_id, man, absent in cep_flag_status(prefix):
        try:
            with open(man, "r", encoding="utf-8", errors="replace") as f:
                text = f.read()
            if "<CEFCommandLine>" not in text:
                if log_fn:
                    log_fn("cep-flags: %s has no <CEFCommandLine>; not editing" % ext_id)
                continue

            def _add(m, absent=absent):
                block = m.group(0)
                have = set(re.findall(r"<Parameter>([^<]*)</Parameter>", block))
                ins = "".join("\n            <Parameter>%s</Parameter>" % f
                              for f in absent if f not in have)
                return block.replace("</CEFCommandLine>",
                                     ins + "\n         </CEFCommandLine>") if ins else block

            new = re.sub(r"<CEFCommandLine>.*?</CEFCommandLine>", _add, text, flags=re.S)
            if new == text:
                continue
            bak = man + CEP_MANIFEST_BACKUP_SUFFIX
            if not os.path.exists(bak):
                shutil.copy2(man, bak)
            with open(man, "w", encoding="utf-8") as f:
                f.write(new)
            repaired.append((ext_id, absent))
            if log_fn:
                log_fn("cep-flags: %s <- %s" % (ext_id, " ".join(absent)))
        except OSError as e:
            if log_fn:
                log_fn("cep-flags: %s FAILED: %s" % (ext_id, e))
    return repaired


def invalidate_cooltype_caches(prefix):
    """Delete CoolType's Typesupport caches so the next launch re-reads the font
    FILES. Adobe rebuilds them automatically; this is safe and idempotent.

    Called unconditionally whenever we touch fonts. The alternative — repair the
    files and leave the cache — produces a prefix that passes every check we can
    make and still fails, which is precisely how three days were lost. Returns
    the number of files removed."""
    n = 0
    for d in _cooltype_cache_dirs(prefix):
        for fn in os.listdir(d):
            if fn.lower().startswith("adobefnt") and fn.lower().endswith(".lst"):
                try:
                    os.remove(os.path.join(d, fn))
                    n += 1
                except OSError:
                    pass
    return n


def _find_real_roman_font(want, extra_dirs=()):
    """A host (or extra_dirs) font file whose PostScript name is `want`, or None.
    Used to repair a prefix whose Roman defaults are Wine substitutes without
    making the user re-run winetricks — but only when a genuine source exists."""
    cands = list(_host_font_files())
    for d in extra_dirs:
        if d and os.path.isdir(d):
            cands += [os.path.join(d, f) for f in sorted(os.listdir(d))]
    for p in cands:
        if os.path.splitext(p)[1].lower() not in (".ttf", ".ttc", ".otf"):
            continue
        if want in font_postscript_names(p):
            return p
    return None


def _wine_fonts_dir(wine):
    """The Wine builtin fonts dir (tahoma.ttf, arial.ttf, times.ttf, ...). These
    are NOT on the Linux host (fc-list misses them) but dwrite's last-resort
    fallback HARDCODES "Tahoma" (layout.c) — without it, Adobe text layout
    NULL-derefs on File>New. Located relative to the wine binary; covers the
    build tree and a packaged (bin/) install."""
    # Check the dir of the wine symlink itself (build tree: fonts/ sits beside it)
    # AND the realpath target's tree (packaged: bin/wine -> ../share/wine/fonts).
    cands = []
    for base in (os.path.dirname(os.path.abspath(wine)),
                 os.path.dirname(os.path.realpath(wine))):
        cands += [os.path.join(base, "fonts"),
                  os.path.join(os.path.dirname(base), "share", "wine", "fonts"),
                  os.path.join(os.path.dirname(base), "lib", "wine", "fonts")]
    for c in cands:
        if os.path.isfile(os.path.join(c, "tahoma.ttf")):
            return c
    return None


def register_prefix_fonts(wine, prefix):
    """Populate HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts with
    (1) the fonts staged under drive_c/windows/Fonts and (2) the host machine's
    fonts (fontconfig). Returns the number of entries written.

    Two failures this prevents, both because Wine does NOT auto-register fonts a
    prefix merely *has*:

    * Copied-in windows/Fonts: load_file_system_fonts() scans that dir with
      flags=0 (win32u/font.c) and update_external_font_keys() — the only writer
      of the HKLM Fonts key — skips faces lacking ADDFONT_EXTERNAL_FONT. So the
      Adobe fonts stay invisible to dwrite; the Segoe UI->Adobe Clean
      replacement resolves to an unregistered family -> blank menu bar.

    * Host fonts: a freshly-provisioned prefix has an almost-empty dwrite system
      font collection. When Adobe's torq text engine lays out the New Document
      and dwrite reaches its LAST-RESORT fallback (layout.c
      layout_run_get_last_resort_font -> create_matching_font), the range's font
      collection is NULL -> create_matching_font derefs NULL -> HARD CRASH on
      File>New (no dialog). Registering the host font set makes the collection
      valid, exactly like a normally-used prefix. load_registry_fonts() loads
      full-path (host) entries and windows/Fonts-relative (bare) entries alike.

    One idempotent `reg import`. Registry key names are made unique so
    load_registry_fonts() never skips a file on a duplicate face name (dwrite
    still keys the loaded font on its real name read from the file)."""
    entries = []           # (unique_reg_name, value)
    seen = set()

    def add(name, value):
        base, i = name, 1
        while name in seen:      # guarantee a unique key per file
            i += 1
            name = f"{base} #{i}"
        seen.add(name)
        entries.append((name, value))

    # (1) prefix windows/Fonts — value is the bare filename (Wine resolves it
    #     against %WINDIR%\Fonts).
    fonts_dir = os.path.join(prefix, "drive_c", "windows", "Fonts")
    if os.path.isdir(fonts_dir):
        for fn in sorted(os.listdir(fonts_dir)):
            suffix = _FONT_REG_SUFFIX.get(os.path.splitext(fn)[1].lower())
            if suffix is None:
                continue
            add(os.path.splitext(fn)[0] + suffix, fn)

    # (2) host fonts — value is the full Wine DOS path (Z: maps to the host root).
    host_files = list(_host_font_files())
    # (3) Wine builtin fonts (Tahoma etc.) — the last-resort font isn't on Linux.
    wfd = _wine_fonts_dir(wine)
    if wfd:
        host_files += [os.path.join(wfd, f) for f in sorted(os.listdir(wfd))]
    for p in host_files:
        suffix = _FONT_REG_SUFFIX.get(os.path.splitext(p)[1].lower())
        if suffix is None or not os.path.isfile(p):
            continue
        dos = "Z:" + os.path.abspath(p).replace("/", "\\")
        add(os.path.basename(os.path.splitext(p)[0]) + suffix, dos)

    if not entries:
        return 0

    def esc(s):  # .reg string escaping
        return s.replace("\\", "\\\\").replace('"', '\\"')

    lines = ["REGEDIT4", "",
             r"[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts]"]
    lines += [f'"{esc(n)}"="{esc(v)}"' for n, v in entries]
    body = "\r\n".join(lines) + "\r\n"

    # Write the .reg inside the prefix so we can hand wine a plain C: path
    # (avoids Z:\ DOS-path escaping quirks).
    tmp_dir = os.path.join(prefix, "drive_c", "windows", "temp")
    try:
        os.makedirs(tmp_dir, exist_ok=True)
        reg_path = os.path.join(tmp_dir, "neutron-fonts.reg")
        with open(reg_path, "w", newline="") as f:
            f.write(body)
    except OSError as e:
        log(f"font registry file write failed (non-fatal): {e}")
        return 0
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")
        subprocess.run([wine, "reg", "import", r"C:\windows\temp\neutron-fonts.reg"],
                       env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=120)
    except Exception as e:
        log(f"font registry import failed (non-fatal): {e}")
        return 0
    return len(entries)


def detect_scale():
    """Best-effort primary-monitor scale (KDE). Returns float or None. Collider
    normally passes --scale; this is the direct-CLI fallback. (DE-specific: KDE
    kscreen-doctor; GNOME/wlroots would need their own source.)"""
    if not have("kscreen-doctor"):
        return None
    try:
        r = subprocess.run(["kscreen-doctor", "--json"], stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, timeout=5)
        data = json.loads(r.stdout or b"{}")
        outs = [o for o in data.get("outputs", []) if o.get("enabled")]
        prim = next((o for o in outs if o.get("priority") == 1), None)
        if prim and prim.get("scale"):
            return float(prim["scale"])
        scales = [float(o["scale"]) for o in outs if o.get("scale")]
        return max(scales) if scales else None
    except Exception:
        return None


def ensure_dxvk_gpl(conf_path, full_body=None):
    """Ensure the DXVK config exists and carries the graphics-pipeline-library workaround.

    ⚠️ If the file has to be CREATED and we know the app's full config, write the full config --
    not just the one workaround line. Writing a one-line stub here is what bit a build tester on
    2026-08-08: the stub satisfied every later "does the conf exist?" check, so the app ran on
    DXVK's defaults (which report an AMD GPU on an NVIDIA card) and provision would not replace it.
    Appending to an EXISTING file stays minimal -- it may carry the user's own tuning."""
    try:
        if os.path.isfile(conf_path):
            with open(conf_path) as f:
                if "enableGraphicsPipelineLibrary" in f.read():
                    return
            with open(conf_path, "a") as f:
                f.write(DXVK_GPL_LINE + "\n")
            return
        os.makedirs(os.path.dirname(conf_path), exist_ok=True)
        with open(conf_path, "w") as f:
            f.write(full_body if full_body else DXVK_GPL_LINE + "\n")
    except Exception as e:
        log(f"dxvk gpl workaround write failed (non-fatal): {e}")


def _display_fix_is_on(content):
    """True iff the display-fix key is present AND its current value is 'true'.

    Parses line by line, splits on tab, strips CR. Robust against the line's
    trailing whitespace (Premiere writes this line with a double CRLF).
    """
    for raw in content.splitlines():
        line = raw.rstrip("\r")
        if line.startswith(DISPLAY_FIX_KEY + "\t"):
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1].strip().lower() == "true":
                return True
            return False
    return False


# --- commands --------------------------------------------------------------

WINE_SYSTEM_PROCS = {
    "wineserver", "services.exe", "winedevice.exe", "plugplay.exe", "explorer.exe",
    "svchost.exe", "rpcss.exe", "start.exe", "conhost.exe", "rundll32.exe", "tabtip.exe",
}


def _prefix_procs(prefix):
    """Live pids belonging to this prefix: [(pid, comm, is_app)].

    Detect by `environ WINEPREFIX=` + exe path, NEVER by cmdline substring -- wine's own system
    processes (services.exe, explorer.exe...) carry no 'wine'/'Adobe' text and would be missed,
    which is precisely how orphans accumulated and deadlocked Lightroom's loader lock."""
    out = []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/environ", "rb") as f:
                env = f.read().decode("utf8", "replace")
            if ("WINEPREFIX=" + prefix.rstrip("/")) not in env:
                continue
            comm = open(f"/proc/{p}/comm").read().strip()
            out.append((int(p), comm, comm not in WINE_SYSTEM_PROCS))
        except Exception:
            pass
    return out


def _app_dir_token(app_id):
    """The install-directory segment that identifies a process as belonging to ONE app,
    e.g. 'Adobe Premiere Pro 2025' from 'drive_c/Program Files/Adobe/Adobe Premiere Pro 2025/...'.

    This is what makes an app-scoped teardown possible at all: every app in APP_PROFILES lives in
    its own directory under Program Files/Adobe, while Adobe's SHARED daemons (IPCBroker, CoreSync,
    Dynamic Link, CCX) live under Common Files/Adobe and therefore match NO app token. So a
    per-app kill can never take out the machinery another running app depends on."""
    prof = APP_PROFILES.get(app_id)
    if not prof:
        return None
    parts = prof["exe"].replace("\\", "/").split("/")
    try:
        return parts[parts.index("Adobe") + 1]
    except (ValueError, IndexError):
        return None


def _proc_win_exe(pid):
    """The WINDOWS exe path a wine process was started with, slash-normalised.
    /proc/<pid>/exe points at the wine loader, not the app -- cmdline[0] is the real identity."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().decode("utf8", "replace").split("\0")[0].replace("\\", "/")
    except Exception:
        return ""


def _app_procs(prefix, app_id):
    """Live pids in this prefix that belong to ONE app: [(pid, comm)]."""
    token = _app_dir_token(app_id)
    if not token:
        return []
    needle = "/" + token + "/"
    return [(pid, comm) for pid, comm, is_app in _prefix_procs(prefix)
            if is_app and needle in _proc_win_exe(pid)]


def _running_app_ids(prefix):
    """Which APP_PROFILES apps still have live processes in this prefix."""
    exes = {pid: _proc_win_exe(pid) for pid, _c, is_app in _prefix_procs(prefix) if is_app}
    out = []
    for app_id in APP_PROFILES:
        token = _app_dir_token(app_id)
        if token and any(("/" + token + "/") in e for e in exes.values()):
            out.append(app_id)
    return out


def _teardown_app(args, prefix, wine, env):
    """Close ONE app, leaving every other app in the prefix running.

    Why this exists: all seven apps share a single prefix, and closing/reopening apps while working
    on a project is a normal workflow -- so the full-prefix teardown (wineserver -k, which is
    per-prefix and therefore kills EVERYTHING) is the wrong tool for a routine app close.

    Order: WM_CLOSE to this app's images only (so it saves its preferences) -> wait -> SIGTERM ->
    SIGKILL, always by literal pid and only for processes under this app's install directory.
    Adobe's shared daemons are deliberately left alone; they are reaped by the full teardown when
    the LAST app exits, because until then another app is still using them."""
    import time as _t

    app_id = args.app
    if app_id not in APP_PROFILES:
        die({"ok": False, "reason": f"unknown app '{app_id}'",
             "known": sorted(APP_PROFILES)}, EX_FAIL, args.json)

    before = _app_procs(prefix, app_id)
    if not before:
        emit({"ok": True, "app": app_id, "torn_down": True, "already_clean": True, "killed": 0,
              "still_running": _running_app_ids(prefix)}, args.json)
        return

    # 1. graceful: WM_CLOSE via taskkill /IM so the app runs its own shutdown and writes prefs.
    #    /IM (image name), never /PID -- taskkill's /pid is a WINDOWS pid and everything we can see
    #    from /proc is a LINUX pid, so /pid silently matches nothing.
    if wine and not args.force:
        images = []
        for pid, _comm in before:
            exe = _proc_win_exe(pid).rsplit("/", 1)[-1]
            if exe.lower().endswith(".exe") and exe not in images:
                images.append(exe)
        for im in images:
            # ⚠️ No stamp guard here, and that is deliberate -- audited 2026-08-26 after the
            # build tester flagged teardown as an unguarded `wine` spawn. It cannot clobber:
            # we only reach this line when app processes exist, which means a wine session is
            # up, which means `__wineboot_event` exists, which makes `run_wineboot()` skip
            # launching wineboot entirely. See stamp_mismatch() for the full chain out of
            # wine's source. ⛔ Do NOT "fix" this by refusing a teardown -- if teardown can be
            # blocked, a stuck prefix cannot be recovered.
            try:
                subprocess.run([wine, "taskkill", "/im", im], env=env, timeout=25,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        if images:
            log(f"teardown[{app_id}]: asked to close: {', '.join(images)}")
        for _ in range(args.grace):
            if not _app_procs(prefix, app_id):
                break
            _t.sleep(1)

    # 2. escalate on this app's pids ONLY.
    for sig in (signal.SIGTERM, signal.SIGKILL):
        left = _app_procs(prefix, app_id)
        if not left:
            break
        for pid, _comm in left:
            try:
                os.kill(pid, sig)
            except Exception:
                pass
        for _ in range(10):
            if not _app_procs(prefix, app_id):
                break
            _t.sleep(1)

    left = _app_procs(prefix, app_id)
    others = [a for a in _running_app_ids(prefix) if a != app_id]

    # 3. Last one out reaps the shared machinery. While ANY app is still up, Adobe's shared daemons
    #    are in use -- killing them is what wedges the next launch, so we only sweep when the
    #    prefix is otherwise idle.
    swept = False
    if not left and not others:
        log(f"teardown[{app_id}]: last app out -- sweeping shared daemons + wineserver")
        args.app = None
        cmd_teardown(args, _emitted=True)
        swept = True

    emit({"ok": not left, "app": app_id, "torn_down": not left,
          "killed": len(before) - len(left), "still_alive": [c for _p, c in left],
          "still_running": others, "swept_prefix": swept}, args.json)
    if left:
        sys.exit(EX_FAIL)


def cmd_teardown(args, _emitted=False):
    """Close a prefix down CLEANLY, then make sure nothing survives.

    ⚠️ This is the FULL-PREFIX teardown: wineserver is per-prefix, so it takes down every app in
    the prefix. For a routine "the user closed one app" use `--app <id>` (_teardown_app), which
    leaves the other apps running.

    Two things this exists for, both learned painfully:
      1. Adobe apps write their preferences ON CLEAN EXIT. A bare `wineserver -k` kills them
         outright, so everything the user changed that session (workspace layout, colour settings,
         panel state) is silently discarded. We first ask each app window to close via `taskkill`
         WITHOUT /F, which posts WM_CLOSE and lets the app run its own shutdown path.
      2. `wineserver -k` alone leaves Adobe's daemons and wine's system processes running. They
         accumulate across launches and break the NEXT app -- Lightroom deadlocks on ntdll's
         loader_section with its licensing threads stuck behind them.

    Order: graceful WM_CLOSE -> wineserver -k (SIGINT, unwinds children) -> -k9 -> sweep survivors
    by literal pid -> clear stale server dirs. NEVER -k9 first: that orphans children mid-wait."""
    prefix = resolve_prefix(args.prefix)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "prefix", None) or getattr(args, "path", None))},
            EX_BADPREFIX, args.json)
    wine, _ = resolve_wine()
    env = dict(os.environ, WINEPREFIX=prefix)
    import time as _t

    # A routine app close is app-scoped; only "shut the whole prefix down" comes through here.
    if getattr(args, "app", None):
        return _teardown_app(args, prefix, wine, env)

    before = _prefix_procs(prefix)
    if not before:
        if not _emitted:
            emit({"ok": True, "torn_down": True, "already_clean": True, "killed": 0}, args.json)
        return

    # 1. graceful: let the apps save their preferences.
    # ⚠️ Use /IM (image name), NOT /PID: taskkill's /pid takes a WINDOWS pid, and everything we can
    # see from /proc is a LINUX pid. Passing the Linux pid silently matches nothing, which made the
    # whole graceful step a no-op the first time this was written.
    if wine and not args.force:
        images = []
        for pid, _comm, is_app in before:
            if not is_app:
                continue
            try:
                cl = open(f"/proc/{pid}/cmdline", "rb").read().decode("utf8", "replace")
                exe = cl.split("\0")[0].replace("\\", "/").rsplit("/", 1)[-1]
                if exe.lower().endswith(".exe") and exe not in images:
                    images.append(exe)
            except Exception:
                pass
        for im in images:
            # ⚠️ No stamp guard here, and that is deliberate -- audited 2026-08-26 after the
            # build tester flagged teardown as an unguarded `wine` spawn. It cannot clobber:
            # we only reach this line when app processes exist, which means a wine session is
            # up, which means `__wineboot_event` exists, which makes `run_wineboot()` skip
            # launching wineboot entirely. See stamp_mismatch() for the full chain out of
            # wine's source. ⛔ Do NOT "fix" this by refusing a teardown -- if teardown can be
            # blocked, a stuck prefix cannot be recovered.
            try:
                subprocess.run([wine, "taskkill", "/im", im], env=env, timeout=25,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        if images:
            log(f"teardown: asked {len(images)} app(s) to close: {', '.join(images)}")
        for _ in range(args.grace):
            if not [p for p in _prefix_procs(prefix) if p[2]]:
                break
            _t.sleep(1)

    # 2/3. graceful server shutdown, then hard
    ws = os.path.join(os.path.dirname(wine), "wineserver") if wine else None
    for flag in ("-k", "-k9"):
        if ws and os.path.exists(ws) and _prefix_procs(prefix):
            try:
                subprocess.run([ws, flag], env=env, timeout=60,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
            for _ in range(20):
                if not _prefix_procs(prefix):
                    break
                _t.sleep(1)

    # 4. sweep survivors, killing by LITERAL pid (a shell "$PIDS" splat fires nothing under zsh)
    for _ in range(3):
        survivors = _prefix_procs(prefix)
        if not survivors:
            break
        for pid, comm, _is_app in survivors:
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
        _t.sleep(2)

    left = _prefix_procs(prefix)
    if not left:
        for d in glob.glob("/tmp/.wine-%d/server-*" % os.getuid()):
            try:
                shutil.rmtree(d)
            except Exception:
                pass
    if not _emitted:
        emit({"ok": not left, "torn_down": not left, "killed": len(before) - len(left),
              "still_alive": [c for _p, c, _a in left]}, args.json)
        if left:
            sys.exit(EX_FAIL)


def cmd_prefix_info(args):
    """Inspect a prefix; report the paths Collider needs.

    NOTE: schema PROVISIONAL (v0-unstable). The hardening brief's ordering note
    says prefix info / doctor JSON must not be frozen until the minimal-stack
    cleanup (§5.2) confirms which components ship. Stable fields below are
    documents_real and display_fix_applied; neutron_stack is best-effort.
    """
    prefix = resolve_prefix(args.path)
    if not prefix:
        # Was a bare "no drive_c found at path" — which names no path, lists nothing, and is the
        # same dead end the tester hit. Explain, and offer the candidates.
        die({"valid": False, **bad_prefix_reason(args.path)}, EX_BADPREFIX, args.json)

    user = prefix_user(prefix)
    if not user:
        die({"valid": False, "reason": "no user dir under drive_c/users"},
            EX_BADPREFIX, args.json)

    link, real = documents_paths(prefix, user)
    dbg = find_debug_database(prefix, user)
    display_fix_applied = False
    if dbg and os.path.isfile(dbg):
        try:
            with open(dbg, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
            display_fix_applied = _display_fix_is_on(content)
        except OSError:
            display_fix_applied = False

    out = {
        "valid": True,
        "wineprefix": prefix,
        "drive_c": os.path.join(prefix, "drive_c"),
        "user": user,
        "documents_symlink": link,
        "documents_real": real,          # <- symlink-resolved real Documents dir
        "debug_database": dbg,
        "display_fix_applied": display_fix_applied,
        "neutron_stack": _stack_versions(),  # best-effort, provisional
        "_schema": "provisional-v0",      # signal: not frozen yet
    }
    emit(out, args.json)
    return EX_OK


def _stack_versions():
    """Best-effort stack version probe. Provisional until minimal stack settles."""
    stack = {}
    try:
        r = subprocess.run(["wine", "--version"],
                           capture_output=True, text=True, timeout=10)
        stack["wine"] = r.stdout.strip() or None
    except Exception:
        stack["wine"] = None
    # DXVK / vkd3d versions live in the deployed DLLs; reading them reliably is
    # part of the hardening pass. Left null until §5.2 pins them.
    stack["dxvk"] = None
    stack["vkd3d"] = None
    return stack


def _has_marker(path, marker):
    """True if the binary contains `marker` (bytes). Used to prove a FIX is in the
    artifact on disk, not merely that a file of the right name exists.

    Size and mtime are worthless here: we patch wine's own builtins, so a reverted
    or debug build has the same name and a plausible size. 2026-08-08 cost a full
    day to exactly that — `nvcuda.dll` was present, correct size, and was the
    ungated diagnostic build."""
    try:
        with open(path, "rb") as f:
            return marker in f.read()
    except OSError:
        return False


def cmd_apply_display_fix(args):
    """Write DS.DisableDirectXDisplay=true into Debug Database.txt. Idempotent."""
    prefix = resolve_prefix(args.path)
    if not prefix:
        die({"changed": False, **bad_prefix_reason(getattr(args, "prefix", None) or getattr(args, "path", None))},
            EX_BADPREFIX, args.json)

    if premiere_is_running():
        die({"changed": False, "already_applied": False,
             "premiere_running": True,
             "reason": "Premiere is running; cannot edit prefs"},
            EX_RUNNING, args.json)

    user = prefix_user(prefix)
    if user:
        results, any_changed, any_target = [], False, False
        for label, dbg, installed in find_debug_databases(prefix, user):
            if not installed:
                results.append({"app": label, "state": "not-installed"})
                continue
            any_target = True
            if dbg:
                try:
                    state = _apply_display_fix_to(dbg)
                except OSError as e:
                    results.append({"app": label, "state": "error", "reason": str(e)})
                    continue
                any_changed |= (state == "changed")
                results.append({"app": label, "state": state, "debug_database": dbg})
            else:
                # The app is installed but has never written its prefs. Adobe creates this file
                # itself on a clean exit, so on a never-run app there is nothing to edit -- which
                # is exactly the state Media Encoder was found in on a real install. Create it
                # carrying only our line; these are debug OVERRIDES, so absent keys simply take
                # their defaults, and the app rewrites the file in its own style when it exits.
                # Proven 2026-08-09 by deleting Premiere's, writing a one-line file and launching.
                vdir = _display_fix_pref_dir(prefix, user, label)
                if not vdir:
                    results.append({"app": label, "state": "pending-first-run"})
                    continue
                try:
                    os.makedirs(vdir, exist_ok=True)
                    path = os.path.join(vdir, "Debug Database.txt")
                    with open(path, "w", encoding="utf-8", newline="") as f:
                        f.write(f"{DISPLAY_FIX_KEY}\t{DISPLAY_FIX_CURRENT}"
                                f"\t{DISPLAY_FIX_DEFAULT}\r\n")
                except OSError as e:
                    results.append({"app": label, "state": "error", "reason": str(e)})
                    continue
                any_changed = True
                results.append({"app": label, "state": "created", "debug_database": path})

        prem = next((r for r in results if r["app"] == "premiere"), {})
        payload = {"ok": True, "changed": any_changed,
                   "already_applied": bool(any_target) and not any_changed,
                   "premiere_running": False,
                   "debug_database": prem.get("debug_database"),
                   "apps": results}
        if not any_target:
            payload.update({"not_applicable": True,
                            "reason": "no Premiere/After Effects/Media Encoder in prefix"})
        for r in results:
            if r["state"] in ("changed", "created"):
                log(f"display fix {r['state']}: {r['debug_database']}")
        emit(payload, args.json)
        return EX_OK

    dbg = find_debug_database(prefix, user) if user else None
    if not dbg:
        # The display fix is PREMIERE-SPECIFIC (DirectXDisplay pref in Premiere's
        # Debug Database). On a prefix without Premiere (e.g. Photoshop), there is
        # nothing to apply — return no-op success so it doesn't abort a non-Premiere
        # launch. Only error if Premiere IS installed but hasn't been run yet.
        if not os.path.isfile(os.path.join(prefix, PREMIERE_SUBPATH)):
            emit({"ok": True, "changed": False, "already_applied": False,
                  "not_applicable": True,
                  "reason": "no Premiere in prefix; display fix not applicable"},
                 args.json)
            return EX_OK
        # Premiere IS installed but has never been run, so its Debug Database does not exist yet.
        # That is the NORMAL state before a first launch — not a failure. This used to die with
        # exit 1, and because Collider applies the display fix on the way into EVERY launch, a
        # prefix with a never-run Premiere could not launch ANY app: the fix aborted the flow
        # before the app was ever spawned. Reported by a build tester 2026-08-08 whose whole
        # freshly-installed suite was unlaunchable.
        #
        # Premiere writes this file itself on first run; we apply the fix on the next launch.
        # We do NOT fabricate the file — it is Adobe's, with a format (tab-separated
        # key/current/default, odd line endings) that Premiere rewrites on a clean exit.
        emit({"ok": True, "changed": False, "already_applied": False,
              "pending_first_run": True,
              "reason": "Premiere has not been run yet; the display fix applies on the next launch"},
             args.json)
        return EX_OK

    # Read raw so we preserve every byte of every line we don't manage.
    # Premiere writes this file with mixed/odd line endings (the display-fix
    # line ends with a double CRLF); we must not rewrite lines we don't own.
    try:
        with open(dbg, "r", encoding="utf-8", errors="replace", newline="") as f:
            raw = f.read()
    except OSError as e:
        die({"changed": False, "reason": f"read failed: {e}"}, EX_FAIL, args.json)

    # The proven line, byte-for-byte as Premiere writes it: tab-separated
    # key/current/default, value 'true', ending in CRLF. We use a single CRLF
    # (sufficient and well-formed); Premiere accepts it.
    new_line = f"{DISPLAY_FIX_KEY}\t{DISPLAY_FIX_CURRENT}\t{DISPLAY_FIX_DEFAULT}\r\n"

    # Already correctly applied? Detect without rewriting anything.
    if _display_fix_is_on(raw):
        emit({"ok": True, "changed": False, "already_applied": True,
              "premiere_running": False, "debug_database": dbg}, args.json)
        return EX_OK

    # Split on \n but KEEP it, so we can reassemble preserving each line's bytes.
    lines = raw.splitlines(keepends=True)
    out_lines = []
    found = False
    for ln in lines:
        # Compare on a CR-stripped copy; the key sits at line start.
        if ln.lstrip("\ufeff").startswith(DISPLAY_FIX_KEY + "\t"):
            found = True
            out_lines.append(new_line)   # replace ONLY this line
        else:
            out_lines.append(ln)         # preserve byte-for-byte

    if not found:
        # Append. Make sure the previous last line is newline-terminated so we
        # don't glue our line onto it — but don't touch its other bytes.
        if out_lines and not out_lines[-1].endswith(("\n", "\r")):
            out_lines[-1] = out_lines[-1] + "\r\n"
        out_lines.append(new_line)

    try:
        with open(dbg, "w", encoding="utf-8", newline="") as f:
            f.write("".join(out_lines))
    except OSError as e:
        die({"changed": False, "reason": f"write failed: {e}"}, EX_FAIL, args.json)

    log(f"display fix written to {dbg}")
    emit({"ok": True, "changed": True, "already_applied": False,
          "premiere_running": False, "debug_database": dbg}, args.json)
    return EX_OK


def _win_path(prefix, abspath):
    """Convert an absolute host path under <prefix>/drive_c to its Windows form
    (C:\\...). Returns None if abspath isn't under the prefix's C: drive."""
    dc = os.path.join(prefix, "drive_c") + os.sep
    ap = os.path.abspath(abspath)
    if not ap.startswith(dc):
        return None
    return "C:\\" + ap[len(dc):].replace("/", "\\")


def provision_photoshop_detection(wine, prefix):
    """Register the Uninstall key Lightroom Classic's PS detector requires.

    LrC's scanner (in ui.dll) does a WHOLE-STRING std::regex_match of
    each HKLM\\...\\Uninstall SUBKEY NAME against `(PHSP|PHSPBETA)[0-9_]+`, then
    checks that subkey's InstallLocation + DisplayName + <InstallLocation>\\
    Photoshop.exe exist. The key name MUST be dot-free (a '.' is not in [0-9_],
    so `PHSP26.0` fails whole-string match — the bug that greyed Edit-In → PS).
    We name it `PHSP<major>` (major = year-1999, e.g. PS 2025 -> PHSP26) and write
    it into BOTH registry views (the detector opens with KEY_WOW64_32KEY, but be
    robust). No-op when no Photoshop is installed in the prefix.
    Returns a status dict (or None if PS absent)."""
    import re
    exe = _resolve_app_exe(prefix, _adobe("Adobe Photoshop 2025", "Photoshop.exe"))
    if not (exe and os.path.isfile(exe)):
        return None
    install_dir = os.path.dirname(exe)
    win_loc = _win_path(prefix, install_dir)
    if not win_loc:
        return {"ok": False, "reason": "PS install not under drive_c"}
    yrs = re.findall(r'(?:19|20)\d{2}', install_dir)
    year = max((int(y) for y in yrs), default=0)
    if not year:
        return {"ok": False, "reason": "no year in PS install path"}
    major = year - 1999                       # 2025 -> 26, 2026 -> 27
    keyname = "PHSP%d" % major                 # dot-free: matches (PHSP|PHSPBETA)[0-9_]+
    display = "Adobe Photoshop %d" % year
    for view in (r"HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
                 r"HKLM\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall"):
        base = "%s\\%s" % (view, keyname)
        reg_set(wine, prefix, base, "InstallLocation", "REG_SZ", win_loc)
        reg_set(wine, prefix, base, "DisplayName", "REG_SZ", display)   # required or the scan drops the record
        reg_set(wine, prefix, base, "DisplayVersion", "REG_SZ", "%d.0" % major)
    return {"ok": True, "key": keyname, "display": display, "install_location": win_loc}


def cmd_prefix_provision(args):
    """Make a (possibly freshly-staged) prefix Neutron-ready. Idempotent. This is
    the single source of truth for the provisioning recipe — Mud Hut calls it
    after copying the Adobe binaries in.

    Steps: (1) initialize the Wine prefix if needed (wineboot); (2) bake the
    registry provisioning (Wayland graphics driver, the Segoe UI->Adobe Clean
    font fix, the native DLL overrides); (3) place the Adobe-suite DXVK config.

    NOT yet automated (reported under `deferred`): staging the native DLL *files*
    (dxcore/dcomp/nvapi64) from the Neutron runtime, licensing/activation, and
    desktop-entry/MIME creation. Those are the remaining P1 chunks."""
    prefix = resolve_prefix(args.path)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "prefix", None) or getattr(args, "path", None))},
            EX_BADPREFIX, args.json)

    wine, is_neutron = resolve_wine()
    if not wine:
        die({"ok": False, "reason": "no wine runtime found"}, EX_FAIL, args.json)

    steps = []

    event(args, event="progress", stage="init", pct=5, msg="initialising the wine prefix (wineboot) — this is the slow part")
    # 1. Initialize / update the prefix under Mono+Gecko suppression. Run wineboot -u
    # ALWAYS (not only on a fresh prefix): an existing prefix launched against a newer
    # runtime build triggers a lazy prefix-UPDATE on the first wine call, and that update
    # pops the blocking Wine Mono/Gecko dialog — which then wedges every subsequent
    # command (reg writes time out). Absorbing the update here with mscoree,mshtml=
    # suppressed keeps the dialog from ever appearing; install_mono_gecko then installs
    # the real thing right after, so no later wine call has a pending update to prompt on.
    # This suppression is ONLY for this controlled boot, NEVER for the launch path.
    sysreg = os.path.join(prefix, "system.reg")
    fresh = not os.path.isfile(sysreg)
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")
        env["WINEDLLOVERRIDES"] = "mscoree,mshtml="   # suppress the Mono/Gecko prompt
        subprocess.run([wine, "wineboot", "-u"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=240)
        wineserver_wait(wine, prefix)   # wineboot detaches; wait so system.reg lands
    except Exception as e:
        log(f"wineboot failed (non-fatal to reporting): {e}")
    steps.append({"step": "init", "skipped": False, "fresh": fresh,
                  "ok": os.path.isfile(sysreg)})

    event(args, event="progress", stage="registry", pct=62, msg="writing registry provisioning (graphics driver, app compat)")
    # 2. Registry provisioning (only affects newly-started processes; shared-safe).
    reg_set(wine, prefix, r"HKCU\Software\Wine\Drivers", "Graphics", "REG_SZ",
            "wayland" if session_is_wayland() else "x11")
    steps.append({"step": "graphics", "ok": True})

    # 2b. Photoshop 2026 caption buttons: on a prefix reporting Windows 11 the
    # Adobe chrome DEFERS its min/max/close caption buttons to DWM (real
    # Windows 11 composites them); Wine has no DWM caption renderer, so the
    # reserved button area renders as a black box (it never even queries
    # DWMWA_CAPTION_BUTTON_BOUNDS on Win10). Reporting Windows 10 to
    # Photoshop.exe selects Adobe's SELF-drawn caption buttons — the PS 2025
    # behavior, which renders correctly under Wine. App-scoped: the rest of
    # the prefix keeps its Windows version.
    reg_set(wine, prefix, r"HKCU\Software\Wine\AppDefaults\Photoshop.exe",
            "Version", "REG_SZ", "win10")
    steps.append({"step": "ps_caption_win10", "ok": True})

    event(args, event="progress", stage="lrc", pct=70, msg="registering the Lightroom → Photoshop detector key")
    # 2c. Lightroom Classic's "Edit in Photoshop" detector: register the dot-free
    # PHSP<major> Uninstall key so LrC's whole-string regex_match finds PS (see
    # provision_photoshop_detection + memory neutron-lrc-editin-photoshop). No-op
    # when no Photoshop is installed in this prefix.
    ps_detect = provision_photoshop_detection(wine, prefix)
    if ps_detect is not None:
        steps.append({"step": "lrc_ps_detection", **ps_detect})

    runtime = resolve_runtime()
    if runtime:
        # Stage the full proven DLL set + write every override from the bundle.
        try:
            with open(os.path.join(runtime, "overrides.json")) as f:
                overrides = json.load(f)
        except Exception as e:
            log(f"runtime overrides.json unreadable: {e}")
            overrides = {}
        files_staged = 0
        # NEUTRON: the DLL bundle is a SNAPSHOT of some past prefix, and provisioning used to
        # copy all of it over the prefix unconditionally -- including the wine builtins that
        # were captured with it. Provisioning a prefix pinned to 11.10-58 therefore reinstated
        # the 11.10-45 dwrite.dll (the use-after-free one) and read as a mass regression with
        # no code change behind it. The bundle is still the right source for everything that
        # is NOT ours (DXVK, vkd3d-proton, nvidia, Microsoft's VC++ redist); for the handful
        # that IS ours, the PINNED RUNTIME is the authority and the bundle is merely stale.
        # Prefer the runtime's copy per file, so this self-heals on every provision instead of
        # waiting for someone to re-run `neutron runtime capture`.
        rt_root = os.path.dirname(os.path.dirname(os.path.realpath(wine)))   # <rt>/bin/wine -> <rt>
        refreshed, unrefreshable = [], []
        for scope, pedir in (("system32", "x86_64-windows"), ("syswow64", "i386-windows")):
            srcdir = os.path.join(runtime, "dlls", scope)
            dstdir = os.path.join(prefix, "drive_c", "windows", scope)
            rtpe = os.path.join(rt_root, "lib", "wine", pedir)
            if os.path.isdir(srcdir):
                os.makedirs(dstdir, exist_ok=True)
                for fn in os.listdir(srcdir):
                    src = os.path.join(srcdir, fn)
                    if _is_wine_builtin(src):
                        cand = os.path.join(rtpe, fn)
                        if os.path.isfile(cand):
                            if _sha256_file(cand) != _sha256_file(src):
                                refreshed.append(f"{scope}/{fn}")
                            src = cand
                        else:
                            # No counterpart in the pinned runtime. ⛔ This was first written as
                            # "a 64-bit-only runtime has no i386-windows tree" -- that was read off
                            # 11.10-61, which shipped BROKEN with an empty i386-windows; 60 and 62
                            # carry 1,101 files and refresh all eight. A healthy runtime should hit
                            # this path for nothing, so anything landing here is a signal that the
                            # runtime is incomplete, not a fact of life.
                            # no i386-windows tree, so every syswow64 builtin lands here. The
                            # bundle's copy is the only one that exists; stage it, but SAY SO.
                            # This is the one that can still rot silently.
                            unrefreshable.append(f"{scope}/{fn}")
                    try:
                        shutil.copyfile(src, os.path.join(dstdir, fn))
                        files_staged += 1
                    except OSError as e:
                        log(f"stage {scope}/{fn} failed: {e}")
        if refreshed:
            log("staged from the pinned runtime instead of the (stale) bundle: "
                + ", ".join(sorted(refreshed)))
        if unrefreshable:
            log("⚠️  bundle-only wine builtins (no counterpart in the pinned runtime, "
                "so they cannot be refreshed here): " + ", ".join(sorted(unrefreshable))
                + " — re-run `neutron runtime capture` if one of these is suspect")
        for name, val in overrides.items():
            reg_set(wine, prefix, r"HKCU\Software\Wine\DllOverrides", name, "REG_SZ", val)
        event(args, event="progress", stage="dlls", pct=75, msg="staged native DLL overrides from the runtime bundle")
        steps.append({"step": "dll_overrides", "source": "runtime-bundle",
                      "overrides": len(overrides), "files_staged": files_staged, "ok": True,
                      "builtins_refreshed": sorted(refreshed),
                      "builtins_bundle_only": sorted(unrefreshable)})
    else:
        # No bundle yet: write the minimal override set, but the native DLL FILES
        # aren't staged (apps won't launch until `neutron runtime capture` is run).
        for dll, val in PROVISION_DLL_OVERRIDES.items():
            reg_set(wine, prefix, r"HKCU\Software\Wine\DllOverrides", dll, "REG_SZ", val)
        steps.append({"step": "dll_overrides", "source": "builtin-minimal",
                      "count": len(PROVISION_DLL_OVERRIDES), "ok": True,
                      "note": "no runtime bundle; native DLL files NOT staged"})

    fonts = dict(PROVISION_FONT_REPLACEMENTS)
    if runtime:
        try:
            with open(os.path.join(runtime, "fonts.json")) as f:
                bundled = json.load(f)
            if bundled:
                fonts = bundled
        except Exception as e:
            log(f"runtime fonts.json unreadable ({e}); using builtin map")
    for name, repl in fonts.items():
        reg_set(wine, prefix, r"HKCU\Software\Wine\Fonts\Replacements", name, "REG_SZ", repl)
    event(args, event="progress", stage="fonts", pct=82, msg="applied the Adobe font replacement map")
    steps.append({"step": "fonts", "count": len(fonts), "ok": True})

    # Activate the staged fonts. Copying files into windows/Fonts is NOT enough —
    # Wine never registers them, so the replacement targets (Adobe Clean) stay
    # invisible to dwrite and the suite deadlocks on first text layout. Register
    # them explicitly in the HKLM Fonts key.
    nfonts = register_prefix_fonts(wine, prefix)
    steps.append({"step": "font_register", "count": nfonts, "ok": True})

    # 🚨 Repair the Roman defaults BEFORE anything launches. If every one of
    # times/arial/cour is a Wine substitute, CoolType has no PostScript name to
    # select as its default Roman face, it throws, and After Effects
    # dies at startup ("EGG Constructor IEggApp failed" -- a message about
    # preferences-folder permissions that has nothing to do with the fault).
    # Repro'd and reversed in the clean room 2026-08-11; see
    # _roman_default_status(). We only ever copy a font whose PostScript name is
    # genuinely the one CoolType wants, so this cannot make a prefix worse.
    roman = _roman_default_status(prefix)
    fake = [fn for fn, state, _ in roman if state != "real"]
    repaired, unrepaired = [], []
    if fake:
        fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
        for fn in fake:
            # The prefix's own Fonts dir is searched too: a `--method windows`
            # copy often carries the genuine face under a different filename
            # (e.g. "Times New Roman.ttf"), which repairs with no download.
            src = _find_real_roman_font(_ROMAN_DEFAULTS[fn], extra_dirs=(fd,))
            if src:
                try:
                    shutil.copyfile(src, os.path.join(fd, fn))
                    repaired.append(fn)
                    continue
                except OSError as e:
                    log(f"roman-default repair of {fn} failed: {e}")
            unrepaired.append(fn)
        if repaired:
            register_prefix_fonts(wine, prefix)   # re-register the replaced files
    # 🚨 UNCONDITIONALLY, even when nothing was repaired. CoolType's cache is
    # keyed on FILENAME, so any font work that overwrites a file in place --
    # ours above, or the `winetricks corefonts` we tell people to run -- leaves
    # the cached record pointing at whatever used to be there. Repairing the
    # files and leaving the cache yields a prefix that passes every check and
    # still fails, which is exactly how the build tester lost three days after
    # their fonts were already correct. Adobe rebuilds these on next launch.
    ncache = invalidate_cooltype_caches(prefix)
    steps.append({"step": "cooltype_cache_invalidate", "count": ncache, "ok": True})
    # CEP panel CEF flags: unconditional, because the thing that removes them is an extension
    # update that can happen at any time and leaves no other trace than "the panel is blank".
    cep_fixed = ensure_cep_flags(prefix, log_fn=log)
    steps.append({"step": "cep_cef_flags", "ok": True,
                  "repaired": [e for e, _f in cep_fixed],
                  "detail": ("re-applied to " + ", ".join(e for e, _f in cep_fixed) +
                             "  — RESTART the app; manifests are read only at startup")
                            if cep_fixed else "all in-scope manifests already correct"})
    roman = _roman_default_status(prefix)
    genuine = [fn for fn, state, _ in roman if state == "real"]
    steps.append({"step": "cooltype_roman_default",
                  "ok": bool(genuine),
                  "genuine": genuine, "repaired": repaired,
                  "detail": ", ".join(f"{fn}={state}" for fn, state, _ in roman) +
                            ("" if genuine else
                             "  — NO genuine Roman face; After Effects WILL fail at startup. "
                             "Install the real Microsoft core fonts (`winetricks corefonts`).")})
    if not genuine:
        log("⚠️  no genuine Roman default font (times/arial/cour are all Wine "
            "substitutes) — After Effects will fail at startup. Run "
            "`winetricks corefonts` against this prefix.")

    # Desktop identity: a .desktop + extracted icon per installed app. Gives each app its own
    # dock icon (StartupWMClass = Wine's app_id) instead of inheriting Collider's, and puts the
    # suite in the application menu. See register_app_desktop_entries().
    desktop_entries = register_app_desktop_entries(prefix)
    steps.append({"step": "desktop_entries", "ok": True,
                  "count": len(desktop_entries["entries"]),
                  "icons": sum(1 for e in desktop_entries["entries"] if e["icon"]),
                  # PER TOOL, not a boolean. A tester who provisions inside a live session used
                  # to see generic icons and report extraction as broken; the refresh is part of
                  # the step now, and if one of the refreshers fails the report says which.
                  "caches": desktop_entries["caches"],
                  "superseded": desktop_entries["superseded"],
                  "claimed_types": desktop_entries["claimed_types"],
                  "detail": desktop_entries["entries"]})

    # WebView2: stage + register the runtime or Adobe's in-app web sign-in (IMS)
    # renders BLANK (the installer's Common Files copy is unregistered).
    wv2 = register_webview2(wine, prefix)
    event(args, event="progress", stage="webview2", pct=88, msg="adopted the WebView2 runtime (Adobe sign-in)")
    steps.append({"step": "webview2", "version": wv2, "ok": wv2 is not None,
                  "note": None if wv2 else
                  "no WebView2 runtime source (set NEUTRON_WEBVIEW2 or stage ~/neutron/webview2); "
                  "Adobe in-app sign-in will render blank without it"})

    # Mono + Gecko: INSTALL the matching versions so wineboot never prompts at
    # launch and nothing is disabled (the correct, non-clobbering handling — a
    # complete Adobe prefix has them installed). NEVER suppress mscoree/mshtml on
    # the launch path; that leaves gecko missing and blanks Adobe's web sign-in.
    mg = install_mono_gecko(wine, prefix)
    mono_ok = (mg["mono"] or {}).get("status") in ("present", "installed")
    gecko_ok = any(s.endswith(("present", "installed"))
                   for s in (mg["gecko"] or {}).get("arches", []))
    event(args, event="progress", stage="mono_gecko", pct=91, msg="installed Wine Mono + Gecko")
    steps.append({"step": "mono_gecko", "detail": mg,
                  "ok": mono_ok and gecko_ok})

    wineserver_wait(wine, prefix)   # flush the reg.exe writes to user.reg on disk

    event(args, event="progress", stage="dxvk", pct=94, msg="placing the Adobe DXVK config")
    # 3. DXVK config at the prefix root (idempotent — don't clobber an existing one).
    conf = os.path.join(prefix, "neutron-apps-dxvk.conf")
    wrote = False
    repaired = False
    if not os.path.isfile(conf):
        try:
            with open(conf, "w") as f:
                f.write(PROVISION_DXVK_CONF)
            wrote = True
        except OSError as e:
            log(f"dxvk conf write failed (non-fatal): {e}")
    else:
        # Idempotent REPAIR for prefixes provisioned before 2026-08-04: without the
        # per-exe CEF section, every Chromium-hosted Adobe panel (Animate's New
        # Document, its whole workspace) renders into a dummy composition swapchain
        # and freezes white. Append only the missing section -- never rewrite the
        # file, since it may carry the user's own tuning.
        try:
            with open(conf) as f:
                existing = f.read()
            if "[CEPHtmlEngine.exe]" not in existing:
                tail = PROVISION_DXVK_CONF[PROVISION_DXVK_CONF.index("\n# ---"):]
                with open(conf, "a") as f:
                    if not existing.endswith("\n"):
                        f.write("\n")
                    f.write(tail)
                repaired = True
        except OSError as e:
            log(f"dxvk conf repair failed (non-fatal): {e}")
    steps.append({"step": "dxvk_conf", "path": conf, "wrote": wrote,
                  "repaired": repaired, "ok": True})
    # 3b. The PER-APP dxvk configs. `launch` exports DXVK_CONFIG_FILE unconditionally from the
    # profile, with no existence check, so a missing file means DXVK silently runs on defaults --
    # which report the wrong GPU vendor. Write any that an installed app needs. Never clobber an
    # existing one: it may carry the user's own tuning.
    per_app = {}
    for _app_id, _p in APP_PROFILES.items():
        rel = _p.get("dxvk_conf")
        body = PROVISION_DXVK_CONF_BODIES.get(rel)
        if not rel or not body:
            continue                      # the shared conf, handled above
        # Only for apps actually present: Premiere's conf lives inside its install directory.
        if not os.path.isfile(_resolve_app_exe(prefix, _p["exe"])):
            per_app[_app_id] = "app-not-installed"
            continue
        target = _resolve_app_dxvk_conf(prefix, _p)
        if os.path.isfile(target):
            # ⚠️ Existing is NOT the same as correct. `ensure_dxvk_gpl` creates a one-line conf on
            # first launch; skipping any file that exists would leave that stub in place forever,
            # and the app keeps running on DXVK's defaults. Append what is missing -- never
            # rewrite, since a real conf may carry the user's own tuning.
            try:
                with open(target) as f:
                    have = f.read()
                missing = [ln for ln in body.splitlines()
                           if any(ln.startswith(k) for k in DXVK_REQUIRED_KEYS)
                           and ln.split("=")[0].strip() not in have]
                if missing:
                    with open(target, "a") as f:
                        f.write("\n# NEUTRON repair: keys missing from this conf (a first-launch\n"
                                "# stub pins none of them, so DXVK ran on defaults).\n")
                        f.write("\n".join(missing) + "\n")
                    per_app[_app_id] = f"repaired({len(missing)})"
                else:
                    per_app[_app_id] = "present"
            except OSError as e:
                log(f"per-app dxvk conf repair for {_app_id} failed (non-fatal): {e}")
                per_app[_app_id] = "error"
            continue
        try:
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(target, "w") as f:
                f.write(body)
            per_app[_app_id] = "wrote"
        except OSError as e:
            log(f"per-app dxvk conf for {_app_id} failed (non-fatal): {e}")
            per_app[_app_id] = "error"
    steps.append({"step": "dxvk_conf_per_app", "apps": per_app, "ok": True})


    deferred = ["licensing/activation", "desktop-entries + XDG MIME associations"]
    if not runtime:
        deferred.insert(0, "native-dll-staging (run `neutron runtime capture` to build the bundle)")
    if not wv2:
        deferred.insert(0, "webview2-runtime (stage ~/neutron/webview2 or set NEUTRON_WEBVIEW2; "
                           "Adobe in-app sign-in renders blank without it)")
    if not (mono_ok and gecko_ok):
        deferred.insert(0, f"mono/gecko install (stage matching wine-mono-{MONO_VERSION} + "
                           f"wine-gecko-{GECKO_VERSION} under ~/neutron/{{mono,gecko}} or set "
                           "NEUTRON_MONO/NEUTRON_GECKO; without them wineboot prompts for Mono at launch)")

    emit({
        "ok": True,
        "prefix": prefix,
        "neutron_wine": is_neutron,
        "runtime_bundle": runtime,
        "steps": steps,
        "deferred": deferred,
    }, args.json, streaming=getattr(args, "progress", False))
    return EX_OK


def _build_ucrtshim(orig_path, out_path):
    """(Re)build the 64-bit ucrtbase FH4 + "\\?\"-strip proxy from MS's real UCRT
    (`ucrtbase_orig.dll`) using the checked-in reproducible source in
    scripts/ucrtshim/ (see stub.c + memory neutron-native-muxing-idea / collider_notes
    §3). Capturing the proxy as an opaque binary would freeze whatever fixes the source
    prefix happened to have; building from source guarantees both the FH4 forwarder and
    the _wstat64 "\\?\"-strip (Premiere native-muxing fix). Returns True on success. On
    failure (e.g. mingw-w64 absent) logs a warning and LEAVES whatever ucrtbase.dll the
    copy loop already staged, so capture still yields a working — if not freshly built —
    bundle."""
    builder = os.path.join(NEUTRON_REPO, "scripts", "ucrtshim", "build.sh")
    if not os.path.isfile(builder):
        log(f"ucrtshim: builder missing ({builder}); keeping captured ucrtbase.dll")
        return False
    try:
        r = subprocess.run(["bash", builder, orig_path, out_path],
                           capture_output=True, text=True)
    except OSError as e:
        log(f"ucrtshim: build could not start ({e}); keeping captured ucrtbase.dll")
        return False
    if r.returncode != 0:
        detail = (r.stderr or r.stdout or "").strip().splitlines()
        log(f"ucrtshim: build failed (rc={r.returncode}: "
            f"{detail[-1] if detail else 'no output'}); keeping captured ucrtbase.dll")
        return False
    out = (r.stdout or "").strip().splitlines()
    log(f"ucrtshim: {out[-1] if out else 'rebuilt ucrtbase.dll from source'}")
    return True


def _copytree_unless_same(src, dst):
    """copytree, but a no-op when src IS dst.

    `neutron runtime capture --out ~/neutron/runtime` re-resolves mono/gecko/webview2 through
    the same `_resolve_*` helpers `provision` uses, and those find the BUNDLE's own copy when it
    is the only one on the machine. copytree then raises SameFileError for every file and the
    step reports itself as failed -- so a capture that changed nothing about mono read as
    "capture mono failed" and recorded mono as absent. Nothing was ever wrong with it.
    """
    if os.path.realpath(src) == os.path.realpath(dst):
        return "same"
    shutil.copytree(src, dst, dirs_exist_ok=True)
    return "copied"


def cmd_runtime_which(args):
    """The wine this CLI would use, and the version tag that goes with it.

    Exists so OTHER tools do not have to guess. Mud Hut creates prefixes and boots them, and it
    resolved wine independently: newest NUMERIC installed runtime when the prefix is new. That
    agrees with us by coincidence on a machine where the newest runtime is also the pinned one,
    and disagrees the moment a newer runtime is installed than the drop pinned -- at which point
    Mud Hut stamps a brand-new prefix for the newer build and every `neutron launch` refuses.
    Raised by the build tester 2026-08-26 as the worst possible first-run experience.

    ⭐ One authority. Ask, do not re-derive.

    With --prefix, also reports whether launching that prefix on this wine would re-stamp it.
    """
    wine, is_neutron = resolve_wine()
    out = {"ok": bool(wine), "wine": wine, "is_neutron_runtime": is_neutron,
           "version": None, "stamp": _runtime_stamp(wine),
           "pinned_by": ("NEUTRON_WINE" if os.environ.get("NEUTRON_WINE")
                         else "NEUTRON_WINE_VERSION" if os.environ.get("NEUTRON_WINE_VERSION")
                         else "compiled-in default")}
    if wine and is_neutron:
        root = os.path.basename(os.path.dirname(os.path.dirname(os.path.realpath(wine))))
        if root.startswith("neutron-wine-"):
            out["version"] = root[len("neutron-wine-"):]
    if getattr(args, "prefix", None):
        prefix = resolve_prefix(args.prefix)
        if not prefix:
            out.update(bad_prefix_reason(args.prefix))
        else:
            mm = stamp_mismatch(prefix, wine)
            out["prefix"] = prefix
            out["prefix_stamp"] = _prefix_stamp(prefix)
            out["would_restamp"] = mm is not None
            if mm:
                out["prefix_is_stamped_for"] = mm["prefix_runtimes"]
    if not wine:
        die({**out, "reason": "no wine found — install the Neutron runtime"}, EX_DEP, args.json)
    emit(out, args.json)
    return EX_OK


def cmd_runtime_capture(args):
    """Build/refresh the Neutron runtime DLL bundle from a proven prefix. Reads
    the source prefix's DllOverrides, writes the full override manifest, and
    copies every native DLL file (system32 + syswow64) into the bundle. This is
    the reproducible source `neutron prefix provision` stages into new prefixes."""
    import re
    src = resolve_prefix(args.from_prefix)
    if not src:
        die({"ok": False, "reason": "invalid --from prefix"}, EX_BADPREFIX, args.json)
    out = os.path.abspath(os.path.expanduser(
        args.out or os.path.join(HOME, "neutron", "runtime")))

    try:
        with open(os.path.join(src, "user.reg"), encoding="utf-8", errors="replace") as f:
            reg = f.read()
    except OSError as e:
        die({"ok": False, "reason": f"cannot read user.reg: {e}"}, EX_FAIL, args.json)

    m = re.search(r'\[Software\\\\Wine\\\\DllOverrides\](.*?)(\n\[|\Z)', reg, re.S)
    block = m.group(1) if m else ""
    overrides = {}
    for star, name, val in re.findall(r'"(\*?)([^"]+)"="([^"]+)"', block):
        overrides[star + name] = val
    if not overrides:
        die({"ok": False, "reason": "no DllOverrides in source prefix"}, EX_FAIL, args.json)

    staged = {"system32": 0, "syswow64": 0}
    total = 0
    for scope in ("system32", "syswow64"):
        srcdir = os.path.join(src, "drive_c", "windows", scope)
        dstdir = os.path.join(out, "dlls", scope)
        os.makedirs(dstdir, exist_ok=True)
        for full, val in overrides.items():
            if "native" not in val:
                continue
            name = full.lstrip("*")
            dll = name if name.lower().endswith(".dll") else name + ".dll"
            # Stage the DLL AND its Wine forwarder companion if present. Wine ships
            # some builtins split as a forwarder (X.dll) + impl (X_orig.dll); staging
            # only the forwarder breaks it (e.g. ucrtbase.dll -> ucrtbase_orig).
            for cand in (dll, dll[:-4] + "_orig.dll"):
                sp = os.path.join(srcdir, cand)
                if os.path.isfile(sp):
                    try:
                        shutil.copyfile(sp, os.path.join(dstdir, cand))
                        staged[scope] += 1
                        total += os.path.getsize(sp)
                    except OSError as e:
                        log(f"capture {scope}/{cand} failed: {e}")

    # Rebuild the 64-bit ucrtbase proxy from source rather than shipping the opaquely
    # captured one, so the bundle always carries BOTH the __CxxFrameHandler4 forwarder and
    # the _wstat64 "\\?\"-strip (Premiere native-muxing fix). 64-bit only — the FH4 proxy
    # and the MainConcept muxer are 64-bit; syswow64 ships MS's real ucrtbase untouched.
    shim_out = None
    _shim_orig = os.path.join(out, "dlls", "system32", "ucrtbase_orig.dll")
    if os.path.isfile(_shim_orig):
        shim_out = _build_ucrtshim(_shim_orig, os.path.join(out, "dlls", "system32", "ucrtbase.dll"))

    with open(os.path.join(out, "overrides.json"), "w") as f:
        json.dump(overrides, f, indent=2, sort_keys=True)

    # Also capture the font-replacement map (fonts Adobe needs -> Adobe Clean).
    fm = re.search(r'\[Software\\\\Wine\\\\Fonts\\\\Replacements\](.*?)(\n\[|\Z)', reg, re.S)
    fonts = dict(re.findall(r'"([^"]+)"="([^"]+)"', fm.group(1))) if fm else {}
    with open(os.path.join(out, "fonts.json"), "w") as f:
        json.dump(fonts, f, indent=2, sort_keys=True)

    # Capture the Microsoft Edge WebView2 registered runtime — Adobe's in-app
    # sign-in (IMS) is a WebView2 web UI and renders BLANK without it (the Adobe
    # installer ships it UNregistered). Copy the source prefix's registered
    # EdgeWebView tree into <out>/webview2 so `prefix provision` (register_webview2)
    # can stage + register it. Large (~550MB) but self-contained, like the DLL set.
    wv2_src = os.path.join(src, "drive_c", "Program Files (x86)", "Microsoft", "EdgeWebView")
    wv2_ver = _webview2_version(os.path.join(wv2_src, "Application"))
    if wv2_ver:
        try:
            _copytree_unless_same(wv2_src, os.path.join(out, "webview2"))
        except OSError as e:
            log(f"capture webview2 failed: {e}")
            wv2_ver = None

    # Capture wine-mono + wine-gecko (version-matched to the runtime) into the bundle
    # so `prefix provision` (install_mono_gecko) installs them on any machine — else a
    # runtime-version bump / Adobe's mshtml web content re-prompts the Mono/Gecko
    # installer. Runtime artifacts, like WebView2; sourced from wherever _resolve_* finds.
    mono_ver = None
    msi = _resolve_mono_support_msi()
    if msi:  # msi = <base>/wine-mono-<ver>/support/winemono-support.msi -> copy the tree
        try:
            _copytree_unless_same(os.path.dirname(os.path.dirname(msi)),
                                  os.path.join(out, "mono", f"wine-mono-{MONO_VERSION}"))
            mono_ver = MONO_VERSION
        except OSError as e:
            log(f"capture mono failed: {e}")
    gecko_arches = []
    for arch in ("x86", "x86_64"):
        g = _resolve_gecko_tree(arch)
        if g:
            try:
                _copytree_unless_same(
                    g, os.path.join(out, "gecko", f"wine-gecko-{GECKO_VERSION}-{arch}"))
                gecko_arches.append(arch)
            except OSError as e:
                log(f"capture gecko {arch} failed: {e}")

    emit({"ok": True, "runtime": out, "source": src, "overrides": len(overrides),
          "fonts": len(fonts), "webview2": wv2_ver, "mono": mono_ver, "gecko": gecko_arches,
          "staged": staged, "bytes": total, "ucrtshim": shim_out}, args.json)
    return EX_OK


def _download(src, dest, as_json):
    """Stream `src` (http(s)/file URL or local path) to `dest`. Shows a simple
    stderr progress line in human mode. Returns bytes written."""
    import urllib.request
    if "://" not in src:                     # plain local path
        shutil.copyfile(src, dest)
        return os.path.getsize(dest)
    req = urllib.request.Request(src, headers={"User-Agent": "neutron-cli"})
    done = 0
    with urllib.request.urlopen(req) as r, open(dest, "wb") as out:
        total = int(r.headers.get("Content-Length") or 0)
        last = -1
        for chunk in iter(lambda: r.read(1 << 20), b""):
            out.write(chunk)
            done += len(chunk)
            if not as_json and total:
                pct = done * 100 // total
                if pct != last:
                    print(f"\r[neutron]   {pct:3d}%  "
                          f"({done/(1<<20):6.1f}/{total/(1<<20):.1f} MiB)",
                          end="", file=sys.stderr, flush=True)
                    last = pct
    if not as_json and done:
        print(file=sys.stderr)               # newline after the progress line
    return done


def _safe_extract(tar, path):
    """Extract `tar` into `path`, refusing any member that escapes it."""
    try:
        tar.extractall(path, filter="data")  # Python 3.12+ hardened filter
        return
    except TypeError:
        pass                                 # older Python: validate manually
    base = os.path.abspath(path)
    for m in tar.getmembers():
        target = os.path.abspath(os.path.join(path, m.name))
        if target != base and not target.startswith(base + os.sep):
            raise RuntimeError(f"unsafe path in archive: {m.name}")
    tar.extractall(path)


def cmd_runtime_install(args):
    """Download + verify + unpack a neutron-wine release so `launch` runs the
    patched, Neutron-owned wine. Resolves the release manifest (download URL +
    sha256), verifies the tarball against it, and unpacks to
    ~/.local/share/neutron/runtimes/neutron-wine-<ver>/. Idempotent."""
    import hashlib, tarfile, tempfile
    import urllib.error

    version = args.version or NEUTRON_WINE_VERSION
    repo = args.repo or NEUTRON_WINE_REPO
    manifest = None

    # NEUTRON: a --manifest NAMES the version it installs, and --manifest is documented as
    # overriding --version. It did not: the manifest was resolved further down, AFTER the
    # already-installed check below had already run against the CLI's compiled-in default.
    # `neutron runtime install --manifest <newer>` therefore printed
    # "already-installed <old default>" and installed nothing -- a silent no-op that looks
    # like a success, which is how a build got handed over as installed when it was not.
    # Resolve the manifest FIRST when it is the authority, and keep what we parsed so the
    # main path below does not fetch it twice. A failure here is left to the main path,
    # which reports it properly.
    if args.manifest and not args.version:
        try:
            with tempfile.TemporaryDirectory(prefix=".mf-") as mdir:
                mp = os.path.join(mdir, "manifest.json")
                _download(args.manifest, mp, as_json=True)
                with open(mp) as f:
                    manifest = json.load(f)
            mver = manifest.get("version")
            if mver and str(mver) != version:
                if not args.json:
                    log(f"manifest names version {mver} (CLI default {version}) - installing {mver}")
                version = str(mver)
        except (urllib.error.URLError, OSError, ValueError) as e:
            # The manifest is the ONLY statement of which version was meant here, so a
            # failure to resolve it cannot fall through to the already-installed check --
            # that check would run against the CLI default and report success for a
            # version the caller never asked for. Same silent-no-op the version fix above
            # closes, reached by a different door.
            die({"ok": False, "reason": f"cannot fetch/parse manifest: {e}",
                 "manifest": args.manifest,
                 "hint": "pass --version to install a specific runtime without a manifest"},
                EX_FAIL, args.json)

    name = f"neutron-wine-{version}"
    dest_root = NEUTRON_RUNTIMES_DIR
    install_dir = os.path.join(dest_root, name)

    def _has_wine(d):
        return (os.path.isfile(os.path.join(d, "bin", "wine"))
                or os.path.isfile(os.path.join(d, "bin", "wine64")))

    if _has_wine(install_dir) and not args.force:
        emit({"ok": True, "status": "already-installed", "version": version,
              "path": install_dir, "wine": os.path.join(install_dir, "bin", "wine")},
             args.json)
        return EX_OK

    os.makedirs(dest_root, exist_ok=True)
    # Work on the target filesystem so the final move is a fast rename and a big
    # download can't overflow a small /tmp tmpfs.
    tmp = tempfile.mkdtemp(prefix=".dl-", dir=dest_root)
    try:
        # 1. Resolve the manifest (download URL + sha256 live here).
        manifest_src = args.manifest or (
            f"https://github.com/{repo}/releases/download/v{version}/{name}.manifest.json")
        if manifest is None:
            if not args.json:
                log(f"resolving manifest: {manifest_src}")
            mpath = os.path.join(tmp, "manifest.json")
            try:
                _download(manifest_src, mpath, as_json=True)
                with open(mpath) as f:
                    manifest = json.load(f)
            except (urllib.error.URLError, OSError, ValueError) as e:
                die({"ok": False, "reason": f"cannot fetch/parse manifest: {e}",
                     "manifest": manifest_src,
                     "hint": f"is release v{version} published on {repo}?"},
                    EX_FAIL, args.json)

        sha_want = manifest.get("sha256")
        artifact = manifest.get("artifact") or f"{name}.tar.xz"
        art_url = manifest.get("url") or (
            f"https://github.com/{repo}/releases/download/v{version}/{artifact}")
        unpack_root = manifest.get("unpack_root") or name
        if not sha_want:
            die({"ok": False, "reason": "manifest has no sha256"}, EX_FAIL, args.json)

        # 2. Download the tarball.
        if not args.json:
            size = manifest.get("size_bytes")
            log(f"downloading {artifact}"
                + (f" ({size/(1<<20):.1f} MiB)" if isinstance(size, int) else ""))
        tarball = os.path.join(tmp, artifact)
        try:
            _download(art_url, tarball, args.json)
        except (urllib.error.URLError, OSError) as e:
            die({"ok": False, "reason": f"download failed: {e}", "url": art_url},
                EX_FAIL, args.json)

        # 3. Verify the checksum before trusting the archive.
        h = hashlib.sha256()
        with open(tarball, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        if h.hexdigest() != sha_want:
            die({"ok": False, "reason": "sha256 mismatch (corrupt or tampered download)",
                 "expected": sha_want, "got": h.hexdigest()}, EX_FAIL, args.json)

        # 4. Unpack, then swap into place (replacing any prior install).
        if not args.json:
            log("verifying + unpacking…")
        staging = os.path.join(tmp, "unpack")
        os.makedirs(staging)
        with tarfile.open(tarball) as tar:
            _safe_extract(tar, staging)
        unpacked = os.path.join(staging, unpack_root)
        if not _has_wine(unpacked):
            die({"ok": False,
                 "reason": f"archive root '{unpack_root}' has no bin/wine"},
                EX_FAIL, args.json)
        if os.path.isdir(install_dir):
            shutil.rmtree(install_dir, ignore_errors=True)
        shutil.move(unpacked, install_dir)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    emit({"ok": True, "status": "installed", "version": version,
          "path": install_dir, "wine": os.path.join(install_dir, "bin", "wine"),
          "sha256": sha_want}, args.json)
    return EX_OK


def _stage_and_inject_psdock(prefix, wine, env):
    """Photoshop dock helper: stage neutron_psdock.dll + the injector into the
    prefix, then arm the SAME detached inject-waiter scripts/launch-photoshop.sh
    uses — a backgrounded bash loop that injects once PS is ready (>=150 threads)
    so File>New docks. Spawned DEVNULL'd + start_new_session so it never holds this
    CLI's stdout pipe (Collider's run_json reads to EOF) and outlives the CLI.
    Best-effort; never affects the launch. Set NEUTRON_PSDOCK_DEBUG=1 to log to
    <prefix>/drive_c/neutron_psdock_inject.log."""
    import shutil
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))   # neutron repo root (realpath: neutron is invoked via a ~/.local/bin symlink)
    dll_src = os.path.join(root, "src", "neutron_psdock.dll")
    inj_src = os.path.join(root, "src", "neutron_psinject.exe")
    if not (os.path.isfile(dll_src) and os.path.isfile(inj_src)):
        log("psdock: helper files missing (src/neutron_psdock.*) - File>New docking inactive")
        return
    dll_dst = os.path.join(prefix, "drive_c", "windows", "system32", "neutron_psdock.dll")
    inj_dst = os.path.join(prefix, "drive_c", "neutron_psinject.exe")
    try:
        os.makedirs(os.path.dirname(dll_dst), exist_ok=True)
        shutil.copyfile(dll_src, dll_dst); os.chmod(dll_dst, 0o755)
        shutil.copyfile(inj_src, inj_dst); os.chmod(inj_dst, 0o755)
    except OSError as e:
        log(f"psdock: staging failed: {e}")
        return

    # The exact inject-waiter from launch-photoshop.sh, run detached + DEVNULL'd.
    waiter = (
        'exec >>"$DBG" 2>&1\n'
        'echo "[psdock] armed $(date)"\n'
        'for i in $(seq 1 120); do\n'
        '  for d in /proc/[0-9]*; do\n'
        '    cl=$(tr "\\0" " " < "$d/cmdline" 2>/dev/null)\n'
        '    case "$cl" in *Photoshop.exe*)\n'
        '      t=$(ls "$d/task" 2>/dev/null | wc -l)\n'
        '      if [ "$t" -ge 150 ]; then echo "[psdock] PS ready t=$t; injecting"; sleep 3; "$WINE_BIN" "$INJ"; echo "[psdock] injected rc=$?"; exit 0; fi;;\n'
        '    esac\n'
        '  done\n'
        '  sleep 1\n'
        'done\n'
        'echo "[psdock] PS never reached ready state"\n'
    )
    wenv = dict(env)
    wenv["WINE_BIN"] = wine
    wenv["INJ"] = inj_dst
    wenv["DBG"] = (os.path.join(prefix, "drive_c", "neutron_psdock_inject.log")
                   if os.environ.get("NEUTRON_PSDOCK_DEBUG") else os.devnull)
    try:
        subprocess.Popen(["bash", "-c", waiter], env=wenv,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        log("psdock: dock-inject waiter armed")
    except Exception as e:
        log(f"psdock: could not arm waiter: {e}")


def cmd_launch(args):
    """Launch an app through the Neutron stack. Returns the spawned PID.
    Profile-driven: the per-app exe/env/overrides come from APP_PROFILES so the
    whole suite launches through this ONE path (Premiere stays byte-identical)."""
    profile = APP_PROFILES.get(args.app)
    if not profile:
        die({"launched": False,
             "reason": f"unknown app '{args.app}' (known: {', '.join(sorted(APP_PROFILES))})"},
            EX_FAIL, args.json)

    prefix = resolve_prefix(args.prefix) or resolve_prefix(collider_selected_prefix())
    if not prefix:
        _tried = [t for t in (args.prefix, collider_selected_prefix()) if t]
        die({"launched": False, "tried": _tried,
             "reason": "no usable prefix (no drive_c). Tried: "
                       + (", ".join(_tried) or "<none>")
                       + ". Pass --prefix, or select one in Collider."},
            EX_BADPREFIX, args.json)

    gpu_mode = "gpu"
    if args.software:
        # Honest about the v0 gap: the proven launcher has no software branch.
        # Faking support would violate the "meaningful exit codes" contract.
        die({"launched": False, "app": args.app, "gpu_mode": "software",
             "reason": "software mode not implemented in v0; use --gpu (default)"},
            EX_DEP, args.json)

    exe = _resolve_app_exe(prefix, profile["exe"])
    if not os.path.isfile(exe):
        die({"launched": False, "reason": f"{profile['name']} exe not found: {exe}"},
            EX_FAIL, args.json)

    wine, is_neutron = resolve_wine()
    if not wine:
        die({"launched": False, "reason": "no Neutron wine and no system wine found"},
            EX_DEP, args.json)
    if not is_neutron:
        log("WARNING: using system wine - Neutron patches (frame pacer / winewayland "
            "fractional-scale) are NOT present; playback/UI fixes will be inactive")

    # 🚨 REFUSE A LAUNCH THAT WOULD RE-STAMP THE PREFIX. Wine compares its wine.inf mtime against
    # <prefix>/.update-timestamp and silently runs `wineboot -u` when they differ, reverting the
    # patched natives. Every occurrence of this has been diagnosed as a code regression first and
    # a stamp mismatch second, at a cost of hours each time. `provision` re-stamps AND re-stages
    # the natives, which is why it is the offered remedy rather than "just let it clobber".
    #
    # ⛔ Deliberately NOT "resolve the runtime from the stamp instead". Stamps are pinned across
    # releases on purpose, so several runtimes share one and stamp-derived resolution silently
    # picks the wrong one -- that is what voided the first Animate test. Detect, explain, stop.
    mismatch = stamp_mismatch(prefix, wine)
    if mismatch and not args.allow_restamp:
        also = mismatch["prefix_runtimes"]
        die({"launched": False,
             "reason": "this runtime would RE-STAMP the prefix and revert its patched natives "
                       "(wine runs `wineboot -u` when the stamps differ)",
             "fix": "run `neutron prefix provision %s` first — it re-stamps and re-stages the "
                    "natives — or pass --allow-restamp to accept the clobber" % prefix,
             "prefix_is_stamped_for": (", ".join(also) if also
                                       else "no installed runtime (stamp %d)"
                                            % mismatch["prefix_stamp"]),
             **mismatch}, EX_FAIL, args.json)
    if mismatch:
        log("WARNING: --allow-restamp: launching on a different-stamp runtime. wine will run "
            "`wineboot -u` and REVERT the prefix's patched natives (dwrite/dcomp/dxcore). "
            "Run `neutron prefix provision %s` afterwards to restore them." % prefix)

    dxvk_conf = _resolve_app_dxvk_conf(prefix, profile)
    env = dict(os.environ)
    env["WINEPREFIX"] = prefix
    env["DXVK_CONFIG_FILE"] = dxvk_conf
    if profile["overrides"]:                     # empty => leave unset (match the proven minimal launch)
        env["WINEDLLOVERRIDES"] = profile["overrides"]
    if profile.get("nvapi"):
        env["DXVK_ENABLE_NVAPI"] = "1"
    # setdefault, NOT assignment: an explicitly pre-set NEUTRON_* in the caller's environment
    # must WIN, or no gate can ever be turned off from outside. Two independent failures of the
    # old `env[k] = v` (both 2026-08-09):
    #   1. premiere-soak.sh's isolation runs (`RTG=0 DIRG=0`) were silently overwritten back to 1
    #      the moment those gates moved into the profile on 08-08 -- our own A/B tool went inert
    #      and would have reported "no difference" for every isolation run since.
    #   2. the build tester could not bisect the Photoshop dcomp-gate bug at all, because every
    #      gate they set on the command line was discarded before the app saw it.
    # Trade-off accepted: a stale exported NEUTRON_* in a shell now sticks instead of being
    # corrected. That is the price of having an override at all, and it is the behaviour the
    # validated soak path always assumed it had.
    for k, v in profile.get("env", {}).items():
        env.setdefault(k, v)
    # NEUTRON_PREMIERE_GPU=0 -> drop Premiere's GPU-UI env so the app falls back to its GDI+
    # SOFTWARE drawbot. Needed as an A/B: GPU mode fixes the interface but the Program Monitor
    # renders black in it, while the software drawbot shows video (with playhead trails). Pair
    # with MZ.Prefs.UseGpuAcceleration=false -- the pref and the env must agree, or the app
    # picks a drawbot whose output nothing presents. See ~/premiere-gpu-mode.sh.
    if args.app == "premiere" and os.environ.get("NEUTRON_PREMIERE_GPU") == "0":
        for k in ("NEUTRON_D2D_DCDIRECT", "NEUTRON_GDI_PRESENT", "NEUTRON_DCOMP_NATIVE",
                  "NEUTRON_CEF_MAX_FPS", "NEUTRON_D2D_COMPOSEREAD"):
            env.pop(k, None)
        log("premiere: GPU-UI env DROPPED (NEUTRON_PREMIERE_GPU=0) -> software drawbot")
    # ⭐ 2026-08-15 — AUDIO DROPOUTS DURING PLAYBACK. winepulse asks PulseAudio for a very small
    # buffer; against PipeWire's pulse shim and a USB interface that is not enough headroom, and
    # Premiere's playback drops audio while reporting NOTHING -- its own log shows zero audio lines
    # and "Frames dropped during playback: 0". The gap is entirely below the app, which is why
    # looking in Premiere for it finds nothing.
    #
    # 90 ms is the smallest value that held up in testing here (PipeWire 1.6.8, quantum 1024 @ 48k,
    # Focusrite Scarlett Solo over USB). The cost is 90 ms of output latency, which matters for
    # live monitoring but not for timeline playback.
    #
    # setdefault, so anyone chasing latency can lower or unset it per launch.
    # ⚠️ Provisional: confirmed by ear over one session, not by an xrun count. If dropouts persist,
    # measure with `pw-top` during playback (the ERR column) before raising this further -- a bigger
    # buffer that does not help means the problem is elsewhere (USB scheduling, winepulse itself).
    env.setdefault("PULSE_LATENCY_MSEC", "90")

    # --- silence Wine's FIXME chatter -------------------------------------------------
    # Wine prints four classes: err, warn, fixme, trace. fixme is on by default and means
    # "this bit is unimplemented and I am ignoring it" -- useful to a Wine developer once,
    # useless every frame thereafter. MEASURED in a live Premiere session, two d2d FIXMEs
    # alone were 14,000 of 20,000 sampled lines:
    #     fixme:d2d:d2d_device_context_PushAxisAlignedClip Ignoring
    #     fixme:d2d:d2d_device_context_DrawGeometry Ignoring
    # ~700 formatted, locked, synchronous writes per second, from inside the render path.
    # Turning them off took the log from 40,413 to 7,952 bytes/sec (-80%).
    #
    # This is not a debug-only cost: cmd_launch redirects app output to a log file on EVERY
    # launch, so every Collider session has been paying it with nobody reading the output.
    #
    # ⚠️ MERGE, never assign. A debugging session passes its own WINEDEBUG, and clobbering it
    # would silently drop the channels being asked for -- an hour of wondering why the log is
    # empty. Skipped entirely if the caller already said anything about fixme, so
    # `WINEDEBUG=+fixme` still works to get them back.
    #
    # ⚠️ err is deliberately untouched: every Neutron diagnostic (MASKFALLBACK, neutron-role,
    # the perf reports) is ERR-level and must keep printing.
    _wd = env.get("WINEDEBUG", "")
    if "fixme" not in _wd:
        env["WINEDEBUG"] = ("fixme-all," + _wd).rstrip(",") if _wd else "fixme-all"

    # --- CEP plugin networking: make Node prefer IPv4 -------------------------------
    # Adobe's CEP panels embed **Node 17.7.2**, and plugins do their HTTP through it
    # (not through Chromium, which is why none of it shows up in DevTools' Network).
    #
    # Node 17 is the worst possible version here. v17.0 changed the DNS result order
    # from `ipv4first` to `verbatim`, so it takes whatever the resolver returns first;
    # and Happy Eyeballs (`autoSelectFamily`, which races v6 against v4 and falls back
    # in ~250 ms) did not arrive until v18.13/v20. So Node 17 commits to the first
    # address and, if that address is unreachable, simply fails. curl and every browser
    # survive the same network because they all implement the fallback.
    #
    # That is fatal on a very common Linux setup: a VPN that blocks IPv6 without
    # removing the ISP's IPv6 address and default route. The box still looks
    # IPv6-capable to getaddrinfo, so AAAA records come back first, and every Node
    # request dies with ECONNREFUSED.
    #
    # MEASURED 2026-08-17 inside the live Captioneer panel (VPN connected):
    #   default            -> ERR ECONNREFUSED   (aescripts.com AAAA 2606:4700::6812:1123)
    #   family:4 forced    -> HTTP 403           (a real TCP+TLS connection)
    #   ipv4first          -> HTTP 403, lookup now 104.18.17.35 fam4
    # The plugin read that unreachable-network failure as licence error 101,
    # "please connect to the internet so the license can be activated" -- while
    # `webreq.exe` succeeded throughout, because WinINet is a different stack.
    # On Windows the same VPN disables IPv6 on the adapter outright, so no AAAA is
    # ever returned and Node never sees the problem. Hence "it works on Windows".
    #
    # `ipv4first` is what Node did by default for its entire life before v17, so this
    # restores long-standing behaviour rather than inventing one. Append rather than
    # overwrite, so an explicit NODE_OPTIONS still wins and a v6-only host can override.
    #
    # ⚠️ **This does NOT fix the CEP panel itself — VERIFIED, do not re-propose it as one.**
    # CEP embeds Node as a *library* inside CEF, which never runs Node's argument
    # processing, so NODE_OPTIONS is ignored there. Measured in the live panel after a
    # relaunch carrying this change:
    #     NODE_OPTIONS = "--dns-result-order=ipv4first"   (delivered)
    #     process.execArgv = []                           (embedded: no arg parsing)
    #     dns.lookup -> 2606:4700::6812:1123 fam6         (STILL IPv6)
    #     https.get  -> ERR ECONNREFUSED
    # It is kept because it does apply to node CHILD PROCESSES a plugin spawns, which
    # are ordinary Node startups. The panel's own requests can only be fixed by making
    # the host stop handing out unreachable AAAA records.
    #
    # ⛔ Do NOT "fix" this in Wine. Windows' getaddrinfo prefers a global IPv6 address in
    # exactly the same way (RFC 6724); Wine matches Windows here. It only LOOKS
    # Windows-specific because VPN-on-Windows removes the IPv6 address from the
    # adapter, while VPN-on-Linux blocks IPv6 and leaves the ISP address in place.
    # Reordering DNS inside Wine would be Wine deviating from Windows for every app.
    # The real fix is the network: `VPN tunnel set ipv6 on`, or drop IPv6 on the
    # interface. See docs/wiki/APPS.md "Captioneer licence 101".
    _node_opts = env.get("NODE_OPTIONS", "")
    if "--dns-result-order" not in _node_opts:
        env["NODE_OPTIONS"] = (_node_opts + " --dns-result-order=ipv4first").strip()

    # GPU-vendor ICD (NVIDIA default; TODO: generalize per detected GPU).
    if os.path.isfile(NVIDIA_EGL_ICD):
        env.setdefault("__EGL_VENDOR_LIBRARY_FILENAMES", NVIDIA_EGL_ICD)
        env.setdefault("__GLX_VENDOR_LIBRARY_NAME", "nvidia")

    # --- Display path: Wayland-native (crisp UI + native-smooth playback) vs
    #     X11 (software frame pacer). Selected per session; merged here so there
    #     is ONE launch path (no redundant launcher script). ---
    if session_is_wayland():
        display_mode = "wayland"
        reg_set(wine, prefix, r"HKCU\Software\Wine\Drivers", "Graphics", "REG_SZ", "wayland")
        # auto-DPI: LogPixels = round(96 * scale) so System-DPI-aware Adobe apps
        # render at device resolution; the wp_fractional_scale patch maps it 1:1.
        scale = args.scale if getattr(args, "scale", None) else detect_scale()
        logpixels = round(96 * scale) if (scale and scale > 0) else None
        if logpixels:
            reg_set(wine, prefix, r"HKCU\Control Panel\Desktop", "LogPixels",
                    "REG_DWORD", str(logpixels))
        # Pass the app's full config so a first launch never leaves a one-line stub behind.
        ensure_dxvk_gpl(dxvk_conf,
                        PROVISION_DXVK_CONF_BODIES.get(profile.get("dxvk_conf")))
        env.pop("DISPLAY", None)
        env["WAYLAND_DISPLAY"] = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        log(f"display: wayland | scale={scale} LogPixels={logpixels}")
    else:
        display_mode = "x11"
        reg_set(wine, prefix, r"HKCU\Software\Wine\Drivers", "Graphics", "REG_SZ", "x11")
        env["NEUTRON_PRESENT_PACE"] = "1"   # X11 software frame pacer
        env.setdefault("DISPLAY", ":0")
        log("display: x11 | software frame pacer (NEUTRON_PRESENT_PACE=1)")

    # A file to open: the --project flag (Collider passes a Windows path) or an
    # optional positional (a .desktop file association passes a Linux %f path).
    project = args.project or getattr(args, "project_file", None)
    if project and project.startswith("/"):
        # Linux path -> Windows path. Wine maps Z:\ to the filesystem root, so an
        # absolute Linux path becomes Z:\... — Adobe apps need a Windows-style path.
        project = "Z:" + project.replace("/", "\\")

    # Start the app's Adobe background services (ADS/IPCBroker) first, if any, and
    # give them a moment to bind their RPC before the app connects.
    if profile.get("daemons"):
        if _start_adobe_daemons(prefix, wine, env, profile["daemons"]):
            import time as _t
            _t.sleep(4)

    cmd = [wine, exe]
    if project:
        cmd.append(project)

    log(f"launching: {profile['name']} -> {wine} {exe} {project or ''}")

    # 🚨 CAPTURE THE APP LOG. This used to be `subprocess.DEVNULL if args.json`,
    # and Collider always passes --json -- so EVERY Collider-launched session
    # threw its wine log away. Verified on a live Premiere 2026-08-12: fd1 and
    # fd2 both /dev/null. Two user-reported bugs (the missing timeline chrome
    # and the Button Editor drag) could not be investigated at all from a normal
    # session, and the answer was always "relaunch by hand from a terminal".
    #
    # A terminal caller (no --json) still inherits the tty, so `neutron launch
    # ... > my.log 2>&1` keeps working exactly as before and does NOT get a
    # second copy. Only the --json path, which had nowhere to write, gains one.
    log_path, log_fh = None, None
    if args.json:
        try:
            os.makedirs(NEUTRON_LOGS_DIR, exist_ok=True)
            _prune_app_logs(NEUTRON_LOGS_DIR, args.app, keep=20)
            log_path = os.path.join(
                NEUTRON_LOGS_DIR, f"{args.app}-{time.strftime('%Y%m%d-%H%M%S')}.log")
            log_fh = open(log_path, "wb")
        except OSError as e:
            # Never let logging break a launch. Fall back to the old behaviour.
            log(f"app log unavailable ({e}); output discarded")
            log_path, log_fh = None, None
    try:
        # Detach so Collider supervises via PID, not via this process.
        proc = subprocess.Popen(
            cmd, env=env,
            stdout=(log_fh or subprocess.DEVNULL) if args.json else None,
            stderr=(subprocess.STDOUT if log_fh else subprocess.DEVNULL) if args.json else None,
            start_new_session=True,
        )
    except Exception as e:
        die({"launched": False, "reason": f"spawn failed: {e}"}, EX_FAIL, args.json)
    finally:
        # The child holds its own dup'd fd; the parent must not keep this open or
        # the file would stay held by a process Collider does not supervise.
        if log_fh:
            log_fh.close()

    # Brief liveness check: if Premiere dies instantly (bad env, missing DLL),
    # report that rather than a misleading "launched: true".
    # (`time` is imported at module scope — a function-local `import time` here
    # would make the name local for the WHOLE function and turn the strftime
    # call above into an UnboundLocalError.)
    time.sleep(0.5)
    if proc.poll() is not None:
        die({"launched": False, "pid": proc.pid,
             "reason": f"process exited immediately (code {proc.returncode})"},
            EX_FAIL, args.json)

    # Post-launch hook: Photoshop's dock-helper inject (File>New docks the workspace).
    if profile.get("post_launch") == "psdock":
        _stage_and_inject_psdock(prefix, wine, env)

    # `log` is returned so Collider can surface "open log" in the UI and so a bug
    # report can name the exact file without the user hunting for it.
    emit({"ok": True, "launched": True, "app": args.app,
          "pid": proc.pid, "gpu_mode": gpu_mode, "display": display_mode,
          "neutron_wine": is_neutron, "log": log_path}, args.json)
    return EX_OK


def _app_version(exe_rel):
    """Pull the release year (e.g. "2025") from the app's path as a lightweight
    version label — no PE version-resource parsing needed."""
    for part in exe_rel.replace("\\", "/").split("/"):
        for tok in part.split():
            if len(tok) == 4 and tok.isdigit() and tok.startswith("20"):
                return tok
    return ""


def _pe_extract_icon_png(exe):
    """The app's largest icon as PNG BYTES, parsed straight out of the PE. NO EXTERNAL TOOLS.

    This used to shell out to `wrestool` + `icotool` and return None when they were missing — so on
    a machine without icoutils (a build tester's, say) Collider silently fell back to monogram
    badges and any .desktop we write would have no icon. The installer is user-space with no root,
    so we cannot make icoutils a dependency; parsing the PE ourselves is ~60 lines and always works.

    Adobe stores its large sizes as PNG inside the .ico, so the common path lifts those bytes
    VERBATIM — no decode, no re-encode, no quality loss. Older/smaller entries are BMP (DIB) and
    are converted with `zlib` from the standard library.

    ⚖️ We extract from the user's OWN installed copy on their OWN machine, and never redistribute
    an Adobe icon — a deliberate decision, not an accident of implementation.
    """
    import struct, zlib

    def u16(b, o): return struct.unpack_from("<H", b, o)[0]
    def u32(b, o): return struct.unpack_from("<I", b, o)[0]

    try:
        with open(exe, "rb") as f:
            d = f.read()
        pe = u32(d, 0x3c)
        if d[pe:pe + 4] != b"PE\0\0":
            return None
        nsec, optsz, opt = u16(d, pe + 6), u16(d, pe + 20), pe + 24
        ddoff = opt + (112 if u16(d, opt) == 0x20b else 96)
        res_rva = u32(d, ddoff + 2 * 8)
        if not res_rva:
            return None
        secs = [(u32(d, opt + optsz + i * 40 + 12), u32(d, opt + optsz + i * 40 + 8),
                 u32(d, opt + optsz + i * 40 + 20)) for i in range(nsec)]

        def rva2off(r):
            for va, vs, raw in secs:
                if va <= r < va + max(vs, 1):
                    return raw + (r - va)
            return None

        rbase = rva2off(res_rva)
        if rbase is None:
            return None

        def entries(off):
            n = u16(d, off + 12) + u16(d, off + 14)
            return [(u32(d, off + 16 + i * 8), u32(d, off + 16 + i * 8 + 4)) for i in range(n)]

        best = None   # (width, bytes, kind)
        for eid, eoff in entries(rbase):
            if (eid & 0x7fffffff) != 3 or not (eoff & 0x80000000):   # RT_ICON
                continue
            for _, noff in entries(rbase + (eoff & 0x7fffffff)):
                if not (noff & 0x80000000):
                    continue
                for _, loff in entries(rbase + (noff & 0x7fffffff)):
                    if loff & 0x80000000:
                        continue
                    de = rbase + loff
                    doff, size = rva2off(u32(d, de)), u32(d, de + 4)
                    if doff is None:
                        continue
                    blob = d[doff:doff + size]
                    if blob[:8] == b"\x89PNG\r\n\x1a\n":
                        w = struct.unpack_from(">I", blob, 16)[0]
                        if not best or w > best[0]:
                            best = (w, blob, "png")
                    elif len(blob) >= 40 and u32(blob, 0) == 40 and u16(blob, 14) == 32:
                        w, h = u32(blob, 4), u32(blob, 8) // 2
                        if w and h and (not best or w > best[0]):
                            best = (w, blob, "dib")
        if not best:
            return None
        w, blob, kind = best
        if kind == "png":
            return blob

        # 32-bit BGRA DIB, bottom-up, no colour table -> minimal PNG via stdlib zlib.
        h = u32(blob, 8) // 2
        px = blob[40:40 + w * h * 4]
        if len(px) < w * h * 4:
            return None
        raw = bytearray()
        for y in range(h - 1, -1, -1):          # bottom-up
            raw.append(0)                        # filter: none
            row = px[y * w * 4:(y + 1) * w * 4]
            for x in range(0, len(row), 4):
                b, g, r, a = row[x:x + 4]
                raw += bytes((r, g, b, a))
        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data
                    + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
        return (b"\x89PNG\r\n\x1a\n"
                + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(bytes(raw), 6))
                + chunk(b"IEND", b""))
    except Exception:
        return None


def _app_icon(exe):
    """The app's real logo as a PNG `data:` URI for Collider's widgets, cached under
    ~/.cache/collider/appicons. Returns None only if the PE genuinely has no icon, in which case
    the UI falls back to its monogram badge."""
    import base64, hashlib
    try:
        cache_dir = os.path.join(HOME, ".cache", "collider", "appicons")
        os.makedirs(cache_dir, exist_ok=True)
        cached = os.path.join(cache_dir,
                              hashlib.sha1((exe + "|pe-v2").encode()).hexdigest()[:16] + ".png")
        if not (os.path.isfile(cached) and os.path.getmtime(cached) >= os.path.getmtime(exe)):
            png = _pe_extract_icon_png(exe)
            if not png:
                return None
            with open(cached, "wb") as f:
                f.write(png)
        with open(cached, "rb") as f:
            return "data:image/png;base64," + base64.b64encode(f.read()).decode()
    except Exception:
        return None


# ---------------------------------------------------------------------------------------------
# Desktop integration tables + helpers.
#
# Split out of register_app_desktop_entries() on 2026-08-25 after the build tester reported all
# three of these as bugs in one pass: generic icons on a live session, file associations that
# opened the app but ignored the file, and a two-main-category warning.
# ---------------------------------------------------------------------------------------------

# ONE main category per app (Graphics or AudioVideo), plus additional ones. Two mains makes some
# menus list the app twice.
APP_CATEGORIES = {
    "premiere":     "AudioVideo;Video;AudioVideoEditing;",
    "mediaencoder": "AudioVideo;Video;AudioVideoEditing;",
    "aftereffects": "AudioVideo;Video;AudioVideoEditing;",
    "photoshop":    "Graphics;2DGraphics;RasterGraphics;Photography;",
    "illustrator":  "Graphics;2DGraphics;VectorGraphics;",
    "lightroom":    "Graphics;Photography;",
    "animate":      "Graphics;2DGraphics;",
}

# The types each app OWNS. `image/vnd.adobe.photoshop` and `application/illustrator` come from
# the system mime database; everything with an `x-neutron-` name is defined by us below, because
# freedesktop has never carried .prproj/.aep/.fla/.lrcat/.psb.
#
# ⛔ NEVER list a type the app merely CAN open. Photoshop reads .jpg and .png; claiming those
# would take the whole desktop's image handling away from the user's viewer.
# Media Encoder is deliberately absent: its inputs are ordinary media types owned by the user's
# player, and its own .epr files are presets nobody double-clicks.
APP_MIME_TYPES = {
    "photoshop":    ("image/vnd.adobe.photoshop", "image/x-neutron-psb"),
    "illustrator":  ("application/illustrator",),
    "premiere":     ("application/x-neutron-prproj",),
    "aftereffects": ("application/x-neutron-aep",),
    "animate":      ("application/x-neutron-fla",),
    "lightroom":    ("application/x-neutron-lrcat",),
}

# Our own shared-mime-info package for the Adobe project formats the system does not define.
# Glob-only (no magic): these are container formats whose signatures vary by version, and a
# wrong magic rule mis-types a file for every application on the system, not just ours.
# weight="60" beats the default 50 that Wine's own `x-wine-extension-*` packages use. Wine
# generates one per registered extension and it won .psb on a tie-break, which routed the file
# through an UNPINNED `wine start /ProgIDOpen` -- the launch path that re-stamps a prefix.
NEUTRON_MIME_XML = """<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- Written by `neutron prefix provision`. Adobe project formats that freedesktop does not
       define, so that a .desktop entry can claim them. -->
  <mime-type type="application/x-neutron-prproj">
    <comment>Adobe Premiere Pro project</comment>
    <glob pattern="*.prproj" weight="60"/>
  </mime-type>
  <mime-type type="application/x-neutron-aep">
    <comment>Adobe After Effects project</comment>
    <glob pattern="*.aep" weight="60"/>
    <glob pattern="*.aet" weight="60"/>
  </mime-type>
  <mime-type type="application/x-neutron-fla">
    <comment>Adobe Animate document</comment>
    <glob pattern="*.fla" weight="60"/>
    <glob pattern="*.xfl" weight="60"/>
  </mime-type>
  <mime-type type="application/x-neutron-lrcat">
    <comment>Lightroom Classic catalog</comment>
    <glob pattern="*.lrcat" weight="60"/>
  </mime-type>
  <mime-type type="image/x-neutron-psb">
    <comment>Adobe Photoshop large document</comment>
    <glob pattern="*.psb" weight="60"/>
  </mime-type>
</mime-info>
"""


def install_neutron_mime_package():
    """Define the Adobe project types in the user's mime database. Idempotent."""
    d = os.path.join(HOME, ".local", "share", "mime", "packages")
    target = os.path.join(d, "neutron-adobe.xml")
    try:
        os.makedirs(d, exist_ok=True)
        prev = ""
        if os.path.isfile(target):
            with open(target) as f:
                prev = f.read()
        if prev == NEUTRON_MIME_XML:
            return False
        with open(target, "w") as f:
            f.write(NEUTRON_MIME_XML)
        subprocess.run(["update-mime-database", os.path.dirname(d)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
        return True
    except Exception as e:
        log("mime package: %s" % e)
        return False


def retire_superseded_entries(apps_dir, app_ids):
    """Remove the previous generation's `mudhut-<app>.desktop`, backing each one up first.

    Mud Hut used to write these; they point at launchers that no longer exist and reference
    `Icon=mudhut-*` names for which no icon file was ever installed, so they show a generic icon
    forever. Left in place they ALSO keep `mimeapps.list` pointed at a dead handler.

    ⛔ Only for an app we just wrote a working `neutron-<app>.desktop` for, and never without a
    backup -- these are files on the user's machine, not ours to silently delete.
    """
    out = []
    backup = os.path.join(HOME, ".local", "share", "neutron", "superseded-desktop-entries")
    for app_id in app_ids:
        stale = os.path.join(apps_dir, "mudhut-%s.desktop" % app_id)
        if not os.path.isfile(stale):
            continue
        try:
            os.makedirs(backup, exist_ok=True)
            shutil.move(stale, os.path.join(backup, os.path.basename(stale)))
            out.append(os.path.basename(stale))
        except OSError as e:
            log("retire %s: %s" % (stale, e))
    return out


def repair_mime_defaults(apps_dir, written):
    """Point each Adobe type at our entry -- but ONLY where nothing live already claims it.

    The rule matters. A user who set their own handler for .psd keeps it; what gets repaired is
    the DANGLING case, where `mimeapps.list` names a .desktop file that no longer exists (which
    is exactly what removing the mudhut generation leaves behind, and what the build tester had
    to fix by hand on 2026-08-25).
    """
    path = os.path.join(HOME, ".config", "mimeapps.list")
    want = {}
    for w in written:
        for m in w.get("mime", ()):
            want[m] = "neutron-%s.desktop" % w["app"]
    if not want:
        return []

    import configparser
    cp = configparser.RawConfigParser()
    cp.optionxform = str            # mime types are case-sensitive keys
    try:
        if os.path.isfile(path):
            cp.read(path)
    except Exception as e:
        log("mimeapps read: %s -- leaving associations alone" % e)
        return []
    section = "Default Applications"
    if not cp.has_section(section):
        cp.add_section(section)

    def live(entry_list):
        for name in entry_list.split(";"):
            name = name.strip()
            if not name:
                continue
            for root in (apps_dir, "/usr/share/applications",
                         os.path.join(HOME, ".local", "share", "applications")):
                if os.path.isfile(os.path.join(root, name)):
                    return True
        return False

    claimed = []
    for mime, entry in sorted(want.items()):
        cur = cp.get(section, mime, fallback="")
        if cur and live(cur):
            continue                # someone real already handles it -- do not steal it
        cp.set(section, mime, entry)
        claimed.append(mime)
    if not claimed:
        return []
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            cp.write(f, space_around_delimiters=False)
    except OSError as e:
        log("mimeapps write: %s" % e)
        return []
    return claimed


def refresh_desktop_caches(apps_dir):
    """Make a LIVE desktop session actually see the entries and icons we just wrote.

    🚨 This is the fix for "icon extraction is broken". It never was. Provision wrote valid
    256x256 PNGs and the desktop showed generic icons anyway, because the running shell had
    cached its icon lookups hours earlier -- on the build tester's machine, `plasmashell` had
    been up for 13 hours and there was no `icon-theme.cache` in the user's hicolor tree at all.
    Every tester who provisions inside a live session hits this and reports a bug that does not
    exist. Writing a file is not the same as the desktop knowing about it.

    All best-effort: each tool is absent on some desktops, and none of them failing is fatal.
    """
    icon_root = os.path.join(HOME, ".local", "share", "icons", "hicolor")
    result = {}
    for cmd in (["update-desktop-database", apps_dir],
                # -t/--ignore-theme-index: our hicolor tree has no index.theme of its own.
                ["gtk-update-icon-cache", "-f", "-t", icon_root],
                ["kbuildsycoca6", "--noincremental"],
                ["kbuildsycoca5", "--noincremental"],
                ["xdg-desktop-menu", "forceupdate"],
                # KDE caches icons per-process; this tells running KDE apps to drop theirs.
                ["dbus-send", "--session", "--type=signal", "/KIconLoader",
                 "org.kde.KIconLoader.iconChanged", "int32:0"]):
        if not shutil.which(cmd[0]):
            result[cmd[0]] = "absent"
            continue
        try:
            r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=60)
            result[cmd[0]] = "ok" if r.returncode == 0 else (
                "rc=%d %s" % (r.returncode, (r.stderr or b"").decode("utf-8", "replace").strip()[:120]))
        except Exception as e:
            result[cmd[0]] = "failed: %s" % e
    # ⚠️ REPORT EACH ONE. Do not collapse this to a boolean: on the dev box
    # `gtk-update-icon-cache -f -t` exits 1 with "The generated cache was invalid" (a 20x19
    # directory in the tree) while every other refresh succeeds -- and a step that answered
    # "caches refreshed: true" over that failure would be the same mistake as the bug it fixes.
    # Harmless in this instance, because GTK compares the cache against directory mtimes and
    # ignores a stale one (verified: Gtk.IconTheme resolves neutron-* against a June cache), but
    # "harmless" is a conclusion for a reader to reach, not for this function to assume.
    return result


def register_app_desktop_entries(prefix):
    """Give every installed app its OWN desktop identity: a .desktop entry + an icon.

    TWO problems, one fix.

    1. **The dock icon.** Wine advertises a Wayland `app_id` equal to the LOWERCASED EXE BASENAME
       (`waylanddrv_main.c:wayland_init_process_name` — basename, downcased, `.exe` kept). The
       compositor matches that against installed .desktop files to choose an icon. Nothing
       matched, so an app launched from Collider was attributed to COLLIDER and wore its icon.
       `StartupWMClass` is that match.

    2. **Real menu entries**, so the suite can be launched without Collider at all. `Exec=` runs
       the same `neutron launch` Collider runs, so a menu launch and a Collider launch are the
       same launch — and Collider can adopt an app started either way (`cmd_apps` reports
       `running`/`pid`).

    ⚖️ Icons are extracted from the user's OWN installed copy, on their OWN machine, at provision
    time. We never redistribute an Adobe icon.

    Idempotent; safe to run on every provision. Returns a per-app summary.
    """
    # The runtime these entries must pin: the one resolve_wine() picks right now, taken from its
    # path so it cannot drift from reality. Falls back to the CLI default only if unparseable.
    pinned_version = NEUTRON_WINE_VERSION
    try:
        _w, _is_neutron = resolve_wine()
        if _is_neutron and _w:
            _root = os.path.basename(os.path.dirname(os.path.dirname(os.path.realpath(_w))))
            if _root.startswith("neutron-wine-"):
                pinned_version = _root[len("neutron-wine-"):]
    except Exception:
        pass

    apps_dir = os.path.join(HOME, ".local", "share", "applications")
    icon_dir = os.path.join(HOME, ".local", "share", "icons", "hicolor", "256x256", "apps")
    os.makedirs(apps_dir, exist_ok=True)
    os.makedirs(icon_dir, exist_ok=True)
    # The Adobe project formats freedesktop has never heard of (.prproj, .aep, .fla, ...) have
    # to be DEFINED before an entry can claim them; only .psd and .ai ship in the system mime
    # database. Idempotent, and scoped to this user.
    install_neutron_mime_package()
    written = []
    changed = False

    for app_id, p in APP_PROFILES.items():
        exe = _resolve_app_exe(prefix, p["exe"]) if prefix else ""
        if not (exe and os.path.isfile(exe)):
            continue

        # The app_id the compositor will see. MUST match Wine exactly or the icon will not bind.
        wm_class = os.path.basename(exe).lower()

        icon_name = "neutron-%s" % app_id
        icon_path = os.path.join(icon_dir, icon_name + ".png")
        have_icon = False
        try:
            if not (os.path.isfile(icon_path)
                    and os.path.getmtime(icon_path) >= os.path.getmtime(exe)):
                png = _pe_extract_icon_png(exe)
                if png:
                    with open(icon_path, "wb") as f:
                        f.write(png)
            have_icon = os.path.isfile(icon_path)
        except OSError as e:
            log("desktop entry: icon for %s failed: %s" % (app_id, e))

        desktop = os.path.join(apps_dir, "neutron-%s.desktop" % app_id)
        # The file types this app OWNS, and therefore `%f`. Without both, a double-clicked .psd
        # opens Photoshop and then ignores the file -- reported from the build tester's machine
        # 2026-08-25, where the superseded mudhut entries HAD carried them. `neutron launch`
        # already accepts a positional Linux path and converts it to Z:\ (cmd_launch), so this
        # is purely the .desktop side of a capability that was always there.
        # ⛔ Only ever the app's OWN formats. Photoshop opens .jpg and .png too, but claiming
        # those would hijack the user's image viewer for the whole desktop.
        mimes = APP_MIME_TYPES.get(app_id, ())
        exec_arg = " %f" if mimes else ""
        body = (
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=%s\n"
            "Comment=%s via Neutron\n"
            # 🚨 PIN THE RUNTIME. Without NEUTRON_WINE_VERSION a menu launch uses the CLI's
            # compiled-in DEFAULT, which is generally NOT the runtime this prefix is stamped for —
            # and an unpinned launch against a different-stamp runtime fires `wineboot -u`, which
            # reverts the patched natives and reads as a mass regression (RUNBOOK, and the reason
            # the stack bundle's own wrapper pins it). Measured 2026-08-25: these entries shipped
            # unpinned for a few hours, the user launched from the menu, and the prefix was
            # re-stamped from 11.10-62 back to the CLI default 11.10-59 with dwrite/dcomp/dxcore
            # all reverted to builtins.
            "Exec=env PATH=%s/.local/bin:/usr/local/bin:/usr/bin:/bin NEUTRON_WINE_VERSION=%s neutron launch %s --prefix %s%s\n"
            "Icon=%s\n"
            "Terminal=false\n"
            # One MAIN category only. `Graphics;AudioVideo;` is two, which makes a menu list the
            # same app twice (desktop-file-validate flags it).
            "Categories=%s\n"
            "%s"
            # ⭐ THE LINE THAT FIXES THE DOCK ICON. Wine's app_id, verbatim.
            "StartupWMClass=%s\n"
            "StartupNotify=false\n"
            % (p["name"], p["name"], HOME, pinned_version, app_id, prefix, exec_arg,
               icon_name if have_icon else "collider",
               APP_CATEGORIES.get(app_id, "Graphics;"),
               ("MimeType=%s\n" % "".join(m + ";" for m in mimes)) if mimes else "",
               wm_class))
        try:
            prev = ""
            if os.path.isfile(desktop):
                with open(desktop) as f:
                    prev = f.read()
            if prev != body:
                with open(desktop, "w") as f:
                    f.write(body)
                os.chmod(desktop, 0o755)
                changed = True
            written.append({"app": app_id, "wm_class": wm_class, "icon": have_icon,
                            "mime": list(mimes)})
        except OSError as e:
            log("desktop entry: %s failed: %s" % (app_id, e))

    superseded = retire_superseded_entries(apps_dir, [w["app"] for w in written])
    claimed = repair_mime_defaults(apps_dir, written)
    caches = refresh_desktop_caches(apps_dir) if written else {}
    return {"entries": written, "superseded": superseded, "claimed_types": claimed,
            "rewrote": changed, "caches": caches}


def _app_running_pid(exe):
    """PID of a live process running `exe` in this prefix, or None.

    ⛔ Matches on /proc/<pid>/exe and the FULL windows path in the cmdline — never a loose
    substring of the app NAME. A cmdline match on something like "premiere" also matches the
    grep, the launcher, and this very process; that trap has cost real time before
    (preserved-fixes/harnesses/premiere_live.py exists because of it). Skips our own pid.
    """
    if not exe:
        return None
    want = os.path.basename(exe).lower()
    me = os.getpid()
    try:
        pids = [d for d in os.listdir("/proc") if d.isdigit()]
    except OSError:
        return None
    for d in pids:
        pid = int(d)
        if pid == me:
            continue
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                parts = f.read().split(b"\0")
        except OSError:
            continue
        # argv[0] is the wine loader; the windows exe path is a later argument. Require the
        # BASENAME to match a full path component, not appear anywhere in the string.
        for a in parts:
            try:
                t = a.decode("utf-8", "replace").lower()
            except Exception:
                continue
            if t.endswith(want) and ("\\" in t or "/" in t):
                return pid
    return None


def cmd_apps(args):
    """List the Adobe apps Neutron can launch + their install status in a prefix.
    Powers Collider's app catalog (one tinted widget per installed app). Never
    launches anything — pure detection (scan the prefix for each profile's exe)."""
    prefix = resolve_prefix(args.prefix) or args.prefix
    # 🚨 SAY WHY WHEN THERE IS NO PREFIX. With none resolvable this used to answer
    # {"ok": true} with all seven apps `installed: false` -- indistinguishable from "you have
    # nothing installed", which is exactly how the build tester read it on 2026-08-25 while all
    # seven WERE installed one `--prefix` away. `ok` stays true and the list stays populated
    # (Collider blanks its whole Apps view on a command failure), but the answer now carries the
    # reason and the candidate paths.
    why = None if prefix else bad_prefix_reason(getattr(args, "prefix", None))
    apps = []
    for app_id, p in APP_PROFILES.items():
        exe = _resolve_app_exe(prefix, p["exe"]) if prefix else ""
        installed = bool(exe) and os.path.isfile(exe)
        apps.append({
            "id": app_id,
            "name": p["name"],
            "accent": p["accent"],
            "version": _app_version(exe) if installed else _app_version(p["exe"]),
            "export": p.get("export", False),
            "installed": installed,
            "exe": exe,
            # Collider adopts these so an app launched from the APPLICATION MENU still shows as
            # Running in the GUI and can be force-quit there. Without it a menu launch is
            # invisible to Collider and clicking Launch would start a SECOND copy.
            "running": bool(_app_running_pid(exe)) if installed else False,
            "pid": _app_running_pid(exe) if installed else None,
            "icon": _app_icon(exe) if installed else None,   # real logo (lowest-ID group); None -> monogram
        })
    # Installed first, then alphabetical — a stable order for the widget grid.
    apps.sort(key=lambda a: (not a["installed"], a["name"]))
    out = {"ok": True, "prefix": prefix or None, "apps": apps}
    if why:
        out.update(why)
    emit(out, args.json)
    return EX_OK


def _runtime_integrity_checks(wine_path):
    """Structural checks on an installed Neutron runtime. Returns [(name, ok, detail), ...].

    Cheap on purpose -- a directory listing and one grep, so `doctor` stays fast enough for
    Collider to call on every view. Deliberately NOT a checksum of the tree: the point is to
    catch a build that came out structurally wrong, not to detect tampering.
    """
    out = []
    root = os.path.dirname(os.path.dirname(os.path.realpath(wine_path)))
    for arch, floor in (("x86_64-windows", 900), ("i386-windows", 900)):
        d = os.path.join(root, "lib", "wine", arch)
        try:
            n = len([f for f in os.listdir(d)])
        except OSError:
            n = 0
        out.append(("runtime-" + arch, n >= floor,
                    "%d PE files" % n if n >= floor else
                    "%d PE files (expected >=%d) -- this runtime is INCOMPLETE. 11.10-61 shipped "
                    "with 0 here. Reinstall the runtime; do not chase app bugs against it."
                    % (n, floor)))
    # wine.inf drives prefix creation; a truncated one produces a prefix that looks fine and is
    # missing registry content. `FileOpenAssociations` sits near the end of the file, so its
    # absence is a cheap proxy for "generation stopped early".
    inf = os.path.join(root, "share", "wine", "wine.inf")
    ok, detail = False, "wine.inf not found at " + inf
    try:
        with open(inf, "rb") as f:
            body = f.read()
        hits = body.count(b"FileOpenAssociations")
        ok = hits > 0
        detail = ("%d FileOpenAssociations sections" % hits if ok else
                  "wine.inf is TRUNCATED (0 FileOpenAssociations sections) -- prefix creation "
                  "will be incomplete. Reinstall the runtime.")
    except OSError as e:
        detail = "wine.inf unreadable: %s" % e
    out.append(("runtime-wine-inf", ok, detail))
    return out


def cmd_doctor(args):
    """Health check. Powers Collider's prefix-health status surface.

    NOTE: schema PROVISIONAL (v0-unstable), same ordering caveat as prefix info.
    """
    checks = []

    def check(name, ok, detail=None):
        c = {"name": name, "ok": bool(ok)}
        if detail:
            c["detail"] = detail
        checks.append(c)

    # ⚠️ Check the wine NEUTRON WILL ACTUALLY USE, not `wine` on PATH. Neutron ships its own
    # runtime and deliberately does not require a distro wine package, so `shutil.which("wine")`
    # is False on a clean machine — every build tester failed this check, doctor returned
    # "unhealthy" (exit 1), and Collider treated that as a command failure and blanked its entire
    # Apps view. The dev box happened to have /usr/bin/wine installed, which is why it never
    # reproduced here.
    _wine, _wine_is_neutron = resolve_wine()
    check("wine", bool(_wine),
          (_wine + ("  (Neutron runtime)" if _wine_is_neutron else "  (system wine)")) if _wine
          else "no wine found — install the Neutron runtime")

    # 🚨 IS THE RUNTIME ITSELF INTACT? Reported from the build tester 2026-08-25: doctor returned
    # {"ok": true, "healthy": true} against 11.10-61, a build we KNOW is defective. Resolving a
    # wine binary was its only unconditional check, and 61's `wine` binary was fine -- what was
    # missing was everything around it. Both defects below are what 61 actually shipped with,
    # caused by cutting a release from an incremental make on a tree wine-tkg partially reverts:
    #   * an EMPTY 32-bit PE tree (0 files vs 1101) -- every 32-bit Adobe helper fails to start;
    #   * a HALF-APPLIED wine.inf -- the prefix comes out missing registry content.
    # A check that cannot fail on a build known to be broken is worse than no check: it is the
    # sentence "doctor says healthy" doing work it never earned.
    if _wine and _wine_is_neutron:
        for c in _runtime_integrity_checks(_wine):
            check(c[0], c[1], c[2])

    if args.prefix:
        prefix = resolve_prefix(args.prefix)
        if not prefix:
            check("prefix", False, "drive_c not found")
        else:
            user = prefix_user(prefix)
            check("prefix", True, prefix)
            # Would launching this prefix on the runtime we just resolved re-stamp it? Same test
            # `launch` refuses on, surfaced here so Collider shows it BEFORE someone clicks
            # Launch. Silent when the prefix has never been booted.
            _mm = stamp_mismatch(prefix, _wine)
            if _mm is not None:
                _also = _mm["prefix_runtimes"]
                check("runtime-prefix-stamp", False,
                      "this prefix is stamped for %s but the resolved runtime is %s — launching "
                      "would run `wineboot -u` and REVERT the patched natives. Run "
                      "`neutron prefix provision %s`."
                      % (", ".join(_also) if _also else "stamp %d (no installed runtime)"
                         % _mm["prefix_stamp"], os.path.basename(_mm["runtime"]), prefix))
            elif _prefix_stamp(prefix) is not None:
                check("runtime-prefix-stamp", True,
                      "prefix and runtime agree (stamp %d)" % _prefix_stamp(prefix))
            # App-agnostic health: a prefix is usable if ANY known Adobe app is
            # installed (not Premiere specifically) — else a Photoshop-only prefix
            # would read as "unhealthy" and gate the whole UI.
            installed = [p["name"] for p in APP_PROFILES.values()
                         if os.path.isfile(_resolve_app_exe(prefix, p["exe"]))]
            check("adobe-app", bool(installed),
                  ", ".join(installed) if installed else "no known Adobe app found")
            # Adobe's CC-desktop IPC broker -- a PHOTOSHOP prerequisite, not a suite-wide one.
            # Only the `photoshop` profile declares `daemons` (ADOBE_DAEMONS); Premiere, LrC,
            # Animate, AME, AE and Illustrator all launch without the broker running, which is why
            # Premiere works on the dev box where `neutron launch premiere` never starts it.
            # ⚠️ An earlier version of this check claimed "every Adobe app fails at launch" -- that
            # came from a build-test report and is CONTRADICTED by our own profiles. Scoped here to
            # the app that actually needs it, and only raised when that app is installed.
            #
            # Worth checking at all because `mudhut --method windows` copies whatever the source
            # Windows install happens to contain: if that machine never had CC Desktop, the prefix
            # comes out app-complete with no broker and the install still reports success.
            # Photoshop then fatals with "unable to communicate with Creative Cloud Desktop".
            ps_exe = _resolve_app_exe(prefix, APP_PROFILES["photoshop"]["exe"])
            if ps_exe and os.path.isfile(ps_exe):
                broker = os.path.join(prefix, "drive_c", "Program Files (x86)", "Common Files",
                                      "Adobe", "Adobe Desktop Common", "IPCBox",
                                      "AdobeIPCBroker.exe")
                check("cc-desktop-ipc", os.path.isfile(broker),
                      broker if os.path.isfile(broker)
                      else "AdobeIPCBroker.exe missing - PHOTOSHOP will fail with 'unable to "
                           "communicate with Creative Cloud Desktop'. Other apps are unaffected. "
                           "The Adobe Desktop Common runtime was never staged into this prefix.")
            # 🚨 nvcuda MUST be the GATED build. The diag build contains `neutron_live_thread`,
            # which samples 8 KB out of every CUDA allocation >=4 MB on a 1 s timer and never
            # drops freed pointers -- during an export it reads a freed buffer and libcuda page
            # faults, killing the app. The gate (`NEUTRON_CUDA_PLAYBACK_EXPERIMENT`, default off)
            # was written and built 2026-08-03 and never installed; the ungated build then went
            # into the runtime bundle and cost the user a day of editing (2026-08-08).
            # Presence of nvcuda.dll proves nothing -- the gate string is the only evidence.
            nvcuda = os.path.join(prefix, "drive_c", "windows", "system32", "nvcuda.dll")
            if os.path.isfile(nvcuda):
                check("nvcuda-gated", _has_marker(nvcuda, b"NEUTRON_CUDA_PLAYBACK_EXPERIMENT"),
                      "gated release build" if _has_marker(
                          nvcuda, b"NEUTRON_CUDA_PLAYBACK_EXPERIMENT")
                      else "UNGATED DIAG BUILD - CUDA exports will crash in libcuda. Install "
                           "~/nvidia-libs/nvcuda/build.release/dlls/nvcuda/nvcuda.dll.so over "
                           "it (and over ~/neutron/runtime/dlls/system32/nvcuda.dll).")
            # 🚨 CoolType's default Roman face. Adobe resolves it by PostScript
            # name, and Wine ships a substitute for all three candidate files
            # under the same Microsoft filenames -- so a prefix can hold
            # times/arial/cour, pass every presence check, and still leave
            # CoolType with nothing to select. When all three are fake,
            # CoolType THROWS and After Effects dies at startup with
            # `EGG Constructor IEggApp failed` behind a boilerplate "check your
            # permissions" message. Reproduced and reversed in the clean room
            # 2026-08-11. Premiere and AME share CoolType and are at risk of the
            # same class of failure, so this is a suite-wide check.
            roman = _roman_default_status(prefix)
            genuine = [r for r in roman if r[1] == "real"]
            # ⚠️ The FILES being genuine is not sufficient — CoolType may never read
            # them. Its cache is keyed on filename, so `winetricks corefonts`
            # (which overwrites in place) leaves the three Regular records
            # pointing at Wine substitutes forever. A files-only check reports
            # PASS on exactly the state our own remedy creates.
            stale = _stale_roman_cache_records(prefix)
            detail = ", ".join(f"{fn}={state}" for fn, state, _ in roman)
            if not genuine:
                check("cooltype-roman-default", False, detail +
                      "  — NO genuine Roman face: CoolType will throw and "
                      "After Effects will fail at startup with 'EGG Constructor IEggApp failed'. "
                      "Install the real Microsoft core fonts (`winetricks corefonts`) or run "
                      "`neutron prefix provision <prefix>` to repair from host fonts.")
            elif stale:
                check("cooltype-roman-default", False, detail +
                      "  — a genuine file is present but CoolType's CACHE offers NO genuine "
                      "Roman face (it serves " +
                      ", ".join(sorted({s[1] for s in stale})) +
                      "). AE will fail at startup regardless of the files. Fix: delete " +
                      os.path.dirname(stale[0][2]) + " (Adobe rebuilds it), or run "
                      "`neutron prefix provision <prefix>`, which now does it for you.")
            else:
                check("cooltype-roman-default", True, detail)
            # CEP panel CEF flags. An extension UPDATE silently reverts these (Captioneer 1.8.1
            # did, 2026-08-15) and the only symptom is "the panel does not load" -- nothing in
            # Premiere's log says why, so without this check it costs an investigation every time.
            cep_missing = cep_flag_status(prefix)
            if cep_missing:
                check("cep-cef-flags", False,
                      "; ".join("%s missing %s" % (e, " ".join(m)) for e, _p, m in cep_missing) +
                      "  — the panel will load but render blank (Chromium composites through "
                      "DirectComposition, whose tile quads do not draw under Wine). An extension "
                      "update overwrites the manifest; run `neutron prefix provision <prefix>` to "
                      "re-apply, then RESTART the app (manifests are read only at startup).")
            else:
                n_scoped = len([1 for e, _p in _cep_manifests(prefix)
                                if e.startswith(NEUTRON_CEP_VENDORS)])
                check("cep-cef-flags", True,
                      "%d in-scope extension(s) carry %s" % (n_scoped, " ".join(NEUTRON_CEP_FLAGS))
                      if n_scoped else "no in-scope CEP extensions installed")
            # Premiere-only checks (Debug Database display fix) apply ONLY when
            # Premiere is installed; they must not fail a Photoshop/other prefix.
            if os.path.isfile(os.path.join(prefix, PREMIERE_SUBPATH)):
                dbg = find_debug_database(prefix, user) if user else None
                check("debug-database", bool(dbg), dbg)
                applied = False
                if dbg and os.path.isfile(dbg):
                    try:
                        with open(dbg, "r", encoding="utf-8", errors="replace") as f:
                            applied = _display_fix_is_on(f.read())
                    except OSError:
                        applied = False
                check("display_fix", applied)

    healthy = all(c["ok"] for c in checks
                  if c["name"] not in ("exiftool",))  # exiftool is optional
    emit({"ok": True, "healthy": healthy, "checks": checks,
          "_schema": "provisional-v0"}, args.json)
    return EX_OK if healthy else EX_FAIL


# --- argument plumbing -----------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="neutron",
        description="Neutron CLI — the engine front door Collider drives.",
    )
    p.add_argument("--json", action="store_true",
                   help="structured JSON to stdout (Collider mode)")
    p.add_argument("--progress", action="store_true",
                   help="with --json, stream newline-delimited progress events before the terminal "
                        "result (same NDJSON contract Mud Hut uses: {event:progress|note|error|result}). "
                        "OPT-IN on purpose: Mud Hut runs `neutron prefix provision` with INHERITED "
                        "stdout, so streaming by default would inject these lines into Mud Hut's own "
                        "event stream and Collider would read our result as Mud Hut's.")
    sub = p.add_subparsers(dest="cmd", required=True)

    # prefix
    pp = sub.add_parser("prefix", help="prefix inspection / provisioning")
    psub = pp.add_subparsers(dest="subcmd", required=True)

    pi = psub.add_parser("info", help="report paths Collider needs")
    pi.add_argument("path", nargs="?", default=None)
    pi.set_defaults(func=cmd_prefix_info)

    pa = psub.add_parser("apply-display-fix",
                         help="write DS.DisableDirectXDisplay=true (idempotent)")
    pa.add_argument("path", nargs="?", default=None)
    pa.set_defaults(func=cmd_apply_display_fix)

    pv = psub.add_parser("provision",
                         help="make a staged prefix Neutron-ready (idempotent)")
    pv.add_argument("path", nargs="?", default=None)
    pv.set_defaults(func=cmd_prefix_provision)

    # launch
    pl = sub.add_parser("launch", help="launch an app through the Neutron stack")
    pl.add_argument("app", help="app to launch (" + ", ".join(APP_PROFILES) + ")")
    pl.add_argument("--prefix", default=None)
    pl.add_argument("--project", default=None,
                    help="optional project path (Windows-style, e.g. C:\\...\\x.prproj)")
    pl.add_argument("--allow-restamp", action="store_true",
                    help="launch even when this runtime's stamp differs from the prefix's. Wine "
                         "will run `wineboot -u` and REVERT the prefix's patched natives. Use "
                         "only when deliberately moving a prefix to a new runtime, and run "
                         "`prefix provision` afterwards.")
    pl.add_argument("project_file", nargs="?", default=None,
                    help="optional file to open, e.g. from a .desktop file association "
                         "(a Linux path is translated to a Windows Z:\\ path)")
    pl.add_argument("--scale", type=float, default=None,
                    help="display scale (e.g. 1.7); on Wayland Neutron sets "
                         "LogPixels=round(96*scale). Collider passes this; else auto-detect.")
    grp = pl.add_mutually_exclusive_group()
    grp.add_argument("--gpu", action="store_true", help="GPU/Mercury (default)")
    grp.add_argument("--software", action="store_true",
                     help="software render (NOT implemented in v0)")
    pl.set_defaults(func=cmd_launch)

    # apps: catalog + install status for Collider's per-app widgets
    pap = sub.add_parser("apps", help="list apps + install status in a prefix")
    pap.add_argument("--prefix", default=None)
    pap.set_defaults(func=cmd_apps)

    # teardown
    pt = sub.add_parser("teardown",
                        help="close a prefix cleanly (apps save prefs) and leave nothing running")
    pt.add_argument("--prefix", default=None)
    pt.add_argument("--app", default=None,
                    help="close ONLY this app (e.g. premiere), leaving the prefix's other apps "
                         "running. This is the routine case -- all apps share one prefix, so the "
                         "default full teardown would take them all down. When the last app exits, "
                         "the shared daemons + wineserver are swept automatically.")
    pt.add_argument("--grace", type=int, default=25,
                    help="seconds to wait for apps to exit after WM_CLOSE (default 25)")
    pt.add_argument("--force", action="store_true",
                    help="skip the graceful close; apps will LOSE unsaved preferences")
    pt.set_defaults(func=cmd_teardown)

    # doctor
    pd = sub.add_parser("doctor", help="health check")
    pd.add_argument("--prefix", default=None)
    pd.set_defaults(func=cmd_doctor)

    # runtime: build/refresh the DLL bundle that provision stages
    prt = sub.add_parser("runtime", help="Neutron runtime DLL bundle")
    rsub = prt.add_subparsers(dest="subcmd", required=True)
    rc = rsub.add_parser("capture",
                         help="build the DLL bundle from a proven prefix")
    rc.add_argument("--from", dest="from_prefix", default=None,
                    help="source prefix to capture from")
    rc.add_argument("--out", default=None,
                    help="bundle output dir (default ~/neutron/runtime)")
    rc.set_defaults(func=cmd_runtime_capture)

    ri = rsub.add_parser("install",
                         help="download + verify + unpack a neutron-wine release")
    ri.add_argument("--version", default=None,
                    help=f"release version (default: {NEUTRON_WINE_VERSION})")
    ri.add_argument("--repo", default=None,
                    help=f"GitHub owner/repo (default: {NEUTRON_WINE_REPO})")
    ri.add_argument("--manifest", default=None,
                    help="manifest URL or local path (overrides --version/--repo)")
    ri.add_argument("--force", action="store_true",
                    help="reinstall even if this version is already present")
    ri.set_defaults(func=cmd_runtime_install)

    rw = rsub.add_parser("which",
                         help="the wine this CLI would use (so other tools can agree with it)")
    rw.add_argument("--prefix", default=None,
                    help="also report whether launching this prefix would re-stamp it")
    rw.set_defaults(func=cmd_runtime_which)

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_FAIL


if __name__ == "__main__":
    sys.exit(main())
