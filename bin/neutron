# The Adobe-suite DXVK config placed at the prefix root (Adobe panel render fix).
PROVISION_DXVK_CONF = (
    "# Neutron Adobe-suite DXVK config (provisioned by `neutron prefix provision`)\n"
    "dxvk.enableGraphicsPipelineLibrary = False\n"
    "dxgi.enableDummyCompositionSwapchain = True\n"
    "\n"
    "# ---------------------------------------------------------------------------\n"
    "# CEF/CEP panels (Animate's New Document + workspace, and every other Chromium-\n"
    "# hosted Adobe panel) MUST NOT get a composition swapchain. Proven 2026-08-04.\n"
    "#\n"
    "# WHAT GOES WRONG: modern CEF presents through DirectComposition. DXVK answers\n"
    "# CreateSwapChainForComposition with a DUMMY swapchain built with a NULL hwnd\n"
    "# (dxgi_factory.cpp: 'Creating dummy swap chain') -- upstream only ever intended\n"
    "# it to satisfy apps that query composition support, not to display anything.\n"
    "# Chromium then renders the whole panel into it and Presents happily. Each Present\n"
    "# reaches the dcomp bridge with hwnd=0, falls back to the global pending_hwnd --\n"
    "# which holds DXVK's own 320x240 DXVKDUMMYWNDCLASS -- and every frame is discarded.\n"
    "# Symptom: the panel paints ONE early (blank) frame and then freezes white forever.\n"
    "# Measured on Animate: 9 presents all with m_window=0, then permanent silence.\n"
    "#\n"
    "# THE FIX: deny composition swapchains to CEF only. CreateSwapChainForComposition\n"
    "# returns E_NOTIMPL and Chromium falls back to a WINDOWED swapchain (m_window != 0)\n"
    "# -- the same path Premiere's working CEP panel has always used, which the dcomp\n"
    "# bridge routes to the real panel host. After: 144 presents, 0 with m_window=0,\n"
    "# 0 null-hwnd fallbacks, and Animate's New Document + canvas render and interact.\n"
    "#\n"
    "# Scoped per-exe on purpose: the global setting above stays for the host apps,\n"
    "# which is the configuration Photoshop/Premiere/AE/LrC were all validated on.\n"
    "[CEPHtmlEngine.exe]\n"
    "dxgi.enableDummyCompositionSwapchain = False\n"
)


# --- Per-app launch profiles (single source of truth for the whole suite) -------
# Each entry: the exe (relative to the prefix), the DXVK config it uses, its
# WINEDLLOVERRIDES, extra env, brand accent, and whether it has a hardware-export
# pipeline. Premiere keeps its historical values BYTE-FOR-BYTE (references the
# constants above); the rest encode the proven per-app env from ~/.local/bin/<app>
# plus the Neutron suite display fixes (dxcore/nvapi/dcomp native overrides).
#   - dxvk_conf: relative to the prefix. Premiere uses its own dxvk.conf beside the
#     exe; the rest use the shared neutron-apps-dxvk.conf (Adobe panel render fix).
#   - nvapi: export DXVK_ENABLE_NVAPI=1 (real-NVIDIA reporting).
#   - env: extra environment (e.g. Photoshop's GPU-present BTW gate).
#   - accent: brand tint for the Collider app widget.
#   - export: produces video output (native HW-export muxing).
def _adobe(*parts):
    return os.path.join("drive_c", "Program Files", "Adobe", *parts)


def _common_adobe(*parts):
    """Path under the prefix's 32-bit Common Files Adobe tree (Adobe Desktop Common)."""
    return os.path.join("drive_c", "Program Files (x86)", "Common Files", "Adobe", *parts)


# Adobe background services Photoshop's NGL/RPC needs at launch (else it fatals with
# "can't communicate with CC desktop"). Started detached before the app; torn down
# with the prefix. Full stop-on-app-exit lifecycle is a TODO
# (see memory neutron-ipcbroker-lifecycle-collider).
ADOBE_DAEMONS = [
    _common_adobe("Adobe Desktop Common", "ADS", "Adobe Desktop Service.exe"),
    _common_adobe("Adobe Desktop Common", "IPCBox", "AdobeIPCBroker.exe"),
]


def _start_adobe_daemons(prefix, wine, env, daemons):
    """Start the Adobe RPC/IPC services (detached) if their exes exist. They are
    singletons (mutex-guarded), so a duplicate start self-exits — safe to call
    unconditionally on a freshly-torn-down prefix."""
    started = []
    for sub in daemons:
        exe = os.path.join(prefix, sub)
        if not os.path.isfile(exe):
            continue
        try:
            subprocess.Popen([wine, exe], env=env,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            started.append(os.path.basename(exe))
        except Exception:
            pass
    if started:
        log("started Adobe daemons: " + ", ".join(started))
    return started


def _resolve_app_exe(prefix, exe_rel):
    """Resolve a profile's (version-locked) exe subpath to an absolute path,
    version-agnostically. Adobe bumps the folder year each release (…2025 → 2026 …)
    but the per-app fixes are the same, so a profile shouldn't need editing per
    version. Try the literal path first (fast; keeps a pinned path working);
    otherwise replace a 4-digit year in the 'Adobe <App> <year>' segment with a
    glob and return the highest-versioned match that exists. Falls back to the
    literal path if nothing globs, so callers still get a sensible path to report."""
    import re
    if not prefix:
        return ""
    literal = os.path.join(prefix, exe_rel)
    if os.path.isfile(literal):
        return literal
    pat_rel = re.sub(r'(?<!\d)(?:19|20)\d{2}(?!\d)', '*', exe_rel, count=1)
    if pat_rel == exe_rel:
        return literal  # no version segment to generalize
    hits = [h for h in glob.glob(os.path.join(prefix, pat_rel)) if os.path.isfile(h)]
    if not hits:
        return literal
    def _year(h):
        yrs = re.findall(r'(?:19|20)\d{2}', h)
        return max((int(y) for y in yrs), default=0)
    return max(hits, key=_year)

