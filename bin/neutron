# --- Neutron-owned wine runtime (Phase 1 of the Proton-style owned runtime) -----
# The CLI must NOT depend on the host's wine; it runs Neutron's PATCHED wine (the
# X11 frame pacer + the winewayland fractional-scale fix). Resolution order:
#   1. $NEUTRON_WINE   2. a packaged dist path   3. the dev build tree
#   4. system 'wine' (last-resort fallback; patches NOT present -> warn).
# Phase 2/3 replace the dev build tree with a versioned, bundled runtime.
# The neutron-wine release the engine expects, and where `runtime install`
# unpacks it. A downloaded runtime lands at
#   <NEUTRON_RUNTIMES_DIR>/neutron-wine-<version>/  (has bin/wine, self-stamps
#   NEUTRON_WINE_VERSION at its root) and is resolved ahead of any dev build tree.
NEUTRON_WINE_REPO = os.environ.get("NEUTRON_WINE_REPO", "Nico-LaFoucate/neutron-wine")
NEUTRON_WINE_VERSION = os.environ.get("NEUTRON_WINE_VERSION", "11.10-63")
NEUTRON_RUNTIMES_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local", "share")),
    "neutron", "runtimes")

# Where `neutron launch --json` writes each app's wine log. Sibling of runtimes so
