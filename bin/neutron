# --- small helpers ---------------------------------------------------------

def log(msg):
    """Human-readable log -> stderr (never pollutes the JSON on stdout)."""
    print(f"[neutron] {msg}", file=sys.stderr)


def event(args, **kw):
    """Emit one newline-delimited progress event, when the caller asked for a stream.

    Shape matches Mud Hut's NDJSON contract so Collider can consume both with the same reader:
      {"event": "progress", "stage": <str>, "pct": <0-100>, "msg": <str>}
      {"event": "note",     "msg": <str>}
    The terminal object is emitted by emit() and carries "event": "result".

    Silent unless BOTH --json and --progress: a long operation's steps are useless noise in human
    mode, and streaming unconditionally would corrupt Mud Hut's stream (see --progress help)."""
    if getattr(args, "progress", False) and getattr(args, "json", False):
        sys.stdout.write(json.dumps(kw) + "\n")
        sys.stdout.flush()


def emit(obj, as_json, streaming=False):
    """Emit the result. JSON object to stdout in --json mode."""
    if as_json:
        # A streamed run's consumer scans for the terminal event; tag it so it is unambiguous
        # among the progress lines that preceded it.
        if streaming:
            obj = {"event": "result", **obj}
        print(json.dumps(obj))
    else:
        # Human mode: a compact readable rendering, still on stdout.
        for k, v in obj.items():
            print(f"{k}: {v}")


def die(obj, code, as_json):
    """Emit a structured error and exit with a meaningful code."""
    obj.setdefault("ok", False)
    obj.setdefault("error_code", code)
    emit(obj, as_json)
    sys.exit(code)


def premiere_is_running(prefix):
    """True if Premiere is alive IN THIS PREFIX (its pref edits are unsafe then).

    ⛔ Matches the EXECUTABLE, never the command line. This used to be
    `pgrep -f "Adobe Premiere"`, which matches any process whose full cmdline merely CONTAINS
    that string — a terminal sitting in the install folder, a file manager, an editor with the
    path open, or the very shell running this check. A false positive made
    `prefix apply-display-fix` return exit 3 "Premiere is running; cannot edit prefs", which
    (before the display fix was made best-effort) aborted the launch of every app in the prefix.
    Same self-match trap as `_prefix_procs`, which documents the rule.

    🚨 2026-09-18: it then scanned ALL of /proc with no prefix check. With Premiere 2025 running
    from ~/.premiere2025, `prefix apply-display-fix ~/Neutron-Prefixes/Adobe2026` refused with
    exit 3 for a prefix in which nothing was running -- so Collider's per-launch display fix was
    skipped for the 2026 suite for as long as the 2025 one was open. Same class as
    `_app_running_pid`: per-app where it must be per-app-PER-PREFIX. Now answered by
    `_app_procs`: `WINEPREFIX=<prefix>` as a whole environ entry AND the app's install-directory
    token in cmdline[0]. Validated against a synthetic known-bad in tests/test_identity.py."""
    return bool(_app_procs(prefix, "premiere"))


def collider_selected_prefix():
    """The prefix Collider is pointed at, from ~/.config/collider/config.json.

    One link in default_prefix()'s chain. This used to be the ONLY defence against a hardcoded
    `$HOME/.premiere2025`, and it never got a chance to run because every argparse default was
    pre-filled with that path. Testers following our own documented command --
    `neutron launch premiere > pp.log` -- got `invalid prefix` and could produce no log at all, so
    a build-test bug went two rounds with no diagnostics (2026-08-08). Removed for good 2026-08-25."""
    try:
        with open(os.path.join(collider_config_dir(), "config.json"),
                  encoding="utf-8") as f:
            sel = json.load(f).get("selected_prefix")
        if sel and os.path.isdir(os.path.join(sel, "drive_c")):
            return sel
    except Exception:
        pass
    return None


# Directories never worth descending into looking for a prefix: huge, or guaranteed not to hold
# one. Keeps the two-level scan cheap enough to run on every command.
_DISCOVER_SKIP = {
    ".cache", ".git", ".local", ".config", ".mozilla", ".npm", ".nvm", ".rustup", ".cargo",
    ".steam", ".var", "node_modules", "snap", ".gradle", ".m2", ".thunderbird", ".pki",
    "Downloads", "Music", "Pictures", "Videos", ".android", ".docker", ".vscode",
}
_DISCOVER_MAX_DIRS = 4000       # hard stop; a pathological home must not make the CLI feel slow


def discover_prefixes():
    """Every wine prefix we can see, newest-first. A prefix is a dir containing `drive_c`.

    Scans each root **two levels deep**. One level was not enough: the build tester keeps their
    prefix at `~/Neutron/Adobe`, so its parent is `~/Neutron` rather than `$HOME`, and discovery
    returned **[]** on a machine with a perfectly good prefix sitting in it (2026-08-26). That is
    a natural way to organise -- a folder named for the tool, holding its prefixes -- and Mud Hut
    imposes no layout of its own, so it is a user choice other users will repeat.

    ⭐ Vindicated again 2026-09-14: the operator's own prefix sits at `~/Neutron-Prefixes/Adobe2026`
    and THIS scan found it, while Collider's `discover()` -- one level under each of a fixed root
    list -- could not, because the parent directory was not one of its roots. The two resolvers
    disagreed and only this one was right. Keep the depth; when in doubt, scan wider here rather
    than adding another special-cased root.

    ⚠️ It was fully masked by Collider's selection resolving first, which made
    `~/.config/collider/config.json` a single point of failure for prefix resolution: absent,
    reset or corrupt, and every command without `--prefix` answered "no wine prefix found" with
    an empty candidate list -- accurate, well-explained, and still wrong. The third resolution
    tier was dead code on that layout. Found by the tester asking discovery directly rather than
    trusting that the tier it never reaches works.
    """
    seen, out, budget = set(), [], _DISCOVER_MAX_DIRS
    # ⭐ `Neutron-Prefixes` is Collider's default parent for a new prefix since 2026-09-14
    # (it was `Neutron`, which differs from the engine's own directory only by case — see
    # Collider `core/prefixes.rs`). Both are reachable via the two-level scan of HOME below,
    # so they are not listed as roots; named here so the connection is findable from this side.
    roots = [HOME, os.path.join(HOME, "Games"), os.path.join(DATA_HOME, "wineprefixes")]
    env = os.environ.get("WINEPREFIX")
    if env:
        roots.insert(0, os.path.dirname(os.path.abspath(os.path.expanduser(env))))

    def consider(d):
        if d in seen or not os.path.isdir(os.path.join(d, "drive_c")):
            return False
        seen.add(d)
        out.append(d)
        return True

    for root in roots:
        if not os.path.isdir(root):
            continue
        try:
            entries = sorted(os.listdir(root))
        except OSError:
            continue
        for name in entries:
            if budget <= 0:
                break
            budget -= 1
            d = os.path.join(root, name)
            if not os.path.isdir(d):
                continue
            # A prefix itself is never descended into -- drive_c holds thousands of dirs.
            if consider(d) or name in _DISCOVER_SKIP:
                continue
            try:
                children = sorted(os.listdir(d))
            except OSError:
                continue
            for sub in children:
                if budget <= 0:
                    break
                budget -= 1
                consider(os.path.join(d, sub))
    out.sort(key=lambda d: os.path.getmtime(d), reverse=True)
    return out


NEUTRON_PREFIXES_JSON = os.path.join(NEUTRON_DATA_DIR, "prefixes.json")


def remember_prefix(prefix):
    """Record a prefix `prefix provision` was run on: that is what makes it a Neutron prefix."""
    p = os.path.realpath(prefix)
    known = _recorded_prefixes()
    if p in known:
        return
    try:
        os.makedirs(NEUTRON_DATA_DIR, exist_ok=True)
        tmp = NEUTRON_PREFIXES_JSON + ".part"
        with open(tmp, "w") as f:
            json.dump({"prefixes": known + [p]}, f, indent=1)
        os.replace(tmp, NEUTRON_PREFIXES_JSON)
    except OSError as e:
        log(f"could not record prefix {p}: {e}")


def _recorded_prefixes():
    try:
        with open(NEUTRON_PREFIXES_JSON) as f:
            return [p for p in json.load(f).get("prefixes", []) if isinstance(p, str)]
    except (OSError, ValueError, AttributeError):
        return []


def neutron_prefixes():
    """Neutron's own prefixes: the ones `prefix provision` recorded, plus any prefix a Neutron menu
    entry launches (prefixes provisioned before the record existed).

    ⛔ `update` and `uninstall --delete-prefixes` act on THIS list, never on discover_prefixes():
    discovery returns every directory holding a `drive_c`, which on a real machine includes
    `~/.wine`, Proton/umu and Lutris prefixes, and copies kept as backups. `update` once
    re-provisioned all of them with neutron-wine, and uninstall would have deleted them."""
    out, seen = [], set()
    cands = list(_recorded_prefixes())
    for entry in sorted(glob.glob(os.path.join(APPS_DIR, "neutron-*.desktop"))):
        try:
            with open(entry, encoding="utf-8", errors="replace") as f:
                for line in f:
                    if line.startswith("Exec="):
                        toks = line.split()
                        cands += [toks[i + 1] for i, t in enumerate(toks[:-1]) if t == "--prefix"]
        except OSError:
            continue
    for p in cands:
        r = os.path.realpath(p)
        if r not in seen and os.path.isdir(os.path.join(r, "drive_c")):
            seen.add(r)
            out.append(r)
    return out


def mudhut_busy(prefix):
    """Mud Hut is installing, updating or rolling back Adobe apps in this prefix: its
    `in_progress` record ({pid, command, apps, stage, ...}), else None.

    The authority is the flock on `<prefix>/.mudhut/lock`, held by the running Mud Hut for the
    whole job and dropped by the kernel when it exits, so a crash never leaves a stale lock.
    Opened read-only and never created: a prefix Mud Hut never touched has no `.mudhut`."""
    import fcntl
    path = os.path.join(prefix, ".mudhut", "lock")
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            info = {}
            try:
                with open(os.path.join(prefix, ".mudhut", "state.json")) as f:
                    info = json.load(f).get("in_progress") or {}
            except (OSError, ValueError, AttributeError):
                pass
            return info or {"command": "update"}
        fcntl.flock(fd, fcntl.LOCK_UN)
        return None
    finally:
        os.close(fd)


def _mudhut_busy_sentence(info):
    """'Adobe apps in this prefix are being updated (Photoshop). ...' for launch's refusal."""
    names = [APP_PROFILES.get(a, {}).get("name", a).replace(" (experimental)", "") for a in (info.get("apps") or [])]
    what = {"install": "installed", "rollback": "put back to an earlier version"}.get(info.get("command"), "updated")
    return ("Adobe apps in this prefix are being %s%s. Wait for that to finish, then open the app again."
            % (what, " (%s)" % ", ".join(names) if names else ""))


def cmd_prefix_list(args):
    """`neutron --json prefix list`: Neutron's own prefixes (the ones `prefix provision` recorded,
    plus any prefix a Neutron menu entry launches), the one list `update` acts on. Mud Hut's
    `check-updates --all-prefixes` reads this, so there is one authority for the prefix list."""
    out, seen = [], set()
    recorded = set(os.path.realpath(p) for p in _recorded_prefixes())
    cands = list(_recorded_prefixes())
    menu = {}
    for entry in sorted(glob.glob(os.path.join(APPS_DIR, "neutron-*.desktop"))):
        try:
            with open(entry, encoding="utf-8", errors="replace") as f:
                for line in f:
                    if line.startswith("Exec="):
                        toks = line.split()
                        for i, t in enumerate(toks[:-1]):
                            if t == "--prefix":
                                cands.append(toks[i + 1])
                                r = os.path.realpath(toks[i + 1])
                                menu[r] = menu.get(r, 0) + 1
        except OSError:
            continue
    for p in cands:
        r = os.path.realpath(p)
        if r in seen:
            continue
        seen.add(r)
        busy = mudhut_busy(r) if os.path.isdir(r) else None
        out.append({"path": r, "valid": os.path.isdir(os.path.join(r, "drive_c")),
                    "recorded": r in recorded, "menu_entries": menu.get(r, 0),
                    "mudhut_busy": busy is not None})
    if args.json:
        emit({"ok": True, "prefixes": out}, True)
    else:
        for e in out:
            print("%s%s" % (e["path"], "" if e["valid"] else "  (missing)"))
    return EX_OK


def default_prefix():
    """The prefix to use when the caller did not name one.

    ⛔ THERE IS NO HARDCODED PREFIX NAME. `$HOME/.premiere2025` is one developer's directory, and
    baking it in as the default has burned the build tester repeatedly: our own documented
    commands (`neutron launch premiere > pp.log`) answered `invalid prefix` on their machine, so a
    build-test bug went two rounds with no diagnostics at all (2026-08-08) — and it kept coming
    back because the fix was added as a *helper* while every argparse default still pointed at the
    hardcoded path and short-circuited it.

    Resolution order, most explicit first:
      1. `$WINEPREFIX`                     — the caller said so
      2. Collider's selected prefix        — the GUI's current choice
      3. discovery, if UNAMBIGUOUS         — exactly one prefix on the machine

    Ambiguity is not resolved by guessing: with several candidates and no selection, return None
    so the caller can fail with the list. A wrong prefix silently provisions or tears down the
    wrong installation.
    """
    env = os.environ.get("WINEPREFIX")
    if env:
        p = os.path.abspath(os.path.expanduser(env))
        if os.path.isdir(os.path.join(p, "drive_c")):
            return p
    sel = collider_selected_prefix()
    if sel:
        return sel
    found = discover_prefixes()
    if len(found) == 1:
        return found[0]
    return None


def bad_prefix_reason(given):
    """Why we have no prefix, and what the caller can do — never a bare "invalid prefix".

    A tester following our own documented command hit exactly that message, with no indication
    that a prefix even had to be chosen, and produced no diagnostics for two rounds. If we cannot
    resolve one, the error must carry the candidates."""
    if given:
        return {"reason": "invalid prefix (no drive_c): %s" % given}
    found = discover_prefixes()
    if not found:
        return {"reason": "no wine prefix found",
                "hint": "pass one explicitly, set $WINEPREFIX, or select one in Collider",
                "candidates": []}
    return {"reason": "several wine prefixes found and none selected — refusing to guess",
            "hint": "pass the path, set $WINEPREFIX, or pick one in Collider "
                    "(a wrong prefix would provision or tear down the wrong installation)",
            "candidates": found[:10]}


def resolve_prefix(path):
    """Validate a prefix path; return the absolute, real path or None.

    With no path, falls back to default_prefix() — never to a hardcoded name."""
    if not path:
        path = default_prefix()
    if not path:
        return None
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(os.path.join(p, "drive_c")):
        return None
    return p


def prefix_user(prefix):
    """The in-prefix Wine username (the dir under drive_c/users that isn't Public)."""
    users_dir = os.path.join(prefix, "drive_c", "users")
    if not os.path.isdir(users_dir):
        return None
    candidates = [
        d for d in os.listdir(users_dir)
        if d != "Public" and os.path.isdir(os.path.join(users_dir, d))
    ]
    if not candidates:
        return None
    # Prefer the Linux $USER if present, else the first real user dir.
    linux_user = os.environ.get("USER")
    if linux_user in candidates:
        return linux_user
    return candidates[0]


def documents_paths(prefix, user):
    """Return (symlink_path, real_path) for the in-prefix Documents dir.

    real_path is the symlink-resolved target — the canonical real Documents dir.
    This encodes the symlink lesson so Collider never computes paths itself.
    """
    link = os.path.join(prefix, "drive_c", "users", user, "Documents")
    real = os.path.realpath(link) if os.path.exists(link) else None
    return link, real


def find_debug_database(prefix, user):
    """Locate the LIVE Debug Database.txt (the pref file apply-display-fix writes).

    Globs the versioned Premiere Pro dir; excludes the .bak copy and the
    Team Projects Local Hub copy, which are not the live prefs.
    """
    base = os.path.join(
        prefix, "drive_c", "users", user, "AppData", "Roaming", "Adobe"
    )
    hits = glob.glob(os.path.join(base, "Premiere Pro", "*", "Debug Database.txt"))
    # Exclude non-live copies defensively (glob above already avoids .bak,
    # but be explicit in case of odd layouts).
    hits = [h for h in hits if ".bak" not in h and "Team Projects" not in h]
    if not hits:
        return None
    # If multiple version dirs exist, pick the highest version number.
    def vkey(p):
        ver = os.path.basename(os.path.dirname(p))
        try:
            return tuple(int(x) for x in ver.split("."))
        except ValueError:
            return (0,)
    hits.sort(key=vkey, reverse=True)
    return hits[0]


def find_debug_databases(prefix, user):
    """Every DVA app's live Debug Database.txt, plus whether that app is installed.

    Returns a list of (label, path_or_None, installed). `path` is None when the app has
    never been run (Adobe writes this file itself on a clean exit) or is not installed.
    See DISPLAY_FIX_APPS for why this is not Premiere-only.
    """
    base = os.path.join(prefix, "drive_c", "users", user, "AppData", "Roaming", "Adobe")
    appsdir = os.path.join(prefix, "drive_c", "Program Files", "Adobe")
    out = []
    for label, subdir, instglob in DISPLAY_FIX_APPS:
        installed = bool(glob.glob(os.path.join(appsdir, instglob)))
        hits = glob.glob(os.path.join(base, subdir, "*", "Debug Database.txt"))
        hits = [h for h in hits if ".bak" not in h and "Team Projects" not in h]

        # 🚨 Pick the REAL database, not the highest version number.
        #
        # After Effects 2026 keeps TWO: the genuine one at 26.0 (184 keys, carrying
        # AEDebugDatabaseVersion) and a 3-line stub at 26.3. Sorting by version
        # descending picked the STUB, so `apply-display-fix` wrote
        # DS.DisableDirectXDisplay into a file AE never reads -- and AE 2026's
        # composition panel stayed black while 2025's worked. 2025 was right only
        # by luck: it has a single database (25.0), so there was nothing to choose
        # between. Collider re-applies this on every launch, so the fix was being
        # written to the wrong file over and over.
        #
        # Rank: has the AEDebugDatabaseVersion marker > more keys > higher version.
        def rank(p):
            try:
                with open(p, "rb") as f:
                    raw = f.read()
            except OSError:
                raw = b""
            real = b"AEDebugDatabaseVersion" in raw
            keys = raw.count(b"\n")
            ver = os.path.basename(os.path.dirname(p))
            try:
                v = tuple(int(x) for x in ver.split("."))
            except ValueError:
                v = (0,)
            return (real, keys, v)

        hits.sort(key=rank, reverse=True)
        out.append((label, hits[0] if hits else None, installed))
    return out


def _display_fix_pref_dir(prefix, user, label):
    """Versioned prefs dir for an app that has never written a Debug Database.

    Prefers a version dir the app has already created (it usually writes other prefs before
    it ever writes this one); falls back to deriving it from the install directory's year,
    which is how Adobe names these (Adobe Media Encoder 2025 -> 25.0). None if undecidable.
    """
    entry = next((e for e in DISPLAY_FIX_APPS if e[0] == label), None)
    if not entry:
        return None
    _, subdir, instglob = entry
    base = os.path.join(prefix, "drive_c", "users", user, "AppData", "Roaming", "Adobe", subdir)
    existing = [d for d in glob.glob(os.path.join(base, "*")) if os.path.isdir(d)]
    if existing:
        def vkey(p):
            try:
                return tuple(int(x) for x in os.path.basename(p).split("."))
            except ValueError:
                return (0,)
        existing.sort(key=vkey, reverse=True)
        return existing[0]
    inst = glob.glob(os.path.join(prefix, "drive_c", "Program Files", "Adobe", instglob))
    for d in inst:
        m = re.search(r"\b(20\d\d)\b", os.path.basename(d))
        if m:
            return os.path.join(base, f"{int(m.group(1)) - 2000}.0")
    return None


def _apply_display_fix_to(dbg, want=DISPLAY_FIX_CURRENT):
    """Set DISPLAY_FIX_KEY to `want` in one Debug Database, preserving every other byte.

    Returns "already" | "changed". Raises OSError on read/write failure.
    Adobe writes these lines as key\\tcurrent\\tdefault terminated by CR CR LF; we write a
    single CRLF, which the apps accept and rewrite in their own style on a clean exit.
    """
    with open(dbg, "r", encoding="utf-8", errors="replace", newline="") as f:
        raw = f.read()
    if _display_fix_matches(raw, want):
        return "already"
    new_line = f"{DISPLAY_FIX_KEY}\t{want}\t{DISPLAY_FIX_DEFAULT}\r\n"
    out_lines, found = [], False
    for ln in raw.splitlines(keepends=True):
        if ln.lstrip("﻿").startswith(DISPLAY_FIX_KEY + "\t"):
            found = True
            out_lines.append(new_line)   # replace ONLY this line
        else:
            out_lines.append(ln)         # preserve byte-for-byte
    if not found:
        if out_lines and not out_lines[-1].endswith(("\n", "\r")):
            out_lines[-1] = out_lines[-1] + "\r\n"
        out_lines.append(new_line)
    with open(dbg, "w", encoding="utf-8", newline="") as f:
        f.write("".join(out_lines))
    return "changed"


def have(cmd):
    return shutil.which(cmd) is not None


def resolve_wine():
    """The Neutron-owned wine binary. Returns (path, is_neutron).

    ⛔ Never falls back to the system's wine. A distro wine boots a prefix with a different
    stamp and `wineboot -u` reverts every patched native; Mud Hut asks `runtime which` and would
    build a brand-new prefix on it. No Neutron runtime => (None, False), and callers refuse with
    NO_RUNTIME_MSG."""
    for c in NEUTRON_WINE_CANDIDATES:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c, True
    return None, False


def _prefix_stamp(prefix):
    """The runtime stamp a prefix is currently booted onto, or None.

    Wine writes its `share/wine/wine.inf` mtime into `<prefix>/.update-timestamp` at wineboot and
    compares the two on every launch: DIFFERENT stamp => it runs `wineboot -u`. That update is
    what reverts our patched natives (dwrite/dcomp/dxcore) and reads as a mass regression with no
    code change behind it.

    ⚠️ The stamp file is CRLF. A naive read keeps the \\r and never matches.
    """
    try:
        with open(os.path.join(prefix, ".update-timestamp")) as f:
            digits = "".join(c for c in f.read() if c.isdigit())
        return int(digits) if digits else None
    except (OSError, ValueError):
        return None


def _prefix_file_problems(prefix):
    """What is wrong with the files Wine keeps at the top of a prefix, as sentences; [] when nothing.

    GitHub Neutron#29: system.reg, user.reg and .update-timestamp could not be read while drive_c
    read fine, and `doctor` said healthy -- every check that reads those files took OSError as
    "cannot tell" and passed. Wine cannot run such a prefix, Collider could not resolve it and Mud
    Hut said its runtime was "not installed". This names each file, who owns it, and the fix.
    A missing .update-timestamp counts too: Neutron's provision always writes it, so a prefix
    without one never finished booting and `prefix provision` is the fix."""
    import pwd

    def owner(uid):
        try:
            return pwd.getpwuid(uid).pw_name
        except KeyError:
            return "user id %d" % uid

    me = os.getuid()
    out, foreign, perms, missing = [], set(), False, False
    try:
        st = os.stat(prefix)
        if st.st_uid != me:
            foreign.add(owner(st.st_uid))
            out.append("the prefix folder belongs to %s, and Wine refuses to run in a prefix that "
                       "is not yours" % owner(st.st_uid))
    except OSError as e:
        out.append("the prefix folder cannot be checked (%s)" % e.strerror)
    for name in ("system.reg", "user.reg", ".update-timestamp"):
        path = os.path.join(prefix, name)
        try:
            st = os.stat(path)
        except FileNotFoundError:
            missing = True
            out.append("%s is missing" % name)
            continue
        except OSError as e:
            out.append("%s cannot be checked (%s)" % (name, e.strerror))
            continue
        cannot = ("" if os.access(path, os.R_OK | os.W_OK) else
                  "write" if os.access(path, os.R_OK) else "read")
        if st.st_uid != me:
            foreign.add(owner(st.st_uid))
            out.append("%s belongs to %s" % (name, owner(st.st_uid))
                       + (", and you can't %s it" % cannot if cannot else ""))
        elif cannot:
            perms = True
            out.append("%s: its permissions don't let you %s it" % (name, cannot))
    if foreign:
        out.append("files owned by %s usually come from running a Neutron step with sudo. Give the "
                   "prefix back to yourself with `sudo chown -R %s: %s`, and run Neutron without sudo"
                   % (" and ".join(sorted(foreign)), owner(me), prefix))
    if perms:
        out.append("`chmod u+rw` on those files makes them readable and writable for you again")
    if missing:
        out.append("`neutron prefix provision %s` recreates what is missing" % prefix)
    return out


def _runtime_stamp(wine_path):
    """The stamp a given wine would impose on a prefix (its wine.inf mtime), or None."""
    if not wine_path:
        return None
    root = os.path.dirname(os.path.dirname(os.path.realpath(wine_path)))
    try:
        return int(os.path.getmtime(os.path.join(root, "share", "wine", "wine.inf")))
    except OSError:
        return None


def _runtimes_matching_stamp(stamp):
    """Installed runtime versions whose wine.inf mtime equals `stamp`.

    ⚠️ Deliberately a LIST, not a single answer. We pin wine.inf mtimes across releases on purpose
    so that a prefix does not re-stamp, which means several runtimes routinely share one stamp
    (11.10-45/58/59/60/62 all did). Resolving a runtime FROM the stamp therefore cannot be trusted
    to pick the newest -- `adobe-smoke.sh` did exactly that and silently launched Animate on
    11.10-23, voiding the test. So this is used to EXPLAIN a mismatch, never to choose.
    """
    out = []
    try:
        names = sorted(os.listdir(NEUTRON_RUNTIMES_DIR))
    except OSError:
        return out
    for name in names:
        if not name.startswith("neutron-wine-"):
            continue
        inf = os.path.join(NEUTRON_RUNTIMES_DIR, name, "share", "wine", "wine.inf")
        try:
            if int(os.path.getmtime(inf)) == stamp:
                out.append(name[len("neutron-wine-"):])
        except OSError:
            continue
    return out


def stamp_mismatch(prefix, wine_path):
    r"""None if this wine can launch into this prefix without re-stamping it; else an explanation.

    🚨 THIS IS THE CLOBBER, MADE LOUD. Launching a prefix on a different-stamp runtime fires
    `wineboot -u` and reverts the patched natives. It has happened repeatedly and has never once
    announced itself -- the user sees seven apps regress at once and goes looking for a code
    change that does not exist (2026-07-19, 2026-07-29/30, and again 2026-08-25 when generated
    .desktop entries shipped unpinned for a few hours).

    Predicted independently by the build tester 2026-08-25 as the next occurrence: install a newer
    runtime, the wrapper's default moves, the prefix stays stamped to the old one, and every
    launch surface that is not an explicitly pinned .desktop entry clobbers the prefix.

    ⛔ Both values must be READABLE before we complain. A prefix with no stamp is a prefix that has
    never been booted, and refusing to launch it would be inventing a problem -- the same
    "render unknown as an answer" mistake that put "X11" in Collider's UI on a Wayland session.
    Failing open also happens to be exactly right for wine's own opt-out: a `.update-timestamp`
    containing the word `disable` turns wine's update check off permanently
    (`programs/wineboot/wineboot.c:update_timestamp`). That file has no digits, so we read None and
    stay quiet -- which is correct, because wine will not re-stamp such a prefix either.

    ⭐ WHERE THE CLOBBER CAN ACTUALLY HAPPEN, read out of wine's source 2026-08-26 rather than
    guessed (the build tester asked, and the honest answer needed the code, not an experiment on
    the only working installation):
      * `wine <prog>` with no wine parent -> `build_initial_params()` -> `run_wineboot()`
        UNCONDITIONALLY (`dlls/ntdll/unix/env.c`).
      * `run_wineboot()` first does `NtCreateEvent(\KernelObjects\__wineboot_event, OBJ_OPENIF)`.
        If that event ALREADY EXISTS it jumps straight to `wait` and **never launches
        wineboot.exe**.
      * wineboot creates that event with `OBJ_INHERIT` "to be inherited by services.exe", and
        services.exe lives as long as the wine session.
      * Only wineboot.exe compares `.update-timestamp` and reinstalls wine.inf.
    => **A prefix can only be re-stamped by the FIRST wine process into a COLD prefix.** Once a
    session is up, no later `wine` invocation can clobber it. That makes `launch` (cold) and
    `provision` (deliberate) the complete set of entry points, which is exactly where the
    handling is.
    """
    want = _prefix_stamp(prefix)
    have = _runtime_stamp(wine_path)
    if want is None or have is None or want == have:
        return None
    return {"prefix_stamp": want, "runtime_stamp": have,
            "runtime": os.path.dirname(os.path.dirname(os.path.realpath(wine_path))),
            "prefix_runtimes": _runtimes_matching_stamp(want)}


def resolve_runtime():
    """A development DLL bundle named by $NEUTRON_RUNTIME (has overrides.json + dlls/), or None.
    Releases never use one: see NEUTRON_RUNTIME_BUNDLE."""
    c = NEUTRON_RUNTIME_BUNDLE
    if c and os.path.isdir(c) and os.path.isfile(os.path.join(c, "overrides.json")):
        return c
    return None


def runtime_root(wine):
    """<runtime> for <runtime>/bin/wine."""
    return os.path.dirname(os.path.dirname(os.path.realpath(wine)))


def _sha256_file(path):
    """Content digest. Used to report which staged builtins actually changed --
    ⛔ never compare sizes for this: two different builds of the same DLL routinely
    come out byte-for-byte the same LENGTH."""
    import hashlib
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
    except OSError:
        return None
    return h.hexdigest()


def _is_wine_builtin(path):
    """True if `path` is a Wine-BUILT PE. Wine stamps every builtin it compiles with
    "Wine builtin DLL" in the DOS stub, so this is provenance, not a guess -- and the
    guess is what there was before: `runtime/dlls/` mixes DXVK, vkd3d-proton, Microsoft's
    real VC++ redist and our own wine builtins under names that collide with Wine's
    (d3d11, dxgi, msvcp140, msxml3 ...). Staging the wrong one either downgrades a fix or
    replaces a third-party native with a Wine stub; both look like a mass regression.
    ⛔ Do NOT substitute a name/size test. `msvcp140_2.dll` in the current bundle is
    byte-different from 11.10-61's and EXACTLY the same size (61709). """
    try:
        with open(path, "rb") as f:
            return b"Wine builtin DLL" in f.read(512)
    except OSError:
        return False


def session_is_wayland():
    """Is there a real Wayland session to render into?

    🚨 THE TEST IS THE SOCKET, not two environment variables agreeing. This used to require
    BOTH `XDG_SESSION_TYPE == "wayland"` AND `WAYLAND_DISPLAY`, and a launch that failed it fell
    through to the X11 branch -- which writes `Graphics=x11` into the PREFIX and turns on the
    software frame pacer. That is a persistent, app-visible change to the user's installation,
    made silently, on the strength of an environment variable being absent.

    It matters because launch surfaces do not share an environment. Collider inherits the login
    session's; a `.desktop` launch inherits the **systemd user manager's**, which is populated by
    whatever the desktop imported at start-up. `XDG_SESSION_TYPE` is present there on the dev box
    and is NOT guaranteed to be -- it comes from PAM/the session, not from the compositor. So the
    same machine could run Wayland from Collider and X11 from the application menu, flip-flopping
    the prefix's graphics driver on every launch.

    ⛔ X11 is a HARD NEVER on this project. A missing variable must not be able to
    select it. `$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY` existing is direct evidence a compositor is
    there; `XDG_SESSION_TYPE` is corroboration, never a veto.
    """
    disp = os.environ.get("WAYLAND_DISPLAY")
    if disp:
        if disp.startswith("/"):          # absolute path form
            return os.path.exists(disp)
        rt = os.environ.get("XDG_RUNTIME_DIR")
        if rt and os.path.exists(os.path.join(rt, disp)):
            return True
        # No XDG_RUNTIME_DIR to check against: trust the variable rather than
        # downgrade the prefix to X11 on a technicality.
        return True
    return os.environ.get("XDG_SESSION_TYPE") == "wayland"


def reg_set(wine, prefix, key, name, vtype, data):
    """Best-effort registry write via the Neutron wine. Shared-prefix safe: uses
    the prefix's existing wineserver, never kills it, and only affects newly
    started processes (so it can't disturb an already-running suite app)."""
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")   # reg.exe needs a driver to init (Xwayland ok)
        subprocess.run([wine, "reg", "add", key, "/v", name, "/t", vtype, "/d", data, "/f"],
                       env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=30)
    except Exception as e:
        log(f"reg set {key}\\{name} failed (non-fatal): {e}")


def wineserver_wait(wine, prefix, timeout=240):
    """Block until the prefix's wineserver quiesces, so pending registry/file
    writes are flushed to disk. wineboot/reg.exe detach work onto the server and
    return early; without this the .reg files aren't updated yet. Best-effort."""
    srv = os.path.join(os.path.dirname(wine), "wineserver")
    if not os.path.isfile(srv):
        srv = shutil.which("wineserver") or "wineserver"
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")
        subprocess.run([srv, "-w"], env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=timeout)
        return True
    except subprocess.TimeoutExpired:
        log(f"wineserver -w: still running after {timeout}s; registry files may lag")
        return False
    except Exception as e:
        log(f"wineserver -w failed (non-fatal): {e}")
        return False


def resolve_webview2():
    """A development WebView2 tree named by $NEUTRON_WEBVIEW2 (has an
    Application/<version>/msedgewebview2.exe), copied into the prefix's
    'Program Files (x86)\\Microsoft\\EdgeWebView'; or one in a $NEUTRON_RUNTIME bundle. Else None."""
    rt = resolve_runtime()
    for c in (WEBVIEW2_DEV_SOURCE, rt and os.path.join(rt, "webview2")):
        if c and os.path.isdir(os.path.join(c, "Application")):
            return c
    return None


def _webview2_version(appdir):
    """Highest x.y.z.w version subdir under an EdgeWebView\\Application that
    actually contains msedgewebview2.exe, or None."""
    import re
    if not os.path.isdir(appdir):
        return None
    vers = [d for d in os.listdir(appdir)
            if re.match(r'^\d+\.\d+\.\d+\.\d+$', d)
            and os.path.isfile(os.path.join(appdir, d, "msedgewebview2.exe"))]
    return max(vers, key=lambda v: tuple(int(x) for x in v.split(".")), default=None)


def _adopt_adobe_webview2(prefix, app_dir):
    """Offline-installed prefixes: adopt the WebView2 runtime the ADOBE installer already put in the
    prefix, instead of demanding an external source dir we may not have.

    Adobe drops a complete runtime at
        Program Files\\Common Files\\Adobe\\Microsoft\\EdgeWebView\\
    but does NOT register it, and its layout is FLAT -- the DLLs sit directly in that directory with
    a sibling '<version>.manifest' naming the build, rather than the
    'Application/<version>/...' layout the loader expects. So the files are right there and the app
    still gets a blank sign-in / blank UXP panel purely because nothing points at them.

    We bridge it with a SYMLINK (Application/<version> -> Adobe's dir) rather than a copy: that tree
    is ~558 MB and duplicating it per prefix is pure waste. The link is RELATIVE, so a moved or
    renamed prefix keeps working; an absolute or dangling one (older CLIs wrote absolute links) is
    replaced. Returns the version, or None.

    Discovered the hard way: this had to be done by hand on ~/.premiere2025 during the Animate
    home-screen investigation, and every offline-installed prefix hits it."""
    adobe = os.path.join(prefix, "drive_c", "Program Files", "Common Files", "Adobe",
                         "Microsoft", "EdgeWebView")
    if not os.path.isdir(adobe):
        return None
    # version from '<version>.manifest'; fall back to a versioned subdir if the layout ever changes
    version = None
    try:
        for name in os.listdir(adobe):
            if name.endswith(".manifest") and name[:1].isdigit():
                version = name[: -len(".manifest")]
                break
    except OSError:
        return None
    if not version:
        return None
    # sanity: it must actually look like a runtime
    if not os.path.isfile(os.path.join(adobe, "msedgewebview2.exe")) and \
       not os.path.isfile(os.path.join(adobe, "WebView2Loader.dll")):
        log(f"webview2: Adobe copy at {adobe} has no loader/exe, not adopting")
        return None
    link = os.path.join(app_dir, version)
    rel = os.path.relpath(adobe, app_dir)
    try:
        os.makedirs(app_dir, exist_ok=True)
        if os.path.islink(link):
            if os.readlink(link) == rel:
                return version                  # already adopted; idempotent
            os.remove(link)                     # absolute (prefix may have moved) or dangling
        elif os.path.exists(link):
            return version                      # a real copy staged there; leave it
        os.symlink(rel, link)
    except OSError as e:
        log(f"webview2: could not adopt Adobe copy: {e}")
        return None
    log(f"webview2: adopted Adobe's in-prefix runtime {version} (symlink, no copy)")
    return version


def _webview2_fixed(as_json=True):
    """Microsoft's WebView2 Fixed Version runtime (x64), downloaded once into MICROSOFT_DIR and
    shared by every prefix. The fallback for a prefix whose Adobe install did not bring its own
    copy. Returns (version, dir), or (None, reason)."""
    import re, tempfile, urllib.error, urllib.request
    base = os.path.join(MICROSOFT_DIR, "webview2")
    vkey = lambda v: tuple(int(x) for x in v.split("."))
    have_v = []
    if os.path.isdir(base):
        have_v = [v for v in os.listdir(base) if re.fullmatch(r"\d+\.\d+\.\d+\.\d+", v)
                  and os.path.isfile(os.path.join(base, v, "msedgewebview2.exe"))]
    if have_v:
        v = max(have_v, key=vkey)
        return v, os.path.join(base, v)
    if not have("cabextract"):
        return None, "cabextract is not installed"
    cands = [WEBVIEW2_FIXED_PIN]
    try:   # the pin can age off Microsoft's servers; the download page lists what is current
        req = urllib.request.Request(WEBVIEW2_PAGE, headers={"User-Agent": "neutron-cli"})
        with urllib.request.urlopen(req, timeout=30) as r:
            page = r.read().decode("utf-8", "replace")
        # The list lives in the page's embedded Nuxt payload, a JSON array of strings.
        m = re.search(r'<script[^>]*id="__NUXT_DATA__"[^>]*>(.*?)</script>', page, re.S)
        found = {}
        for item in (json.loads(m.group(1)) if m else []):
            hit = isinstance(item, str) and re.fullmatch(
                r"https://msedge\.sf\.dl\.delivery\.mp\.microsoft\.com/\S+/"
                r"Microsoft\.WebView2\.FixedVersionRuntime\.(\d+\.\d+\.\d+\.\d+)\.x64\.cab", item)
            if hit:
                found[hit.group(1)] = item
        cands += sorted(found.items(), key=lambda kv: vkey(kv[0]), reverse=True)
    except (urllib.error.URLError, OSError, ValueError) as e:
        log(f"webview2: could not read Microsoft's download page ({e}); trying the pinned version")
    os.makedirs(base, exist_ok=True)
    last = "no download available"
    for v, url in cands:
        tmp = tempfile.mkdtemp(prefix=".wv2-", dir=base)
        try:
            cab = os.path.join(tmp, os.path.basename(url))
            if not as_json:
                log(f"downloading Microsoft WebView2 {v} (about 300 MiB)")
            _download(url, cab, as_json)
            subprocess.run(["cabextract", "-q", "-d", tmp, cab], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            os.remove(cab)
            tree = os.path.join(tmp, f"Microsoft.WebView2.FixedVersionRuntime.{v}.x64")
            if not os.path.isfile(os.path.join(tree, "msedgewebview2.exe")):
                raise RuntimeError("the download did not contain msedgewebview2.exe")
            os.replace(tree, os.path.join(base, v))
            return v, os.path.join(base, v)
        except (urllib.error.URLError, OSError, subprocess.CalledProcessError, RuntimeError) as e:
            last = f"{v}: {e}"
            log(f"webview2: {last}")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    return None, last


def register_webview2(wine, prefix, as_json=True):
    """Stage + register the WebView2 runtime so Adobe's in-app web sign-in (IMS)
    renders instead of a blank window. Idempotent. Returns (version, source), with
    version None if nothing could be staged (source then says why).

    The loader finds the runtime via HKLM ...\\EdgeUpdate\\Clients\\{GUID} "pv"
    + the standard path %ProgramFiles(x86)%\\Microsoft\\EdgeWebView\\Application\\
    <pv> — BOTH the files (at that path) and the key are required, and the key
    must exist in the 64-bit view AND Wow6432Node (the licensing helper is 32-bit).
    The Adobe installer's Common Files copy is NOT registered, hence blank sign-in."""
    ew = os.path.join(prefix, "drive_c", "Program Files (x86)", "Microsoft", "EdgeWebView")
    app = os.path.join(ew, "Application")
    # Adobe's own copy wins whenever it is there, even over a runtime staged earlier: only some
    # Adobe apps bring it (Illustrator's "UXP WebView Support"), so a prefix whose first app was
    # another one got Microsoft's fallback, and must move to Adobe's copy once it arrives.
    source = "adobe"
    version = _adopt_adobe_webview2(prefix, app)
    if version:
        fallback = os.path.realpath(os.path.join(MICROSOFT_DIR, "webview2"))
        for d in (os.listdir(app) if os.path.isdir(app) else []):
            pth = os.path.join(app, d)
            if d != version and os.path.islink(pth) and \
                    os.path.realpath(pth).startswith(fallback + os.sep):
                os.remove(pth)                  # our Microsoft fallback link, now superseded
    if not version:
        source = "prefix"
        version = _webview2_version(app)             # already staged?
    if not version and resolve_webview2():
        source = "dev"
        src = resolve_webview2()
        version = _webview2_version(os.path.join(src, "Application"))
        if version:
            try:
                os.makedirs(os.path.dirname(ew), exist_ok=True)
                shutil.copytree(src, ew, dirs_exist_ok=True)
            except OSError as e:
                log(f"webview2 stage failed: {e}")
                version = None
    if not version:
        source = "microsoft"
        version, where = _webview2_fixed(as_json)
        if not version:
            return None, where
        try:
            os.makedirs(app, exist_ok=True)
            link = os.path.join(app, version)
            if os.path.islink(link) and not os.path.exists(link):
                os.remove(link)                 # dangling (the shared copy moved); relink
            if not os.path.lexists(link):
                os.symlink(where, link)
        except OSError as e:
            return None, f"could not link WebView2 into the prefix: {e}"
        if int(version.split(".")[0]) not in WEBVIEW2_TESTED_MAJORS:
            log(f"⚠️  WebView2 {version} is untested under neutron-wine (tested: "
                + ", ".join(map(str, WEBVIEW2_TESTED_MAJORS)) + "). If Adobe's sign-in window stays "
                "blank, please report it.")
    # Register in both registry views so the 32-bit + 64-bit loaders find it.
    reg_import(wine, prefix, {
        rf"HKEY_LOCAL_MACHINE\{clients}\{WEBVIEW2_CLIENT_GUID}":
            {"name": "Microsoft Edge WebView2 Runtime", "pv": version}
        for clients in (r"Software\Microsoft\EdgeUpdate\Clients",
                        r"Software\Wow6432Node\Microsoft\EdgeUpdate\Clients")},
        tag="neutron-webview2")
    return version, source


def webview2_untested(version):
    return bool(version) and int(version.split(".")[0]) not in WEBVIEW2_TESTED_MAJORS


def _mono_gecko_versions(wine):
    """(mono, gecko) versions this runtime expects, read from the trees it ships in
    <runtime>/share/wine/{mono,gecko}; the constants only cover a runtime without them."""
    import re
    rt = runtime_root(wine) if wine else None
    mono, gecko = MONO_VERSION, GECKO_VERSION
    if rt:
        for sub, pat in (("mono", r"wine-mono-([\d.]+)$"), ("gecko", r"wine-gecko-([\d.]+)-x86$")):
            try:
                hits = [m.group(1) for m in (re.match(pat, n) for n in
                        os.listdir(os.path.join(rt, "share", "wine", sub))) if m]
            except OSError:
                hits = []
            if len(hits) == 1:
                mono, gecko = (hits[0], gecko) if sub == "mono" else (mono, hits[0])
    return mono, gecko


def _mono_bases(wine=None):
    """Where to look for the wine-mono tree: $NEUTRON_MONO, the runtime's own share/wine/mono,
    a $NEUTRON_RUNTIME bundle, then the host's /usr/share/wine/mono."""
    rt, bundle = (runtime_root(wine) if wine else None), resolve_runtime()
    return [MONO_CANDIDATES[0], rt and os.path.join(rt, "share", "wine", "mono"),
            bundle and os.path.join(bundle, "mono"), *MONO_CANDIDATES[1:]]


def _gecko_bases(wine=None):
    """Same order as _mono_bases, for wine-gecko."""
    rt, bundle = (runtime_root(wine) if wine else None), resolve_runtime()
    return [GECKO_CANDIDATES[0], rt and os.path.join(rt, "share", "wine", "gecko"),
            bundle and os.path.join(bundle, "gecko"), *GECKO_CANDIDATES[1:]]


def _resolve_mono_support_msi(wine=None):
    """Absolute path to the version-matched wine-mono support MSI
    (<tree>/wine-mono-<version>/support/winemono-support.msi), or None."""
    ver = _mono_gecko_versions(wine)[0]
    for base in _mono_bases(wine):
        if not base:
            continue
        msi = os.path.join(base, f"wine-mono-{ver}", "support", "winemono-support.msi")
        if os.path.isfile(msi):
            return msi
    return None


def _resolve_gecko_tree(arch, wine=None):
    """Absolute path to the version-matched extracted wine-gecko tree for an arch
    ('x86' or 'x86_64'): <tree>/wine-gecko-<version>-<arch>, or None."""
    ver = _mono_gecko_versions(wine)[1]
    for base in _gecko_bases(wine):
        if not base:
            continue
        d = os.path.join(base, f"wine-gecko-{ver}-{arch}")
        if os.path.isdir(d):
            return d
    return None


def install_mono_gecko(wine, prefix):
    """Install the matching Wine Mono + Gecko INTO the prefix so wineboot never
    prompts the user for them at launch and nothing (mscoree/mshtml) is disabled.
    Idempotent. This is the correct, non-clobbering handling: a complete Adobe
    prefix HAS mono+gecko installed (the proven mudhut-accc2 does) — we never
    suppress mscoree/mshtml on the launch path (that leaves gecko missing and
    blanks Adobe's mshtml-backed web content). Returns a dict describing what ran.

    - Gecko: copy the extracted tree into system32/gecko/<ver>/wine_gecko (x86)
      and syswow64/gecko/<ver>/wine_gecko (x86_64) — the exact layout wine's
      mshtml produces (matches accc2). No MSI/prompt needed.
    - Mono: run the tree's winemono-support.msi via msiexec (this is what wine's
      own installer runs; it creates the c:\\windows\\mono links + registry)."""
    res = {"mono": None, "gecko": None}
    win = os.path.join(prefix, "drive_c", "windows")
    mono_ver, gecko_ver = _mono_gecko_versions(wine)

    # --- Gecko: place both arch trees where mshtml looks (idempotent). ----------
    gecko_done = []
    for arch, scope in (("x86", "system32"), ("x86_64", "syswow64")):
        dst = os.path.join(win, scope, "gecko", gecko_ver, "wine_gecko")
        if os.path.isdir(dst) and os.listdir(dst):
            gecko_done.append(f"{scope}:present")
            continue
        src = _resolve_gecko_tree(arch, wine)
        if not src:
            gecko_done.append(f"{scope}:no-source")
            continue
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copytree(src, dst, dirs_exist_ok=True)
            gecko_done.append(f"{scope}:installed")
        except OSError as e:
            log(f"gecko {scope} install failed: {e}")
            gecko_done.append(f"{scope}:error")
    res["gecko"] = {"version": gecko_ver, "arches": gecko_done}

    # --- Mono: install via the support MSI unless already installed. ------------
    # Modern wine-mono's support MSI references the extracted tree in place (no
    # c:\windows\mono copy); what it leaves is the "Wine Mono Windows Support" entry in
    # Programs and Features (matches the proven accc2 prefix). ⛔ Not syswow64\monodebg.vxd:
    # wineboot puts that stub in EVERY prefix, so it reported Mono "present" where it never was.
    if _ms_installed(prefix, "Wine Mono Windows Support"):
        res["mono"] = {"version": mono_ver, "status": "present"}
    else:
        msi = _resolve_mono_support_msi(wine)
        if not msi:
            res["mono"] = {"version": mono_ver, "status": "no-source"}
        else:
            try:
                env = dict(os.environ)
                env["WINEPREFIX"] = prefix
                env.setdefault("DISPLAY", ":0")
                # mscoree/mshtml must be ENABLED here so the MSI's mono setup runs;
                # this is the install path, never the launch path.
                env.pop("WINEDLLOVERRIDES", None)
                winpath = "z:" + msi.replace("/", "\\")
                subprocess.run([wine, "msiexec", "/i", winpath, "/qn"],
                               env=env, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=240)
                wineserver_wait(wine, prefix)
                res["mono"] = {"version": mono_ver,
                               "status": "installed" if _ms_installed(prefix, "Wine Mono Windows Support")
                               else "ran"}
            except Exception as e:
                log(f"mono install failed (non-fatal): {e}")
                res["mono"] = {"version": mono_ver, "status": "error"}
    return res


def _mshtml_protocols_registered(prefix):
    """True when the prefix registers Wine's browser engine (mshtml) as the about: protocol
    handler, False when it does not, None when system.reg is unreadable."""
    want = "[Software\\\\Classes\\\\PROTOCOLS\\\\Handler\\\\about]"
    try:
        with open(os.path.join(prefix, "system.reg"), encoding="utf-8", errors="replace") as f:
            return any(line.startswith(want) for line in f)
    except OSError:
        return None


def register_mshtml(wine, prefix):
    """Register Wine's built-in browser engine (mshtml): its about:, javascript:, res: ... protocol
    handlers. Wine does this when a prefix is created, but Mud Hut creates prefixes with mshtml
    disabled (to keep Wine's Gecko download prompt away), so it never happened. Every embedded
    browser that starts at about:blank then stays empty -- Lightroom Classic's About box showed a
    blank panel where its build and copyright text go (GitHub Neutron#10). Idempotent."""
    if _mshtml_protocols_registered(prefix):
        return {"status": "present", "ok": True}
    env = {**os.environ, "WINEPREFIX": prefix, "WINEDEBUG": "-all",
           "WINEDLLOVERRIDES": "winemenubuilder.exe=d"}   # mshtml itself must be ENABLED here
    env.setdefault("DISPLAY", ":0")
    try:
        subprocess.run([wine, "regsvr32", "/s", "mshtml.dll"], env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=120)
        wineserver_wait(wine, prefix)   # the registry reaches system.reg when wineserver exits
    except Exception as e:
        return {"status": "error", "ok": False, "detail": str(e)}
    ok = bool(_mshtml_protocols_registered(prefix))
    return {"status": "registered" if ok else "failed", "ok": ok}


# Font-type suffix Wine uses in the HKLM Fonts value name, by extension.
_FONT_REG_SUFFIX = {".otf": " (OpenType)", ".ttf": " (TrueType)",
                    ".ttc": " (TrueType)", ".fon": ""}


def _host_font_files():
    """The host machine's installed font files, via fontconfig. Portable: reads
    THIS machine's fonts, so it self-populates correctly on any build-tester's
    box (never a hardcoded list). Returns absolute Linux paths."""
    try:
        out = subprocess.run(["fc-list", ":", "file"], capture_output=True,
                             text=True, timeout=30).stdout
    except Exception as e:
        log(f"fc-list unavailable ({e}); host fonts NOT registered")
        return []
    files = []
    for line in out.splitlines():
        # fc-list ": file" prints "<path>: " — strip the trailing ": ".
        p = line.strip()
        if p.endswith(":"):
            p = p[:-1].strip()
        if os.path.isabs(p) and os.path.isfile(p):
            files.append(p)
    return files


def font_postscript_names(path):
    """EVERY nameID 6 (PostScript name) -- see _font_name_records()."""
    return _font_name_records(path, 6)


def font_family_names(path):
    """EVERY family name a font declares: nameID 1 (legacy family, what GDI and Wine's
    replacement map key on) plus nameID 16 (typographic family, e.g. "Adobe Clean" on a face
    whose nameID 1 is "Adobe Clean Black"). Used to verify a replacement TARGET exists."""
    return _font_name_records(path, 1) | _font_name_records(path, 16)


def _font_name_records(path, want_nid):
    """EVERY nameID `want_nid` (6 = PostScript name) in a TrueType/OpenType `name` table, as a
    set. Dependency-free — this has to run on a build tester's box.

    ⚠️ Returns a SET, and reads every record, because the real Microsoft core
    fonts carry TWO nameID 6 entries (a Macintosh-platform one whose bytes are
    UTF-16 anyway, then the Windows one) while Wine's substitutes carry only the
    Windows one. An earlier version returned the first match and therefore
    decoded the genuine times.ttf as '\\x00T\\x00i\\x00m...' and reported the
    HEALTHY dev-box prefix as faked — a check that condemns working machines is
    worse than no check. Both decodings of every record are collected.

    Why the PostScript name and not the family name: Wine's replacement fonts
    carry the REAL family ("Times New Roman") under the REAL filename
    (times.ttf) but a Wine-specific PostScript name ("WineTimesNewRoman").
    Adobe's CoolType resolves the per-script default face by PostScript name, so
    family-name and filename checks both come back clean on a prefix that is
    fatally broken. See _roman_default_status()."""
    names = set()
    try:
        with open(path, "rb") as f:
            d = f.read()
        # collection: first font only — the Roman defaults are never .ttc anyway
        off = struct.unpack(">I", d[12:16])[0] if d[:4] == b"ttcf" else 0
        name_off = None
        for i in range(struct.unpack(">H", d[off + 4:off + 6])[0]):
            e = off + 12 + 16 * i
            if d[e:e + 4] == b"name":
                name_off = struct.unpack(">II", d[e + 8:e + 16])[0]
                break
        if name_off is None:
            return names
        count, str_off = struct.unpack(">HH", d[name_off + 2:name_off + 6])
        for i in range(count):
            r = name_off + 6 + 12 * i
            _pid, _eid, _lid, nid, ln, o = struct.unpack(">HHHHHH", d[r:r + 12])
            if nid != want_nid:
                continue
            raw = d[name_off + str_off + o:name_off + str_off + o + ln]
            for enc in ("utf-16-be", "latin1"):
                try:
                    s = raw.decode(enc).strip("\x00").strip()
                except UnicodeDecodeError:
                    continue
                if s:
                    names.add(s)
    except Exception:
        return names
    return names


# 🚨 The three faces Adobe's CoolType tries, in order, when it picks the default
# Roman face. Wine ships a substitute for EVERY one of them
# under the same Microsoft filename, so a prefix can hold all three files, pass
# every presence check, and still contain none of the PostScript names CoolType
# is looking for.
_ROMAN_DEFAULTS = {"times.ttf": "TimesNewRomanPSMT",
                   "arial.ttf": "ArialMT",
                   "cour.ttf": "CourierNewPSMT"}

# FamilyName as CoolType records it, per PostScript name. Needed to find the
# right record in AdobeFnt_OSFonts.lst -- see _stale_roman_cache_records().
_ROMAN_FAMILY = {"TimesNewRomanPSMT": "Times New Roman",
                 "ArialMT": "Arial",
                 "CourierNewPSMT": "Courier New"}


def _roman_default_status(prefix):
    """Per-file authenticity of the fonts CoolType needs for its default Roman
    face. Returns [(filename, state, detail)] with state in
    real | wine-substitute | missing | unreadable.

    ⭐ 2026-08-11 — THIS IS THE AFTER EFFECTS `IEggApp failed` BUG, reproduced on the dev
    box in the clean room. Replace times.ttf, arial.ttf and cour.ttf with Wine's
    substitutes and AE dies at startup with `EGG Constructor IEggApp failed` and
    the boilerplate "check you have the appropriate permissions" message; restore
    them and it starts. Confirmed at the exception level: 81 CoolType throws +1
    TXT.dll +1 aelib.dll on the failing run vs 80 +0 +0 on the working one, and
    the AE internal log is a 93-line normalized match for the build tester's.
    CoolType throws when NONE of the three resolves; it
    falls back gracefully as long as ONE survives, which is why swapping only
    times.ttf changes the log line to ArialMT and nothing breaks.

    ⛔ Do NOT replace this with a filename or family-name check. The existing
    msttcorefonts check tests six Wine-UNIQUE names (georgia/verdana/impact/
    trebuc/comic/andalemo) precisely because they cannot collide — which is
    exactly why it reports 6/6 on a prefix with all three Roman defaults faked."""
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    rows = []
    for fn, want in _ROMAN_DEFAULTS.items():
        path = os.path.join(fd, fn)
        if not os.path.isfile(path):
            rows.append((fn, "missing", f"{fn} not in windows/Fonts"))
            continue
        ps = font_postscript_names(path)
        if want in ps:
            rows.append((fn, "real", want))
        elif not ps:
            rows.append((fn, "unreadable", "no PostScript name in the font's name table"))
        else:
            # Report the shortest pure-ASCII name: the UTF-16 record decoded as
            # latin1 also lands in the set as "W i n e A r i a l", which is noise.
            ascii_names = [n for n in ps if all(0x20 <= ord(c) < 0x7f for c in n)]
            best = min(ascii_names or sorted(ps), key=len)
            rows.append((fn, "wine-substitute",
                         f"PostScript name is {best!r}, not {want!r}"))
    return rows


def _prune_app_logs(log_dir, app, slug, keep=20):
    """Keep only the newest `keep` logs for this app IN THIS PREFIX; delete the rest.

    Bounded per app+prefix so a chatty app can't starve a quiet one out of its history.
    ⚠️ Size matters here: an Adobe wine log with debug channels on reaches
    hundreds of MB (this box has a 5.4 GB one), so an unbounded log dir would
    quietly become the biggest thing on the disk. Best-effort — a failure to
    prune must never stop a launch.

    2026-09-18: logs are `<app>-<prefix slug>-<ts>.log`. They used to be `<app>-<ts>.log` and
    pruned 20-per-app ACROSS prefixes, so a busy Premiere 2025 session erased Premiere 2026's
    history -- and a log someone sent us did not say which prefix produced it from its name.
    Old-format files are left alone (already bounded at 20 per app; never grows again)."""
    try:
        stem = "%s-%s-" % (app, slug)
        mine = sorted(
            (e.path for e in os.scandir(log_dir)
             if e.is_file() and e.name.startswith(stem) and e.name.endswith(".log")),
            key=os.path.getmtime, reverse=True)
        for old in mine[keep - 1:]:      # -1: we are about to create one more
            try:
                os.remove(old)
            except OSError:
                pass
    except OSError:
        pass


def _cooltype_cache_files(prefix):
    """Every CoolType font cache file in a prefix, found by the ARTEFACT name rather
    than by Adobe's per-app directory name.

    🚨 2026-09-01, build tester. This used to collect only directories basename-equal
    to `typesupport`, which finds 3 of the 6 live caches on a full suite prefix:

        Premiere / After Effects / Media Encoder  AppData/Local/Temp/.../Typesupport   ✅
        Photoshop 2025                            AppData/Roaming/.../CT Font Cache    ❌
        Illustrator 29 / AIRobin 29.7.1           AppData/Roaming/.../en_US/x64        ❌

    Observed live: `provision` reported `cooltype_cache_invalidate: {"count": 2}` while
    11 AdobeFnt*.lst files sat on disk, six of them live caches. After a font install,
    Premiere would see the new font and Photoshop and Illustrator would NOT -- with
    every file-level and registry-level check passing. That is exactly the failure
    invalidate_cooltype_caches() exists to prevent, and it was reporting ok:true while
    doing a third of the job.

    ⭐ The directory name varies by app and version; the cache FILE name does not. That
    predicate was already being applied inside each directory -- hoisting it out is the
    whole fix. The two Roaming locations are also never cleared incidentally, because
    nothing else prunes Roaming the way Temp gets pruned.
    """
    out = []
    users = os.path.join(prefix, "drive_c", "users")
    for root, _dirs, files in os.walk(users):
        for fn in files:
            low = fn.lower()
            if low.startswith("adobefnt") and low.endswith(".lst"):
                out.append(os.path.join(root, fn))
    return out


def _cooltype_cache_dirs(prefix):
    """Directories that actually hold a CoolType cache, deduped, order-stable."""
    seen, out = set(), []
    for f in _cooltype_cache_files(prefix):
        d = os.path.dirname(f)
        if d not in seen:
            seen.add(d)
            out.append(d)
    return out


def _stale_roman_cache_records(prefix):
    """The Roman-default families whose CACHED record still names a Wine
    substitute, as [(family, cached FontName, cache path)].

    🚨 2026-08-12, from the build tester — THIS, not the files, is what actually
    kept After Effects down. Their times/arial/cour were all genuine (installed
    by `winetricks corefonts`), every file-level check passed, and AE still died
    for three more days: `AdobeFnt_OSFonts.lst` was still serving
    `WineTimesNewRoman`/`WineArial`/`WineCourierNew` with the SUBSTITUTES' file
    lengths. We had hit the same trap mirrored (our cache kept serving the real
    font's length after we installed a substitute), so this is symmetric and it
    invalidates a files-only check in BOTH directions.

    ⭐ The staleness is PER RECORD, keyed on filename: corefonts introduced new
    filenames (georgia, verdana, impact, trebuc, comic, andalemo) and those were
    read fresh, and the Bold/Italic faces of Times/Arial/Courier refreshed too
    — because Wine ships substitutes for exactly times/arial/cour REGULAR and
    nothing else. So the only stale records are the three Regular faces, which
    are exactly and only what CoolType looks up for its default. Everything else
    refreshing correctly is what made this so well hidden.

    ⚠️ Two rules this must obey, both learned by getting them wrong (2026-08-12,
    caught by the build tester on a prefix where AE starts):

    * **At least one genuine is enough**, exactly like the file-level rule —
      CoolType falls back. An earlier version appended an entry for each of the
      three whose genuine name was absent and failed on any of them, so a prefix
      with a substitute `times.ttf` but genuine `arial`/`cour` — files and cache
      faithful to each other, AE starting fine on ArialMT — was reported FAIL and
      the user told to delete a correct cache. That is the false PASS mirrored.
    * **Scope the lookup to the right record.** Searching the whole file for
      `FontName:Wine\\w*` reports the first Wine record anywhere, and every real
      prefix legitimately carries several (msyh, symbol, tahoma, tahomabd,
      wingding) — it blamed `WineYahei`, a CJK face with nothing to do with Roman
      defaults. Match on FamilyName + StyleName:Regular, because the Bold/Italic
      records share the FamilyName and are genuine.
    """
    stale = []
    for d in _cooltype_cache_dirs(prefix):
        lst = os.path.join(d, "AdobeFnt_OSFonts.lst")
        if not os.path.isfile(lst):
            continue
        try:
            with open(lst, "rb") as f:
                text = f.read().decode("latin1")
        except OSError:
            continue
        # Records are "%BeginFont ... FontName:X ... %EndFont" blocks.
        recs = re.findall(r"%BeginFont(.*?)%EndFont", text, re.S)
        per_file, found_genuine = [], False
        for want in _ROMAN_DEFAULTS.values():
            fam = _ROMAN_FAMILY[want]
            blk = next((r for r in recs
                        if re.search(r"FamilyName:%s\s" % re.escape(fam), r)
                        and re.search(r"StyleName:Regular\s", r)), None)
            if blk and ("FontName:%s" % want) in blk:
                found_genuine = True        # one is enough, same as the files
            else:
                m = re.search(r"FontName:(Wine\w*)", blk or "")
                per_file.append((want, m.group(1) if m else "absent", lst))
        if not found_genuine:
            stale.extend(per_file)
    return stale


# ⭐ 2026-10-12 — CEP MANIFESTS ARE SIGNED: Neutron no longer edits them (DECISIONS C47).
#
# From 2026-08-15 through 1.0.0-beta.5, provision added three CEF flags to aescripts' manifests
# (--no-sandbox --disable-gpu-sandbox --disable-direct-composition), because the Captioneer panel
# rendered blank without them in July (memory `neutron-cep-panel-sandbox`). Two things were wrong:
#   1. CSXS/manifest.xml is listed in the extension's META-INF/signatures.xml, so the edit made CEP
#      refuse the extension ("Signature verification failed" in CEP12-<HOST>.log, and the panel
#      never opens). It only ever worked on a prefix with PlayerDebugMode=1, which skips the check.
#   2. On 11.10-108 none of the flags is needed: Captioneer's original manifest renders its full,
#      interactive UI (clean room, 2026-10-12). CEP passes --no-sandbox to its renderers itself, and
#      Chromium presents through a plain window swapchain.
# So provision puts back the signed original of each manifest it edited -- the candidate whose
# SHA-256 matches the extension's own signature -- and never touches one it cannot match. It does
# so only when provisioning onto 11.10-108 or later, the first runtime verified without the flags.
CEP_MANIFEST_BACKUP_SUFFIX = ".pre-neutron-cepflags"
CEP_RESTORE_MIN_RUNTIME = "11.10-108"
# Exactly what the old patcher inserted in front of </CEFCommandLine>.
_NEUTRON_CEP_FLAG_INSERT = re.compile(
    rb"(?:\n            <Parameter>(?:--no-sandbox|--disable-gpu-sandbox|--disable-direct-composition)"
    rb"</Parameter>)+\n         (?=</CEFCommandLine>)")


def _cep_manifests(prefix):
    """Every installed CEP extension manifest, as (extension_id, path)."""
    user = prefix_user(prefix)
    roots = [
        os.path.join(prefix, "drive_c", "Program Files (x86)", "Common Files",
                     "Adobe", "CEP", "extensions"),
    ]
    # Per-user extensions only when the prefix has a real user dir -- never a guessed name.
    if user:
        roots.append(os.path.join(prefix, "drive_c", "users", user, "AppData", "Roaming",
                                  "Adobe", "CEP", "extensions"))
    out = []
    for root in roots:
        if not os.path.isdir(root):
            continue
        try:
            entries = sorted(os.listdir(root))
        except OSError:
            continue
        for name in entries:
            man = os.path.join(root, name, "CSXS", "manifest.xml")
            if os.path.isfile(man):
                out.append((name, man))
    return out


def _cep_signed_digests(ext_dir):
    """{relative path: (hashlib name, base64 digest)} from the extension's META-INF/signatures.xml,
    or None when the extension is unsigned."""
    import urllib.parse
    sig = os.path.join(ext_dir, "META-INF", "signatures.xml")
    try:
        with open(sig, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    out = {}
    for uri, alg, dv in re.findall(r'<Reference URI="([^"#][^"]*)"[^>]*>.*?<DigestMethod Algorithm='
                                   r'"[^"]*#(sha\d+)"/?>.*?<DigestValue>([^<]*)</DigestValue>',
                                   text, re.S):
        out[urllib.parse.unquote(uri)] = (alg, dv.strip())
    return out


def _digest_matches(data, want):
    import base64, hashlib
    alg, dv = want
    try:
        return base64.b64encode(hashlib.new(alg, data).digest()).decode() == dv
    except ValueError:
        return False


def cep_extension_name(manifest):
    """What the user sees for an extension: its bundle name, else its first literal menu entry,
    else the folder name."""
    try:
        with open(manifest, "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        text = ""
    m = (re.search(r'ExtensionBundleName="([^"%]+)"', text)
         or re.search(r"<Menu>\s*([^<%][^<]*?)\s*</Menu>", text))
    return m.group(1) if m else os.path.basename(os.path.dirname(os.path.dirname(manifest)))


def cep_signature_status(ext_dir):
    """Signed files that are missing or changed, as (missing, changed); None when unsigned.

    Either list non-empty means CEP refuses the extension unless PlayerDebugMode is on. Validated
    against CEP12's own verdicts 2026-10-12: an edited manifest, a removed `.debug` and an
    extension missing 119 node_modules files each failed; the untouched extension loaded."""
    signed = _cep_signed_digests(ext_dir)
    if signed is None:
        return None
    missing, changed = [], []
    for rel, want in signed.items():
        try:
            with open(os.path.join(ext_dir, rel), "rb") as f:
                data = f.read()
        except OSError:
            missing.append(rel)
            continue
        if not _digest_matches(data, want):
            changed.append(rel)
    return missing, changed


def cep_extension_damage(prefix):
    """Extensions whose signed files are missing or changed, split as (ours, vendor).

    `ours`: Adobe's own (com.adobe.*) or a manifest an older Neutron edited -- a prefix problem.
    `vendor`: any other extension -- its vendor's install. Each entry is
    {id, name, missing, changed, edited_by_neutron}."""
    ours, vendor = [], []
    for ext_id, man in _cep_manifests(prefix):
        st = cep_signature_status(os.path.dirname(os.path.dirname(man)))
        if not st or not (st[0] or st[1]):
            continue
        entry = {"id": ext_id, "name": cep_extension_name(man),
                 "missing": len(st[0]), "changed": len(st[1]),
                 "edited_by_neutron": os.path.exists(man + CEP_MANIFEST_BACKUP_SUFFIX)}
        (ours if entry["edited_by_neutron"] or ext_id.startswith("com.adobe.") else vendor).append(entry)
    return ours, vendor


def _cep_debug_mode(prefix):
    """CSXS versions with PlayerDebugMode=1 in the prefix (CEP then skips signature checks)."""
    try:
        with open(os.path.join(prefix, "user.reg"), "r", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return []
    return sorted(set(re.findall(r'\[Software\\\\Adobe\\\\CSXS\.(\d+)\][^\[]*?"PlayerDebugMode"="1"',
                                 text)), key=int)


def _runtime_at_least(version, minimum):
    def key(v):
        return tuple(int(x) for x in re.findall(r"\d+", v or ""))
    return bool(version) and key(version) >= key(minimum)


def restore_cep_manifests(prefix, log_fn=None):
    """Put back the signed original of every CEP manifest an older Neutron edited.

    Returns (restored, unmatched): extension ids restored, and ids whose manifest is not the signed
    original and that we could not rebuild (left exactly as they are)."""
    restored, unmatched = [], []
    for ext_id, man in _cep_manifests(prefix):
        bak = man + CEP_MANIFEST_BACKUP_SUFFIX
        if not os.path.exists(bak):
            continue                      # never edited by Neutron
        ext_dir = os.path.dirname(os.path.dirname(man))
        want = (_cep_signed_digests(ext_dir) or {}).get("CSXS/manifest.xml")
        try:
            with open(man, "rb") as f:
                cur = f.read()
            if want and _digest_matches(cur, want):
                os.remove(bak)            # already original; the backup is an unsigned extra file
                continue
            candidates = [_NEUTRON_CEP_FLAG_INSERT.sub(b"", cur)]
            with open(bak, "rb") as f:
                candidates.append(f.read())
            good = next((c for c in candidates if want and _digest_matches(c, want)), None)
            if good is None:
                unmatched.append(ext_id)
                if log_fn:
                    log_fn("cep-manifest: %s does not match its signature and could not be "
                           "rebuilt; not editing" % ext_id)
                continue
            tmp = man + ".neutron-tmp"
            with open(tmp, "wb") as f:
                f.write(good)
            shutil.copymode(man, tmp)
            os.replace(tmp, man)
            os.remove(bak)
            restored.append(ext_id)
            if log_fn:
                log_fn("cep-manifest: %s restored to its signed original" % ext_id)
        except OSError as e:
            if log_fn:
                log_fn("cep-manifest: %s FAILED: %s" % (ext_id, e))
    return restored, unmatched


def invalidate_cooltype_caches(prefix):
    """Delete CoolType's Typesupport caches so the next launch re-reads the font
    FILES. Adobe rebuilds them automatically; this is safe and idempotent.

    Called unconditionally whenever we touch fonts. The alternative — repair the
    files and leave the cache — produces a prefix that passes every check we can
    make and still fails, which is precisely how three days were lost. Returns
    the number of files removed."""
    n = 0
    for f in _cooltype_cache_files(prefix):
        try:
            os.remove(f)
            n += 1
        except OSError:
            pass
    return n


def _find_real_roman_font(want, extra_dirs=()):
    """A host (or extra_dirs) font file whose PostScript name is `want`, or None.
    Used to repair a prefix whose Roman defaults are Wine substitutes without
    making the user re-run winetricks — but only when a genuine source exists."""
    cands = list(_host_font_files())
    for d in extra_dirs:
        if d and os.path.isdir(d):
            cands += [os.path.join(d, f) for f in sorted(os.listdir(d))]
    for p in cands:
        if os.path.splitext(p)[1].lower() not in (".ttf", ".ttc", ".otf"):
            continue
        if want in font_postscript_names(p):
            return p
    return None


def _wine_fonts_dir(wine):
    """The Wine builtin fonts dir (tahoma.ttf, arial.ttf, times.ttf, ...). These
    are NOT on the Linux host (fc-list misses them) but dwrite's last-resort
    fallback HARDCODES "Tahoma" (layout.c) — without it, Adobe text layout
    NULL-derefs on File>New. Located relative to the wine binary; covers the
    build tree and a packaged (bin/) install."""
    # Check the dir of the wine symlink itself (build tree: fonts/ sits beside it)
    # AND the realpath target's tree (packaged: bin/wine -> ../share/wine/fonts).
    cands = []
    for base in (os.path.dirname(os.path.abspath(wine)),
                 os.path.dirname(os.path.realpath(wine))):
        cands += [os.path.join(base, "fonts"),
                  os.path.join(os.path.dirname(base), "share", "wine", "fonts"),
                  os.path.join(os.path.dirname(base), "lib", "wine", "fonts")]
    for c in cands:
        if os.path.isfile(os.path.join(c, "tahoma.ttf")):
            return c
    return None


def register_prefix_fonts(wine, prefix):
    """Populate HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts with
    (1) the fonts staged under drive_c/windows/Fonts and (2) the host machine's
    fonts (fontconfig). Returns the number of entries written.

    Two failures this prevents, both because Wine does NOT auto-register fonts a
    prefix merely *has*:

    * Copied-in windows/Fonts: load_file_system_fonts() scans that dir with
      flags=0 (win32u/font.c) and update_external_font_keys() — the only writer
      of the HKLM Fonts key — skips faces lacking ADDFONT_EXTERNAL_FONT. So the
      Adobe fonts stay invisible to dwrite; the Segoe UI->Adobe Clean
      replacement resolves to an unregistered family -> blank menu bar.

    * Host fonts: a freshly-provisioned prefix has an almost-empty dwrite system
      font collection. When Adobe's torq text engine lays out the New Document
      and dwrite reaches its LAST-RESORT fallback (layout.c
      layout_run_get_last_resort_font -> create_matching_font), the range's font
      collection is NULL -> create_matching_font derefs NULL -> HARD CRASH on
      File>New (no dialog). Registering the host font set makes the collection
      valid, exactly like a normally-used prefix. load_registry_fonts() loads
      full-path (host) entries and windows/Fonts-relative (bare) entries alike.

    One idempotent `reg import`. Registry key names are made unique so
    load_registry_fonts() never skips a file on a duplicate face name (dwrite
    still keys the loaded font on its real name read from the file)."""
    entries = []           # (unique_reg_name, value)
    seen = set()

    def add(name, value):
        base, i = name, 1
        while name in seen:      # guarantee a unique key per file
            i += 1
            name = f"{base} #{i}"
        seen.add(name)
        entries.append((name, value))

    # (1) prefix windows/Fonts — value is the bare filename (Wine resolves it
    #     against %WINDIR%\Fonts).
    fonts_dir = os.path.join(prefix, "drive_c", "windows", "Fonts")
    if os.path.isdir(fonts_dir):
        for fn in sorted(os.listdir(fonts_dir)):
            suffix = _FONT_REG_SUFFIX.get(os.path.splitext(fn)[1].lower())
            if suffix is None:
                continue
            add(os.path.splitext(fn)[0] + suffix, fn)

    # (2) host fonts — value is the full Wine DOS path (Z: maps to the host root).
    host_files = list(_host_font_files())
    # (3) Wine builtin fonts (Tahoma etc.) — the last-resort font isn't on Linux.
    wfd = _wine_fonts_dir(wine)
    if wfd:
        host_files += [os.path.join(wfd, f) for f in sorted(os.listdir(wfd))]
    for p in host_files:
        suffix = _FONT_REG_SUFFIX.get(os.path.splitext(p)[1].lower())
        if suffix is None or not os.path.isfile(p):
            continue
        dos = "Z:" + os.path.abspath(p).replace("/", "\\")
        add(os.path.basename(os.path.splitext(p)[0]) + suffix, dos)

    if not entries:
        return 0

    def esc(s):  # .reg string escaping
        return s.replace("\\", "\\\\").replace('"', '\\"')

    lines = ["REGEDIT4", "",
             r"[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts]"]
    lines += [f'"{esc(n)}"="{esc(v)}"' for n, v in entries]
    body = "\r\n".join(lines) + "\r\n"

    # Write the .reg inside the prefix so we can hand wine a plain C: path
    # (avoids Z:\ DOS-path escaping quirks).
    tmp_dir = os.path.join(prefix, "drive_c", "windows", "temp")
    try:
        os.makedirs(tmp_dir, exist_ok=True)
        reg_path = os.path.join(tmp_dir, "neutron-fonts.reg")
        with open(reg_path, "w", newline="") as f:
            f.write(body)
    except OSError as e:
        log(f"font registry file write failed (non-fatal): {e}")
        return 0
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")
        subprocess.run([wine, "reg", "import", r"C:\windows\temp\neutron-fonts.reg"],
                       env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=120)
    except Exception as e:
        log(f"font registry import failed (non-fatal): {e}")
        return 0
    return len(entries)



def install_corefonts(wine, prefix, as_json=True):
    """Put Microsoft's core fonts (Arial, Times New Roman, Courier New, Georgia, Verdana, Impact,
    Trebuchet MS, Comic Sans MS, Andale Mono, Webdings) into the prefix's windows/Fonts, from the
    Microsoft cache; the first use downloads Microsoft's original font installers (~4 MB). Returns
    True when it ran to completion -- callers re-read the files and judge from those."""
    keys = [k for k in MS_FILES if k.startswith("corefonts/")]
    r = ms_fetch(as_json, only=keys)
    if not r["ok"]:
        log("could not download the Microsoft core fonts: "
            + "; ".join(f"{k}: {v}" for k, v in r["failed"].items()))
        return False
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    os.makedirs(fd, exist_ok=True)
    for k in keys:
        sha, name = MS_FILES[k][2], MS_FILES[k][4]
        dst = os.path.join(fd, name)
        if _sha256_file(dst) != sha:
            shutil.copyfile(_ms_cached(sha), dst)
    return True


def _repair_roman_defaults(wine, prefix):
    """Make at least one of times/arial/cour a genuine Microsoft face. Returns
    (repaired, unrepaired, fetched_corefonts).

    Extracted verbatim from `prefix provision` on 2026-09-13 so that `neutron fonts repair` and
    provision share ONE implementation. Behaviour unchanged: copy a genuine face from the host or
    the prefix's own Fonts dir; only when nothing on this host can supply one, fetch the real
    Microsoft core fonts. We only ever copy a font whose PostScript name is genuinely the one
    CoolType wants, so this cannot make a prefix worse."""
    roman = _roman_default_status(prefix)
    fake = [fn for fn, state, _ in roman if state != "real"]
    repaired, unrepaired, fetched = [], [], False
    if fake:
        fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
        for fn in fake:
            # The prefix's own Fonts dir is searched too: a `--method windows`
            # copy often carries the genuine face under a different filename
            # (e.g. "Times New Roman.ttf"), which repairs with no download.
            src = _find_real_roman_font(_ROMAN_DEFAULTS[fn], extra_dirs=(fd,))
            if src:
                try:
                    shutil.copyfile(src, os.path.join(fd, fn))
                    repaired.append(fn)
                    continue
                except OSError as e:
                    log(f"roman-default repair of {fn} failed: {e}")
            unrepaired.append(fn)
        # 🚨 If NOTHING on this host could supply a genuine face, copying cannot
        # help and the prefix stays fatally broken -- we would only print
        # "install the core fonts" and call it a day, which is how a build
        # tester ends up with an install that reported success and cannot launch
        # Premiere, AE or Media Encoder.
        #
        # Fetch them. Gated on the prefix ALREADY being broken, so a healthy
        # prefix pays nothing, and corefonts brings georgia/verdana/impact/trebuc
        # too -- which the video trio needs and _ROMAN_DEFAULTS (times/arial/cour)
        # never covered.
        if unrepaired:
            log("no genuine Roman face on this host — installing the Microsoft core fonts")
            fetched = install_corefonts(wine, prefix)
            # Re-evaluate: whatever landed changes the verdict below, and the
            # CoolType cache invalidation after this block must see the NEW files.
            roman = _roman_default_status(prefix)
            newly = [fn for fn, state, _ in roman if state == "real" and fn in unrepaired]
            repaired.extend(newly)
            unrepaired = [fn for fn in unrepaired if fn not in newly]
        if repaired:
            register_prefix_fonts(wine, prefix)   # re-register the replaced files
    return repaired, unrepaired, fetched



# --- fonts: re-verify + repair (`neutron fonts check|repair`) ------------------------------------
# Fonts are the highest-value check in the stack because the failures are severe and the symptom
# never mentions fonts (built 2026-09-13):
#   * After Effects dies at startup ("EGG Constructor IEggApp failed") when CoolType cannot
#     resolve its default Roman face -- _roman_default_status() / _stale_roman_cache_records().
#   * Premiere / Media Encoder / AE do not start without the real Microsoft core fonts. Wine's
#     substitutes ship under the REAL filenames, so presence of arial.ttf proves nothing; the six
#     names below are the ones msttcorefonts ships and Wine does not.
#   * Photoshop's menu bar comes up blank when a font is COPIED into windows/Fonts but never
#     REGISTERED -- Wine only offers dwrite the fonts written to the HKLM Fonts key.
# `check` is READ-ONLY and never starts wine: Collider runs it for every prefix on the Prefixes
# tab, and starting wine against a cold prefix on a different-stamp runtime fires `wineboot -u`.
# Only `repair` touches the prefix, behind the same guards `theme apply` uses.

_MS_CORE_FONTS = ("georgia", "verdana", "impact", "trebuc", "comic", "andalemo")


def _ms_core_fonts_status(prefix):
    """(present, missing) among the six msttcorefonts filenames Wine ships NOTHING under.

    A presence test BY DESIGN: it answers "did the real core fonts ever land here", which a
    check of times/arial/cour cannot (Wine's substitutes carry those exact filenames). It is
    blind to a faked times/arial/cour -- that is _roman_default_status()'s job. The two are
    complementary, never interchangeable (2026-08-11)."""
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    try:
        have_files = {f.lower() for f in os.listdir(fd)}
    except OSError:
        have_files = set()
    present = [n for n in _MS_CORE_FONTS if n + ".ttf" in have_files]
    missing = [n for n in _MS_CORE_FONTS if n + ".ttf" not in have_files]
    return present, missing


def _reg_unescape(s):
    return s.replace('\\"', '"').replace("\\\\", "\\")


def _reg_section_values(reg_file, section):
    """{name: value} of the string values under ONE key of a Wine .reg file ON DISK -- never
    through wine. `section` takes single backslashes. None when the file is unreadable, {} when
    the key is absent.

    ⚠️ Wine's wineserver writes these files periodically and at exit, so while a session is live
    in the prefix the file can lag a registry write by up to ~30 s; fonts_verdict() says so and
    repair_prefix_fonts() waits for the server before judging."""
    try:
        with open(reg_file, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    key = re.escape(section.replace("\\", "\\\\"))
    m = re.search(r"^\[" + key + r"\][^\n]*\n(.*?)(?=^\[|\Z)", text, re.S | re.M)
    if not m:
        return {}
    out = {}
    for name, val in re.findall(r'^"((?:[^"\\]|\\.)*)"="((?:[^"\\]|\\.)*)"', m.group(1), re.M):
        out[_reg_unescape(name)] = _reg_unescape(val)
    return out


def _registered_font_basenames(prefix):
    """Lower-cased basenames of every value under HKLM\\...\\CurrentVersion\\Fonts (system.reg),
    or None when the file cannot be read."""
    vals = _reg_section_values(os.path.join(prefix, "system.reg"),
                               r"Software\Microsoft\Windows NT\CurrentVersion\Fonts")
    if vals is None:
        return None
    return {v.replace("\\", "/").rsplit("/", 1)[-1].lower() for v in vals.values()}


def expected_font_replacements(runtime=None):
    """The replacement map a prefix should carry: the runtime's fonts.json when present, else
    the builtin PROVISION_FONT_REPLACEMENTS. ONE definition, shared by `prefix provision` (which
    writes it) and `fonts check` (which verifies it), so both agree on what "intact" means."""
    fonts = dict(PROVISION_FONT_REPLACEMENTS)
    if runtime:
        try:
            with open(os.path.join(runtime, "fonts.json")) as f:
                bundled = json.load(f)
            if bundled:
                fonts = bundled
        except Exception as e:
            log(f"runtime fonts.json unreadable ({e}); using builtin map")
    return fonts


def _prefix_font_replacements(prefix):
    """The HKCU\\Software\\Wine\\Fonts\\Replacements map as the prefix has it (user.reg), or
    None when unreadable."""
    return _reg_section_values(os.path.join(prefix, "user.reg"), r"Software\Wine\Fonts\Replacements")


def _family_registered_files(prefix, family):
    """Registered font files whose family name is `family`, as basenames.

    This is the check on a replacement TARGET: a map that says Segoe UI -> Adobe Clean is only a
    fix if Adobe Clean is actually present AND registered; pointing at a family that is not
    there is the original failure with an extra step. Looks at registered files in windows/Fonts
    and at registered host paths; parses name tables (nameID 1 + 16), filename-likely ones first
    and everything only if that finds nothing."""
    reg_vals = _reg_section_values(os.path.join(prefix, "system.reg"),
                                   r"Software\Microsoft\Windows NT\CurrentVersion\Fonts") or {}
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    paths = []
    for v in reg_vals.values():
        p = v.replace("\\", "/")
        if p[1:3] == ":/":                      # Z:/host/path or C:/windows/Fonts/x
            p = p[2:] if p[0].upper() == "Z" else os.path.join(fd, p.rsplit("/", 1)[-1])
        else:
            p = os.path.join(fd, p.rsplit("/", 1)[-1])
        if os.path.splitext(p)[1].lower() in (".ttf", ".otf", ".ttc") and os.path.isfile(p):
            paths.append(p)
    key = re.sub(r"[^a-z0-9]", "", family.lower())
    likely = [p for p in paths if key in re.sub(r"[^a-z0-9]", "", os.path.basename(p).lower())]
    hits = [os.path.basename(p) for p in likely if family in font_family_names(p)]
    if not hits:
        hits = [os.path.basename(p) for p in paths if p not in likely and family in font_family_names(p)]
    return sorted(set(hits))


ADOBE_CLEAN = "Adobe Clean"
_FONT_COPY_SUFFIX = (".ttf", ".otf")


def _is_adobe_clean_name(filename):
    return "adobeclean" in re.sub(r"[^a-z0-9]", "", filename.lower())


def _adobe_clean_in_fonts_dir(prefix):
    """Files in windows/Fonts whose family is Adobe Clean, registered or not."""
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    try:
        names = sorted(os.listdir(fd))
    except OSError:
        return []
    return [f for f in names
            if os.path.splitext(f)[1].lower() in _FONT_COPY_SUFFIX and _is_adobe_clean_name(f)
            and ADOBE_CLEAN in font_family_names(os.path.join(fd, f))]


def _adobe_clean_sources(prefix):
    """The Adobe Clean faces the Adobe apps installed in this prefix ship, one path per file name.

    Every Adobe app carries the family in its own folder -- Photoshop in Resources/ui-fonts,
    Lightroom Classic at the top of its install dir, Premiere in otf/ and AdobeCleanUX/, the
    Creative Cloud components in ACC/resources/fonts -- and none of them puts it in windows/Fonts,
    the only place the Segoe UI -> Adobe Clean replacement can reach it. Mud Hut used to copy
    Photoshop's ui-fonts only, so a prefix with just Lightroom (Classic or cloud), copied from
    Windows or downloaded, had no Adobe Clean at all (issue: the fonts check failed and Repair
    could not fix it). The walk stops four levels below Program Files/Adobe, which covers every
    layout above and skips the CEP extensions' web assets.

    ONE folder is used, so the same face is never registered twice in two formats (Lightroom
    Classic ships .ttf, the Creative Cloud components .otf): an app's own folder before the
    Creative Cloud components (the fallback for Lightroom, the cloud app, which ships only
    Adobe Clean UX), then the folder with the most Adobe Clean faces, then path order."""
    drive_c = os.path.join(prefix, "drive_c")
    by_dir = {}
    for root in (os.path.join(drive_c, "Program Files", "Adobe"),
                 os.path.join(drive_c, "Program Files (x86)", "Adobe")):
        if not os.path.isdir(root):
            continue
        base = root.rstrip(os.sep).count(os.sep)
        for d, dirs, files in os.walk(root):
            dirs.sort()
            if d.count(os.sep) - base >= 4:
                dirs[:] = []
            for f in sorted(files):
                if (os.path.splitext(f)[1].lower() not in _FONT_COPY_SUFFIX
                        or not _is_adobe_clean_name(f)):
                    continue
                p = os.path.join(d, f)
                if ADOBE_CLEAN in font_family_names(p):
                    by_dir.setdefault(d, []).append(p)
    if not by_dir:
        return []
    best = min(by_dir, key=lambda d: ("Adobe Creative Cloud" in d.split(os.sep), -len(by_dir[d]), d))
    return sorted(by_dir[best], key=lambda p: os.path.basename(p).lower())


def seed_adobe_clean(prefix):
    """Copy Adobe Clean into windows/Fonts from an installed Adobe app when windows/Fonts has
    none, so the replacement map points at a family that exists. Never overwrites a file; a
    prefix that already has Adobe Clean is left alone. register_prefix_fonts() must run after.
    Returns {ok, present, copied, sources, detail}; `present` is re-read from the prefix."""
    if _adobe_clean_in_fonts_dir(prefix):
        return {"ok": True, "present": True, "copied": [], "sources": [],
                "detail": "already in windows/Fonts"}
    srcs = _adobe_clean_sources(prefix)
    if not srcs:
        return {"ok": True, "present": False, "copied": [], "sources": [],
                "detail": "no installed Adobe app in this prefix ships Adobe Clean yet"}
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    os.makedirs(fd, exist_ok=True)
    have = {f.lower() for f in os.listdir(fd)}
    copied, errors = [], []
    for p in srcs:
        name = os.path.basename(p)
        if name.lower() in have:
            continue
        try:
            shutil.copyfile(p, os.path.join(fd, name))
            copied.append(name)
        except OSError as e:
            errors.append("%s: %s" % (name, e))
    rel = sorted({os.path.relpath(os.path.dirname(p), os.path.join(prefix, "drive_c")) for p in srcs})
    present = bool(_adobe_clean_in_fonts_dir(prefix))
    return {"ok": present, "present": present, "copied": copied, "sources": rel,
            "detail": ("copied %d file%s from %s" % (len(copied), "" if len(copied) == 1 else "s",
                                                     ", ".join(rel)))
                      + ("; failed: " + "; ".join(errors) if errors else "")}


def _unregistered_prefix_fonts(prefix):
    """Font files in windows/Fonts that no HKLM Fonts value names, or None when system.reg is
    unreadable. Copying a font in is not enough (register_prefix_fonts() explains why)."""
    reg = _registered_font_basenames(prefix)
    if reg is None:
        return None
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    try:
        files = sorted(os.listdir(fd))
    except OSError:
        return []
    return [f for f in files
            if os.path.splitext(f)[1].lower() in _FONT_REG_SUFFIX and f.lower() not in reg]


def fonts_verdict(prefix):
    """The plain-English font verdict for a prefix. Read-only; never starts wine.

    Returns {status, summary, checks, repair, apps_running, note?} where status is
      bad   an Adobe app will fail to start (or Photoshop's menu bar will be blank),
      warn  the apps start, but something in the prefix is invisible to them,
      good  nothing for Repair to do.
    `summary` is the one sentence Collider shows; each check carries its own `detail`.
    `repair` lists what `neutron fonts repair` would do, in order -- empty when good."""
    checks, repair = [], []

    def add(name, status, detail, **extra):
        checks.append({"name": name, "status": status, "detail": detail, **extra})

    # 1. CoolType's default Roman face -- by PostScript name, never by filename or family.
    roman = _roman_default_status(prefix)
    genuine = [fn for fn, st, _ in roman if st == "real"]
    per_file = ", ".join(f"{fn}={st}" for fn, st, _ in roman)
    rows = [{"file": fn, "state": st, "detail": d} for fn, st, d in roman]
    if genuine:
        add("roman-default", "good",
            "CoolType can pick a genuine default face from " + ", ".join(genuine) +
            " (" + per_file + ")", files=rows)
    else:
        add("roman-default", "bad",
            "none of times.ttf, arial.ttf or cour.ttf is a genuine Microsoft font (" + per_file +
            "). CoolType then has no default Roman face, so After Effects fails at startup with "
            "'EGG Constructor IEggApp failed'; Premiere and Media Encoder share CoolType. Repair "
            "copies a genuine face from this machine, or installs the real Microsoft core fonts.",
            files=rows)
        repair.append("restore a genuine Times New Roman / Arial / Courier New")

    # 2. CoolType's cache -- the state our own remedy creates. Files can be genuine while the
    #    cache still serves Wine's substitutes; a files-only check passes on exactly that prefix.
    stale = _stale_roman_cache_records(prefix)
    caches = _cooltype_cache_dirs(prefix)
    if stale:
        served = sorted({s[1] for s in stale})
        add("cooltype-cache", "bad",
            "CoolType's cache offers no genuine default Roman face (it serves " +
            ", ".join(served) + "), so the apps never read the " +
            ("genuine files that are on disk" if genuine else "font files") +
            " -- After Effects fails at startup regardless of the files. Repair deletes the "
            "cache; Adobe rebuilds it on the next launch.",
            stale=[{"font": w, "cached": c, "cache": p} for w, c, p in stale])
        repair.append("delete CoolType's stale font cache (Adobe rebuilds it)")
    elif not caches:
        add("cooltype-cache", "good", "no CoolType cache on disk yet (Adobe writes one on first launch)")
    else:
        add("cooltype-cache", "good",
            "%d CoolType cache%s on disk, each naming a genuine default Roman face"
            % (len(caches), "" if len(caches) == 1 else "s"))

    # 3. The real Microsoft core fonts -- the video trio's startup requirement.
    present, missing = _ms_core_fonts_status(prefix)
    if missing:
        add("ms-core-fonts", "bad",
            "%d of the 6 Microsoft core fonts are missing (%s). Premiere, After Effects and Media "
            "Encoder are known to fail at startup without the real set, and Wine's own substitutes "
            "do not count. Repair installs them (Microsoft's font installers, ~4 MB on first use)."
            % (len(missing), ", ".join(missing)), present=present, missing=missing)
        repair.append("install the Microsoft core fonts")
    else:
        add("ms-core-fonts", "good", "all 6 Microsoft core fonts present (" +
            ", ".join(_MS_CORE_FONTS) + ")", present=present, missing=[])

    # 4. The font replacement map (HKCU\\Software\\Wine\\Fonts\\Replacements). Adobe asks for
    #    Segoe UI, Calibri, MS Gothic, the Noto CJK set... none of which is redistributable and
    #    none of which is in any prefix; the redirect to Adobe Clean is permanent infrastructure.
    #    Without it dwrite's FindFamilyName returns NULL, AdobeOwl dereferences it, a critsec
    #    leaks and Photoshop deadlocks at startup / on File > New -- and nothing on screen says
    #    "font". Both halves are verified: the entries, AND that the target they point at is
    #    present and registered (a map pointing at an absent family is the same failure with an
    #    extra step). Added 2026-09-13 at the operator's request.
    expected = expected_font_replacements(resolve_runtime())
    have = _prefix_font_replacements(prefix)
    rep_missing, rep_differ, rep_absent = [], {}, []
    if have is None:
        add("replacements", "warn", "user.reg is unreadable, so the font replacement map is unknown")
    else:
        rep_missing = [k for k in expected if k not in have]
        rep_differ = {k: have[k] for k in expected if k in have and have[k] != expected[k]}
        targets = sorted(set(expected.values()) | set(rep_differ.values()))
        reg_readable = _registered_font_basenames(prefix) is not None
        target_files = {t: (_family_registered_files(prefix, t) if reg_readable else []) for t in targets}
        rep_absent = [t for t in targets if not target_files[t]] if reg_readable else []
        n_exp, exp_targets = len(expected), ", ".join(sorted(set(expected.values())))
        shown = ", ".join(rep_missing[:4]) + (" and %d more" % (len(rep_missing) - 4) if len(rep_missing) > 4 else "")
        if rep_missing:
            add("replacements", "bad",
                "%d of the %d font replacements are missing (%s). Adobe asks for these fonts, "
                "which are not redistributable and are not in the prefix; without the redirect to "
                "%s dwrite returns nothing and Photoshop deadlocks at startup. Repair restores the map."
                % (len(rep_missing), n_exp, shown, exp_targets)
                + ("" if not rep_absent else " Also, %s is not present and registered in this prefix."
                   % ", ".join(rep_absent)),
                missing=rep_missing, absent_targets=rep_absent, differ=rep_differ)
            repair.append("restore %d font replacement entries" % len(rep_missing))
        elif rep_absent:
            clean_src = (sorted({os.path.relpath(os.path.dirname(p), os.path.join(prefix, "drive_c"))
                                 for p in _adobe_clean_sources(prefix)})
                         if ADOBE_CLEAN in rep_absent and not _adobe_clean_in_fonts_dir(prefix) else [])
            add("replacements", "bad",
                "all %d font replacements are present, but they point at %s, which is not present "
                "and registered in this prefix -- the same Photoshop deadlock with an extra step. "
                % (n_exp, ", ".join(rep_absent))
                + ("Repair copies it into windows/Fonts from %s and registers it." % ", ".join(clean_src)
                   if clean_src else
                   "Repair registers what is in windows/Fonts; no installed Adobe app in this prefix "
                   "ships the family, so install one (every Adobe app carries Adobe Clean)."),
                missing=[], absent_targets=rep_absent, differ=rep_differ)
            if clean_src:
                repair.append("copy Adobe Clean into windows/Fonts from " + ", ".join(clean_src))
            repair.append("register the replacement target (%s)" % ", ".join(rep_absent))
        elif not reg_readable:
            add("replacements", "warn",
                "all %d font replacements are present, but system.reg is unreadable so whether %s "
                "is registered could not be verified" % (n_exp, exp_targets),
                missing=[], absent_targets=[], differ=rep_differ)
        elif rep_differ:
            add("replacements", "warn",
                "%d font replacement%s point%s somewhere other than the runtime's map (%s); the "
                "targets exist, so the apps start. Repair restores the map."
                % (len(rep_differ), "" if len(rep_differ) == 1 else "s", "s" if len(rep_differ) == 1 else "",
                   "; ".join("%s -> %s" % (k, v) for k, v in sorted(rep_differ.items())[:3])),
                missing=[], absent_targets=[], differ=rep_differ)
            repair.append("restore %d font replacement entries" % len(rep_differ))
        else:
            add("replacements", "good",
                "all %d font replacements intact, pointing at %s (present and registered: %s)"
                % (n_exp, exp_targets, ", ".join(sorted({f for fs in target_files.values() for f in fs})[:3])),
                missing=[], absent_targets=[], differ={})

    # 5. Registration -- a font the prefix merely HAS is invisible to the apps.
    unreg = _unregistered_prefix_fonts(prefix)
    fd = os.path.join(prefix, "drive_c", "windows", "Fonts")
    try:
        n_files = len([f for f in os.listdir(fd)
                       if os.path.splitext(f)[1].lower() in _FONT_REG_SUFFIX])
    except OSError:
        n_files = 0
    if unreg is None:
        add("registered", "warn", "system.reg is unreadable, so which fonts are registered is unknown")
    elif unreg:
        clean = [f for f in unreg if "adobeclean" in f.lower().replace("-", "").replace("_", "")]
        shown = ", ".join(unreg[:5]) + (" and %d more" % (len(unreg) - 5) if len(unreg) > 5 else "")
        if clean:
            add("registered", "bad",
                "Adobe Clean is in windows/Fonts but not registered (%s), so Photoshop's menu "
                "bar comes up blank. %d file%s unregistered in total: %s. Repair registers them."
                % (clean[0], len(unreg), "" if len(unreg) == 1 else "s", shown), files=unreg)
        else:
            add("registered", "warn",
                "%d font file%s in windows/Fonts %s not registered, so the apps cannot see %s: "
                "%s. Repair registers them."
                % (len(unreg), "" if len(unreg) == 1 else "s", "is" if len(unreg) == 1 else "are",
                   "it" if len(unreg) == 1 else "them", shown), files=unreg)
        repair.append("register %d font file%s with Wine" % (len(unreg), "" if len(unreg) == 1 else "s"))
    else:
        add("registered", "good",
            "all %d font files in windows/Fonts are registered" % n_files if n_files
            else "no font files in windows/Fonts yet", files=[])

    status = ("bad" if any(c["status"] == "bad" for c in checks)
              else "warn" if any(c["status"] == "warn" for c in checks) else "good")
    by = {c["name"]: c for c in checks}
    if by["roman-default"]["status"] == "bad":
        summary = ("After Effects will not start: none of Times New Roman, Arial or Courier New "
                   "in this prefix is a genuine Microsoft font")
    elif by["cooltype-cache"]["status"] == "bad":
        summary = ("After Effects will not start: CoolType's cache still points at Wine's "
                   "substitute fonts" + (" (the files themselves are genuine)" if genuine else ""))
    elif by["ms-core-fonts"]["status"] == "bad":
        summary = ("Premiere, After Effects and Media Encoder may not start: %d of the 6 "
                   "Microsoft core fonts are missing" % len(missing))
    elif by["replacements"]["status"] == "bad":
        summary = ("Photoshop will deadlock at startup: the font replacement map (Segoe UI and "
                   "others -> Adobe Clean) " +
                   ("is missing %d of %d entries" % (len(rep_missing), len(expected)) if rep_missing
                    else "points at %s, which is not in this prefix" % ", ".join(rep_absent)))
    elif by["registered"]["status"] == "bad":
        summary = "Photoshop's menu bar will be blank: Adobe Clean is in the prefix but not registered"
    elif by["replacements"]["status"] == "warn" and rep_differ:
        summary = ("%d font replacement%s differ from the runtime's map; the apps start, Repair "
                   "restores it" % (len(rep_differ), "" if len(rep_differ) == 1 else "s"))
    elif by["registered"]["status"] == "warn":
        summary = ("%d font file%s in the prefix %s not registered, so the apps cannot see %s"
                   % (len(unreg or []), "" if len(unreg or []) == 1 else "s",
                      "is" if len(unreg or []) == 1 else "are", "it" if len(unreg or []) == 1 else "them")
                   if unreg else "which fonts are registered could not be determined")
    else:
        summary = ("Fonts are good: genuine Microsoft core fonts, CoolType's default face resolves, "
                   "the replacement map is intact, all %d font files registered" % n_files)

    out = {"status": status, "summary": summary, "checks": checks, "repair": repair}
    # `registered` last so the row reads: files -> cache -> core set -> map -> registration.
    # Collider greys out Repair while an app is running in the prefix; the CLI refuses anyway.
    procs = _prefix_procs(prefix)
    out["apps_running"] = sorted({comm for _pid, comm, is_app in procs if is_app})
    if procs:
        out["note"] = ("a wine session is live in this prefix; the registry file can lag a "
                       "font registration by up to ~30 s, and the apps only read fonts at startup")
    return out


def repair_prefix_fonts(wine, prefix):
    """Repair everything fonts_verdict() can flag, in order, and re-verify. Returns
    {before, steps, after}. Every step's `ok` is judged from a RE-READ of the prefix after the
    step, never from intent -- a step that reports what it meant to do is a guess.

    The cache is invalidated UNCONDITIONALLY, even when nothing else changed: CoolType's cache is
    keyed on filename, so any font overwritten in place (ours, or one the user copied in by hand)
    leaves a record pointing at what used to be there. Repairing the files and
    leaving the cache is how a build tester lost three days (2026-08-12)."""
    before = fonts_verdict(prefix)
    steps = []

    repaired, unrepaired, ran = _repair_roman_defaults(wine, prefix)
    roman = _roman_default_status(prefix)
    steps.append({"step": "roman_default", "ok": any(st == "real" for _f, st, _d in roman),
                  "repaired": repaired, "unrepaired": unrepaired, "fetched": ran,
                  "detail": ", ".join(f"{fn}={st}" for fn, st, _ in roman)})

    present, missing = _ms_core_fonts_status(prefix)
    if missing:
        ran2 = ran or install_corefonts(wine, prefix)   # the same fetch covers both
        present, missing = _ms_core_fonts_status(prefix)
        step = {"step": "ms_core_fonts", "ok": not missing, "fetched": ran2,
                "present": present, "missing": missing}
        if not ran2:
            step["detail"] = ("the Microsoft core fonts could not be downloaded; check the "
                              "connection and repair again")
        steps.append(step)
    else:
        steps.append({"step": "ms_core_fonts", "ok": True, "present": present, "missing": []})

    # The replacement map: rewrite every entry that is missing or differs from the expected map.
    expected = expected_font_replacements(resolve_runtime())
    have = _prefix_font_replacements(prefix) or {}
    to_write = [k for k in expected if have.get(k) != expected[k]]
    for k in to_write:
        reg_set(wine, prefix, r"HKCU\Software\Wine\Fonts\Replacements", k, "REG_SZ", expected[k])
    rep_step = {"step": "font_replacements", "ok": None, "restored": to_write}
    steps.append(rep_step)          # `ok` judged from a re-read after the registry has reached disk

    # The map's target: Adobe Clean copied in from an installed app when windows/Fonts has none.
    # Without this, a prefix with only Lightroom stayed "still broken after repair" for good.
    steps.append({"step": "adobe_clean", **seed_adobe_clean(prefix)})

    # Always: idempotent, and it is the only way a hand-copied font becomes visible.
    n = register_prefix_fonts(wine, prefix)
    steps.append({"step": "font_register", "ok": n > 0, "count": n})
    # 🚨 WAIT FOR THE REGISTRY TO REACH DISK before judging. `reg import` returns as soon as its
    # own process exits, but the prefix's wineserver lingers ~3 s behind wine's system processes
    # and only writes system.reg when it shuts down. The first version of this function re-read
    # the file inside that window and reported "Adobe Clean not registered -- Photoshop's menu
    # bar will be blank" right after a repair that had just registered it (throwaway prefix,
    # 2026-09-13). Only system processes can be alive here (an app makes the caller refuse), so
    # the server exits on its own; the timeout is a safety net, not an expected path.
    settled = wineserver_wait(wine, prefix, timeout=30)
    if not settled:
        steps.append({"step": "registry_flush", "ok": False,
                      "detail": "a wine session is still live in this prefix, so system.reg "
                                "may lag the registration by up to ~30 s; re-run "
                                "`neutron fonts check` in a moment"})

    have = _prefix_font_replacements(prefix) or {}
    rep_step["ok"] = all(have.get(k) == v for k, v in expected.items())
    rep_step["detail"] = ("%d/%d entries as expected" % (sum(1 for k, v in expected.items() if have.get(k) == v),
                                                        len(expected)))

    ncache = invalidate_cooltype_caches(prefix)
    steps.append({"step": "cooltype_cache_invalidate", "ok": True, "count": ncache})

    after = fonts_verdict(prefix)
    return {"before": before, "steps": steps, "after": after}


def _print_fonts_verdict(v, indent=""):
    mark = {"good": "[ OK ]", "warn": "[WARN]", "bad": "[BAD ]"}
    print(f"{indent}fonts: {v['status'].upper()} -- {v['summary']}")
    for c in v["checks"]:
        print(f"{indent}  {mark[c['status']]} {c['name']:<16} {c['detail']}")
    if v.get("note"):
        print(f"{indent}  note: {v['note']}")


def cmd_fonts_check(args):
    """Re-verify a prefix's fonts. Read-only, never starts wine; exit 1 when status is bad
    (the same status-through-exit-code convention as doctor)."""
    prefix = resolve_prefix(args.prefix)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "prefix", None))},
            EX_BADPREFIX, args.json)
    v = fonts_verdict(prefix)
    if args.json:
        emit({"ok": True, "prefix": prefix, **v}, True)
    else:
        print(f"prefix: {prefix}")
        _print_fonts_verdict(v)
        if v["repair"]:
            print("repair would: " + "; ".join(v["repair"]))
            print(f"run: neutron fonts repair --prefix {prefix}")
    return EX_OK if v["status"] != "bad" else EX_FAIL


def cmd_fonts_repair(args):
    """Repair a prefix's fonts (see repair_prefix_fonts). Refuses to touch the prefix through a
    runtime that would re-stamp it, and while an Adobe app is running in it."""
    prefix = resolve_prefix(args.prefix)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "prefix", None))},
            EX_BADPREFIX, args.json)
    wine, is_neutron = resolve_wine()
    if not wine:
        die({"ok": False, "reason": NO_RUNTIME_MSG}, EX_DEP, args.json)
    if not is_neutron:
        die({"ok": False, "reason": "resolved wine is not a Neutron runtime; refusing to touch the "
                                    "prefix (distro wine would wineboot-clobber it)"},
            EX_DEP, args.json)
    mismatch = stamp_mismatch(prefix, wine)
    if mismatch and not getattr(args, "allow_restamp", False):
        die({"ok": False,
             "reason": "this runtime would RE-STAMP the prefix and revert its patched natives; "
                       "refusing to repair fonts through it",
             "hint": "run it with the runtime this prefix is stamped for: "
                     "NEUTRON_WINE_VERSION=<ver> neutron fonts repair --prefix %s" % prefix,
             **mismatch}, EX_FAIL, args.json)
    # Adobe reads fonts and writes CoolType's cache during startup; a repair under a running app
    # can neither take effect nor be verified until the app restarts, and the app could write
    # the stale cache straight back at exit. Same rule (and exit code) as apply-display-fix.
    running = sorted({comm for _pid, comm, is_app in _prefix_procs(prefix) if is_app})
    if running:
        die({"ok": False, "reason": "an Adobe app is running in this prefix (%s); close it, then "
                                    "repair" % ", ".join(running), "apps_running": running},
            EX_RUNNING, args.json)

    res = repair_prefix_fonts(wine, prefix)
    ok = res["after"]["status"] != "bad"
    out = {"ok": ok, "prefix": prefix, **res}
    if not ok:
        out["reason"] = "still broken after repair: " + res["after"]["summary"]
    if args.json:
        emit(out, True)
    else:
        print(f"prefix: {prefix}")
        print(f"before: {res['before']['status'].upper()} -- {res['before']['summary']}")
        for s in res["steps"]:
            extra = {k: v for k, v in s.items() if k not in ("step", "ok")}
            print(f"  {'[ OK ]' if s['ok'] else '[FAIL]'} {s['step']:<26} " +
                  ", ".join(f"{k}={v}" for k, v in extra.items()))
        print("after:")
        _print_fonts_verdict(res["after"], indent="  ")
    return EX_OK if ok else EX_FAIL


# --- display scale --------------------------------------------------------------------------
# Adobe apps are System-DPI-aware: they read ONE dpi at startup, LogPixels = round(96 * scale).
# Each desktop reports its scale differently, so detection dispatches by compositor and falls
# back to a compositor-agnostic Wayland probe. Only Windows scale steps (dpi a multiple of 24:
# 100/125/150/175/200%...) render exactly: Adobe rounds its UI scale to 2 decimals, and at 170%
# Premiere's rulers drew 0.47% stretched. Collider passes --scale; this is the CLI's own source.

def _run_json(cmd, env=None):
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5,
                           env=env)
        return json.loads(r.stdout) if r.returncode == 0 and r.stdout else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def _scale_kde():
    """KDE: kscreen-doctor. Primary = the enabled output with priority 1, else the max."""
    if not have("kscreen-doctor"):
        return None
    data = _run_json(["kscreen-doctor", "--json"]) or {}
    outs = [o for o in data.get("outputs", []) if o.get("enabled") and o.get("scale")]
    if not outs:
        return None
    prim = next((o for o in outs if o.get("priority") == 1), None) or \
        max(outs, key=lambda o: float(o["scale"]))
    return {"scale": float(prim["scale"]), "output": prim.get("name"), "source": "kde"}


def _scale_gnome():
    """GNOME/Mutter: org.gnome.Mutter.DisplayConfig.GetCurrentState via busctl's JSON. Each
    logical monitor is (x, y, scale, transform, primary, monitors, props); use the primary."""
    if not have("busctl"):
        return None
    data = _run_json(["busctl", "--user", "--json=short", "call", "org.gnome.Mutter.DisplayConfig",
                      "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig",
                      "GetCurrentState"])
    try:
        lms = data["data"][2]
    except (TypeError, KeyError, IndexError):
        return None
    if not lms:
        return None
    lm = next((m for m in lms if m[4]), None) or max(lms, key=lambda m: float(m[2]))
    name = lm[5][0][0] if lm[5] else None
    return {"scale": float(lm[2]), "output": name, "source": "gnome"}


def _v120(scale, w=None, h=None):
    """Scale as a wp_fractional_scale client receives it: round(scale*120)/120. Hyprland <= 0.56.1
    prints 2 decimals (5/3 -> 1.67); pick the 1/120 step that divides the mode cleanly."""
    n = round(scale * 120)
    if w and h:
        for k in (n, n - 1, n + 1):
            if k > 0 and abs(k / 120 - scale) <= 0.0051 and (w * 120) % k == 0 \
                    and (h * 120) % k == 0:
                return k / 120
    return n / 120


def _scale_wlroots():
    """Sway (swaymsg) / Hyprland (hyprctl) / other wlroots (wlr-randr). No 'primary' exists:
    use the focused output (new windows open there), else the largest scale."""
    def pick(outs, source):
        if not outs:
            return None
        o = next((o for o in outs if o[2]), None) or max(outs, key=lambda o: o[1])
        return {"scale": o[1], "output": o[0], "source": source}
    desk = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or "hyprland" in desk:
        if have("hyprctl"):
            env = None
            if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
                wl = os.environ.get("WAYLAND_DISPLAY")
                inst = [i for i in _run_json(["hyprctl", "instances", "-j"]) or []
                        if not wl or i.get("wl_socket") == wl]
                env = ({**os.environ, "HYPRLAND_INSTANCE_SIGNATURE": inst[0]["instance"]}
                       if len(inst) == 1 else None)
            r = pick([(m.get("name"), _v120(float(m["scale"]), m.get("width"), m.get("height")),
                       bool(m.get("focused")))
                      for m in _run_json(["hyprctl", "-j", "monitors"], env) or []
                      if (m.get("scale") or 0) > 0], "hyprland")
            if r:
                return r
    elif have("swaymsg"):
        cmd = ["swaymsg", "-t", "get_outputs", "--raw"]
        sock_ok = bool(os.environ.get("SWAYSOCK"))
        if not sock_ok:   # upstream sway doesn't export SWAYSOCK to .desktop launches
            rt = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
            live = [sk for sk in glob.glob(f"{rt}/sway-ipc.{os.getuid()}.*.sock")
                    if os.path.exists("/proc/" + sk.rsplit(".", 2)[-2])]
            if len(live) == 1:
                cmd[1:1] = ["-s", live[0]]
                sock_ok = True
        if sock_ok:
            r = pick([(o.get("name"), _v120(float(o["scale"])), bool(o.get("focused")))
                      for o in _run_json(cmd) or []
                      if o.get("active") and not o.get("non_desktop")
                      and (o.get("scale") or 0) > 0], "sway")
            if r:
                return r
    if have("wlr-randr"):
        return pick([(o.get("name"), _v120(float(o["scale"])), False)
                     for o in _run_json(["wlr-randr", "--json"]) or []
                     if o.get("enabled") and (o.get("scale") or 0) > 0], "wlr-randr")
    return None


def _wayland_outputs(timeout=2.0):
    """Any compositor: per-output scale exactly as winewayland computes it (mode width over
    xdg-output logical width). A minimal stdlib Wayland client; None if it can't connect."""
    import socket
    import struct
    d = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
    path = d if d.startswith("/") else os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), d)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    ids, buf, outs, xdg = [1], bytearray(), {}, {}

    def new():
        ids[0] += 1
        return ids[0]

    def send(obj, op, p=b""):
        s.sendall(struct.pack("<II", obj, (8 + len(p)) << 16 | op) + p)

    def wstr(t):
        b = t.encode() + b"\0"
        return struct.pack("<I", len(b)) + b + bytes(-len(b) % 4)

    def rstr(b, o):
        n = struct.unpack_from("<I", b, o)[0]
        return b[o + 4:o + 3 + n].decode("utf-8", "replace"), o + 4 + n + (-n % 4)

    def roundtrip(handle):
        cb = new()
        send(1, 0, struct.pack("<I", cb))                       # wl_display.sync
        while True:
            while len(buf) >= 8:
                obj, so = struct.unpack_from("<II", buf)
                if len(buf) < so >> 16:
                    break
                body = bytes(buf[8:so >> 16])
                del buf[:so >> 16]
                if obj == cb:
                    return
                if obj == 1 and (so & 0xffff) == 0:
                    raise OSError("wl_display.error")
                handle(obj, so & 0xffff, body)
            chunk = s.recv(65536)
            if not chunk:
                raise OSError("closed")
            buf.extend(chunk)
    try:
        s.connect(path)
        reg, globs = new(), []
        send(1, 1, struct.pack("<I", reg))                     # wl_display.get_registry

        def on_global(obj, op, b):
            if obj == reg and op == 0:
                iface, o = rstr(b, 4)
                globs.append((struct.unpack_from("<I", b)[0], iface,
                              struct.unpack_from("<I", b, o)[0]))
        roundtrip(on_global)

        def bind(name, iface, ver):
            i = new()
            send(reg, 0, struct.pack("<I", name) + wstr(iface) + struct.pack("<II", ver, i))
            return i
        mgr = None
        for name, iface, ver in globs:
            if iface == "wl_output":
                outs[bind(name, iface, min(ver, 4))] = {"transform": 0, "int_scale": 1}
            elif iface == "zxdg_output_manager_v1":
                mgr = bind(name, iface, min(ver, 3))
        for oid in (outs if mgr else ()):
            x = new()
            send(mgr, 1, struct.pack("<II", x, oid))           # get_xdg_output
            xdg[x] = oid

        def on_event(obj, op, b):
            if obj in outs:
                o = outs[obj]
                if op == 0:
                    o["transform"] = struct.unpack_from("<i", b, len(b) - 4)[0]
                elif op == 1 and struct.unpack_from("<I", b)[0] & 1:
                    o["mode"] = struct.unpack_from("<ii", b, 4)
                elif op == 3:
                    o["int_scale"] = struct.unpack_from("<i", b)[0]
                elif op == 4:
                    o["name"] = rstr(b, 0)[0]
            elif obj in xdg:
                o = outs[xdg[obj]]
                if op == 0:
                    o["pos"] = struct.unpack_from("<ii", b)
                elif op == 1:
                    o["logical"] = struct.unpack_from("<ii", b)
                elif op == 3:
                    o.setdefault("name", rstr(b, 0)[0])
        roundtrip(on_event)
    except (OSError, struct.error):
        return None
    finally:
        s.close()
    res = []
    for o in outs.values():
        if "mode" not in o:
            continue
        mw, mh = o["mode"][::-1] if o["transform"] & 1 else o["mode"]   # logical is rotated, mode not
        lw = o.get("logical", (mw,))[0] or mw
        physical = lw == mw and o["int_scale"] > 1                     # Mutter physical layout
        sc = o["int_scale"] if physical else mw / lw
        # size: the mode in the desktop's orientation (a portrait 1080p reads 1080x1920). Without it
        # the position was the only pair of numbers shown, and a reporter read it as a wrong
        # resolution (GitHub Neutron#20).
        res.append({"output": o.get("name"), "pos": tuple(o.get("pos", (0, 0))),
                    "size": (mw, mh), "scale": round(sc * 120) / 120})
    return res


def _scale_probe():
    """Generic fallback: Wine's primary rule (the output at 0,0), else the largest scale."""
    outs = _wayland_outputs()
    if not outs:
        return None
    o = next((o for o in outs if o["pos"] == (0, 0)), None) or max(outs, key=lambda o: o["scale"])
    return {"scale": o["scale"], "output": o["output"], "source": "wayland"}


def detect_scale_info():
    """{scale, dpi, output, source, windows_step} for the monitor Adobe will start on, or None."""
    desk = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    if "kde" in desk or "plasma" in desk:
        order = (_scale_kde, _scale_probe)
    elif "gnome" in desk:
        order = (_scale_gnome, _scale_probe)
    elif (os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or os.environ.get("SWAYSOCK")
          or any(w in desk for w in ("hyprland", "sway", "river", "wayfire", "labwc"))):
        order = (_scale_wlroots, _scale_probe)
    else:
        order = (_scale_kde, _scale_gnome, _scale_wlroots, _scale_probe)
    for fn in order:
        try:
            r = fn()
        except Exception:
            r = None
        if r and r.get("scale", 0) > 0:
            dpi = round(96 * r["scale"])
            return {**r, "dpi": dpi, "windows_step": dpi % 24 == 0}
    return None


def detect_scale():
    """Back-compat: just the scale (float) or None."""
    info = detect_scale_info()
    return info["scale"] if info else None


def collider_manual_scale():
    """Collider's Preferences > Display scale when it is set to a value rather than Auto, else None.

    Collider stores it in ~/.config/collider/config.json (`scale_mode: "manual"`, `scale_value`) and
    used to apply it only by passing --scale to the launches IT started. A launch from the app menu
    or a desktop icon ran `neutron launch <app>` without --scale and detected the desktop's scale
    again, so the setting did nothing there (GitHub Neutron#16: 100% in Collider fixed Premiere's
    clicks, but the desktop icon still opened it at 125%). The same file collider_selected_prefix()
    reads. Unreadable, missing or out of range means "not set"."""
    try:
        with open(os.path.join(collider_config_dir(), "config.json"),
                  encoding="utf-8") as f:
            cfg = json.load(f)
        if cfg.get("scale_mode") != "manual":
            return None
        v = float(cfg.get("scale_value"))
    except Exception:
        return None
    return v if 0.5 <= v <= 8 else None


def resolve_launch_scale(cli_scale=None):
    """(scale, source) for a launch: --scale, then Collider's manual setting, then the desktop's
    own scale. Every launch surface goes through here, so they all agree. (None, None) when
    nothing can tell."""
    if cli_scale:
        return cli_scale, "--scale"
    v = collider_manual_scale()
    if v:
        return v, "collider setting"
    info = detect_scale_info()
    return (info["scale"], info["source"]) if info else (None, None)


def windows_step_warning(dpi):
    """The warning shown when a scale isn't a Windows step, or None."""
    if dpi is None or dpi % 24 == 0:
        return None
    return ("display scale %d%% isn't a Windows scale step; Adobe apps may draw slightly "
            "misaligned. Use 100, 125, 150 or 200%% (or 175%% where your desktop offers it)."
            % round(dpi * 100 / 96))


def ensure_dxvk_gpl(conf_path, full_body=None):
    """Ensure the DXVK config exists and carries the graphics-pipeline-library workaround.

    ⚠️ If the file has to be CREATED and we know the app's full config, write the full config --
    not just the one workaround line. Writing a one-line stub here is what bit a build tester on
    2026-08-08: the stub satisfied every later "does the conf exist?" check, so the app ran on
    DXVK's defaults (which report an AMD GPU on an NVIDIA card) and provision would not replace it.
    Appending to an EXISTING file stays minimal -- it may carry the user's own tuning."""
    try:
        if os.path.isfile(conf_path):
            with open(conf_path) as f:
                if "enableGraphicsPipelineLibrary" in f.read():
                    return
            with open(conf_path, "a") as f:
                f.write(DXVK_GPL_LINE + "\n")
            return
        os.makedirs(os.path.dirname(conf_path), exist_ok=True)
        with open(conf_path, "w") as f:
            f.write(full_body if full_body else DXVK_GPL_LINE + "\n")
    except Exception as e:
        log(f"dxvk gpl workaround write failed (non-fatal): {e}")


def _display_fix_value(content):
    """The display-fix key's current value ("true"/"false", lowercased), or None when the key is absent."""
    for raw in content.splitlines():
        line = raw.rstrip("\r").lstrip("\ufeff")
        if line.startswith(DISPLAY_FIX_KEY + "\t"):
            parts = line.split("\t")
            return parts[1].strip().lower() if len(parts) >= 2 else ""
    return None


def _display_fix_matches(content, want):
    """True iff this Debug Database already has the value Neutron wants. An absent key means Adobe's
    default, which is right when that is what Neutron wants (Premiere 2026+)."""
    cur = _display_fix_value(content)
    return cur == want or (cur is None and want == DISPLAY_FIX_DEFAULT)


def _display_fix_is_on(content):
    """True iff the display-fix key is present AND its current value is 'true'.

    Parses line by line, splits on tab, strips CR. Robust against the line's
    trailing whitespace (Premiere writes this line with a double CRLF).
    """
    for raw in content.splitlines():
        line = raw.rstrip("\r")
        if line.startswith(DISPLAY_FIX_KEY + "\t"):
            parts = line.split("\t")
            if len(parts) >= 2 and parts[1].strip().lower() == "true":
                return True
            return False
    return False


# --- commands --------------------------------------------------------------

WINE_SYSTEM_PROCS = {
    "wineserver", "services.exe", "winedevice.exe", "plugplay.exe", "explorer.exe",
    "svchost.exe", "rpcss.exe", "start.exe", "conhost.exe", "rundll32.exe", "tabtip.exe",
}


def _prefix_procs(prefix):
    """Live pids belonging to this prefix: [(pid, comm, is_app)].

    Detect by `environ WINEPREFIX=` + exe path, NEVER by cmdline substring -- wine's own system
    processes (services.exe, explorer.exe...) carry no 'wine'/'Adobe' text and would be missed,
    which is precisely how orphans accumulated and deadlocked Lightroom's loader lock.

    ⛔ Compare WINEPREFIX as a WHOLE NUL-separated entry, never as a substring of the joined
    environ. 2026-09-18: the substring test made ~/mudhut-accc own every process of
    ~/mudhut-accc2 -- so a full teardown of the first prefix would have killed the second's live
    session. Measured against a synthetic known-bad in tests/test_identity.py before the fix."""
    out = []
    want = ("WINEPREFIX=" + prefix.rstrip("/")).encode("utf-8", "replace")
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/environ", "rb") as f:
                entries = f.read().split(b"\0")
            if want not in entries:
                continue
            comm = open(f"/proc/{p}/comm").read().strip()
            out.append((int(p), comm, comm not in WINE_SYSTEM_PROCS))
        except Exception:
            pass
    return out


def _app_dir_token(app_id, prefix=None):
    """The install-directory segment that identifies a process as belonging to ONE app,
    e.g. 'Adobe Premiere Pro 2025' from 'drive_c/Program Files/Adobe/Adobe Premiere Pro 2025/...'.

    This is what makes an app-scoped teardown possible at all: every app in APP_PROFILES lives in
    its own directory under Program Files/Adobe, while Adobe's SHARED daemons (IPCBroker, CoreSync,
    Dynamic Link, CCX) live under Common Files/Adobe and therefore match NO app token. So a
    per-app kill can never take out the machinery another running app depends on."""
    prof = APP_PROFILES.get(app_id)
    if not prof:
        return None
    # Resolve the profile's VERSION-LOCKED exe against the prefix first. The profiles are pinned to
    # the year they were written (…2025) and stay that way deliberately -- _resolve_app_exe is what
    # makes them version-agnostic. Reading prof["exe"] raw skips that, so on a 2026 install the token
    # was 'Adobe Photoshop 2025', matched no live process, and every app-scoped teardown became a
    # silent no-op that still reported success. Found by a build tester 2026-09-08.
    exe = _resolve_app_exe(prefix, prof["exe"]) if prefix else ""
    parts = (exe or prof["exe"]).replace("\\", "/").split("/")
    try:
        # LAST 'Adobe' segment: the install dir is <...>/Program Files/Adobe/<app dir>, and a prefix
        # path can itself contain an 'Adobe' component once we resolve to an absolute path.
        return parts[len(parts) - parts[::-1].index("Adobe")]
    except (ValueError, IndexError):
        return None


def _proc_win_exe(pid):
    """The WINDOWS exe path a wine process was started with, slash-normalised.
    /proc/<pid>/exe points at the wine loader, not the app -- cmdline[0] is the real identity."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().decode("utf8", "replace").split("\0")[0].replace("\\", "/")
    except Exception:
        return ""


def _app_procs(prefix, app_id):
    """Live pids in this prefix that belong to ONE app: [(pid, comm)]."""
    token = _app_dir_token(app_id, prefix)
    if not token:
        return []
    needle = "/" + token + "/"
    return [(pid, comm) for pid, comm, is_app in _prefix_procs(prefix)
            if is_app and needle in _proc_win_exe(pid)]


def _running_app_ids(prefix):
    """Which APP_PROFILES apps still have live processes in this prefix.

    Every installed YEAR of an app counts (`Adobe Photoshop 2025` beside `2026`): the token of
    the year `launch` would pick is not enough once two are installed, and this answer decides
    whether `update` may re-provision the prefix."""
    exes = {pid: _proc_win_exe(pid) for pid, _c, is_app in _prefix_procs(prefix) if is_app}
    out = []
    for app_id in APP_PROFILES:
        tokens = {_app_dir_token(app_id, prefix)}
        prof = APP_PROFILES[app_id]
        for exe in _app_exe_variants(prefix, prof["exe"]):
            parts = exe.replace("\\", "/").split("/")
            if "Adobe" in parts:
                try:
                    tokens.add(parts[len(parts) - parts[::-1].index("Adobe")])
                except (ValueError, IndexError):
                    pass
        tokens.discard(None)
        if any(("/" + t + "/") in e for t in tokens for e in exes.values()):
            out.append(app_id)
    return out


def _post_wm_close(wine, env, images):
    """`wine taskkill /im NAME` (no /F) for each image: post WM_CLOSE to every top-level window of every process of that
    name, so an app runs its own shutdown and writes its preferences. Returns the images that were SENT a WM_CLOSE.

    Wine's taskkill returns 0 when every matched process had a window to post to, and 128 when one had none (or none
    matched) -- Windows' "can only be terminated forcefully". A process that was sent nothing cannot answer, so the
    grace wait must not wait for it. It used to: Lightroom's Crash Processor and dynamiclinkmanager, then
    AdobeIPCBroker, are windowless, and each teardown sat out two full 25 s grace periods for them after Lightroom had
    already closed -- Collider's card said "Quitting…" for 51 s (lab, 2026-10-18; Neutron#27's reporter relaunched in
    that window). A taskkill that times out or fails to start counts as sent: unknown keeps the old, waiting behavior."""
    sent = set()
    for im in images:
        # ⚠️ No stamp guard here, and that is deliberate -- audited 2026-08-26 after the
        # build tester flagged teardown as an unguarded `wine` spawn. It cannot clobber:
        # we only reach this line when app processes exist, which means a wine session is
        # up, which means `__wineboot_event` exists, which makes `run_wineboot()` skip
        # launching wineboot entirely. See stamp_mismatch() for the full chain out of
        # wine's source. ⛔ Do NOT "fix" this by refusing a teardown -- if teardown can be
        # blocked, a stuck prefix cannot be recovered.
        try:
            r = subprocess.run([wine, "taskkill", "/im", im], env=env, timeout=25,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if r.returncode == 0:
                sent.add(im)
        except Exception:
            sent.add(im)
    return sent


def _proc_image(pid):
    """The Windows image name (`Lightroom.exe`) from /proc/<pid>/cmdline[0], as the full teardown names it."""
    try:
        cl = open(f"/proc/{pid}/cmdline", "rb").read().decode("utf8", "replace")
        return cl.split("\0")[0].replace("\\", "/").rsplit("/", 1)[-1]
    except Exception:
        return ""


def _teardown_app(args, prefix, wine, env):
    """Close ONE app, leaving every other app in the prefix running.

    Why this exists: all seven apps share a single prefix, and closing/reopening apps while working
    on a project is a normal workflow -- so the full-prefix teardown (wineserver -k, which is
    per-prefix and therefore kills EVERYTHING) is the wrong tool for a routine app close.

    Order: WM_CLOSE to this app's images only (so it saves its preferences) -> wait -> SIGTERM ->
    SIGKILL, always by literal pid and only for processes under this app's install directory.
    Adobe's shared daemons are deliberately left alone; they are reaped by the full teardown when
    the LAST app exits, because until then another app is still using them."""
    import time as _t

    app_id = args.app
    if app_id not in APP_PROFILES:
        die({"ok": False, "reason": f"unknown app '{app_id}'",
             "known": sorted(APP_PROFILES)}, EX_FAIL, args.json)

    before = _app_procs(prefix, app_id)
    if not before:
        # Report finding nothing as FINDING NOTHING, not as a successful teardown, and say what we
        # matched on. The old message claimed torn_down:True with killed:0, so a token that matched
        # no process was indistinguishable from an app that was already closed -- which is exactly
        # how the 2025/2026 token bug stayed invisible.
        emit({"ok": True, "app": app_id, "torn_down": False, "already_clean": True, "killed": 0,
              "matched_token": _app_dir_token(app_id, prefix),
              "note": "no live processes matched this app's install directory",
              "still_running": _running_app_ids(prefix)}, args.json)
        return

    # 1. graceful: WM_CLOSE via taskkill /IM so the app runs its own shutdown and writes prefs.
    #    /IM (image name), never /PID -- taskkill's /pid is a WINDOWS pid and everything we can see
    #    from /proc is a LINUX pid, so /pid silently matches nothing.
    if wine and not args.force:
        images = []
        for pid, _comm in before:
            exe = _proc_win_exe(pid).rsplit("/", 1)[-1]
            if exe.lower().endswith(".exe") and exe not in images:
                images.append(exe)
        sent = _post_wm_close(wine, env, images)
        if images:
            log(f"teardown[{app_id}]: asked to close: {', '.join(images)}")
        if set(images) - sent:
            log(f"teardown[{app_id}]: no window to close, not waited for: {', '.join(sorted(set(images) - sent))}")
        for _ in range(args.grace):
            if not [p for p in _app_procs(prefix, app_id) if _proc_win_exe(p[0]).rsplit("/", 1)[-1] in sent]:
                break
            _t.sleep(1)

    # 2. escalate on this app's pids ONLY.
    for sig in (signal.SIGTERM, signal.SIGKILL):
        left = _app_procs(prefix, app_id)
        if not left:
            break
        for pid, _comm in left:
            try:
                os.kill(pid, sig)
            except Exception:
                pass
        for _ in range(10):
            if not _app_procs(prefix, app_id):
                break
            _t.sleep(1)

    left = _app_procs(prefix, app_id)
    others = [a for a in _running_app_ids(prefix) if a != app_id]

    # 3. Last one out reaps the shared machinery. While ANY app is still up, Adobe's shared daemons
    #    are in use -- killing them is what wedges the next launch, so we only sweep when the
    #    prefix is otherwise idle.
    swept = False
    if not left and not others:
        log(f"teardown[{app_id}]: last app out -- sweeping shared daemons + wineserver")
        args.app = None
        cmd_teardown(args, _emitted=True)
        swept = True

    emit({"ok": not left, "app": app_id, "torn_down": not left,
          "killed": len(before) - len(left), "still_alive": [c for _p, c in left],
          "still_running": others, "swept_prefix": swept}, args.json)
    if left:
        sys.exit(EX_FAIL)


def cmd_teardown(args, _emitted=False):
    """Close a prefix down CLEANLY, then make sure nothing survives.

    ⚠️ This is the FULL-PREFIX teardown: wineserver is per-prefix, so it takes down every app in
    the prefix. For a routine "the user closed one app" use `--app <id>` (_teardown_app), which
    leaves the other apps running.

    Two things this exists for, both learned painfully:
      1. Adobe apps write their preferences ON CLEAN EXIT. A bare `wineserver -k` kills them
         outright, so everything the user changed that session (workspace layout, colour settings,
         panel state) is silently discarded. We first ask each app window to close via `taskkill`
         WITHOUT /F, which posts WM_CLOSE and lets the app run its own shutdown path.
      2. `wineserver -k` alone leaves Adobe's daemons and wine's system processes running. They
         accumulate across launches and break the NEXT app -- Lightroom deadlocks on ntdll's
         loader_section with its licensing threads stuck behind them.

    Order: graceful WM_CLOSE -> wineserver -k (SIGINT, unwinds children) -> -k9 -> sweep survivors
    by literal pid -> clear stale server dirs. NEVER -k9 first: that orphans children mid-wait."""
    prefix = resolve_prefix(args.prefix)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "prefix", None) or getattr(args, "path", None))},
            EX_BADPREFIX, args.json)
    wine, _ = resolve_wine()
    env = dict(os.environ, WINEPREFIX=prefix)
    import time as _t

    # A routine app close is app-scoped; only "shut the whole prefix down" comes through here.
    if getattr(args, "app", None):
        return _teardown_app(args, prefix, wine, env)

    before = _prefix_procs(prefix)
    if not before:
        if not _emitted:
            emit({"ok": True, "torn_down": True, "already_clean": True, "killed": 0}, args.json)
        return

    # 1. graceful: let the apps save their preferences.
    # ⚠️ Use /IM (image name), NOT /PID: taskkill's /pid takes a WINDOWS pid, and everything we can
    # see from /proc is a LINUX pid. Passing the Linux pid silently matches nothing, which made the
    # whole graceful step a no-op the first time this was written.
    if wine and not args.force:
        images = []
        for pid, _comm, is_app in before:
            if not is_app:
                continue
            try:
                cl = open(f"/proc/{pid}/cmdline", "rb").read().decode("utf8", "replace")
                exe = cl.split("\0")[0].replace("\\", "/").rsplit("/", 1)[-1]
                if exe.lower().endswith(".exe") and exe not in images:
                    images.append(exe)
            except Exception:
                pass
        sent = _post_wm_close(wine, env, images)
        if images:
            log(f"teardown: asked {len(images)} app(s) to close: {', '.join(images)}")
        if set(images) - sent:
            log(f"teardown: no window to close, not waited for: {', '.join(sorted(set(images) - sent))}")
        for _ in range(args.grace):
            if not [p for p in _prefix_procs(prefix) if p[2] and _proc_image(p[0]) in sent]:
                break
            _t.sleep(1)

    # 2/3. graceful server shutdown, then hard
    ws = os.path.join(os.path.dirname(wine), "wineserver") if wine else None
    for flag in ("-k", "-k9"):
        if ws and os.path.exists(ws) and _prefix_procs(prefix):
            try:
                subprocess.run([ws, flag], env=env, timeout=60,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
            for _ in range(20):
                if not _prefix_procs(prefix):
                    break
                _t.sleep(1)

    # 4. sweep survivors, killing by LITERAL pid (a shell "$PIDS" splat fires nothing under zsh)
    for _ in range(3):
        survivors = _prefix_procs(prefix)
        if not survivors:
            break
        for pid, comm, _is_app in survivors:
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
        _t.sleep(2)

    left = _prefix_procs(prefix)
    if not left:
        # 🚨 2026-09-18: this used to rmtree EVERY /tmp/.wine-<uid>/server-* directory, not just
        # this prefix's. Tearing down one prefix while another was still running deleted the live
        # one's socket directory; the next process into that prefix cannot find its wineserver and
        # starts a SECOND one, so the app loses its own daemons and writes prefs into a registry
        # that is then discarded. wineserver names the directory server-<dev>-<ino> of the prefix
        # (server/request.c init_server_dir), so derive it and remove exactly that one.
        try:
            st = os.stat(prefix)
            only = "/tmp/.wine-%d/server-%x-%x" % (os.getuid(), st.st_dev, st.st_ino)
        except OSError:
            only = None
        if only and os.path.isdir(only):
            try:
                shutil.rmtree(only)
            except Exception:
                pass
    if not _emitted:
        emit({"ok": not left, "torn_down": not left, "killed": len(before) - len(left),
              "still_alive": [c for _p, c, _a in left]}, args.json)
        if left:
            sys.exit(EX_FAIL)


def cmd_prefix_info(args):
    """Inspect a prefix; report the paths Collider needs.

    NOTE: schema PROVISIONAL (v0-unstable). The hardening brief's ordering note
    says prefix info / doctor JSON must not be frozen until the minimal-stack
    cleanup (§5.2) confirms which components ship. Stable fields below are
    documents_real and display_fix_applied; neutron_stack is best-effort.
    """
    prefix = resolve_prefix(args.path)
    if not prefix:
        # Was a bare "no drive_c found at path" — which names no path, lists nothing, and is the
        # same dead end the tester hit. Explain, and offer the candidates.
        die({"valid": False, **bad_prefix_reason(args.path)}, EX_BADPREFIX, args.json)

    user = prefix_user(prefix)
    if not user:
        die({"valid": False, "reason": "no user dir under drive_c/users"},
            EX_BADPREFIX, args.json)

    link, real = documents_paths(prefix, user)
    dbg = find_debug_database(prefix, user)
    display_fix_applied = False
    if dbg and os.path.isfile(dbg):
        try:
            with open(dbg, "r", encoding="utf-8", errors="replace") as f:
                content = f.read()
            # "Applied" = the value Neutron wants for this Premiere version (Premiere 2026+: Adobe's default).
            display_fix_applied = _display_fix_matches(content, _display_fix_wanted("premiere", dbg, prefix))
        except OSError:
            display_fix_applied = False

    out = {
        "valid": True,
        "wineprefix": prefix,
        "drive_c": os.path.join(prefix, "drive_c"),
        "user": user,
        "documents_symlink": link,
        "documents_real": real,          # <- symlink-resolved real Documents dir
        "debug_database": dbg,
        "display_fix_applied": display_fix_applied,
        "neutron_stack": _stack_versions(),  # best-effort, provisional
        "_schema": "provisional-v0",      # signal: not frozen yet
    }
    emit(out, args.json)
    return EX_OK


def _stack_versions():
    """Best-effort stack version probe. Provisional until minimal stack settles."""
    stack = {}
    try:
        r = subprocess.run(["wine", "--version"],
                           capture_output=True, text=True, timeout=10)
        stack["wine"] = r.stdout.strip() or None
    except Exception:
        stack["wine"] = None
    # DXVK / vkd3d versions live in the deployed DLLs; reading them reliably is
    # part of the hardening pass. Left null until §5.2 pins them.
    stack["dxvk"] = None
    stack["vkd3d"] = None
    return stack


def _has_marker(path, marker):
    """True if the binary contains `marker` (bytes). Used to prove a FIX is in the
    artifact on disk, not merely that a file of the right name exists.

    Size and mtime are worthless here: we patch wine's own builtins, so a reverted
    or debug build has the same name and a plausible size. 2026-08-08 cost a full
    day to exactly that — `nvcuda.dll` was present, correct size, and was the
    ungated diagnostic build."""
    try:
        with open(path, "rb") as f:
            return marker in f.read()
    except OSError:
        return False


def _apply_display_fix_apps(prefix, user, running):
    """Apply the display fix to every DVA app (Premiere, After Effects, Media Encoder) installed in
    `prefix`, skipping any that is running. No output. Returns (results, any_changed, any_target).
    Shared by `prefix apply-display-fix` and `launch`."""
    results, any_changed, any_target = [], False, False
    for label, dbg, installed in find_debug_databases(prefix, user):
        if not installed:
            results.append({"app": label, "state": "not-installed"})
            continue
        any_target = True
        if label in running:
            results.append({"app": label, "state": "running",
                            "reason": "%s is running in this prefix; its prefs are left "
                                      "alone until it exits" % label})
            continue
        # Premiere keeps one Debug Database PER VERSION (Premiere Pro/25.0, 26.0) and the value differs by
        # version (PREMIERE_DIRECTX_DISPLAY_FROM), so every one is set, not only the highest.
        dbgs = [dbg] if dbg else []
        if label == "premiere" and dbg:
            dbgs = sorted(h for h in glob.glob(os.path.join(os.path.dirname(os.path.dirname(dbg)), "*",
                                                            "Debug Database.txt"))
                          if ".bak" not in h and "Team Projects" not in h)
        if dbgs:
            for one in dbgs:
                want = _display_fix_wanted(label, one, prefix)
                try:
                    state = _apply_display_fix_to(one, want)
                except OSError as e:
                    results.append({"app": label, "state": "error", "reason": str(e)})
                    continue
                any_changed |= (state == "changed")
                results.append({"app": label, "state": state, "debug_database": one,
                                "value": want})
        else:
            # The app is installed but has never written its prefs. Adobe creates this file
            # itself on a clean exit, so on a never-run app there is nothing to edit -- which
            # is exactly the state Media Encoder was found in on a real install. Create it
            # carrying only our line; these are debug OVERRIDES, so absent keys simply take
            # their defaults, and the app rewrites the file in its own style when it exits.
            # Proven 2026-08-09 by deleting Premiere's, writing a one-line file and launching.
            vdir = _display_fix_pref_dir(prefix, user, label)
            if not vdir:
                results.append({"app": label, "state": "pending-first-run"})
                continue
            if _display_fix_wanted(label, vdir, prefix) == DISPLAY_FIX_DEFAULT:
                # Premiere 2026+ wants Adobe's default, which an absent file already is.
                results.append({"app": label, "state": "already", "value": DISPLAY_FIX_DEFAULT})
                continue
            try:
                os.makedirs(vdir, exist_ok=True)
                path = os.path.join(vdir, "Debug Database.txt")
                with open(path, "w", encoding="utf-8", newline="") as f:
                    f.write(f"{DISPLAY_FIX_KEY}\t{DISPLAY_FIX_CURRENT}"
                            f"\t{DISPLAY_FIX_DEFAULT}\r\n")
            except OSError as e:
                results.append({"app": label, "state": "error", "reason": str(e)})
                continue
            any_changed = True
            results.append({"app": label, "state": "created", "debug_database": path})
    return results, any_changed, any_target


def _display_fix_before_launch(prefix):
    """Apply the display fix on the way into every launch, the way Collider does, so launches from
    the app menu, the dock, a file association or a terminal get it too (2026-10-09: only
    Collider applied it, so a user who never launched through Collider never got it). Best-effort:
    an app that is running is skipped, any failure is logged to stderr, and the launch always
    goes ahead. Never writes to stdout, which carries `launch --json`."""
    try:
        user = prefix_user(prefix)
        if not user:
            return
        results, _, _ = _apply_display_fix_apps(prefix, user, set(_running_app_ids(prefix)))
        for r in results:
            if r["state"] in ("changed", "created"):
                log(f"display fix {r['state']}: {r['debug_database']}")
            elif r["state"] == "error":
                log(f"display fix skipped for {r['app']}: {r['reason']}")
    except Exception as e:   # never block a launch on a display preference
        log(f"display fix skipped: {e}")


def cmd_apply_display_fix(args):
    """Write DS.DisableDirectXDisplay=true into Debug Database.txt. Idempotent."""
    prefix = resolve_prefix(args.path)
    if not prefix:
        die({"changed": False, **bad_prefix_reason(getattr(args, "prefix", None) or getattr(args, "path", None))},
            EX_BADPREFIX, args.json)

    # Which of the apps whose prefs this edits are live IN THIS PREFIX. Adobe rewrites its Debug
    # Database on exit, so a write under a running app is lost at best and races Adobe's own
    # write at worst. Premiere keeps its historical exit-3 contract (Collider treats it as
    # best-effort and carries on); After Effects / Media Encoder are skipped per app so a running
    # AE no longer blocks Premiere's fix, and vice versa. One /proc pass, prefix-scoped.
    running = set(_running_app_ids(prefix))
    if "premiere" in running:
        die({"changed": False, "already_applied": False,
             "premiere_running": True,
             "reason": "Premiere is running; cannot edit prefs"},
            EX_RUNNING, args.json)

    user = prefix_user(prefix)
    if user:
        results, any_changed, any_target = _apply_display_fix_apps(prefix, user, running)

        prem = next((r for r in results if r["app"] == "premiere"), {})
        payload = {"ok": True, "changed": any_changed,
                   "already_applied": bool(any_target) and not any_changed,
                   "premiere_running": False,
                   "debug_database": prem.get("debug_database"),
                   "apps": results}
        if not any_target:
            payload.update({"not_applicable": True,
                            "reason": "no Premiere/After Effects/Media Encoder in prefix"})
        for r in results:
            if r["state"] in ("changed", "created"):
                log(f"display fix {r['state']}: {r['debug_database']}")
        emit(payload, args.json)
        return EX_OK

    dbg = find_debug_database(prefix, user) if user else None
    if not dbg:
        # The display fix is PREMIERE-SPECIFIC (DirectXDisplay pref in Premiere's
        # Debug Database). On a prefix without Premiere (e.g. Photoshop), there is
        # nothing to apply — return no-op success so it doesn't abort a non-Premiere
        # launch. Only error if Premiere IS installed but hasn't been run yet.
        if not os.path.isfile(os.path.join(prefix, PREMIERE_SUBPATH)):
            emit({"ok": True, "changed": False, "already_applied": False,
                  "not_applicable": True,
                  "reason": "no Premiere in prefix; display fix not applicable"},
                 args.json)
            return EX_OK
        # Premiere IS installed but has never been run, so its Debug Database does not exist yet.
        # That is the NORMAL state before a first launch — not a failure. This used to die with
        # exit 1, and because Collider applies the display fix on the way into EVERY launch, a
        # prefix with a never-run Premiere could not launch ANY app: the fix aborted the flow
        # before the app was ever spawned. Reported by a build tester 2026-08-08 whose whole
        # freshly-installed suite was unlaunchable.
        #
        # Premiere writes this file itself on first run; we apply the fix on the next launch.
        # We do NOT fabricate the file — it is Adobe's, with a format (tab-separated
        # key/current/default, odd line endings) that Premiere rewrites on a clean exit.
        emit({"ok": True, "changed": False, "already_applied": False,
              "pending_first_run": True,
              "reason": "Premiere has not been run yet; the display fix applies on the next launch"},
             args.json)
        return EX_OK

    # Read raw so we preserve every byte of every line we don't manage.
    # Premiere writes this file with mixed/odd line endings (the display-fix
    # line ends with a double CRLF); we must not rewrite lines we don't own.
    try:
        with open(dbg, "r", encoding="utf-8", errors="replace", newline="") as f:
            raw = f.read()
    except OSError as e:
        die({"changed": False, "reason": f"read failed: {e}"}, EX_FAIL, args.json)

    # The proven line, byte-for-byte as Premiere writes it: tab-separated
    # key/current/default, value 'true', ending in CRLF. We use a single CRLF
    # (sufficient and well-formed); Premiere accepts it.
    new_line = f"{DISPLAY_FIX_KEY}\t{DISPLAY_FIX_CURRENT}\t{DISPLAY_FIX_DEFAULT}\r\n"

    # Already correctly applied? Detect without rewriting anything.
    if _display_fix_is_on(raw):
        emit({"ok": True, "changed": False, "already_applied": True,
              "premiere_running": False, "debug_database": dbg}, args.json)
        return EX_OK

    # Split on \n but KEEP it, so we can reassemble preserving each line's bytes.
    lines = raw.splitlines(keepends=True)
    out_lines = []
    found = False
    for ln in lines:
        # Compare on a CR-stripped copy; the key sits at line start.
        if ln.lstrip("\ufeff").startswith(DISPLAY_FIX_KEY + "\t"):
            found = True
            out_lines.append(new_line)   # replace ONLY this line
        else:
            out_lines.append(ln)         # preserve byte-for-byte

    if not found:
        # Append. Make sure the previous last line is newline-terminated so we
        # don't glue our line onto it — but don't touch its other bytes.
        if out_lines and not out_lines[-1].endswith(("\n", "\r")):
            out_lines[-1] = out_lines[-1] + "\r\n"
        out_lines.append(new_line)

    try:
        with open(dbg, "w", encoding="utf-8", newline="") as f:
            f.write("".join(out_lines))
    except OSError as e:
        die({"changed": False, "reason": f"write failed: {e}"}, EX_FAIL, args.json)

    log(f"display fix written to {dbg}")
    emit({"ok": True, "changed": True, "already_applied": False,
          "premiere_running": False, "debug_database": dbg}, args.json)
    return EX_OK


def _win_path(prefix, abspath):
    """Convert an absolute host path under <prefix>/drive_c to its Windows form
    (C:\\...). Returns None if abspath isn't under the prefix's C: drive."""
    dc = os.path.join(prefix, "drive_c") + os.sep
    ap = os.path.abspath(abspath)
    if not ap.startswith(dc):
        return None
    return "C:\\" + ap[len(dc):].replace("/", "\\")


# Photoshop reads a pen through WinTab only when its PSUserConfig.txt says `UseSystemStylus 0`. Without that line it
# uses Windows Ink, and under Wine Windows Ink delivers the pen as a plain mouse: no pressure, no tilt. The runtime's
# WinTab bridge supplies pressure, tilt and the eraser. Measured 2026-10-20 on a Cintiq 22HD (GitHub neutron-wine#1):
# with no file Photoshop 2026 never loaded WinTab32.dll and drew without pressure; with the line it opened a WinTab
# context and pressure worked. The July pen work had that line written by hand into its test prefix, so no
# Neutron-made prefix ever had it. An existing UseSystemStylus line is the user's choice and is left alone.
PS_USERCONFIG = "PSUserConfig.txt"
PS_WINTAB_LINE = "UseSystemStylus 0"


def ensure_photoshop_wintab(prefix):
    """Make every installed Photoshop in `prefix` read the pen through WinTab (see PS_WINTAB_LINE).

    Returns [(install dir name, "added" | "kept")]; nothing for a prefix without Photoshop.
    """
    user = prefix_user(prefix)
    if not user:
        return []
    appsdir = os.path.join(prefix, "drive_c", "Program Files", "Adobe")
    roaming = os.path.join(prefix, "drive_c", "users", user, "AppData", "Roaming", "Adobe")
    done = []
    for inst in sorted(glob.glob(os.path.join(appsdir, "Adobe Photoshop *"))):
        if not os.path.isfile(os.path.join(inst, "Photoshop.exe")):
            continue
        name = os.path.basename(inst)                       # "Adobe Photoshop 2026"
        settings = os.path.join(roaming, name, name + " Settings")
        path = os.path.join(settings, PS_USERCONFIG)
        text = ""
        if os.path.isfile(path):
            with open(path, encoding="utf-8", errors="replace", newline="") as f:
                text = f.read()
        if re.search(r"(?im)^\s*UseSystemStylus\b", text):
            done.append((name, "kept"))
            continue
        os.makedirs(settings, exist_ok=True)
        add = "" if not text or text.endswith("\n") else "\r\n"
        add += "# Neutron: read the pen through WinTab (pressure, tilt, eraser)\r\n" + PS_WINTAB_LINE + "\r\n"
        with open(path, "a", encoding="utf-8", newline="") as f:
            f.write(add)
        done.append((name, "added"))
    return done


# Lightroom Classic takes its UI scale once, at launch, from the screen its window was last on, and ignores the message
# Windows sends when a window moves to a screen of another scale. Measured 2026-10-21 on a 100% Cintiq beside a 175%
# screen: a +message trace shows WM_DPICHANGED going straight to DefWindowProc, and the only scale query in a whole
# run is substrate.dll's GetDpiForMonitor at launch. On Wayland the compositor, not the app, picks the screen a window
# opens on, so Lightroom came up at 100% on the 175% screen (and the reverse) and kept the wrong scale when moved.
# Windows gives such an app the right size on every screen with its "System" high-DPI override: the app draws at the
# main screen's scale and the system scales its window for each screen. This is the same setting, in the place Windows
# keeps it. With it, GetDpiForMonitor returns the main screen's dpi for every screen, and runtime 11.10-141 scales the
# window per screen. On a single screen nothing changes. A Layers value the user already has for Lightroom is kept.
# ⛔ Only with runtime 11.10-141 or newer: older runtimes drew such a window on a screen of another scale as a strip of
# itself, or never showed it (runtime 141's mixed-dpi patch), so the setting would break Lightroom on two screens there.
LRC_LAYERS_KEY = r"Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers"
LRC_LAYERS_NAME = "lightroom.exe"
LRC_LAYERS_FLAGS = "~ HIGHDPIAWARE"
LRC_LAYERS_MIN_RUNTIME = (11, 10, 141)


def runtime_version_of(wine):
    """(major, minor, build) of the Neutron runtime `wine` belongs to, from its NEUTRON_WINE_VERSION stamp, else its
    directory name (neutron-wine-11.10-141); None for anything else (a dev tree, system wine)."""
    root = os.path.dirname(os.path.dirname(os.path.realpath(wine)))
    try:
        with open(os.path.join(root, "NEUTRON_WINE_VERSION"), encoding="utf-8") as f:
            ver = f.read().strip()
    except OSError:
        name = os.path.basename(root)
        ver = name[len("neutron-wine-"):] if name.startswith("neutron-wine-") else ""
    m = re.match(r"^(\d+)\.(\d+)-(\d+)$", ver)
    return tuple(int(g) for g in m.groups()) if m else None


def ensure_lightroom_system_dpi(wine, prefix):
    """Give Lightroom Classic in `prefix` Windows' "System" high-DPI override (see LRC_LAYERS_FLAGS).

    Returns "added", "kept" (a Layers value for lightroom.exe exists), "old-runtime" (`wine` is older than
    LRC_LAYERS_MIN_RUNTIME or not a numbered release) or None (no Lightroom Classic, or user.reg unreadable). Reads
    user.reg on disk; writes through the runtime's reg.exe (reg_set), which only new processes see.
    """
    if not os.path.isfile(os.path.join(prefix, "drive_c", "Program Files", "Adobe", "Adobe Lightroom Classic",
                                       "Lightroom.exe")):
        return None
    version = runtime_version_of(wine)
    if not version or version < LRC_LAYERS_MIN_RUNTIME:
        return "old-runtime"
    values = _reg_section_values(os.path.join(prefix, "user.reg"), LRC_LAYERS_KEY)
    if values is None:
        return None
    if any(name.lower() == LRC_LAYERS_NAME for name in values):   # Wine looks the exe up by file name only
        return "kept"
    reg_set(wine, prefix, "HKCU\\" + LRC_LAYERS_KEY, LRC_LAYERS_NAME, "REG_SZ", LRC_LAYERS_FLAGS)
    return "added"


def provision_photoshop_detection(wine, prefix):
    """Register the Uninstall key Lightroom Classic's PS detector requires.

    LrC's scanner (in ui.dll) does a WHOLE-STRING std::regex_match of
    each HKLM\\...\\Uninstall SUBKEY NAME against `(PHSP|PHSPBETA)[0-9_]+`, then
    checks that subkey's InstallLocation + DisplayName + <InstallLocation>\\
    Photoshop.exe exist. The key name MUST be dot-free (a '.' is not in [0-9_],
    so `PHSP26.0` fails whole-string match — the bug that greyed Edit-In → PS).
    We name it `PHSP<major>` (major = year-1999, e.g. PS 2025 -> PHSP26) and write
    it into BOTH registry views (the detector opens with KEY_WOW64_32KEY, but be
    robust). No-op when no Photoshop is installed in the prefix.
    Returns a status dict (or None if PS absent)."""
    import re
    exe = _resolve_app_exe(prefix, _adobe("Adobe Photoshop 2025", "Photoshop.exe"))
    if not (exe and os.path.isfile(exe)):
        return None
    install_dir = os.path.dirname(exe)
    win_loc = _win_path(prefix, install_dir)
    if not win_loc:
        return {"ok": False, "reason": "PS install not under drive_c"}
    yrs = re.findall(r'(?:19|20)\d{2}', install_dir)
    year = max((int(y) for y in yrs), default=0)
    if not year:
        return {"ok": False, "reason": "no year in PS install path"}
    major = year - 1999                       # 2025 -> 26, 2026 -> 27
    keyname = "PHSP%d" % major                 # dot-free: matches (PHSP|PHSPBETA)[0-9_]+
    display = "Adobe Photoshop %d" % year
    for view in (r"HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
                 r"HKLM\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall"):
        base = "%s\\%s" % (view, keyname)
        reg_set(wine, prefix, base, "InstallLocation", "REG_SZ", win_loc)
        reg_set(wine, prefix, base, "DisplayName", "REG_SZ", display)   # required or the scan drops the record
        reg_set(wine, prefix, base, "DisplayVersion", "REG_SZ", "%d.0" % major)
    return {"ok": True, "key": keyname, "display": display, "install_location": win_loc}


# ============================================================================================
# THE DEFAULT NEUTRON THEME
#
# ⭐ OWNERSHIP, because this drifted repeatedly: **this is Neutron's default theme, and the CLI
# applies it.** Collider is the GUI front end — a graphical way to execute what the CLI already
# does — and its job with themes is to let the user CUSTOMIZE one, not to be the only thing that
# installs the default. Before 2026-09-11 the palette lived only in Collider's `core/theme.rs`,
# so a prefix provisioned and launched from the CLI or a .desktop entry never got the theme at
# all; it arrived only if the user happened to launch through the GUI at least once.
#
# ⛔ Unless the operator says otherwise, Collider must never be the sole owner of a behaviour.
#
# Two halves, and BOTH are required or the theme stops at the controls:
#
#   1. HKCU\Control Panel\Colors — the classic palette. Anything painted through GetSysColor
#      follows it: window frames, dialog backgrounds, list views, the Wine-drawn non-client area.
#
#   2. ThemeActive=0 — Wine's own wine.inf [ThemeManager] switches its bundled aero.msstyles ON in
#      every prefix, and comctl32 v6 controls then paint via uxtheme (PB_ThemedPaint), never
#      consulting GetSysColor. Aero's colour table is Windows-default LIGHT, so buttons and column
#      headers rendered light on an otherwise fully dark dialog — measured on 2026-09-11:
#      Open button face 255,255,255 -> 43,43,43 with the style off, while every surface that
#      already obeyed the palette was untouched.
DEFAULT_THEME_COLORS = {
    # title bar
    "ActiveTitle": "43 43 43", "GradientActiveTitle": "43 43 43", "TitleText": "224 224 224",
    "InactiveTitle": "32 32 32", "GradientInactiveTitle": "32 32 32",
    "InactiveTitleText": "140 140 140",
    "ActiveBorder": "43 43 43", "InactiveBorder": "32 32 32", "WindowFrame": "20 20 20",
    # menu bar
    "Menu": "43 43 43", "MenuText": "224 224 224", "MenuBar": "43 43 43",
    "MenuHilight": "64 64 64",
    # window / general
    "Window": "43 43 43", "WindowText": "224 224 224", "HilightText": "255 255 255",
    # classic scrollbar TRACK (the thumb and arrows follow the button palette below). Never set
    # before, so every Wine-drawn scrollbar had a light track -- the one bright strip left in the
    # restyled file dialog (2026-09-12). Windows' default is 200 200 200.
    "Scrollbar": "30 30 30",
    # dialogs + controls Wine draws itself. ⚠️ Darkening these is SAFE only because
    # neutron-wine zzzzzzzzzp/q/r moved the caption buttons, window frame and menu rule off the
    # button palette onto the caption/border colours. Before that, a dark ButtonFace put a white
    # outline around every window.
    "ButtonFace": "43 43 43", "ButtonHilight": "60 60 60", "ButtonLight": "50 50 50",
    "ButtonShadow": "30 30 30", "ButtonDkShadow": "16 16 16", "ButtonText": "224 224 224",
    "3DLight": "60 60 60", "3DDarkShadow": "20 20 20",
}


def theme_reg_text(colors=None):
    """REGEDIT4 text for a theme: the palette, then the visual-style switch.

    Kept as one function so the two halves cannot be applied separately — see the note above."""
    colors = DEFAULT_THEME_COLORS if colors is None else colors
    out = ["REGEDIT4", "", "; Generated by the Neutron CLI — default Neutron theme.",
           r"[HKEY_CURRENT_USER\Control Panel\Colors]"]
    for k in sorted(colors):
        out.append('"%s"="%s"' % (k, colors[k]))
    out += ["",
            "; Wine's wine.inf turns its bundled Aero visual style on in every prefix, and",
            "; comctl32 v6 controls then paint from IT rather than the palette above.",
            "; Switch it off so the theme we just wrote actually reaches them.",
            r"[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]",
            '"ThemeActive"="0"']
    return "\r\n".join(out) + "\r\n"


def apply_theme(wine, prefix, colors=None):
    """Import the theme into `prefix`. Returns a step dict. Idempotent."""
    import tempfile
    reg = theme_reg_text(colors)
    tmp_dir = os.path.join(prefix, "drive_c", "windows", "temp")
    try:
        os.makedirs(tmp_dir, exist_ok=True)
        path = os.path.join(tmp_dir, "neutron-theme.reg")
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(reg)
    except OSError as e:
        return {"ok": False, "reason": "write theme .reg: %s" % e}
    try:
        r = subprocess.run([wine, "regedit", r"C:\windows\temp\neutron-theme.reg"],
                           env=dict(os.environ, WINEPREFIX=prefix, WINEDEBUG="-all"),
                           capture_output=True, text=True, timeout=120)
        ok = r.returncode == 0
        return {"ok": ok, "keys": len(colors or DEFAULT_THEME_COLORS), "visual_style": "disabled",
                "reason": None if ok else (r.stderr or "").strip()[:200]}
    except Exception as e:
        return {"ok": False, "reason": str(e)}
    finally:
        try: os.remove(path)
        except OSError: pass


