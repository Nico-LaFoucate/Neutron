#!/usr/bin/env python3
# neutron — the Neutron CLI front door (v0).
#
# The stable surface Collider drives. Structured --json on every command,
# meaningful exit codes, no interactivity. Internals wrap the proven hand-driven
# stack (the `premiere` launcher, the Debug Database pref);
# the contract is the part that stays stable while internals evolve.
#
# Implement in the Neutron repo (LGPL v2.1). See docs/NEUTRON_CLI_CONTRACT.md.
#
# Exit codes (contract §Design rules):
#   0  success
#   1  generic failure
#   2  prefix not found / invalid
#   3  Premiere running (can't edit prefs)
#   4  dependency missing  (also: feature not available in v0)
#
# Output discipline: JSON to stdout, human logs to stderr. Collider parses
# stdout only. In --json mode, stdout carries exactly one JSON object.

import argparse
import json
import os
import shutil
import subprocess
import sys
import glob
import re
import signal
import struct
import time

# --- exit codes ------------------------------------------------------------
EX_OK = 0
EX_FAIL = 1
EX_BADPREFIX = 2
EX_RUNNING = 3
EX_DEP = 4

# --- where things live (engine knowledge, kept in ONE place) ---------------
# Defaults match the proven working stack. Resolution is dynamic where it
# matters (in-prefix user, Documents symlink target, Debug Database version
# dir) so a version bump or a different prefix doesn't break the contract.

HOME = os.path.expanduser("~")


def _xdg_dir(var, *default):
    """$var when it holds an absolute path, else HOME/<default>. The XDG Base Directory spec: unset
    OR EMPTY means the default, and a relative value is invalid and ignored. An empty
    XDG_DATA_HOME used to be joined as-is, so `neutron setup` installed into the current directory
    (found in the 11.10-138 fresh-HOME test, 2026-10-19)."""
    value = os.environ.get(var, "")
    return value if os.path.isabs(value) else os.path.join(HOME, *default)


# Every XDG-governed path goes through these. Until 2026-10-19 about half the CLI hardcoded
# ~/.local/share, ~/.config and ~/.cache, so with a non-default XDG_DATA_HOME the menu entries were
# written where APPS_DIR (and the desktop) never looked.
DATA_HOME = _xdg_dir("XDG_DATA_HOME", ".local", "share")
CONFIG_HOME = _xdg_dir("XDG_CONFIG_HOME", ".config")
CACHE_HOME = _xdg_dir("XDG_CACHE_HOME", ".cache")


def collider_config_dir():
    """Collider's settings folder: $XDG_CONFIG_HOME/collider. ⚠️ Collider and the CLI used to
    hardcode ~/.config/collider, so when only that one exists it is still the folder in use (no
    settings lost when XDG_CONFIG_HOME is set). Collider's core/xdg.rs applies the SAME rule; change
    both or neither."""
    current = os.path.join(CONFIG_HOME, "collider")
    legacy = os.path.join(HOME, ".config", "collider")
    if legacy != current and not os.path.exists(current) and os.path.isdir(legacy):
        return legacy
    return current

# ⛔ NO DEFAULT PREFIX PATH. Resolution is default_prefix(): $WINEPREFIX -> Collider's selection
# -> unambiguous discovery. A hardcoded name is one machine's layout and has repeatedly broken the
# build tester; see default_prefix() for the history.

# This repo's root (bin/neutron -> ..), wherever it was unpacked.
NEUTRON_REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

# The CLI's own version. Each piece versions independently (CLI, neutron-wine, Mud Hut,
# Collider); `neutron --version` prints all of them for bug reports.
CLI_VERSION = "1.0.0-beta.20"
NEUTRON_DATA_DIR = os.path.join(
    DATA_HOME, "neutron")
# What `neutron setup` installed (component -> version); read by --version.
NEUTRON_INSTALLED_JSON = os.path.join(NEUTRON_DATA_DIR, "installed.json")

# The proven launcher env (from ~/.local/bin/premiere). Single source of truth.
PREMIERE_SUBPATH = os.path.join(
    "drive_c", "Program Files", "Adobe",
    "Adobe Premiere Pro 2025", "Adobe Premiere Pro.exe",
)
DXVK_CONF_SUBPATH = os.path.join(
    "drive_c", "Program Files", "Adobe",
    "Adobe Premiere Pro 2025", "dxvk.conf",
)
WINEDLLOVERRIDES = "ucrtbase=n,b;dwrite=b"

# --- Neutron-owned wine runtime (Phase 1 of the Proton-style owned runtime) -----
# The CLI must NOT depend on the host's wine; it runs Neutron's PATCHED wine (the
# X11 frame pacer + the winewayland fractional-scale fix). Resolution order:
#   1. $NEUTRON_WINE   2. a packaged dist path   3. the dev build tree
#   4. system 'wine' (last-resort fallback; patches NOT present -> warn).
# Phase 2/3 replace the dev build tree with a versioned, bundled runtime.
# The neutron-wine release the engine expects, and where `runtime install`
# unpacks it. A downloaded runtime lands at
#   <NEUTRON_RUNTIMES_DIR>/neutron-wine-<version>/  (has bin/wine, self-stamps
#   NEUTRON_WINE_VERSION at its root) and is resolved ahead of any dev build tree.
NEUTRON_WINE_REPO = os.environ.get("NEUTRON_WINE_REPO", "Nico-LaFoucate/neutron-wine")
NEUTRON_RUNTIMES_DIR = os.path.join(
    DATA_HOME, "neutron", "runtimes")


def _installed_runtime_versions():
    """Installed runtime versions, newest first. Only numeric releases (11.10-72);
    dev trees like `neutron-wine-11.10-gpufix` are never auto-selected."""
    out = []
    try:
        names = os.listdir(NEUTRON_RUNTIMES_DIR)
    except OSError:
        return []
    for name in names:
        if not name.startswith("neutron-wine-"):
            continue
        ver = name[len("neutron-wine-"):]
        m = re.match(r"^(\d+)\.(\d+)-(\d+)$", ver)
        if not m:
            continue
        if not os.path.isfile(os.path.join(NEUTRON_RUNTIMES_DIR, name, "bin", "wine")):
            continue
        out.append((tuple(int(g) for g in m.groups()), ver))
    out.sort(reverse=True)
    return [v for _, v in out]


def _default_wine_version():
    """The runtime version to use when $NEUTRON_WINE_VERSION is unset.

    🚨 2026-09-01, build tester. This was a hardcoded literal, and it had gone stale by two
    drops: it still said "11.10-70" while the shipped wrapper exported 11.10-72. The wrapper
    hid it, so the only way to hit it was to invoke bin/neutron directly -- which our own
    LAUNCHERS.md documented as a launcher pattern. One direct `prefix provision` then staged
    70's natives, stamped the prefix with 70's wine.inf mtime, and rewrote ALL SEVEN desktop
    entries to pin 11.10-70, silently repointing every launch surface at an old runtime.

    ⛔ `doctor` could not catch it: it reported 14/14 healthy including "prefix and runtime
    agree". That was TRUE -- they agreed on the wrong runtime. Doctor validates internal
    consistency, never "is this the runtime that was installed".

    So: derive it from what is actually on disk, newest first. A constant that has to be bumped
    by hand every drop will go stale again -- it already did, twice. Returns None when nothing
    is installed, and callers must refuse rather than silently pick."""
    env = os.environ.get("NEUTRON_WINE_VERSION")
    if env:
        return env
    versions = _installed_runtime_versions()
    return versions[0] if versions else None


NEUTRON_WINE_VERSION = _default_wine_version()

# Where `neutron launch --json` writes each app's wine log. Sibling of runtimes so
# it follows XDG_DATA_HOME and a fake-HOME clean-room test the same way.
NEUTRON_LOGS_DIR = os.path.join(
    DATA_HOME, "neutron", "logs")

# A dev build is selected with $NEUTRON_WINE; there are no hardcoded home-dir fallbacks.
NEUTRON_WINE_CANDIDATES = [
    os.environ.get("NEUTRON_WINE"),
    (os.path.join(NEUTRON_RUNTIMES_DIR, f"neutron-wine-{NEUTRON_WINE_VERSION}",
                  "bin", "wine") if NEUTRON_WINE_VERSION else None),
]
NO_RUNTIME_MSG = "neutron-wine isn't installed. Run `neutron setup` first."

# NVIDIA's EGL vendor file: forced on a launch only when an NVIDIA GPU is in use (_apply_gl_vendor_env).
NVIDIA_EGL_ICD = "/usr/share/glvnd/egl_vendor.d/10_nvidia.json"
NVIDIA_PCI_VENDOR = "0x10de"


def drm_gpus(sysfs="/sys/class/drm"):
    """The GPUs the kernel exposes, as [(pci_vendor, driver)], e.g. [("0x8086", "i915"), ("0x10de", "nvidia")].
    Only cardN nodes; connectors (card1-HDMI-A-1) and devices without a PCI vendor (simpledrm) are skipped."""
    gpus = []
    for d in sorted(glob.glob(os.path.join(sysfs, "card[0-9]*"))):
        if "-" in os.path.basename(d):
            continue
        try:
            with open(os.path.join(d, "device", "vendor")) as f:
                vendor = f.read().strip().lower()
        except OSError:
            continue
        driver = os.path.basename(os.path.realpath(os.path.join(d, "device", "driver")))
        gpus.append((vendor, driver))
    return gpus


def nvidia_hybrid(gpus):
    """True for an NVIDIA GPU next to another vendor's (a laptop's Intel/AMD iGPU)."""
    vendors = {v for v, _ in gpus}
    return NVIDIA_PCI_VENDOR in vendors and len(vendors) > 1


def boot_gpu_vendor(sysfs="/sys/class/drm"):
    """PCI vendor of the GPU the firmware booted on (device/boot_vga = 1), or None if no card says.
    KWin and Mutter render the desktop on this GPU by default."""
    for d in sorted(glob.glob(os.path.join(sysfs, "card[0-9]*"))):
        if "-" in os.path.basename(d):
            continue
        try:
            with open(os.path.join(d, "device", "boot_vga")) as f:
                if f.read().strip() != "1":
                    continue
            with open(os.path.join(d, "device", "vendor")) as f:
                return f.read().strip().lower()
        except OSError:
            continue
    return None


def nvidia_render_offload(gpus, boot_vendor):
    """True when NVIDIA must render for a desktop another vendor's GPU drives (PRIME render offload):
    a hybrid machine whose boot GPU is not the NVIDIA one. A desktop that runs its monitors on NVIDIA
    with the CPU's iGPU also enabled boots on NVIDIA and keeps the NVIDIA-only environment. With no
    boot_vga anywhere, a hybrid machine is assumed to be a laptop."""
    return nvidia_hybrid(gpus) and boot_vendor != NVIDIA_PCI_VENDOR


NVIDIA_PROC_GPUS = "/proc/driver/nvidia/gpus"   # one entry per GPU NVIDIA's own driver has bound


def nvidia_gpu_expected(gpus):
    """False only when the kernel lists GPUs, none is NVIDIA's, and NVIDIA's driver reports no GPU either
    (it has one with no DRM node when nvidia-drm is not loaded). Gates the NVIDIA-API launch settings
    (DXVK_ENABLE_NVAPI=1 and the nvapi64 DLL override, see _apply_app_env) and NVIDIA's EGL/GLX vendor
    (_apply_gl_vendor_env). An empty list means the GPUs could not be read, not that there are none,
    so it keeps the settings NVIDIA was tested with."""
    if not gpus or any(v == NVIDIA_PCI_VENDOR for v, _ in gpus):
        return True
    try:
        return bool(os.listdir(NVIDIA_PROC_GPUS))
    except OSError:
        return False


def _apply_gl_vendor_env(env, gpus):
    """NVIDIA's EGL and GLX vendor for a launch, plus PRIME render offload on a hybrid laptop. `gpus` is
    drm_gpus(). Returns True when NVIDIA's vendor was requested.

    Only when NVIDIA's EGL vendor file is installed AND an NVIDIA GPU is in use (nvidia_gpu_expected).
    Until 2026-10-15 the file alone decided, so a machine with only AMD or Intel GPUs that still had
    NVIDIA's userspace installed (a GPU swap, or nvidia-utils pulled in by another package) was handed
    NVIDIA's EGL in place of Mesa's: no EGL display, so no OpenGL in Wine, and with it no OpenGL display
    for After Effects, Media Encoder and Premiere 2025 (AMD support audit, X5). Any NVIDIA GPU, or GPUs
    that could not be read, keeps exactly the environment NVIDIA was tested with."""
    if not (os.path.isfile(NVIDIA_EGL_ICD) and nvidia_gpu_expected(gpus)):
        return False
    env.setdefault("__EGL_VENDOR_LIBRARY_FILENAMES", NVIDIA_EGL_ICD)
    env.setdefault("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
    # GitHub Neutron#12: on a laptop the desktop usually runs on the Intel/AMD iGPU, and NVIDIA's
    # EGL then renders for it only in PRIME render offload. Without __NV_PRIME_RENDER_OFFLOAD=1
    # Wine's EGL got no configs at all ("Failed to get any configs from eglChooseConfig"), so no
    # OpenGL context, and Premiere's CUDA renderer never delivered a frame: black Program
    # Monitor, Export never opened. Only hybrid machines whose desktop runs on the other GPU get
    # it (nvidia_render_offload); NVIDIA-only machines, and desktops that boot on NVIDIA with an
    # iGPU also enabled, keep the environment they were tested with (it was harmless on
    # NVIDIA-only too, 2026-10-13).
    if nvidia_render_offload(gpus, boot_gpu_vendor()):
        env.setdefault("__NV_PRIME_RENDER_OFFLOAD", "1")
    return True


# DLL overrides that exist only for NVIDIA's API (dxvk-nvapi); a profile's copy is dropped when
# nvidia_gpu_expected() is False.
NVIDIA_ONLY_DLL_OVERRIDES = ("nvapi64",)


def _drop_dll_overrides(spec, dlls):
    """A WINEDLLOVERRIDES string without the named DLLs: "a=n,b;nvapi64=n;c=b" -> "a=n,b;c=b"."""
    out = []
    for entry in spec.split(";"):
        if not entry.strip():
            continue
        names, sep, mode = entry.partition("=")
        keep = [n for n in names.split(",") if n.strip().lower() not in dlls]
        if keep:
            out.append(",".join(keep) + sep + mode)
    return ";".join(out)

# --- DLLs staged into every prefix ---------------------------------------------------------
# Two sources, nothing else:
#   * our open-source builds (DXVK, vkd3d-proton, dxvk-nvapi, the NVIDIA wrappers, the ucrtbase
#     shim) ship INSIDE the neutron-wine runtime: <runtime>/lib/wine/<project>/, listed with their
#     DLL overrides in <runtime>/share/neutron/natives.json (neutron-wine external/);
#   * Microsoft's files are downloaded from Microsoft by `neutron setup` (MS_DOWNLOADS below).
# NEUTRON_RUNTIME may point at an old-style captured bundle (<dir>/dlls/{system32,syswow64} +
# <dir>/overrides.json) for development; nothing else reads one.
NEUTRON_RUNTIME_BUNDLE = os.environ.get("NEUTRON_RUNTIME")

# --- WebView2 runtime (Adobe in-app sign-in / IMS is a Microsoft Edge WebView2
# web UI). The Adobe installer drops WebView2 files under Common Files\Adobe but
# never REGISTERS the runtime, so the app's WebView2 loader can't find it and the
# sign-in window renders BLANK (a big time-sink to diagnose — bank it). provision
# stages a complete *registered* runtime to the standard path AND writes the
# EdgeUpdate\Clients\{GUID} "pv" the loader reads (both the 64-bit view and
# Wow6432Node — the Adobe licensing helper is 32-bit). Sources, in order: Adobe's own copy in the
# prefix (only some Adobe apps bring it); a copy already staged in the prefix; $NEUTRON_WEBVIEW2;
# and last, Microsoft's WebView2 Fixed Version runtime, downloaded once into MICROSOFT_DIR.
WEBVIEW2_CLIENT_GUID = "{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
WEBVIEW2_DEV_SOURCE = os.environ.get("NEUTRON_WEBVIEW2")
# Microsoft offers only its recent majors (150-154 in October 2026), and only 133 and 140 (Adobe's
# copies) have run under neutron-wine; anything else is flagged as untested. The pin is refreshed at release time;
# if it has gone, the current list is read from Microsoft's download page.
WEBVIEW2_TESTED_MAJORS = (133, 140)
WEBVIEW2_FIXED_PIN = ("154.0.4258.62", "https://msedge.sf.dl.delivery.mp.microsoft.com/filestreamingservice/"
                      "files/b92cd7d9-6976-4f34-9708-47e80937c287/"
                      "Microsoft.WebView2.FixedVersionRuntime.154.0.4258.62.x64.cab")
WEBVIEW2_PAGE = "https://developer.microsoft.com/en-us/microsoft-edge/webview2/"

# --- Wine Mono + Gecko (Adobe prefixes need them INSTALLED, never suppressed) ----
# The Wine Mono/Gecko installer popup must never reach the end user, but the WRONG
# way to dodge it is WINEDLLOVERRIDES="mscoree,mshtml=..." on the LAUNCH path — that
# leaves gecko uninstalled and CLOBBERS Adobe's mshtml-backed web content (sign-in).
# The RIGHT way (a complete Adobe prefix, e.g. the proven mudhut-accc2, has both Mono
# and Gecko installed): actually INSTALL the matching versions during provision so
# wineboot never prompts at launch and nothing is disabled. The versions MUST match
# what the runtime expects (baked at build time into appwiz.cpl / mshtml) -- a skew is
# exactly what makes wineboot re-prompt. The runtime ships the matching trees in
# <runtime>/share/wine/{mono,gecko} (neutron-wine package.sh), and the versions are read from
# there; these two are only the fallback for a runtime that predates that.
MONO_VERSION = "11.1.0"
GECKO_VERSION = "2.47.4"
# Extra source trees, after the runtime's own: $NEUTRON_MONO / $NEUTRON_GECKO, then the host's
# /usr/share/wine trees IF they carry the matching version.
MONO_CANDIDATES = [os.environ.get("NEUTRON_MONO"), "/usr/share/wine/mono"]
GECKO_CANDIDATES = [os.environ.get("NEUTRON_GECKO"), "/usr/share/wine/gecko"]

# DXVK workaround: winevulkan can't marshal VK_EXT_graphics_pipeline_library
# create-infos under winewayland.drv -> disable that DXVK feature.
DXVK_GPL_LINE = "dxvk.enableGraphicsPipelineLibrary = False"

# The display-fix preference line. Premiere uses true/false (NOT 1/0) — verified
# against the live, working Debug Database. The proven line is:
#   DS.DisableDirectXDisplay<TAB>true<TAB>false
DISPLAY_FIX_KEY = "DS.DisableDirectXDisplay"
DISPLAY_FIX_CURRENT = "true"
DISPLAY_FIX_DEFAULT = "false"

# ⭐ 2026-10-14 (Neutron#21) — PREMIERE 2026+ RUNS ON ADOBE'S DIRECTX DISPLAY.
# Premiere 26.x draws the Program Monitor's Transform/Crop handles with a new GPU overlay renderer
# (`OverlayRendererGPU_Manta`), and its OpenGL display -- the one `DS.DisableDirectXDisplay=true`
# selects -- "does not handle Manta texture frames" (Adobe's own message), so on that display the
# handles were drawn and dropped: invisible but working. Premiere 2025 draws them the older way and
# shows them on either display. The DirectX display needs runtime 11.10-121+ (DXVK dxgi stores the
# swap chain background color; it used to fail and Premiere never presented -> black monitor) and
# blit-to-window off (NEUTRON_DISABLE_BTW=1, set in _apply_app_env): with it on, every Program Monitor
# frame was read back and repainted through GDI and playback ran at 6-7 fps; off, 30 fps.
# So Premiere 2026+ gets Adobe's default (`false`) -- including undoing the `true` older CLIs wrote --
# while Premiere 2025, After Effects and Media Encoder keep `true`. Both halves apply only when the
# prefix's dxgi.dll has the fix (_prefix_dxgi_presents_directx_display): on an older runtime -- a
# launcher can pin one -- Premiere 2026 stays on the OpenGL display with blit-to-window on, as before.
PREMIERE_DIRECTX_DISPLAY_FROM = 26   # Premiere major version: prefs dir "26.0", install "Adobe Premiere Pro 2026"


def _premiere_major(path):
    """Premiere's major version from a prefs path (".../Premiere Pro/26.0/Debug Database.txt" or the
    "26.0" dir) or an install path (".../Adobe Premiere Pro 2026/..."). 0 if it names none."""
    m = re.search(r"Adobe Premiere Pro (20\d\d)", path or "")
    if m:
        return int(m.group(1)) - 2000
    m = re.search(r"Premiere Pro[/\\](\d+)\.\d+", path or "")
    return int(m.group(1)) if m else 0


def _prefix_dxgi_presents_directx_display(prefix):
    """True iff this prefix's DXVK dxgi.dll can carry Premiere 2026's DirectX display: runtime 11.10-121+
    stores the swap chain background color, and its dxgi has no "BackgroundColor" string at all, where the
    old stubs logged "...BackgroundColor: Not implemented" (the build gate in neutron-wine checks the same).
    Checked on the prefix's own copy -- what Premiere loads -- not the runtime's, because a launcher can
    pin an older runtime and the CLI must never switch Premiere to a display that runtime leaves black."""
    try:
        with open(os.path.join(prefix, "drive_c", "windows", "system32", "dxgi.dll"), "rb") as f:
            b = f.read()
    except OSError:
        return False
    return b"DxgiSwapChain" in b and b"BackgroundColor" not in b


def _premiere_directx_display(prefix, path):
    """Premiere 2026+ in a prefix whose dxgi can show its DirectX display (see PREMIERE_DIRECTX_DISPLAY_FROM)."""
    return (_premiere_major(path) >= PREMIERE_DIRECTX_DISPLAY_FROM
            and _prefix_dxgi_presents_directx_display(prefix))


def _display_fix_wanted(label, path, prefix):
    """The DS.DisableDirectXDisplay value Neutron wants for this app's Debug Database (or prefs dir):
    "true" (Adobe's OpenGL display) everywhere except Premiere 2026+ on a runtime that can show its DirectX
    display, which keeps Adobe's default "false". See PREMIERE_DIRECTX_DISPLAY_FROM."""
    if label == "premiere" and _premiere_directx_display(prefix, path):
        return DISPLAY_FIX_DEFAULT
    return DISPLAY_FIX_CURRENT

# ⭐ 2026-08-09 — THE DISPLAY FIX IS NOT PREMIERE-ONLY.
# `DS.DisableDirectXDisplay` lives in the Debug Database of every DVA-based app: Premiere,
# After Effects AND Media Encoder. apply-display-fix only ever resolved Premiere's, so on any
# real install AE and AME silently never got it. It went unnoticed for months because this dev
# box has the key set to `true` in all three files -- set by hand long ago, never by this code.
# A build tester found it the honest way: of the three, the only app whose display fix was
# correct was the only one of the three that worked. Same class as corefonts and
# `Program Files (x86)` -- dev-box state standing in for a step no install performs.
#   (label, AppData\Roaming\Adobe subdir, install-dir glob under drive_c/Program Files/Adobe)
DISPLAY_FIX_APPS = (
    ("premiere",     "Premiere Pro",        "Adobe Premiere Pro*"),
    ("aftereffects", "After Effects",       "Adobe After Effects*"),
    ("mediaencoder", "Adobe Media Encoder", "Adobe Media Encoder*"),
)

# --- Prefix provisioning recipe (single source of truth; Mud Hut calls this) ----
# What makes a freshly-staged prefix Neutron-ready. Registry-level fixes that
# apply BEFORE first launch (the DS.DisableDirectXDisplay pref lives in Premiere's
# Debug Database and is written post-first-launch by apply-display-fix, so it's
# not part of provision). Values are the proven ones from the live suite.
PROVISION_DLL_OVERRIDES = {          # HKCU\Software\Wine\DllOverrides: Wine builtin pins
    "d2d1": "builtin",               # our patched d2d1, never a native copy
    "dwrite": "builtin",             # our patched dwrite; a stray Microsoft DWrite.dll must not win
}
# The overrides for our own DLLs come from the runtime's natives.json, and Microsoft's from
# MS_OVERRIDES; provision writes all three.
# ⛔ dxcore and dcomp were REMOVED here 2026-08-07. They used to be staged as `native` because the
# patched versions had to be supplied as files; that is obsolete — a wineboot on 11.10-22+ is a
# SELF-HEAL that installs the runtime's own PATCHED dcomp/dxcore/dwrite builtins (verified by
# marker, not size). Re-adding them is not merely redundant: on the Photoshop profile,
# dcomp/dxcore/nvapi64 overrides black-box PS 2026, and the prefix-wide case points the same way. The live
# ~/.premiere2025, which runs all seven apps, has NEITHER override.
#
# HKCU\Software\Wine\Fonts\Replacements — map the fonts Adobe requests but that
# can't ship (MS Segoe/Calibri, CJK Noto/MS) onto Adobe Clean (installed with the
# apps). Missing these -> dwrite FindFamilyName NULL -> AdobeOwl AV -> leaked
# critsec -> deadlock/crash on new-doc. The full proven map (fallback when no
# runtime fonts.json is present).
PROVISION_FONT_REPLACEMENTS = {
    "BIZ UDGothic": "Adobe Clean", "Calibri": "Adobe Clean",
    "Microsoft Sans Serif": "Adobe Clean", "MS Gothic": "Adobe Clean",
    "MS UI Gothic": "Adobe Clean", "Noto Sans JP": "Adobe Clean",
    "Noto Sans KR": "Adobe Clean", "Noto Sans SC": "Adobe Clean",
    "Noto Sans TC": "Adobe Clean", "Noto Serif JP": "Adobe Clean",
    "Noto Serif KR": "Adobe Clean", "Noto Serif SC": "Adobe Clean",
    "Noto Serif TC": "Adobe Clean", "Sans": "Adobe Clean",
    "Segoe UI": "Adobe Clean", "Segoe UI Symbol": "Adobe Clean",
}
# The Adobe-suite DXVK config placed at the prefix root (Adobe panel render fix).
# ⚠️ The shared conf above is NOT the only one. Two profiles point DXVK_CONFIG_FILE at their own
# file, and provision used to create neither — so on a FRESH prefix, Premiere and After Effects
# launched with DXVK on DEFAULTS. The defaults matter enormously here: DXVK's default HIDES the
# real NVIDIA GPU and reports an AMD Radeon, while creating the device on the actual NVIDIA card.
# Premiere's GPU sniffer then selects a backend for a GPU that isn't there. A build tester hit
# "Initialization failure: Unknown error" after the splash on 2026-08-08 with the same GPU as the
# dev box — the difference was not hardware, it was that this file existed here (hand-made
# 2026-08-03) and not there.
PROVISION_DXVK_CONF_PREMIERE = (
    "# Neutron Premiere DXVK config (provisioned by `neutron prefix provision`)\n"
    "dxgi.deferSurfaceCreation = True\n"
    "dxgi.hideNvidiaGpu = False\n"
    "dxgi.nvapiHack = False\n"
    "dxgi.enableDummyCompositionSwapchain = True\n"
    "dxvk.enableGraphicsPipelineLibrary = False\n"
    "\n"
    # 🚨 CEF PANELS -- WITHOUT THIS, OPENING AN EXTENSION PANEL FREEZES PREMIERE.
    # Reported from the build tester 2026-08-27 (RC1 week, day 1), 3/3 reproductions: the app
    # wedged with every process alive in futex_wait and the log still being written. Their
    # capture is the documented signature verbatim -- `PresentBase m_window=0`, then
    # `calls=43 blits=1 skips=42 (gate ENGAGED)`: one frame painted, every present after it
    # skipped, forever.
    #
    # ⭐ ROOT CAUSE, AND IT IS OUR OMISSION. `enableDummyCompositionSwapchain = True` above is
    # required by Premiere ITSELF, and CEPHtmlEngine.exe INHERITS it. The shared conf and AE's
    # conf have both carried a [CEPHtmlEngine.exe] override since the Animate fix.
    # **Premiere's own conf never got it** -- Premiere is the one app with a private conf, and
    # the fix landed on the two files that were not this one. Same defect, opposite outcomes.
    #
    # ⛔ NOT fixable by a dxvk.conf beside CEPHtmlEngine.exe: `launch` exports DXVK_CONFIG_FILE
    # and children inherit it, so DXVK never looks beside the child's exe. The tester tried
    # exactly that and it silently did nothing. A per-exe SECTION in the inherited file is the
    # only vector that works.
    "[CEPHtmlEngine.exe]\n"
    "dxgi.enableDummyCompositionSwapchain = False\n"
)

PROVISION_DXVK_CONF_AE = (
    "# Neutron After Effects DXVK config (provisioned by `neutron prefix provision`)\n"
    "#\n"
    "# AE shared the suite conf until 2026-07-31, which does not set hideNvidiaGpu -- so DXVK's\n"
    "# default applied and AE enumerated an AMD Radeon while the device underneath was the real\n"
    "# NVIDIA GPU. Mercury picks its backend from the GPU it detects (CUDA for NVIDIA, OpenCL for\n"
    "# AMD), so detecting the wrong vendor can leave the render pipeline half-initialised.\n"
    "dxgi.enableDummyCompositionSwapchain = True\n"
    "dxgi.deferSurfaceCreation = True\n"
    "dxvk.enableGraphicsPipelineLibrary = False\n"
    "dxgi.hideNvidiaGpu = False\n"
    "dxgi.nvapiHack = False\n"
    "\n"
    "# CEF/CEP panels must NOT get a composition swapchain -- without this per-exe override every\n"
    "# Chromium-hosted Adobe panel renders into a dummy swapchain with a NULL hwnd and freezes\n"
    "# white. The shared conf has carried this since 2026-08-04; AE hosts CEP panels too, and the\n"
    "# first draft of this file omitted it. See the repair in cmd_prefix_provision.\n"
    "[CEPHtmlEngine.exe]\n"
    "dxgi.enableDummyCompositionSwapchain = False\n"
)

# Keys a per-app conf MUST pin. A conf missing these is a STUB, not a user's tuned file:
# `ensure_dxvk_gpl` creates a one-line conf on first launch, which then satisfies any
# "does the file exist?" check and silently locks in DXVK's defaults -- including reporting an
# AMD GPU on an NVIDIA card. Provision repairs such a file by APPENDING what is missing.
DXVK_REQUIRED_KEYS = ("dxgi.hideNvidiaGpu", "dxgi.nvapiHack",
                      "dxgi.enableDummyCompositionSwapchain", "dxgi.deferSurfaceCreation")

PROVISION_DXVK_CONF_BODIES = {
    DXVK_CONF_SUBPATH: PROVISION_DXVK_CONF_PREMIERE,
    "neutron-ae-dxvk.conf": PROVISION_DXVK_CONF_AE,
}

PROVISION_DXVK_CONF = (
    "# Neutron Adobe-suite DXVK config (provisioned by `neutron prefix provision`)\n"
    "dxvk.enableGraphicsPipelineLibrary = False\n"
    "dxgi.enableDummyCompositionSwapchain = True\n"
    "\n"
    "# ---------------------------------------------------------------------------\n"
    "# CEF/CEP panels (Animate's New Document + workspace, and every other Chromium-\n"
    "# hosted Adobe panel) MUST NOT get a composition swapchain. Proven 2026-08-04.\n"
    "#\n"
    "# WHAT GOES WRONG: modern CEF presents through DirectComposition. DXVK answers\n"
    "# CreateSwapChainForComposition with a DUMMY swapchain built with a NULL hwnd\n"
    "# (dxgi_factory.cpp: 'Creating dummy swap chain') -- upstream only ever intended\n"
    "# it to satisfy apps that query composition support, not to display anything.\n"
    "# Chromium then renders the whole panel into it and Presents happily. Each Present\n"
    "# reaches the dcomp bridge with hwnd=0, falls back to the global pending_hwnd --\n"
    "# which holds DXVK's own 320x240 DXVKDUMMYWNDCLASS -- and every frame is discarded.\n"
    "# Symptom: the panel paints ONE early (blank) frame and then freezes white forever.\n"
    "# Measured on Animate: 9 presents all with m_window=0, then permanent silence.\n"
    "#\n"
    "# THE FIX: deny composition swapchains to CEF only. CreateSwapChainForComposition\n"
    "# returns E_NOTIMPL and Chromium falls back to a WINDOWED swapchain (m_window != 0)\n"
    "# -- the same path Premiere's working CEP panel has always used, which the dcomp\n"
    "# bridge routes to the real panel host. After: 144 presents, 0 with m_window=0,\n"
    "# 0 null-hwnd fallbacks, and Animate's New Document + canvas render and interact.\n"
    "#\n"
    "# Scoped per-exe on purpose: the global setting above stays for the host apps,\n"
    "# which is the configuration Photoshop/Premiere/AE/LrC were all validated on.\n"
    "[CEPHtmlEngine.exe]\n"
    "dxgi.enableDummyCompositionSwapchain = False\n"
)


# --- Per-app launch profiles (single source of truth for the whole suite) -------
# Each entry: the exe (relative to the prefix), the DXVK config it uses, its
# WINEDLLOVERRIDES, extra env, brand accent, and whether it has a hardware-export
# pipeline. Premiere keeps its historical values BYTE-FOR-BYTE (references the
# constants above); the rest encode the proven per-app env from ~/.local/bin/<app>
# plus the Neutron suite display fixes (dxcore/nvapi/dcomp native overrides).
#   - dxvk_conf: relative to the prefix. Premiere uses its own dxvk.conf beside the
#     exe; the rest use the shared neutron-apps-dxvk.conf (Adobe panel render fix).
#   - nvapi: export DXVK_ENABLE_NVAPI=1 (real-NVIDIA reporting). This and an nvapi64 entry in
#     overrides apply only when an NVIDIA GPU is present (_apply_app_env, nvidia_gpu_expected).
#   - env: extra environment (e.g. Photoshop's GPU-present BTW gate).
#   - accent: brand tint for the Collider app widget.
#   - export: produces video output (native HW-export muxing).
def _adobe(*parts):
    return os.path.join("drive_c", "Program Files", "Adobe", *parts)


def _common_adobe(*parts):
    """Path under the prefix's 32-bit Common Files Adobe tree (Adobe Desktop Common)."""
    return os.path.join("drive_c", "Program Files (x86)", "Common Files", "Adobe", *parts)


# Adobe background services Photoshop's NGL/RPC needs at launch (else it fatals with
# "can't communicate with CC desktop"). Started detached before the app; torn down
# with the prefix. Full stop-on-app-exit lifecycle is a TODO.
ADOBE_DAEMONS = [
    _common_adobe("Adobe Desktop Common", "ADS", "Adobe Desktop Service.exe"),
    _common_adobe("Adobe Desktop Common", "IPCBox", "AdobeIPCBroker.exe"),
]


def _start_adobe_daemons(prefix, wine, env, daemons):
    """Start the Adobe RPC/IPC services (detached) if their exes exist. They are
    singletons (mutex-guarded), so a duplicate start self-exits — safe to call
    unconditionally on a freshly-torn-down prefix."""
    started = []
    for sub in daemons:
        exe = os.path.join(prefix, sub)
        if not os.path.isfile(exe):
            continue
        try:
            subprocess.Popen([wine, exe], env=env,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            started.append(os.path.basename(exe))
        except Exception:
            pass
    if started:
        log("started Adobe daemons: " + ", ".join(started))
    return started


def _resolve_app_exe(prefix, exe_rel):
    """Resolve a profile's (version-locked) exe subpath to an absolute path,
    version-agnostically. Adobe bumps the folder year each release (…2025 → 2026 …)
    but the per-app fixes are the same, so a profile shouldn't need editing per
    version. Replace the 4-digit year in the 'Adobe <App> <year>' segment with a glob and
    return the highest year installed; the literal path is only the answer when the profile's
    path has no year or nothing globs (so callers still get a sensible path to report).

    ⭐ NEWEST YEAR FIRST (2026-10-16, Adobe yearly updates). This used to return the literal
    path whenever it existed, and the profiles are pinned to the year they were written
    (Photoshop 2025, Animate 2024): after Mud Hut installed Photoshop 2026 (or 2027) beside an
    older year, the menu entry and Collider's card kept starting the OLD one. A prefix holding
    one year per app is unaffected; one holding two years of an app now starts the newer."""
    import re
    if not prefix:
        return ""
    literal = os.path.join(prefix, exe_rel)
    pat_rel = re.sub(r'(?<!\d)(?:19|20)\d{2}(?!\d)', '*', exe_rel, count=1)
    if pat_rel == exe_rel:
        return literal  # no version segment to generalize
    hits = [h for h in glob.glob(os.path.join(prefix, pat_rel)) if os.path.isfile(h)]
    if not hits:
        return literal
    def _year(h):
        # The year of the APP FOLDER, read from the path below the prefix: a prefix named like
        # `~/Neutron-Prefixes/Adobe2026` must not make every hit look like 2026.
        yrs = re.findall(r'(?<!\d)(?:19|20)\d{2}(?!\d)', os.path.relpath(h, prefix))
        return max((int(y) for y in yrs), default=0)
    return max(sorted(hits), key=_year)

def _resolve_app_dxvk_conf(prefix, profile):
    """Absolute path to this app's DXVK config, version-agnostically.

    🚨 Premiere's conf lives INSIDE its install directory, so its subpath carries the year --
    `Adobe Premiere Pro 2025/dxvk.conf`. The exe went through `_resolve_app_exe()` and follows the
    suite to 2026; this did not. On a 2026 install `launch` would export `DXVK_CONFIG_FILE`
    pointing at a directory that does not exist -- and it exports it **unconditionally, with no
    existence check**, so DXVK silently falls back to its defaults and reports the WRONG GPU
    VENDOR. Nothing errors; Premiere just quietly loses its tuning. Provision would likewise write
    the conf into the 2025 directory nobody reads.

    Found 2026-08-26 while preparing the 2026-suite smoke test, before it could waste a day of it.

    Anchored to the RESOLVED EXE's directory rather than year-globbed separately, so the conf can
    never end up beside a different version of the app than the one we are about to launch.
    """
    rel = profile.get("dxvk_conf") or ""
    if not rel:
        return ""
    # Prefix-root confs (the shared ones) have no version in them -- nothing to resolve.
    if os.sep not in rel:
        return os.path.join(prefix, rel)
    exe = _resolve_app_exe(prefix, profile["exe"])
    return os.path.join(os.path.dirname(exe), os.path.basename(rel))


def _app_exe_variants(prefix, exe_rel):
    """Every installed copy of a profile's exe in this prefix: the literal path plus every year of it
    (`Adobe After Effects 2025` beside `2026`). `_resolve_app_exe` picks ONE to launch; an app started by
    another app can be any of them."""
    import re
    out = []
    literal = os.path.join(prefix, exe_rel)
    if os.path.isfile(literal):
        out.append(literal)
    pat_rel = re.sub(r'(?<!\d)(?:19|20)\d{2}(?!\d)', '*', exe_rel, count=1)
    if pat_rel != exe_rel:
        out += [h for h in sorted(glob.glob(os.path.join(prefix, pat_rel)))
                if os.path.isfile(h) and h not in out]
    return out


def _dxvk_conf_for_exe(prefix, profile, exe):
    """The DXVK config for one installed copy of an app -- `_resolve_app_dxvk_conf`, for a given exe."""
    rel = profile.get("dxvk_conf") or ""
    if not rel:
        return ""
    if os.sep not in rel:
        return os.path.join(prefix, rel)
    return os.path.join(os.path.dirname(exe), os.path.basename(rel))


def _read_env_conf(prefix):
    """<prefix>/neutron-env.conf as {KEY: VALUE} (one `KEY=VALUE` per line, `#` comments)."""
    out = {}
    _envconf = os.path.join(prefix, "neutron-env.conf")
    try:
        if os.path.isfile(_envconf):
            with open(_envconf) as f:
                for ln in f:
                    ln = ln.strip()
                    if not ln or ln.startswith("#") or "=" not in ln:
                        continue
                    k, v = ln.split("=", 1)
                    k, v = k.strip(), v.strip()
                    if k:
                        out[k] = v
    except OSError as e:
        log("neutron-env.conf unreadable (%s); ignoring" % e)
    return out


def _apply_app_env(env, app, profile, prefix, dxvk_conf, protected=(), exe=None, gpus=None):
    """Put one app's launch settings into `env`. THE one place they are computed: `neutron launch` calls
    it for the app it starts, and `write_appenv_conf` for every installed app, so an app started BY
    ANOTHER APP (Dynamic Link, Edit in Photoshop) gets exactly what launching it directly gives it.

    `protected` names the keys the caller set itself (its own environment, --with/--without): the
    per-prefix neutron-env.conf does not override those, and the profile only fills in what is still
    unset. `gpus` is drm_gpus() (read here when not given). Returns the neutron-env.conf entries
    applied, for the launch log.
    """
    # NEUTRON_APP tells Neutron's Wine which app's settings this environment already carries, so
    # neutron-appenv.conf leaves a directly launched app alone (see write_appenv_conf).
    env["NEUTRON_APP"] = app

    # ⭐ PER-PREFIX WAYLAND app_id, so two prefixes with the same app are distinguishable.
    #
    # Wine's default app_id is the lowercased EXE basename, which is IDENTICAL for the same app in
    # every prefix. The desktop environment matches a running window back to a .desktop entry by
    # that id, so with Premiere installed in two prefixes it labelled a window launched from the
    # .premiere2025 icon "Premiere Pro (Adobe2026)" (operator, 2026-09-18 -- the app was in the
    # right prefix; only the label and the window grouping were wrong).
    #
    # Set it here rather than only in the generated Exec= line, so a launch from Collider or a
    # terminal gets the same identity as a launch from the menu. An explicit value in the caller's
    # environment still wins. The id is the .desktop basename for this app+prefix, which is the XDG
    # convention for binding a window to its entry. Honoured by winewayland.drv
    # `wayland_init_process_name`; harmless on a runtime that predates it (Wine keeps the EXE name).
    if not env.get("NEUTRON_WAYLAND_APP_ID"):
        try:
            env["NEUTRON_WAYLAND_APP_ID"] = "neutron-%s-%s" % (app, _prefix_slug(prefix))
        except Exception:
            pass

    # ⭐ PER-PREFIX GATE OVERRIDES: <prefix>/neutron-env.conf, `KEY=VALUE` per line.
    #
    # Every behaviour change this project ships is env-gated so it can be A/B'd without a
    # rebuild -- and that is worthless on the launch surfaces a tester actually uses. A menu
    # entry, the dock and a file association all run a fixed `Exec=` line with no way to set a
    # variable, and Collider's launch button has no field for one. So the only surface that
    # could be A/B'd was a terminal -- which is useless precisely when the surface itself is
    # what differs, as with the build tester's 2026-08-27 report that Premiere's splash renders
    # half white from the application menu but not from Collider.
    #
    # Applied BEFORE the profile's own gates, which use setdefault -- so this wins over a
    # profile default. The caller's real environment still wins over this, so a terminal
    # `NEUTRON_FOO=1 neutron launch ...` overrides the file for a one-off.
    applied = {}
    for k, v in _read_env_conf(prefix).items():
        if k not in protected:
            env[k] = v
            applied[k] = v
    env["DXVK_CONFIG_FILE"] = dxvk_conf
    # NVIDIA's API only where Windows has it (GitHub Neutron#18). DXVK_ENABLE_NVAPI=1 and nvapi64=n
    # exist for an NVIDIA GPU: DXVK reports a fake AMD card in its place unless NVAPI is on (or the
    # app's dxvk conf says hideNvidiaGpu = False), and nvapi64 is dxvk-nvapi. Windows on a machine
    # with only AMD or Intel GPUs has no nvapi64.dll, so both are left out there. They were inert
    # there anyway: DXVK hides only NVIDIA adapters, the prefix registry already loads nvapi64
    # native, and dxvk-nvapi's NvAPI_Initialize finds no NVIDIA adapter. Any NVIDIA GPU, or GPUs that
    # could not be read, keeps both exactly as before.
    nvidia = nvidia_gpu_expected(drm_gpus() if gpus is None else gpus)
    overrides = profile["overrides"]
    if not nvidia:
        overrides = _drop_dll_overrides(overrides, NVIDIA_ONLY_DLL_OVERRIDES)
    if overrides:                                # empty => leave unset (match the proven minimal launch)
        # MERGE, never assign. This used to be a bare assignment, which silently discarded any
        # WINEDLLOVERRIDES the caller set or that neutron-env.conf had just applied -- and
        # `neutron gates` advertises neutron-env.conf as reaching EVERY launch surface, so the
        # one variable it did not cover was invisible. A build tester lost a test run to this on
        # 2026-09-08 and had to go around us via the registry. The profile's own overrides come
        # LAST so they still win a same-DLL conflict; anything naming a different DLL survives.
        _pre = env.get("WINEDLLOVERRIDES", "").strip(";")
        env["WINEDLLOVERRIDES"] = (_pre + ";" + overrides) if _pre else overrides
    if profile.get("nvapi") and nvidia:
        env["DXVK_ENABLE_NVAPI"] = "1"
    # setdefault, NOT assignment: an explicitly pre-set NEUTRON_* in the caller's environment
    # must WIN, or no gate can ever be turned off from outside. Two independent failures of the
    # old `env[k] = v` (both 2026-08-09):
    #   1. premiere-soak.sh's isolation runs (`RTG=0 DIRG=0`) were silently overwritten back to 1
    #      the moment those gates moved into the profile on 08-08 -- our own A/B tool went inert
    #      and would have reported "no difference" for every isolation run since.
    #   2. the build tester could not bisect the Photoshop dcomp-gate bug at all, because every
    #      gate they set on the command line was discarded before the app saw it.
    # Trade-off accepted: a stale exported NEUTRON_* in a shell now sticks instead of being
    # corrected. That is the price of having an override at all, and it is the behaviour the
    # validated soak path always assumed it had.
    for k, v in profile.get("env", {}).items():
        env.setdefault(k, v)
    # Premiere 2026+ runs on Adobe's DirectX display (PREMIERE_DIRECTX_DISPLAY_FROM). Its Program Monitor
    # presents through vkd3d-proton straight to its own surface; blit-to-window would ALSO read every
    # frame back and repaint it through GDI, which held playback at 6-7 fps (30 fps without it).
    # setdefault, so NEUTRON_DISABLE_BTW=0 from the caller still turns it back on for an A/B.
    # Tied to the same check as the display value: on the OpenGL display Premiere still needs it.
    if app == "premiere" and _premiere_directx_display(prefix, exe or dxvk_conf):
        env.setdefault("NEUTRON_DISABLE_BTW", "1")
    return applied


APPENV_CONF = "neutron-appenv.conf"


def write_appenv_conf(prefix):
    """Write <prefix>/neutron-appenv.conf: every installed app's own settings, for when ANOTHER app starts it.

    🚨 2026-10-13: Premiere's Dynamic Link started After Effects with PREMIERE'S settings -- a child
    process inherits its parent's environment, and the per-app settings only ever reached the process
    `neutron launch` started. After Effects came up with no splash and a black Composition panel: it
    lacked NEUTRON_WL_ORPHAN_TOPLEVEL and NEUTRON_DXVK_EXPORT_TEXTURES and carried Premiere's
    NEUTRON_D2D_COMPOSEREAD. Same for every app-starts-app path (Edit in Photoshop, Send to Media
    Encoder, ...). The profiles genuinely conflict, so no single environment can serve both apps.

    Neutron's Wine (ntdll, `neutron_apply_app_env`, runtime 11.10-118+) reads this file whenever a
    process starts: if the image path names a section and the inherited NEUTRON_APP differs from the
    section's, it applies the section -- `KEY=VALUE` sets, `-KEY` clears -- to the Windows environment
    and the Unix environ before anything reads them. Each section lists every variable that differs
    between apps, so the child loses the parent's per-app settings as well as gaining its own.

    What a started app gets: exactly what `neutron launch <app>` gives it from a clean shell -- its
    profile plus this prefix's neutron-env.conf. Variables set on the launcher's command line (or
    --with/--without) apply to the app that was launched, not to apps it starts. Variables no profile
    sets (WINEDEBUG, diagnostics) are not listed and still inherit.

    Rewritten on every launch, atomically. Never blocks a launch."""
    sections = []
    drive_c = os.path.join(prefix, "drive_c")
    gpus = drm_gpus()                            # once: every section sees the same machine
    for app, profile in APP_PROFILES.items():
        for exe in _app_exe_variants(prefix, profile["exe"]):
            rel = os.path.relpath(exe, drive_c)
            if rel.startswith(".."):
                continue
            e = {}
            _apply_app_env(e, app, profile, prefix, _dxvk_conf_for_exe(prefix, profile, exe), exe=exe,
                           gpus=gpus)
            sections.append(("C:\\" + rel.replace("/", "\\"), e))
    managed = sorted(set().union(*(e for _, e in sections))) if sections else []
    out = ["# Written by `neutron launch` on every launch -- edits here are overwritten.",
           "# Each installed app's own settings. Neutron's Wine applies an app's section when ANOTHER app",
           "# starts it (Dynamic Link, Edit in Photoshop, ...), so it does not run with the starting app's",
           "# settings. KEY=VALUE sets a variable, -KEY clears it. To change a setting for every app in",
           "# this prefix, use neutron-env.conf.",
           ""]
    for path, e in sections:
        out.append("[%s]" % path)
        out += ["%s=%s" % (k, e[k]) if k in e else "-%s" % k for k in managed]
        out.append("")
    dst = os.path.join(prefix, APPENV_CONF)
    tmp = dst + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(out))
    os.replace(tmp, dst)
    return [path for path, _ in sections]


APP_PROFILES = {
    "premiere": {
        "name": "Premiere Pro",
        "exe": PREMIERE_SUBPATH,
        "dxvk_conf": DXVK_CONF_SUBPATH,
        "overrides": WINEDLLOVERRIDES,           # "ucrtbase=n,b;dwrite=b"
        # ⭐ 2026-08-03 — GPU-ACCELERATED UI MODE, PRODUCTIONISED (was ~/premiere-gpu-mode.sh).
        # The prefix has MZ.Prefs.UseGpuAcceleration=true, and GPU mode WITHOUT this env blacks
        # the ENTIRE interface -- so a plain `neutron launch premiere` rendered black all morning
        # while we hunted a regression that did not exist. Premiere's UI drawbot is the D2D/GPU
        # one; these six are what make its output reach the screen:
        #   NEUTRON_D2D_DCDIRECT   -- D2D HwndRenderTargets render into the window's GDI paint
        #       surface instead of a DXGI swapchain nothing presents ("swapchain-stomp
        #       invisibility", d2d1_private.h:75). The single most load-bearing one.
        #   NEUTRON_GDI_PRESENT    -- DXVK presents non-FLIP swapchains through GDI so they
        #       compose with that same surface. Lives in the prefix's DXVK d3d11, not in wine.
        #   NEUTRON_DCOMP_NATIVE   -- same-process D2D-UI composition path (staged dcomp).
        #   NEUTRON_CEF_MAX_FPS    -- caps the CEF Home-screen repaint rate.
        #   NEUTRON_D2D_COMPOSEREAD -- full-client GetDC+BitBlt compose-read. ⚠️ Premiere WANTS
        #       this; AE must NOT have it (it paints a white screen over AE's canvas before a
        #       composition exists). This is exactly why env is per-profile.
        # NEUTRON_D2D_CLIPCHILDREN is deliberately absent: it defaults ON and only accepts "0",
        # so passing "1" was always inert.
        #
        # ⚠️ Three DLLs must also be staged in the runtime (dcomp.dll, windows.ui.dll,
        # winewayland.drv, all built from the dev tree 2026-08-03 and backed up as
        # *.pre-gpumode-prod). They are LEAKY EXPORTS -- no .mypatch reproduces them, so a fresh
        # `runtime install` will NOT have them and Premiere will be black again. Capturing them
        # as patches is the outstanding work. All three are env-gated OFF by default, which is
        # why staging them is safe for Photoshop/Lightroom/AE sharing this runtime.
        #
        # ⭐ 2026-08-08 — THREE MORE GATES MOVED IN FROM ~/premiere-soak.sh. Premiere was only
        # ever validated through that script, which sets these on top of the profile; every
        # `neutron launch premiere` (and therefore every Collider launch) ran with a strictly
        # smaller feature set than any session judged "working". Defaults in the soak script are
        # RTG=1, DIRG=1, so these values ARE the validated configuration:
        #   NEUTRON_WIC_READTHROUGH -- WIC bitmaps handed to D2D as GPU memory directly.
        #   NEUTRON_DCOMP_DIRECT    -- direct publish of the CEP/Captioneer panel surface.
        #   NEUTRON_HEAP_LARGE_CACHE-- large-block heap cache.
        # ⚠️ Keep this list and premiere-soak.sh's env block in sync; if they diverge again the
        # CLI and the validated path stop testing the same thing. (3rd occurrence of "check how
        # the app was previously validated".)
        "nvapi": False,
