# DLL overrides for the Microsoft files (HKCU\Software\Wine\DllOverrides). msvcp140_2 and
# vcruntime140_1 are deliberately absent: the validated prefixes run Wine's own builds of those two,
# and the ucrtbase shim forwards __CxxFrameHandler4 to Wine's vcruntime140_1.
MS_OVERRIDES = {
    **{"*" + n: "native,builtin" for n, _, _ in _VC2022},
    "*ucrtbase": "native,builtin",
    "*d3dcompiler_47": "native,builtin",   # a missing file falls back to Wine's builtin
    "gdiplus": "native,builtin",           # Animate exits on Wine's builtin GDI+
}
# Written only when the VC++ 2013 installer runs (what winetricks' vcrun2013 sets).
MS_OVERRIDES_VC2013 = {"*" + n: "native,builtin" for n in ("atl120", "msvcp120", "msvcr120", "vcomp120")}


def _ms_cached(sha):
    return os.path.join(MICROSOFT_DIR, "files", sha)


def _ms_have(sha):
    p = _ms_cached(sha)
    return os.path.isfile(p) and _sha256_file(p) == sha


def _http_get(url, dest, as_json=True, ranges=None, size=None):
    """Download `url` to `dest`. With `ranges`, fetch only those byte spans into a sparse file of
    `size` bytes and return False (without raising) if the server ignores Range requests."""
    import urllib.request
    if not ranges:
        _download(url, dest, as_json)
        return True
    with open(dest, "wb") as out:
        for start, end in ranges:
            req = urllib.request.Request(url, headers={"User-Agent": "neutron-cli",
                                                       "Range": f"bytes={start}-{end - 1}"})
            with urllib.request.urlopen(req, timeout=60) as r:
                if r.status != 206:
                    return False
                out.seek(start)
                for chunk in iter(lambda: r.read(1 << 20), b""):
                    out.write(chunk)
        out.truncate(size or out.tell())
    return True


def _cab_extract(container, members, workdir):
    """Pull members[-1] out of `container`, descending through nested cabinets. Returns its path."""
    src = container
    for i, member in enumerate(members):
        out = os.path.join(workdir, f"x{i}")
        os.makedirs(out, exist_ok=True)
        r = subprocess.run(["cabextract", "-q", "-d", out, "-F", member, src],
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        hit = None
        want = member.replace("\\", "/").lower()
        for root, _dirs, files in os.walk(out):
            for fn in files:
                rel = os.path.relpath(os.path.join(root, fn), out).replace(os.sep, "/")
                if rel.lower() == want:
                    hit = os.path.join(root, fn)
        if not hit:
            raise RuntimeError(f"{member} not found in {os.path.basename(src)}"
                               + (f" ({r.stderr.strip()[:200]})" if r.stderr.strip() else ""))
        src = hit
    return src


def ms_fetch(as_json=True, only=None):
    """Make sure every pinned Microsoft file (or those in `only`) is in MICROSOFT_DIR, verified.
    Returns {"ok", "fetched", "present", "failed": {download: reason}}."""
    import tempfile
    os.makedirs(os.path.join(MICROSOFT_DIR, "files"), exist_ok=True)
    want = {k: v for k, v in MS_FILES.items() if only is None or k in only}
    missing = {k: v for k, v in want.items() if not _ms_have(v[2])}
    res = {"ok": True, "fetched": [], "present": sorted(set(want) - set(missing)), "failed": {}}
    if missing and not have("cabextract"):
        res.update(ok=False, failed={"*": "cabextract is not installed"})
        return res
    by_dl = {}
    for k, v in missing.items():
        by_dl.setdefault(v[0], []).append(k)
    for dl_id, keys in sorted(by_dl.items()):
        dl = MS_DOWNLOADS[dl_id]
        tmp = tempfile.mkdtemp(prefix=".ms-", dir=MICROSOFT_DIR)
        try:
            container = os.path.join(tmp, os.path.basename(dl["url"]))
            whole = True
            if dl.get("ranges"):
                if not as_json:
                    log(f"downloading part of {os.path.basename(dl['url'])} "
                        f"(~{sum(b - a for a, b in dl['ranges']) / (1 << 20):.0f} MiB of "
                        f"{dl['size'] / (1 << 20):.0f} MiB)")
                try:
                    whole = not _http_get(dl["url"], container, ranges=dl["ranges"], size=dl["size"])
                    if not whole:
                        for k in keys:
                            _ms_take(container, MS_FILES[k], tmp)
                except Exception as e:
                    log(f"{dl_id}: partial download did not work ({e}); downloading the whole file")
                    whole = True
            if whole:
                if not as_json:
                    log(f"downloading {os.path.basename(dl['url'])} ({dl['size'] / (1 << 20):.1f} MiB)")
                _http_get(dl["url"], container, as_json)
                got = _sha256_file(container)
                if got != dl["sha256"]:
                    raise RuntimeError(f"checksum mismatch (expected {dl['sha256'][:16]}…, got {(got or '')[:16]}…)")
            for k in keys:
                if not _ms_have(MS_FILES[k][2]):
                    _ms_take(container, MS_FILES[k], tmp)
                res["fetched"].append(k)
        except Exception as e:
            res["ok"] = False
            res["failed"][dl_id] = str(e)
            log(f"{dl_id}: {e}")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    return res


def _ms_take(container, spec, tmp):
    """Extract one MS_FILES entry from its downloaded container into the cache, verified."""
    _dl, members, sha, _dir, _name = spec
    path = _cab_extract(container, members, tmp) if members else container
    got = _sha256_file(path)
    if got != sha:
        raise RuntimeError(f"{members[-1] if members else os.path.basename(container)}: checksum "
                           f"mismatch (expected {sha[:16]}…, got {(got or '')[:16]}…)")
    dst = _ms_cached(sha)
    shutil.copyfile(path, dst + ".part")
    os.replace(dst + ".part", dst)


def ms_status():
    """{file key: True/False} for the cache, without hashing every file (size check only)."""
    out = {}
    for k, (_dl, _m, sha, _d, _n) in MS_FILES.items():
        out[k] = os.path.isfile(_ms_cached(sha))
    return out


def reg_import(wine, prefix, sections, tag="neutron"):
    """Write {key: {name: value}} to the prefix in ONE `reg import`: str = REG_SZ, int = DWORD,
    None = delete the value."""
    def esc(s):
        return s.replace("\\", "\\\\").replace('"', '\\"')
    def val(v):
        if v is None:
            return "-"
        if isinstance(v, bool) or isinstance(v, int):
            return "dword:%08x" % int(v)
        return f'"{esc(v)}"'
    lines = ["REGEDIT4", ""]
    for key, values in sections.items():
        lines.append(f"[{key}]")
        lines += [f'"{esc(n)}"={val(v)}' for n, v in values.items()]
        lines.append("")
    tmp_dir = os.path.join(prefix, "drive_c", "windows", "temp")
    os.makedirs(tmp_dir, exist_ok=True)
    with open(os.path.join(tmp_dir, f"{tag}.reg"), "w", newline="") as f:
        f.write("\r\n".join(lines) + "\r\n")
    env = {**os.environ, "WINEPREFIX": prefix}
    env.setdefault("DISPLAY", ":0")
    r = subprocess.run([wine, "reg", "import", rf"C:\windows\temp\{tag}.reg"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
    return r.returncode == 0


def _ms_installed(prefix, display_name):
    """True if Programs and Features (system.reg) lists `display_name`. Checked by the installer's
    own entry, not the VC\\Runtimes key: Wine's wine.inf writes that key itself (claiming 14.42)."""
    want = f'"DisplayName"="{display_name}"'
    try:
        with open(os.path.join(prefix, "system.reg"), encoding="utf-8", errors="replace") as f:
            return any(line.startswith(want) for line in f)
    except OSError:
        return False


def _run_ms_installer(wine, prefix, key, args=("/q",)):
    """Run a cached Microsoft installer (MS_FILES key) in the prefix. The cache names files by
    sha256, so it runs from a copy with its real .exe name in the prefix's temp dir."""
    tmp = os.path.join(prefix, "drive_c", "windows", "temp")
    os.makedirs(tmp, exist_ok=True)
    exe = os.path.join(tmp, "neutron-" + key)
    shutil.copyfile(_ms_cached(MS_FILES[key][2]), exe)
    env = {**os.environ, "WINEPREFIX": prefix, "WINEDEBUG": "-all"}
    env.setdefault("DISPLAY", ":0")
    env.pop("WINEDLLOVERRIDES", None)
    try:
        r = subprocess.run([wine, exe, *args], env=env, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=600)
        wineserver_wait(wine, prefix)
    finally:
        try:
            os.remove(exe)
        except OSError:
            pass
    return r.returncode


def install_microsoft(wine, prefix, as_json=True, vc2013=False):
    """Install the Microsoft components into a prefix. Idempotent; downloads anything not yet
    cached. VC++ 2015-2022 runs through Microsoft's own installer (Adobe's installers look for
    the registration it writes), then its DLLs are pinned to the validated build.

    VC++ 2013 only with vc2013=True: Mud Hut asks for it right before Adobe's installer, the one
    place it was ever installed (winetricks vcrun2013). A prefix that is already set up never gets
    it from a later provision -- .premiere2025 runs all seven apps without it, on Wine's own
    msvcp120/vcomp120. Returns a step dict for provision's report."""
    fetched = ms_fetch(as_json)
    if not fetched["ok"]:
        return {"step": "microsoft", "ok": False, "failed": fetched["failed"],
                "detail": "could not download the Microsoft components; run `neutron setup` "
                          "again when online"}
    win = os.path.join(prefix, "drive_c", "windows")
    rt_root = os.path.dirname(os.path.dirname(os.path.realpath(wine)))
    done = {"installers": {}, "copied": 0, "restored_wine_builtins": []}   # installer -> exit code

    # 1. VC++ 2013 (12.0.40660). Like winetricks: Wine's own msvcp120/msvcr120/vcomp120 builtins
    #    are removed first so Microsoft's installer can put its files in place.
    if vc2013 and not _ms_installed(prefix, "Microsoft Visual C++ 2013 Redistributable (x64) - 12.0.40660"):
        for scope in ("syswow64", "system32"):
            for n in ("msvcp120", "msvcr120", "vcomp120"):
                p = os.path.join(win, scope, n + ".dll")
                if _is_wine_builtin(p):
                    os.remove(p)
        for k in ("vc2013-x86.exe", "vc2013-x64.exe"):
            done["installers"][k] = _run_ms_installer(wine, prefix, k)

    # 2. VC++ 2015-2022 (14.44.35211): the installer registers it, then the nine DLLs are copied
    #    from the cache, because Wine's builtins carry a HIGHER version and the installer will not
    #    replace them.
    if not _ms_installed(prefix, "Microsoft Visual C++ 2015-2022 Redistributable (x64) - 14.44.35211"):
        for k in ("vc2022-x86.exe", "vc2022-x64.exe"):
            done["installers"][k] = _run_ms_installer(wine, prefix, k)

    # 3. Every file with a prefix destination: copy when missing or different.
    fonts_copied = False
    for k, (_dl, _m, sha, pdir, name) in MS_FILES.items():
        if not pdir:
            continue
        dst = os.path.join(win, pdir, name)
        if _sha256_file(dst) == sha:
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copyfile(_ms_cached(sha), dst)
        done["copied"] += 1
        fonts_copied = fonts_copied or pdir == "Fonts"
    if fonts_copied:
        register_prefix_fonts(wine, prefix)   # Wine only offers apps the fonts in the HKLM key

    # 4. msvcp140_2 + vcruntime140_1 stay Wine's builds (see MS_OVERRIDES). If an installer
    #    replaced them, put the runtime's copies back.
    for scope, pedir in (("system32", "x86_64-windows"), ("syswow64", "i386-windows")):
        for n in ("msvcp140_2.dll", "vcruntime140_1.dll"):
            p = os.path.join(win, scope, n)
            src = os.path.join(rt_root, "lib", "wine", pedir, n)
            if os.path.isfile(p) and not _is_wine_builtin(p) and os.path.isfile(src):
                shutil.copyfile(src, p)
                done["restored_wine_builtins"].append(f"{scope}/{n}")

    overrides = dict(MS_OVERRIDES)
    if any(k.startswith("vc2013") for k in done["installers"]):
        overrides.update(MS_OVERRIDES_VC2013)
    reg_import(wine, prefix, {r"HKEY_CURRENT_USER\Software\Wine\DllOverrides": overrides},
               tag="neutron-microsoft")
    return {"step": "microsoft", "ok": True, "overrides": len(overrides), **done,
            "downloaded": fetched["fetched"]}


# --- What stage_natives put into a prefix -------------------------------------------------------
# A runtime's natives.json says which DLLs it stages, and the next runtime a prefix moves to may list
# FEWER: `neutron update` after trying a pre-release goes back to the Latest release, and 11.10-128
# added amfrt64.dll (AMD hardware encoding) with `amfrt64=native`, which 11.10-127 does not have.
# Staging used to only add, so the newer runtime's DLL and its override stayed behind.
# So each staging records in the prefix what Neutron put there: per file the path under
# drive_c/windows, its sha256 and its overrides. A later staging removes an entry the runtime no
# longer lists -- the file only while it is still byte-for-byte what we staged (never one the user or
# an app replaced), and its overrides unless something Neutron writes still wants that key.
NATIVES_RECORD = "neutron-natives-staged.json"
# Natives an older CLI staged before the record existed: (path under drive_c/windows, the runtime
# whose natives.json gives the checksum it staged). Without a record a file is removed only when it
# matches that checksum exactly, which only that runtime's own build does; when that runtime is no
# longer installed, the file is left alone.
NATIVES_UNRECORDED = (("system32/amfrt64.dll", "11.10-128"),)


def _natives_entry(e):
    """A validated record entry {"path", "sha256", "override"}, or None. The path must stay inside
    drive_c/windows: the record is a file in the prefix, and cleanup deletes what it names."""
    if not isinstance(e, dict):
        return None
    path, sha, ovr = e.get("path"), e.get("sha256"), e.get("override")
    if (not isinstance(path, str) or not path or path.startswith("/") or "\\" in path
            or ".." in path.split("/") or not isinstance(sha, str)
            or not re.fullmatch(r"[0-9a-f]{64}", sha) or not isinstance(ovr, dict)
            or not all(isinstance(k, str) and isinstance(v, str) for k, v in ovr.items())):
        return None
    return {"path": path, "sha256": sha, "override": dict(ovr)}


def read_natives_record(prefix):
    """{path: entry} of what Neutron staged into `prefix`, or None when the prefix has no record
    (provisioned by CLI 1.0.0-beta.13 or older, or never)."""
    try:
        with open(os.path.join(prefix, NATIVES_RECORD)) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    out = {}
    for e in (data.get("files") if isinstance(data, dict) else None) or []:
        e = _natives_entry(e)
        if e:
            out[e["path"]] = e
    return out


def _write_natives_record(prefix, runtime, entries):
    path = os.path.join(prefix, NATIVES_RECORD)
    data = {"format": 1, "runtime": runtime, "files": [entries[k] for k in sorted(entries)]}
    try:
        with open(path + ".part", "w") as f:
            json.dump(data, f, indent=1)
            f.write("\n")
        os.replace(path + ".part", path)
    except OSError as e:
        log(f"could not write {path}: {e}")


def _unrecorded_natives(skip):
    """Entries for NATIVES_UNRECORDED whose paths are not in `skip`, with the checksum and overrides
    from the natives.json of the runtime that staged them, when that runtime is installed."""
    out = {}
    for path, ver in NATIVES_UNRECORDED:
        if path in skip:
            continue
        try:
            with open(os.path.join(NEUTRON_RUNTIMES_DIR, f"neutron-wine-{ver}", "share", "neutron",
                                   "natives.json")) as f:
                rows = json.load(f).get("files", [])
        except (OSError, ValueError, AttributeError):
            continue
        for row in rows:
            try:
                if f'{row["prefix_dir"]}/{row["dll"]}.dll' != path:
                    continue
                e = _natives_entry({"path": path, "sha256": row["sha256"], "override": row["override"]})
            except (KeyError, TypeError):
                continue
            if e:
                out[path] = e
            break
    return out


def stage_natives(wine, prefix):
    """Copy the runtime's own DLLs (DXVK, vkd3d-proton, dxvk-nvapi, the NVIDIA wrappers, the
    ucrtbase shim, amfrt64) into the prefix and write their overrides, from
    <runtime>/share/neutron/natives.json. Copies only files whose sha256 differs, so it is cheap
    to run on every provision and heals a prefix whose DLLs were replaced. Removes what an earlier
    runtime staged and this one no longer lists (NATIVES_RECORD)."""
    rt = runtime_root(wine)
    try:
        with open(os.path.join(rt, "share", "neutron", "natives.json")) as f:
            natives = json.load(f)
    except (OSError, ValueError):
        return {"step": "natives", "ok": False,
                "detail": f"{os.path.basename(rt)} predates the runtime-bundled DLLs (no "
                          "share/neutron/natives.json), so the prefix keeps the DLLs it has; "
                          "`neutron update` installs a current runtime"}
    win = os.path.join(prefix, "drive_c", "windows")
    rows = natives.get("files", [])
    previous = read_natives_record(prefix) or {}
    record = {}
    staged, unchanged, waiting, broken = [], 0, [], []
    overrides = dict(PROVISION_DLL_OVERRIDES)
    for row in rows:
        name = f'{row["prefix_dir"]}/{row["dll"]}.dll'
        req = row.get("requires")
        if req and _sha256_file(os.path.join(win, row["prefix_dir"], req["file"])) != req["sha256"]:
            # The shim without its exact Microsoft UCRT would break everything that links the CRT.
            waiting.append(f'{name} (needs Microsoft\'s {req["file"]})')
            if name in previous:
                record[name] = previous[name]     # still listed and left as it is
            continue
        dst = os.path.join(win, row["prefix_dir"], row["dll"] + ".dll")
        if _sha256_file(dst) == row["sha256"]:
            unchanged += 1
        elif _sha256_file(os.path.join(rt, row["file"])) != row["sha256"]:
            broken.append(name)
            if name in previous:
                record[name] = previous[name]
            continue
        else:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copyfile(os.path.join(rt, row["file"]), dst)
            staged.append(name)
        overrides.update(row["override"])
        record[name] = {"path": name, "sha256": row["sha256"], "override": dict(row["override"])}

    # What this runtime no longer lists. An override key that anything Neutron writes still wants
    # (any row of this runtime, staged or not; the provision pins; Microsoft's) is never removed.
    listed = {f'{r["prefix_dir"]}/{r["dll"]}.dll' for r in rows}
    wanted = {k.lower() for r in rows for k in r["override"]}
    wanted |= {k.lower() for k in (*PROVISION_DLL_OVERRIDES, *MS_OVERRIDES, *MS_OVERRIDES_VC2013)}
    stale = {p: e for p, e in previous.items() if p not in listed}
    unrecorded = _unrecorded_natives(set(previous) | listed)
    removed, kept, gone, kept_keys = [], [], [], set()
    for path in sorted({**unrecorded, **stale}):
        e = stale.get(path) or unrecorded[path]
        f = os.path.join(win, path)
        have = _sha256_file(f)
        if path not in stale and have != e["sha256"]:
            continue                              # no record and not that exact build: not ours to touch
        if have is not None and have != e["sha256"]:
            # Replaced since we staged it, by the user or an app: theirs now, and so is its override.
            kept.append(path)
            kept_keys |= {k.lower() for k in e["override"]}
            continue
        if have is not None:
            try:
                os.remove(f)
            except OSError as err:
                log(f"could not remove {f}: {err}")
                record[path] = e                  # try again next time
                kept_keys |= {k.lower() for k in e["override"]}
                continue
            removed.append(path)
        gone.append(e)
    drop = sorted({k for e in gone for k in e["override"]
                   if k.lower() not in wanted and k.lower() not in kept_keys}, key=str.lower)
    reg_ok = reg_import(wine, prefix, {r"HKEY_CURRENT_USER\Software\Wine\DllOverrides":
                                       {**overrides, **{k: None for k in drop}}},
                        tag="neutron-natives")
    if drop and not reg_ok:
        for e in gone:                            # the overrides are still there: try again next time
            record.setdefault(e["path"], e)
    _write_natives_record(prefix, os.path.basename(rt), record)
    step = {"step": "natives", "ok": not waiting and not broken, "staged": staged,
            "unchanged": unchanged, "overrides": len(overrides), "removed": removed,
            "overrides_removed": drop if reg_ok else []}
    details = []
    if waiting:
        details.append("not staged: " + ", ".join(waiting))
    if broken:
        details = [f"{os.path.basename(rt)} is damaged ({', '.join(broken)} does not match "
                   "its checksum); reinstall it with `neutron update`"]
    if kept:
        step["kept"] = kept
        details.append("left in place because it changed after Neutron staged it: " + ", ".join(kept))
    if details:
        step["detail"] = "; ".join(details)
    return step


def cmd_prefix_provision(args):
    """Make a (possibly freshly-staged) prefix Neutron-ready. Idempotent. This is
    the single source of truth for the provisioning recipe — Mud Hut calls it
    after copying the Adobe binaries in.

    Steps: (1) initialize the Wine prefix if needed (wineboot); (2) install Microsoft's
    components (VC++ runtimes, UCRT, d3dcompiler_47, GDI+, core fonts; downloaded once by
    `neutron setup`); (3) stage the runtime's own DLLs (DXVK, vkd3d-proton, NVIDIA wrappers, the
    ucrtbase shim) with their overrides; (4) registry provisioning (Wayland graphics driver, fonts,
    theme); (5) WebView2 + Mono/Gecko; (6) the Adobe-suite DXVK configs.

    --microsoft-only stops after (2): Mud Hut runs that before Adobe's installer, which looks for
    the VC++ runtimes. Licensing/activation is never ours (it happens inside the Adobe app)."""
    prefix = resolve_prefix(args.path)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "prefix", None) or getattr(args, "path", None))},
            EX_BADPREFIX, args.json)

    wine, is_neutron = resolve_wine()
    if not wine:
        die({"ok": False, "reason": NO_RUNTIME_MSG}, EX_DEP, args.json)
    remember_prefix(prefix)

    steps = []

    # Adobe's helpers (Adobe Desktop Service and AdobeIPCBroker, which `launch` starts for
    # Photoshop; CCXProcess and node, which the apps start) outlive the app, so the prefix's wine
    # session never ends and every wineserver_wait below sat out its 240 s behind them (release
    # test, 2026-10-07: 495 s instead of 27). With no Adobe app open, close the session first;
    # with one open, leave it alone.
    leftover = [_proc_win_exe(pid).rsplit("/", 1)[-1] or c
                for pid, c, is_app in _prefix_procs(prefix) if is_app]
    if leftover and not _running_app_ids(prefix):
        cmd_teardown(argparse.Namespace(prefix=prefix, json=True, force=False, grace=25, app=None),
                     _emitted=True)
        steps.append({"step": "closed_helpers", "ok": not _prefix_procs(prefix),
                      "closed": sorted(set(leftover))})

    event(args, event="progress", stage="init", pct=5, msg="initialising the wine prefix (wineboot) — this is the slow part")
    # 1. Initialize / update the prefix under Mono+Gecko suppression. Run wineboot -u
    # ALWAYS (not only on a fresh prefix): an existing prefix launched against a newer
    # runtime build triggers a lazy prefix-UPDATE on the first wine call, and that update
    # pops the blocking Wine Mono/Gecko dialog — which then wedges every subsequent
    # command (reg writes time out). Absorbing the update here with mscoree,mshtml=
    # suppressed keeps the dialog from ever appearing; install_mono_gecko then installs
    # the real thing right after, so no later wine call has a pending update to prompt on.
    # This suppression is ONLY for this controlled boot, NEVER for the launch path.
    sysreg = os.path.join(prefix, "system.reg")
    fresh = not os.path.isfile(sysreg)
    try:
        env = dict(os.environ)
        env["WINEPREFIX"] = prefix
        env.setdefault("DISPLAY", ":0")
        env["WINEDLLOVERRIDES"] = "mscoree,mshtml="   # suppress the Mono/Gecko prompt
        # -r: without it wineboot also runs the Windows "Run" keys and Startup folder
        # (wineboot.c: `if (!init && !restart) ProcessRunKeys(... L"Run" ...)`), i.e. every
        # program set to start at login. Adobe's add-ons register CCXProcess there; it starts
        # node.exe and an AdobeIPCBroker and never exits, so every wineserver_wait below ran
        # out its 240 s and the stray broker can take Photoshop's IPC endpoint ("unable to
        # communicate with Creative Cloud desktop"). -r skips only those; the forced update
        # and RunOnce are unchanged. App launches never run them: a cold prefix boots with
        # --init. Release test, 2026-10-07.
        subprocess.run([wine, "wineboot", "-u", "-r"], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=240)
        wineserver_wait(wine, prefix)   # wineboot detaches; wait so system.reg lands
    except Exception as e:
        log(f"wineboot failed (non-fatal to reporting): {e}")
    steps.append({"step": "init", "skipped": False, "fresh": fresh,
                  "ok": os.path.isfile(sysreg)})

    # Microsoft's components BEFORE our DLLs: the ucrtbase shim forwards to ucrtbase_orig.dll.
    event(args, event="progress", stage="microsoft", pct=40,
          msg="installing Microsoft's VC++ runtimes, UCRT, d3dcompiler, GDI+ and core fonts")
    steps.append(install_microsoft(wine, prefix, args.json,
                                   vc2013=getattr(args, "microsoft_only", False)))
    if getattr(args, "microsoft_only", False):
        wineserver_wait(wine, prefix)
        ok = all(st.get("ok", True) for st in steps)
        emit({"ok": ok, "prefix": prefix, "steps": steps}, args.json,
             streaming=getattr(args, "progress", False))
        return EX_OK if ok else EX_FAIL

    event(args, event="progress", stage="registry", pct=62, msg="writing registry provisioning (graphics driver, app compat)")
    # 2. Registry provisioning (only affects newly-started processes; shared-safe).
    reg_set(wine, prefix, r"HKCU\Software\Wine\Drivers", "Graphics", "REG_SZ",
            "wayland" if session_is_wayland() else "x11")
    steps.append({"step": "graphics", "ok": True})

    # 2b. Photoshop 2026 caption buttons: on a prefix reporting Windows 11 the
    # Adobe chrome DEFERS its min/max/close caption buttons to DWM (real
    # Windows 11 composites them); Wine has no DWM caption renderer, so the
    # reserved button area renders as a black box (it never even queries
    # DWMWA_CAPTION_BUTTON_BOUNDS on Win10). Reporting Windows 10 to
    # Photoshop.exe selects Adobe's SELF-drawn caption buttons — the PS 2025
    # behavior, which renders correctly under Wine. App-scoped: the rest of
    # the prefix keeps its Windows version.
    reg_set(wine, prefix, r"HKCU\Software\Wine\AppDefaults\Photoshop.exe",
            "Version", "REG_SZ", "win10")
    steps.append({"step": "ps_caption_win10", "ok": True})

    # 2b'. InDesign's Type > Font menu: on build >= 22000 (Windows 11) its owner-drawn menu paints
    # the hovered row's rounded highlight BEFORE applying its own UI scale, from the row's
    # unscaled frame, and skips clearing its reused row bitmap. At any UI scale above 100% the bar
    # is the row divided by that scale and the previously drawn row shows through (unchanged since
    # InDesign 2025). The Windows 10 branch fills the whole row. App-scoped like Photoshop above.
    reg_set(wine, prefix, r"HKCU\Software\Wine\AppDefaults\InDesign.exe",
            "Version", "REG_SZ", "win10")
    steps.append({"step": "indesign_menu_win10", "ok": True})

    # 2b''. Photoshop pen pressure: WinTab instead of Windows Ink (see PS_WINTAB_LINE). Launches repeat it for a
    # Photoshop installed after this.
    try:
        steps.append({"step": "ps_pen_wintab", "ok": True,
                      "photoshops": [{"app": n, "action": a} for n, a in ensure_photoshop_wintab(prefix)]})
    except OSError as e:
        steps.append({"step": "ps_pen_wintab", "ok": False, "error": str(e)})

    # 2b'''. Lightroom Classic: Windows' "System" high-DPI override, so it has the right size on every screen (see
    # LRC_LAYERS_FLAGS). Launches repeat it for a Lightroom installed after this.
    steps.append({"step": "lrc_system_dpi", "ok": True, "action": ensure_lightroom_system_dpi(wine, prefix)})

    event(args, event="progress", stage="lrc", pct=70, msg="registering the Lightroom → Photoshop detector key")
    # 2c. Lightroom Classic's "Edit in Photoshop" detector: register the dot-free
    # PHSP<major> Uninstall key so LrC's whole-string regex_match finds PS (see
    # provision_photoshop_detection). No-op
    # when no Photoshop is installed in this prefix.
    ps_detect = provision_photoshop_detection(wine, prefix)
    if ps_detect is not None:
        steps.append({"step": "lrc_ps_detection", **ps_detect})

    runtime = resolve_runtime()        # a development bundle ($NEUTRON_RUNTIME), never in releases
    event(args, event="progress", stage="dlls", pct=75, msg="staging the runtime's DXVK, vkd3d-proton and NVIDIA DLLs")
    steps.append(stage_natives(wine, prefix))
    if runtime:
        # Stage the full proven DLL set + write every override from the bundle.
        try:
            with open(os.path.join(runtime, "overrides.json")) as f:
                overrides = json.load(f)
        except Exception as e:
            log(f"runtime overrides.json unreadable: {e}")
            overrides = {}
        files_staged = 0
        # NEUTRON: the DLL bundle is a SNAPSHOT of some past prefix, and provisioning used to
        # copy all of it over the prefix unconditionally -- including the wine builtins that
        # were captured with it. Provisioning a prefix pinned to 11.10-58 therefore reinstated
        # the 11.10-45 dwrite.dll (the use-after-free one) and read as a mass regression with
        # no code change behind it. The bundle is still the right source for everything that
        # is NOT ours (DXVK, vkd3d-proton, nvidia, Microsoft's VC++ redist); for the handful
        # that IS ours, the PINNED RUNTIME is the authority and the bundle is merely stale.
        # Prefer the runtime's copy per file, so this self-heals on every provision instead of
        # waiting for someone to rebuild the bundle.
        rt_root = os.path.dirname(os.path.dirname(os.path.realpath(wine)))   # <rt>/bin/wine -> <rt>
        refreshed, unrefreshable = [], []
        for scope, pedir in (("system32", "x86_64-windows"), ("syswow64", "i386-windows")):
            srcdir = os.path.join(runtime, "dlls", scope)
            dstdir = os.path.join(prefix, "drive_c", "windows", scope)
            rtpe = os.path.join(rt_root, "lib", "wine", pedir)
            if os.path.isdir(srcdir):
                os.makedirs(dstdir, exist_ok=True)
                for fn in os.listdir(srcdir):
                    src = os.path.join(srcdir, fn)
                    if _is_wine_builtin(src):
                        cand = os.path.join(rtpe, fn)
                        if os.path.isfile(cand):
                            if _sha256_file(cand) != _sha256_file(src):
                                refreshed.append(f"{scope}/{fn}")
                            src = cand
                        else:
                            # No counterpart in the pinned runtime. ⛔ This was first written as
                            # "a 64-bit-only runtime has no i386-windows tree" -- that was read off
                            # 11.10-61, which shipped BROKEN with an empty i386-windows; 60 and 62
                            # carry 1,101 files and refresh all eight. A healthy runtime should hit
                            # this path for nothing, so anything landing here is a signal that the
                            # runtime is incomplete, not a fact of life.
                            # no i386-windows tree, so every syswow64 builtin lands here. The
                            # bundle's copy is the only one that exists; stage it, but SAY SO.
                            # This is the one that can still rot silently.
                            unrefreshable.append(f"{scope}/{fn}")
                    try:
                        shutil.copyfile(src, os.path.join(dstdir, fn))
                        files_staged += 1
                    except OSError as e:
                        log(f"stage {scope}/{fn} failed: {e}")
        if refreshed:
            log("staged from the pinned runtime instead of the (stale) bundle: "
                + ", ".join(sorted(refreshed)))
        if unrefreshable:
            log("⚠️  bundle-only wine builtins (no counterpart in the pinned runtime, "
                "so they cannot be refreshed here): " + ", ".join(sorted(unrefreshable))
               )
        for name, val in overrides.items():
            reg_set(wine, prefix, r"HKCU\Software\Wine\DllOverrides", name, "REG_SZ", val)
        steps.append({"step": "dev_bundle", "source": runtime,
                      "overrides": len(overrides), "files_staged": files_staged, "ok": True,
                      "builtins_refreshed": sorted(refreshed),
                      "builtins_bundle_only": sorted(unrefreshable)})
    fonts = expected_font_replacements(runtime)
    for name, repl in fonts.items():
        reg_set(wine, prefix, r"HKCU\Software\Wine\Fonts\Replacements", name, "REG_SZ", repl)
    event(args, event="progress", stage="fonts", pct=82, msg="applied the Adobe font replacement map")
    steps.append({"step": "fonts", "count": len(fonts), "ok": True})

    # The replacement map's target must exist: copy Adobe Clean in from whichever Adobe app is
    # installed (see _adobe_clean_sources), for every install method, before registering.
    seeded = seed_adobe_clean(prefix)
    steps.append({"step": "adobe_clean", **seeded})

    # Activate the staged fonts. Copying files into windows/Fonts is NOT enough —
    # Wine never registers them, so the replacement targets (Adobe Clean) stay
    # invisible to dwrite and the suite deadlocks on first text layout. Register
    # them explicitly in the HKLM Fonts key.
    nfonts = register_prefix_fonts(wine, prefix)
    steps.append({"step": "font_register", "count": nfonts, "ok": True})

    # 🚨 Repair the Roman defaults BEFORE anything launches. If every one of
    # times/arial/cour is a Wine substitute, CoolType has no PostScript name to
    # select as its default Roman face, it throws, and After Effects
    # dies at startup ("EGG Constructor IEggApp failed" -- a message about
    # preferences-folder permissions that has nothing to do with the fault).
    # Repro'd and reversed in the clean room 2026-08-11; see
    # _roman_default_status(). We only ever copy a font whose PostScript name is
    # genuinely the one CoolType wants, so this cannot make a prefix worse.
    repaired, unrepaired, _fetched = _repair_roman_defaults(wine, prefix)
    # ⭐ 2026-09-13 (operator's decision): ALSO fetch when ANY of the six Microsoft core fonts is
    # missing, not only when the Roman defaults could not be repaired locally. install_microsoft
    # above already put them in place; this catches a prefix whose Fonts dir was changed since.
    _present, _missing = _ms_core_fonts_status(prefix)
    _core_fetched = False
    if _missing and not _fetched:
        log("Microsoft core fonts incomplete (missing %s) -- installing them" % ", ".join(_missing))
        _core_fetched = install_corefonts(wine, prefix, args.json)
        _present, _missing = _ms_core_fonts_status(prefix)
        if _core_fetched:
            register_prefix_fonts(wine, prefix)   # the new files must be registered too
    steps.append({"step": "ms_core_fonts", "ok": not _missing, "present": _present,
                  "missing": _missing, "fetched": _core_fetched or _fetched,
                  "detail": ("%d/6 present" % len(_present)) if not _missing else
                            ("%d/6 present, missing %s -- Premiere, After Effects and Media Encoder "
                             "will not start; run `neutron fonts repair --prefix %s` when online"
                             % (len(_present), ", ".join(_missing), prefix))})
    # 🚨 UNCONDITIONALLY, even when nothing was repaired. CoolType's cache is
    # keyed on FILENAME, so any font work that overwrites a file in place --
    # ours above, or a font the user copied in -- leaves
    # the cached record pointing at whatever used to be there. Repairing the
    # files and leaving the cache yields a prefix that passes every check and
    # still fails, which is exactly how the build tester lost three days after
    # their fonts were already correct. Adobe rebuilds these on next launch.
    ncache = invalidate_cooltype_caches(prefix)
    steps.append({"step": "cooltype_cache_invalidate", "count": ncache, "ok": True})
    # CEP manifests an older Neutron edited: put back the signed originals, or CEP refuses the
    # extension (restore_cep_manifests). Only onto a runtime verified without the old flags.
    rt = _runtime_version_of(wine)
    if _runtime_at_least(rt, CEP_RESTORE_MIN_RUNTIME):
        cep_restored, cep_unmatched = restore_cep_manifests(prefix, log_fn=log)
        steps.append({"step": "cep_manifests", "ok": True,
                      "restored": cep_restored, "unmatched": cep_unmatched,
                      "detail": "; ".join(filter(None, [
                          ("restored the signed manifest of %s  — RESTART the app; manifests are "
                           "read only at startup" % ", ".join(cep_restored)) if cep_restored else "",
                          ("could not rebuild the signed manifest of %s; reinstall the extension"
                           % ", ".join(cep_unmatched)) if cep_unmatched else ""]))
                                or "no manifests edited by Neutron"})
    else:
        steps.append({"step": "cep_manifests", "ok": True, "skipped": True,
                      "detail": "left as they are on runtime %s (restoring needs %s or later)"
                                % (rt or "unknown", CEP_RESTORE_MIN_RUNTIME)})
    roman = _roman_default_status(prefix)
    genuine = [fn for fn, state, _ in roman if state == "real"]
    steps.append({"step": "cooltype_roman_default",
                  "ok": bool(genuine),
                  "genuine": genuine, "repaired": repaired,
                  "detail": ", ".join(f"{fn}={state}" for fn, state, _ in roman) +
                            ("" if genuine else
                             "  — NO genuine Roman face; After Effects WILL fail at startup. "
                             "Run `neutron fonts repair --prefix %s` to install the Microsoft "
                             "core fonts." % prefix)})
    if not genuine:
        log("⚠️  no genuine Roman default font (times/arial/cour are all Wine "
            "substitutes) — After Effects will fail at startup. Run "
            "`neutron fonts repair --prefix %s`." % prefix)

    # Desktop identity: a .desktop + extracted icon per installed app. Gives each app its own
    # dock icon (StartupWMClass = Wine's app_id) instead of inheriting Collider's, and puts the
    # suite in the application menu. See register_app_desktop_entries().
    desktop_entries = register_app_desktop_entries(prefix)
    steps.append({"step": "desktop_entries", "ok": True,
                  "count": len(desktop_entries["entries"]),
                  "icons": sum(1 for e in desktop_entries["entries"] if e["icon"]),
                  # PER TOOL, not a boolean. A tester who provisions inside a live session used
                  # to see generic icons and report extraction as broken; the refresh is part of
                  # the step now, and if one of the refreshers fails the report says which.
                  "caches": desktop_entries["caches"],
                  "superseded": desktop_entries["superseded"],
                  "claimed_types": desktop_entries["claimed_types"],
                  "detail": desktop_entries["entries"]})

    # WebView2: stage + register the runtime or Adobe's in-app web sign-in (IMS)
    # renders BLANK (the installer's Common Files copy is unregistered).
    wv2, wv2_src = register_webview2(wine, prefix, args.json)
    event(args, event="progress", stage="webview2", pct=88, msg="registered the WebView2 runtime (Adobe sign-in)")
    wv2_step = {"step": "webview2", "version": wv2, "source": wv2 and wv2_src, "ok": wv2 is not None}
    if not wv2:
        wv2_step["detail"] = (f"no WebView2 runtime ({wv2_src}); Adobe's in-app sign-in will "
                              "render blank until provisioning can download it")
    elif webview2_untested(wv2):
        wv2_step["warning"] = (f"WebView2 {wv2} is untested under neutron-wine; tested: "
                               + ", ".join(map(str, WEBVIEW2_TESTED_MAJORS)))
    steps.append(wv2_step)

    # Mono + Gecko: INSTALL the matching versions so wineboot never prompts at
    # launch and nothing is disabled (the correct, non-clobbering handling — a
    # complete Adobe prefix has them installed). NEVER suppress mscoree/mshtml on
    # the launch path; that leaves gecko missing and blanks Adobe's web sign-in.
    mg = install_mono_gecko(wine, prefix)
    mono_ok = (mg["mono"] or {}).get("status") in ("present", "installed")
    gecko_ok = any(s.endswith(("present", "installed"))
                   for s in (mg["gecko"] or {}).get("arches", []))
    event(args, event="progress", stage="mono_gecko", pct=91, msg="installed Wine Mono + Gecko")
    steps.append({"step": "mono_gecko", "detail": mg,
                  "ok": mono_ok and gecko_ok})

    # Wine's browser engine must be REGISTERED too, or every embedded browser that starts at
    # about:blank shows an empty panel (Lightroom Classic's About box, GitHub Neutron#10).
    event(args, event="progress", stage="mshtml", pct=92, msg="registering Wine's browser engine")
    steps.append({"step": "mshtml_register", **register_mshtml(wine, prefix)})

    wineserver_wait(wine, prefix)   # flush the reg.exe writes to user.reg on disk

    # The DEFAULT NEUTRON THEME. Applied here, by the engine, so a prefix is themed whether it is
    # ever launched through Collider or not — the CLI owns the default; the GUI owns customizing it.
    event(args, event="progress", stage="theme", pct=93, msg="applying the default Neutron theme")
    th = apply_theme(wine, prefix)
    steps.append({"step": "theme", "detail": th, "ok": th.get("ok", False)})

    event(args, event="progress", stage="dxvk", pct=94, msg="placing the Adobe DXVK config")
    # 3. DXVK config at the prefix root (idempotent — don't clobber an existing one).
    conf = os.path.join(prefix, "neutron-apps-dxvk.conf")
    wrote = False
    repaired = False
    if not os.path.isfile(conf):
        try:
            with open(conf, "w") as f:
                f.write(PROVISION_DXVK_CONF)
            wrote = True
        except OSError as e:
            log(f"dxvk conf write failed (non-fatal): {e}")
    else:
        # Idempotent REPAIR for prefixes provisioned before 2026-08-04: without the
        # per-exe CEF section, every Chromium-hosted Adobe panel (Animate's New
        # Document, its whole workspace) renders into a dummy composition swapchain
        # and freezes white. Append only the missing section -- never rewrite the
        # file, since it may carry the user's own tuning.
        try:
            with open(conf) as f:
                existing = f.read()
            if "[CEPHtmlEngine.exe]" not in existing:
                tail = PROVISION_DXVK_CONF[PROVISION_DXVK_CONF.index("\n# ---"):]
                with open(conf, "a") as f:
                    if not existing.endswith("\n"):
                        f.write("\n")
                    f.write(tail)
                repaired = True
        except OSError as e:
            log(f"dxvk conf repair failed (non-fatal): {e}")
    steps.append({"step": "dxvk_conf", "path": conf, "wrote": wrote,
                  "repaired": repaired, "ok": True})
    # 3b. The PER-APP dxvk configs. `launch` exports DXVK_CONFIG_FILE unconditionally from the
    # profile, with no existence check, so a missing file means DXVK silently runs on defaults --
    # which report the wrong GPU vendor. Write any that an installed app needs. Never clobber an
    # existing one: it may carry the user's own tuning.
    per_app = {}
    for _app_id, _p in APP_PROFILES.items():
        rel = _p.get("dxvk_conf")
        body = PROVISION_DXVK_CONF_BODIES.get(rel)
        if not rel or not body:
            continue                      # the shared conf, handled above
        # Only for apps actually present: Premiere's conf lives inside its install directory.
        if not os.path.isfile(_resolve_app_exe(prefix, _p["exe"])):
            per_app[_app_id] = "app-not-installed"
            continue
        target = _resolve_app_dxvk_conf(prefix, _p)
        if os.path.isfile(target):
            # ⚠️ Existing is NOT the same as correct. `ensure_dxvk_gpl` creates a one-line conf on
            # first launch; skipping any file that exists would leave that stub in place forever,
            # and the app keeps running on DXVK's defaults. Append what is missing -- never
            # rewrite, since a real conf may carry the user's own tuning.
            try:
                with open(target) as f:
                    have = f.read()
                # ⛔ Only the keys BEFORE the first [section] header. A per-exe section repeats
                # keys with different values on purpose, and appending those at top level would
                # apply a CHILD's override to the HOST app -- e.g. denying Premiere itself the
                # composition swapchain it requires.
                _global_body = body.split("\n[", 1)[0]
                _have_global = have.split("\n[", 1)[0]
                missing = [ln for ln in _global_body.splitlines()
                           if any(ln.startswith(k) for k in DXVK_REQUIRED_KEYS)
                           and ln.split("=")[0].strip() not in _have_global]
                # 🚨 A WHOLE MISSING SECTION is invisible to the key check above, because the key
                # it contains (`dxgi.enableDummyCompositionSwapchain`) is already present at the
                # top level with the OPPOSITE value. That is exactly how Premiere's conf sat
                # without its [CEPHtmlEngine.exe] override while the shared and AE confs had one:
                # every key "existed", so nothing was ever repaired, and opening an extension
                # panel froze the app (build tester, 2026-08-27, 3/3). Repair by SECTION too.
                missing_sections = []
                for _sec in re.findall(r"^\[[^\]]+\]$", body, re.M):
                    if _sec not in have:
                        _blk = body.split(_sec, 1)[1].split("\n[", 1)[0]
                        missing_sections.append(_sec + _blk.rstrip("\n"))
                if missing or missing_sections:
                    with open(target, "a") as f:
                        if missing:
                            f.write("\n# NEUTRON repair: keys missing from this conf (a first-launch\n"
                                    "# stub pins none of them, so DXVK ran on defaults).\n")
                            f.write("\n".join(missing) + "\n")
                        for _s in missing_sections:
                            f.write("\n# NEUTRON repair: per-exe section missing from this conf.\n"
                                    "# Without it a child process inherits the HOST app's settings\n"
                                    "# through DXVK_CONFIG_FILE -- which froze Premiere on every\n"
                                    "# extension panel until 2026-08-27.\n")
                            f.write(_s + "\n")
                    per_app[_app_id] = "repaired(%d keys, %d sections)" % (
                        len(missing), len(missing_sections))
                else:
                    per_app[_app_id] = "present"
            except OSError as e:
                log(f"per-app dxvk conf repair for {_app_id} failed (non-fatal): {e}")
                per_app[_app_id] = "error"
            continue
        try:
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(target, "w") as f:
                f.write(body)
            per_app[_app_id] = "wrote"
        except OSError as e:
            log(f"per-app dxvk conf for {_app_id} failed (non-fatal): {e}")
            per_app[_app_id] = "error"
    steps.append({"step": "dxvk_conf_per_app", "apps": per_app, "ok": True})


    deferred = ["licensing/activation (inside the Adobe app)"]
    if not wv2:
        deferred.insert(0, "webview2-runtime (Adobe in-app sign-in renders blank without it)")
    if not (mono_ok and gecko_ok):
        _mv, _gv = _mono_gecko_versions(wine)
        deferred.insert(0, f"mono/gecko install (this runtime has no wine-mono-{_mv} / "
                           f"wine-gecko-{_gv} tree; without them wineboot prompts for Mono at launch)")

    emit({
        "ok": True,
        "prefix": prefix,
        "neutron_wine": is_neutron,
        "runtime_bundle": runtime,
        "steps": steps,
        "deferred": deferred,
    }, args.json, streaming=getattr(args, "progress", False))
    return EX_OK


# ---------------------------------------------------------------------------------------------
# GATES — the fixes you can turn off, as a first-class CLI surface.
#
# 🚨 WHY THIS EXISTS. The engine reads 62 different NEUTRON_* environment variables, and they are
# three unrelated things wearing one costume:
#
#   1. PER-APP CONFIGURATION -- NEUTRON_D2D_DCDIRECT, NEUTRON_GDI_PRESENT, NEUTRON_DISABLE_BTW.
#      These are already baked into the launch: they live in APP_PROFILES and `launch` sets them.
#      Nobody should ever type one. This is what "like everything else" looks like.
#   2. DEVELOPER TRACES -- *_TRACE, *_DIAG, *_PROBE. Instruments, off by default, no user surface.
#   3. KILL SWITCHES FOR SHIPPED FIXES -- the odd one out, and the operator was right to object.
#      These are the ONLY ones a tester ever needs, and until 2026-08-27 they had no interface at
#      all: the name lived in a handoff document, had to be typed exactly, could not be set on a
#      menu or dock launch, and a typo silently did nothing while looking like a clean negative
#      result. That is the same shape as every "harness was broken, not the code" incident.
#
# So the env var stays as the TRANSPORT to the C code -- that is just how a DLL reads a setting --
# and stops being the INTERFACE. `neutron gates` lists them; `launch --without <name>` sets one,
# validated, with the applied value visible in the log's provenance header so there is proof it
# reached the code. A wrong name is now an error listing the right ones instead of a no-op.
#
# ⛔ Only list a gate here once its fix has SHIPPED. This is the bisect surface for released
# behaviour, not a dumping ground for every getenv in the tree.
