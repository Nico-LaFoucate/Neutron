#!/usr/bin/env python3
# neutron — the Neutron CLI front door (v0).
#
# The stable surface Collider drives. Structured --json on every command,
# meaningful exit codes, no interactivity. Internals wrap the proven hand-driven
# stack (the `premiere` launcher, the Debug Database pref);
# the contract is the part that stays stable while internals evolve.
#
# Implement in the Neutron repo (LGPL v2.1). See docs/NEUTRON_CLI_CONTRACT.md.
#
# Exit codes (contract §Design rules):
#   0  success
#   1  generic failure
#   2  prefix not found / invalid
#   3  Premiere running (can't edit prefs)
#   4  dependency missing  (also: feature not available in v0)
#
# Output discipline: JSON to stdout, human logs to stderr. Collider parses
# stdout only. In --json mode, stdout carries exactly one JSON object.

import argparse
import json
import os
import shutil
import subprocess
import sys
import glob

# --- exit codes ------------------------------------------------------------
EX_OK = 0
EX_FAIL = 1
EX_BADPREFIX = 2
EX_RUNNING = 3
EX_DEP = 4

# --- where things live (engine knowledge, kept in ONE place) ---------------
# Defaults match the proven working stack. Resolution is dynamic where it
# matters (in-prefix user, Documents symlink target, Debug Database version
# dir) so a version bump or a different prefix doesn't break the contract.

