def gate_env(name, on):
    """The env assignment that forces gate `name` on/off, or raise ValueError naming the valid set.

    ⛔ A wrong name must never be silently ignored. `NEUTRON_WIC_SEED_SKP=0` looks exactly like a
    clean negative result and is how a session gets spent proving nothing.
    """
    g = NEUTRON_GATES.get(name)
    if not g:
        raise ValueError("unknown gate %r -- known gates: %s"
                         % (name, ", ".join(sorted(NEUTRON_GATES))))
    return g["env"], ("1" if on else "0")


def cmd_gates(args):
    """List the shipped fixes that can be turned off, and how."""
    out = []
    for name in sorted(NEUTRON_GATES):
        g = NEUTRON_GATES[name]
        out.append({"gate": name, "env": g["env"], "default": "on" if g["default"] else "off",
                    "what": g["what"], "why": g["why"]})
    if args.json:
        emit({"ok": True, "gates": out}, True)
        return EX_OK
    print("Fixes you can turn off for a launch. Use --with/--without on `neutron launch`,")
    print("or put `<ENV>=0` in <prefix>/neutron-env.conf to affect EVERY launch surface")
    print("(menu, dock, file association, Collider) -- which a flag cannot reach.\n")
    for g in out:
        print("  %-28s default %-3s  (%s)" % (g["gate"], g["default"], g["env"]))
        print("      %s" % g["what"])
        print("      %s\n" % g["why"])
    return EX_OK


def cmd_runtime_which(args):
    """The wine this CLI would use, and the version tag that goes with it.

    Exists so OTHER tools do not have to guess. Mud Hut creates prefixes and boots them, and it
    resolved wine independently: newest NUMERIC installed runtime when the prefix is new. That
    agrees with us by coincidence on a machine where the newest runtime is also the pinned one,
    and disagrees the moment a newer runtime is installed than the drop pinned -- at which point
    Mud Hut stamps a brand-new prefix for the newer build and every `neutron launch` refuses.
    Raised by the build tester 2026-08-26 as the worst possible first-run experience.

    ⭐ One authority. Ask, do not re-derive.

    With --prefix, also reports whether launching that prefix on this wine would re-stamp it.
    """
    wine, is_neutron = resolve_wine()
    out = {"ok": bool(wine), "wine": wine, "is_neutron_runtime": is_neutron,
           "version": None, "stamp": _runtime_stamp(wine),
           "pinned_by": ("NEUTRON_WINE" if os.environ.get("NEUTRON_WINE")
                         else "NEUTRON_WINE_VERSION" if os.environ.get("NEUTRON_WINE_VERSION")
                         else "newest installed")}
    if wine and is_neutron:
        root = os.path.basename(os.path.dirname(os.path.dirname(os.path.realpath(wine))))
        if root.startswith("neutron-wine-"):
            out["version"] = root[len("neutron-wine-"):]
    if getattr(args, "prefix", None):
        prefix = resolve_prefix(args.prefix)
        if not prefix:
            out.update(bad_prefix_reason(args.prefix))
        else:
            mm = stamp_mismatch(prefix, wine)
            out["prefix"] = prefix
            out["prefix_stamp"] = _prefix_stamp(prefix)
            out["would_restamp"] = mm is not None
            if mm:
                out["prefix_is_stamped_for"] = mm["prefix_runtimes"]
    if not wine:
        die({**out, "reason": NO_RUNTIME_MSG}, EX_DEP, args.json)
    emit(out, args.json)
    return EX_OK


# Seconds to wait before the 2nd, 3rd and 4th attempt of a download. A fresh-HOME release test of 119
# (2026-10-13) failed setup on one HTTP 500 from GitHub for a font file; the second run passed.
DOWNLOAD_RETRY_DELAYS = (2, 5, 10)
DOWNLOAD_TIMEOUT = 60                        # per connect / per read, not for the whole file


class ShortDownload(OSError):
    """The connection ended before Content-Length bytes arrived."""


def _download_retryable(e):
    """A failure another attempt can fix: the server's fault (5xx, 429), a timed-out, reset or dropped
    connection, or a body cut short. Never another 4xx (a 404 is a wrong URL every time), and never a
    checksum mismatch, which callers check after the download."""
    import http.client
    import urllib.error
    if isinstance(e, urllib.error.HTTPError):
        return e.code >= 500 or e.code == 429
    if isinstance(e, urllib.error.URLError) and isinstance(e.reason, BaseException):
        e = e.reason
    return isinstance(e, (TimeoutError, ConnectionResetError, ConnectionAbortedError, ShortDownload,
                          http.client.IncompleteRead))


def _download(src, dest, as_json):
    """Stream `src` (http(s)/file URL or local path) to `dest`. Shows a simple
    stderr progress line in human mode. Returns bytes written. A transient failure
    (see _download_retryable) is retried after each of DOWNLOAD_RETRY_DELAYS; the
    last failure is raised."""
    if "://" not in src:                     # plain local path
        shutil.copyfile(src, dest)
        return os.path.getsize(dest)
    for attempt in range(len(DOWNLOAD_RETRY_DELAYS) + 1):
        try:
            return _download_once(src, dest, as_json)
        except Exception as e:
            if attempt == len(DOWNLOAD_RETRY_DELAYS) or not _download_retryable(e):
                raise
            wait = DOWNLOAD_RETRY_DELAYS[attempt]
            log(f"download failed ({e}); trying again in {wait} s "
                f"(attempt {attempt + 2} of {len(DOWNLOAD_RETRY_DELAYS) + 1}): {src}")
            time.sleep(wait)


def _download_once(src, dest, as_json):
    import http.client
    import urllib.request
    req = urllib.request.Request(src, headers={"User-Agent": "neutron-cli"})
    done = 0
    last = -1
    try:
        with urllib.request.urlopen(req, timeout=DOWNLOAD_TIMEOUT) as r, open(dest, "wb") as out:
            total = int(r.headers.get("Content-Length") or 0)
            for chunk in iter(lambda: r.read(1 << 20), b""):
                out.write(chunk)
                done += len(chunk)
                if not as_json and total:
                    pct = done * 100 // total
                    if pct != last:
                        print(f"\r[neutron]   {pct:3d}%  "
                              f"({done/(1<<20):6.1f}/{total/(1<<20):.1f} MiB)",
                              end="", file=sys.stderr, flush=True)
                        last = pct
            if total and done < total:
                raise ShortDownload(f"connection closed after {done} of {total} bytes")
    except http.client.IncompleteRead as e:
        raise ShortDownload(f"connection closed after {done + len(e.partial)} bytes") from e
    finally:
        if not as_json and last >= 0:
            print(file=sys.stderr)           # newline after the progress line
    return done


def _safe_extract(tar, path):
    """Extract `tar` into `path`, refusing any member that escapes it."""
    try:
        tar.extractall(path, filter="data")  # Python 3.12+ hardened filter
        return
    except TypeError:
        pass                                 # older Python: validate manually
    base = os.path.abspath(path)
    for m in tar.getmembers():
        target = os.path.abspath(os.path.join(path, m.name))
        if target != base and not target.startswith(base + os.sep):
            raise RuntimeError(f"unsafe path in archive: {m.name}")
    tar.extractall(path)


def cmd_runtime_install(args):
    """Download + verify + unpack a neutron-wine release so `launch` runs the
    patched, Neutron-owned wine. Resolves the release manifest (download URL +
    sha256), verifies the tarball against it, and unpacks to
    ~/.local/share/neutron/runtimes/neutron-wine-<ver>/. Idempotent."""
    import hashlib, tarfile, tempfile
    import urllib.error

    version = args.version or NEUTRON_WINE_VERSION
    if not version:
        # No installed runtime to derive from and no explicit version: refuse rather than
        # silently choose. A wrong default here repoints every launch surface (see
        # _default_wine_version()).
        die({"ok": False, "reason": "no runtime version: none installed and "
                                    "NEUTRON_WINE_VERSION unset; pass --version"},
            EX_FAIL, getattr(args, "json", False))
    repo = args.repo or NEUTRON_WINE_REPO
    manifest = None

    # NEUTRON: a --manifest NAMES the version it installs, and --manifest is documented as
    # overriding --version. It did not: the manifest was resolved further down, AFTER the
    # already-installed check below had already run against the CLI's compiled-in default.
    # `neutron runtime install --manifest <newer>` therefore printed
    # "already-installed <old default>" and installed nothing -- a silent no-op that looks
    # like a success, which is how a build got handed over as installed when it was not.
    # Resolve the manifest FIRST when it is the authority, and keep what we parsed so the
    # main path below does not fetch it twice. A failure here is left to the main path,
    # which reports it properly.
    if args.manifest and not args.version:
        try:
            with tempfile.TemporaryDirectory(prefix=".mf-") as mdir:
                mp = os.path.join(mdir, "manifest.json")
                _download(args.manifest, mp, as_json=True)
                with open(mp) as f:
                    manifest = json.load(f)
            mver = manifest.get("version")
            if mver and str(mver) != version:
                if not args.json:
                    log(f"manifest names version {mver} (CLI default {version}) - installing {mver}")
                version = str(mver)
        except (urllib.error.URLError, OSError, ValueError) as e:
            # The manifest is the ONLY statement of which version was meant here, so a
            # failure to resolve it cannot fall through to the already-installed check --
            # that check would run against the CLI default and report success for a
            # version the caller never asked for. Same silent-no-op the version fix above
            # closes, reached by a different door.
            die({"ok": False, "reason": f"cannot fetch/parse manifest: {e}",
                 "manifest": args.manifest,
                 "hint": "pass --version to install a specific runtime without a manifest"},
                EX_FAIL, args.json)

    name = f"neutron-wine-{version}"
    dest_root = NEUTRON_RUNTIMES_DIR
    install_dir = os.path.join(dest_root, name)

    def _has_wine(d):
        return (os.path.isfile(os.path.join(d, "bin", "wine"))
                or os.path.isfile(os.path.join(d, "bin", "wine64")))

    if _has_wine(install_dir) and not args.force:
        emit({"ok": True, "status": "already-installed", "version": version,
              "path": install_dir, "wine": os.path.join(install_dir, "bin", "wine")},
             args.json)
        return EX_OK

    os.makedirs(dest_root, exist_ok=True)
    # Work on the target filesystem so the final move is a fast rename and a big
    # download can't overflow a small /tmp tmpfs.
    tmp = tempfile.mkdtemp(prefix=".dl-", dir=dest_root)
    try:
        # 1. Resolve the manifest (download URL + sha256 live here).
        manifest_src = args.manifest or (
            f"https://github.com/{repo}/releases/download/v{version}/{name}.manifest.json")
        if manifest is None:
            if not args.json:
                log(f"resolving manifest: {manifest_src}")
            mpath = os.path.join(tmp, "manifest.json")
            try:
                _download(manifest_src, mpath, as_json=True)
                with open(mpath) as f:
                    manifest = json.load(f)
            except (urllib.error.URLError, OSError, ValueError) as e:
                die({"ok": False, "reason": f"cannot fetch/parse manifest: {e}",
                     "manifest": manifest_src,
                     "hint": f"is release v{version} published on {repo}?"},
                    EX_FAIL, args.json)

        sha_want = manifest.get("sha256")
        artifact = manifest.get("artifact") or f"{name}.tar.xz"
        art_url = manifest.get("url") or (
            f"https://github.com/{repo}/releases/download/v{version}/{artifact}")
        unpack_root = manifest.get("unpack_root") or name
        if not sha_want:
            die({"ok": False, "reason": "manifest has no sha256"}, EX_FAIL, args.json)

        # 2. Download the tarball.
        if not args.json:
            size = manifest.get("size_bytes")
            log(f"downloading {artifact}"
                + (f" ({size/(1<<20):.1f} MiB)" if isinstance(size, int) else ""))
        tarball = os.path.join(tmp, artifact)
        try:
            _download(art_url, tarball, args.json and not getattr(args, "show_progress", False))
        except (urllib.error.URLError, OSError) as e:
            die({"ok": False, "reason": f"download failed: {e}", "url": art_url},
                EX_FAIL, args.json)

        # 3. Verify the checksum before trusting the archive.
        h = hashlib.sha256()
        with open(tarball, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        if h.hexdigest() != sha_want:
            die({"ok": False, "reason": "sha256 mismatch (corrupt or tampered download)",
                 "expected": sha_want, "got": h.hexdigest()}, EX_FAIL, args.json)

        # 4. Unpack, then swap into place (replacing any prior install).
        if not args.json:
            log("verifying + unpacking…")
        staging = os.path.join(tmp, "unpack")
        os.makedirs(staging)
        with tarfile.open(tarball) as tar:
            _safe_extract(tar, staging)
        unpacked = os.path.join(staging, unpack_root)
        if not _has_wine(unpacked):
            die({"ok": False,
                 "reason": f"archive root '{unpack_root}' has no bin/wine"},
                EX_FAIL, args.json)
        if os.path.isdir(install_dir):
            shutil.rmtree(install_dir, ignore_errors=True)
        shutil.move(unpacked, install_dir)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    emit({"ok": True, "status": "installed", "version": version,
          "path": install_dir, "wine": os.path.join(install_dir, "bin", "wine"),
          "sha256": sha_want}, args.json)
    return EX_OK


def cmd_launch(args):
    """Launch an app through the Neutron stack. Returns the spawned PID.
    Profile-driven: the per-app exe/env/overrides come from APP_PROFILES so the
    whole suite launches through this ONE path (Premiere stays byte-identical)."""
    profile = APP_PROFILES.get(args.app)
    if not profile:
        die({"launched": False,
             "reason": f"unknown app '{args.app}' (known: {', '.join(sorted(APP_PROFILES))})"},
            EX_FAIL, args.json)

    prefix = resolve_prefix(args.prefix) or resolve_prefix(collider_selected_prefix())
    if not prefix:
        _tried = [t for t in (args.prefix, collider_selected_prefix()) if t]
        die({"launched": False, "tried": _tried,
             "reason": "no usable prefix (no drive_c). Tried: "
                       + (", ".join(_tried) or "<none>")
                       + ". Pass --prefix, or select one in Collider."},
            EX_BADPREFIX, args.json)

    # 🔒 Mud Hut is installing, updating or rolling back Adobe apps here: refuse. Starting an app
    # now would run beside Adobe's installer rewriting it, and the update refuses to start (or
    # its rollback cannot finish) while an app is open.
    _mh = mudhut_busy(prefix)
    if _mh is not None:
        die({"launched": False, "app": args.app, "reason": _mudhut_busy_sentence(_mh),
             "update_in_progress": _mh}, EX_RUNNING, args.json)

    gpu_mode = "gpu"
    if args.software:
        # Honest about the v0 gap: the proven launcher has no software branch.
        # Faking support would violate the "meaningful exit codes" contract.
        die({"launched": False, "app": args.app, "gpu_mode": "software",
             "reason": "software mode is not implemented; use --gpu (default)"},
            EX_DEP, args.json)

    exe = _resolve_app_exe(prefix, profile["exe"])
    if not os.path.isfile(exe):
        die({"launched": False, "reason": f"{profile['name']} exe not found: {exe}"},
            EX_FAIL, args.json)

    wine, is_neutron = resolve_wine()
    if not wine:
        die({"launched": False, "reason": NO_RUNTIME_MSG},
            EX_DEP, args.json)

    # 🚨 REFUSE A LAUNCH THAT WOULD RE-STAMP THE PREFIX. Wine compares its wine.inf mtime against
    # <prefix>/.update-timestamp and silently runs `wineboot -u` when they differ, reverting the
    # patched natives. Every occurrence of this has been diagnosed as a code regression first and
    # a stamp mismatch second, at a cost of hours each time. `provision` re-stamps AND re-stages
    # the natives, which is why it is the offered remedy rather than "just let it clobber".
    #
    # ⛔ Deliberately NOT "resolve the runtime from the stamp instead". Stamps are pinned across
    # releases on purpose, so several runtimes share one and stamp-derived resolution silently
    # picks the wrong one -- that is what voided the first Animate test. Detect, explain, stop.
    mismatch = stamp_mismatch(prefix, wine)
    if mismatch and not args.allow_restamp:
        also = mismatch["prefix_runtimes"]
        die({"launched": False,
             "reason": "this runtime would RE-STAMP the prefix and revert its patched natives "
                       "(wine runs `wineboot -u` when the stamps differ)",
             # Provision re-stamps the prefix for THIS runtime: its `wineboot -u` installs this
             # runtime's own (patched) builtins, and stage_natives then restages the runtime's
             # DXVK / vkd3d-proton / NVIDIA DLLs. `neutron update` does this for every Neutron prefix.
             "fix": "Run `neutron update` (or `neutron prefix provision %s`): it moves the "
                    "prefix to this runtime and restages Neutron's DLLs. Or pass --allow-restamp "
                    "to launch anyway." % prefix,
             "prefix_is_stamped_for": (", ".join(also) if also
                                       else "no installed runtime (stamp %d)"
                                            % mismatch["prefix_stamp"]),
             **mismatch}, EX_FAIL, args.json)
    if mismatch:
        log("WARNING: --allow-restamp: launching on a different-stamp runtime. wine will run "
            "`wineboot -u` and REVERT the prefix's patched natives (dwrite/dcomp/dxcore). "
            "Run `neutron prefix provision %s` afterwards to restore them." % prefix)

    dxvk_conf = _resolve_app_dxvk_conf(prefix, profile)
    env = dict(os.environ)

    # --with / --without: the named form of the same thing. Applied FIRST so an explicit flag
    # beats both the per-prefix file and the profile default -- the flag is the most deliberate
    # statement of intent available, and a bisect is worthless if something quietly overrides it.
    _from_flag = set()
    for _name, _on in ([(n, False) for n in (getattr(args, "without", None) or [])] +
                       [(n, True) for n in (getattr(args, "with_", None) or [])]):
        try:
            _k, _v = gate_env(_name, _on)
        except ValueError as e:
            die({"launched": False, "reason": str(e),
                 "known_gates": sorted(NEUTRON_GATES)}, EX_FAIL, args.json)
        env[_k] = _v
        _from_flag.add(_k)
        log("gate: --%s %s -> %s=%s" % ("with" if _on else "without", _name, _k, _v))

    # The profile itself: ONE function computes it for this launch and for neutron-appenv.conf below.
    _applied = _apply_app_env(env, args.app, profile, prefix, dxvk_conf,
                              protected=set(os.environ) | _from_flag,
                              exe=_resolve_app_exe(prefix, profile["exe"]))
    if _applied:
        log("neutron-env.conf: %s" % " ".join("%s=%s" % kv for kv in sorted(_applied.items())))
    env["WINEPREFIX"] = prefix
    # NEUTRON_PREMIERE_GPU=0 -> drop Premiere's GPU-UI env so the app falls back to its GDI+
    # SOFTWARE drawbot. Needed as an A/B: GPU mode fixes the interface but the Program Monitor
    # renders black in it, while the software drawbot shows video (with playhead trails). Pair
    # with MZ.Prefs.UseGpuAcceleration=false -- the pref and the env must agree, or the app
    # picks a drawbot whose output nothing presents. See ~/premiere-gpu-mode.sh.
    if args.app == "premiere" and os.environ.get("NEUTRON_PREMIERE_GPU") == "0":
        for k in ("NEUTRON_D2D_DCDIRECT", "NEUTRON_GDI_PRESENT", "NEUTRON_DCOMP_NATIVE",
                  "NEUTRON_CEF_MAX_FPS", "NEUTRON_D2D_COMPOSEREAD"):
            env.pop(k, None)
        log("premiere: GPU-UI env DROPPED (NEUTRON_PREMIERE_GPU=0) -> software drawbot")
    # ⛔ 2026-10-13 — NO PULSE_LATENCY_MSEC. From 08-17 every launch set PULSE_LATENCY_MSEC=90 for
    # audio dropouts in Premiere playback ("confirmed by ear over one session, not by an xrun
    # count"). libpulse applies it to CAPTURE too, and PipeWire gives a source twice that: the
    # Scarlett's mic delivered audio in 180 ms chunks. Since runtime 11.10-117 Premiere opens its
    # MME input at startup and keeps it running, and with 180 ms input chunks its playback jumped
    # and the audio cut out (operator: "the audio cuts out and jumps with the footage"); with the
    # variable off it is smooth. Measured on 10-13 (preserved-fixes/harnesses/playback-underruns.c,
    # winepulse Underflow count, 30 s, idle and with 22 of 24 threads busy): unset / 30 / 60 / 90 ms
    # -> 0 / 0 / 0-1 / 0 underflows -- the August dropouts no longer reproduce, so the variable bought
    # nothing. Anyone who needs it can still set it themselves (it passes through), at the cost of
    # Premiere's playback with the mic open. Wiki OPEN-ISSUES "Program Monitor playback jitter".

    # --- silence Wine's FIXME chatter -------------------------------------------------
    # Wine prints four classes: err, warn, fixme, trace. fixme is on by default and means
    # "this bit is unimplemented and I am ignoring it" -- useful to a Wine developer once,
    # useless every frame thereafter. MEASURED in a live Premiere session, two d2d FIXMEs
    # alone were 14,000 of 20,000 sampled lines:
    #     fixme:d2d:d2d_device_context_PushAxisAlignedClip Ignoring
    #     fixme:d2d:d2d_device_context_DrawGeometry Ignoring
    # ~700 formatted, locked, synchronous writes per second, from inside the render path.
    # Turning them off took the log from 40,413 to 7,952 bytes/sec (-80%).
    #
    # This is not a debug-only cost: cmd_launch redirects app output to a log file on EVERY
    # launch, so every Collider session has been paying it with nobody reading the output.
    #
    # ⚠️ MERGE, never assign. A debugging session passes its own WINEDEBUG, and clobbering it
    # would silently drop the channels being asked for -- an hour of wondering why the log is
    # empty. Skipped entirely if the caller already said anything about fixme, so
    # `WINEDEBUG=+fixme` still works to get them back.
    #
    # ⚠️ err is deliberately untouched: every Neutron diagnostic (MASKFALLBACK, neutron-role,
    # the perf reports) is ERR-level and must keep printing.
    _wd = env.get("WINEDEBUG", "")
    if "fixme" not in _wd:
        env["WINEDEBUG"] = ("fixme-all," + _wd).rstrip(",") if _wd else "fixme-all"

    # --- CEP plugin networking: make Node prefer IPv4 -------------------------------
    # Adobe's CEP panels embed **Node 17.7.2**, and plugins do their HTTP through it
    # (not through Chromium, which is why none of it shows up in DevTools' Network).
    #
    # Node 17 is the worst possible version here. v17.0 changed the DNS result order
    # from `ipv4first` to `verbatim`, so it takes whatever the resolver returns first;
    # and Happy Eyeballs (`autoSelectFamily`, which races v6 against v4 and falls back
    # in ~250 ms) did not arrive until v18.13/v20. So Node 17 commits to the first
    # address and, if that address is unreachable, simply fails. curl and every browser
    # survive the same network because they all implement the fallback.
    #
    # That is fatal on a very common Linux setup: a VPN that blocks IPv6 without
    # removing the ISP's IPv6 address and default route. The box still looks
    # IPv6-capable to getaddrinfo, so AAAA records come back first, and every Node
    # request dies with ECONNREFUSED.
    #
    # MEASURED 2026-08-17 inside the live Captioneer panel (VPN connected):
    #   default            -> ERR ECONNREFUSED   (aescripts.com AAAA 2606:4700::6812:1123)
    #   family:4 forced    -> HTTP 403           (a real TCP+TLS connection)
    #   ipv4first          -> HTTP 403, lookup now 104.18.17.35 fam4
    # The plugin read that unreachable-network failure as licence error 101,
    # "please connect to the internet so the license can be activated" -- while
    # `webreq.exe` succeeded throughout, because WinINet is a different stack.
    # On Windows the same VPN disables IPv6 on the adapter outright, so no AAAA is
    # ever returned and Node never sees the problem. Hence "it works on Windows".
    #
    # `ipv4first` is what Node did by default for its entire life before v17, so this
    # restores long-standing behaviour rather than inventing one. Append rather than
    # overwrite, so an explicit NODE_OPTIONS still wins and a v6-only host can override.
    #
    # ⚠️ **This does NOT fix the CEP panel itself — VERIFIED, do not re-propose it as one.**
    # CEP embeds Node as a *library* inside CEF, which never runs Node's argument
    # processing, so NODE_OPTIONS is ignored there. Measured in the live panel after a
    # relaunch carrying this change:
    #     NODE_OPTIONS = "--dns-result-order=ipv4first"   (delivered)
    #     process.execArgv = []                           (embedded: no arg parsing)
    #     dns.lookup -> 2606:4700::6812:1123 fam6         (STILL IPv6)
    #     https.get  -> ERR ECONNREFUSED
    # It is kept because it does apply to node CHILD PROCESSES a plugin spawns, which
    # are ordinary Node startups. The panel's own requests can only be fixed by making
    # the host stop handing out unreachable AAAA records.
    #
    # ⛔ Do NOT "fix" this in Wine. Windows' getaddrinfo prefers a global IPv6 address in
    # exactly the same way (RFC 6724); Wine matches Windows here. It only LOOKS
    # Windows-specific because some VPN clients remove the IPv6 address from the adapter
    # on Windows, while on Linux they block IPv6 and leave the ISP address in place.
    # Reordering DNS inside Wine would be Wine deviating from Windows for every app.
    # The real fix is the network: enable IPv6 in the VPN, or drop IPv6 on the interface.
    _node_opts = env.get("NODE_OPTIONS", "")
    if "--dns-result-order" not in _node_opts:
        env["NODE_OPTIONS"] = (_node_opts + " --dns-result-order=ipv4first").strip()

    # GPU-vendor EGL/GLX: NVIDIA's when an NVIDIA GPU is in use, else the system's (Mesa).
    gpus = drm_gpus()
    _apply_gl_vendor_env(env, gpus)

    # --- Display path: Wayland-native (crisp UI + native-smooth playback) vs
    #     X11 (software frame pacer). Selected per session; merged here so there
    #     is ONE launch path (no redundant launcher script). ---
    if session_is_wayland():
        display_mode = "wayland"
        reg_set(wine, prefix, r"HKCU\Software\Wine\Drivers", "Graphics", "REG_SZ", "wayland")
        # auto-DPI: LogPixels = round(96 * scale) so System-DPI-aware Adobe apps
        # render at device resolution; the wp_fractional_scale patch maps it 1:1.
        scale, _scale_src = resolve_launch_scale(getattr(args, "scale", None))
        logpixels = round(96 * scale) if (scale and scale > 0) else None
        _warn = windows_step_warning(logpixels)
        if _warn:
            log("WARNING: " + _warn)
        if logpixels:
            reg_set(wine, prefix, r"HKCU\Control Panel\Desktop", "LogPixels",
                    "REG_DWORD", str(logpixels))
        # Pass the app's full config so a first launch never leaves a one-line stub behind.
        ensure_dxvk_gpl(dxvk_conf,
                        PROVISION_DXVK_CONF_BODIES.get(profile.get("dxvk_conf")))
        env.pop("DISPLAY", None)
        env["WAYLAND_DISPLAY"] = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        log(f"display: wayland | scale={scale} ({_scale_src or 'not detected'}) LogPixels={logpixels}")
    else:
        # ⛔ NO AUTOMATIC X11. EVER.
        #
        # This used to fall through to X11: write `Graphics=x11` into the PREFIX, turn on the
        # software frame pacer, and launch. It did that on the strength of an environment
        # variable being absent -- and launch surfaces do not share an environment (Collider
        # inherits the login session's, a .desktop launch inherits the systemd user manager's),
        # so the same machine could run Wayland from Collider and X11 from the application menu,
        # rewriting the prefix's graphics driver on every launch.
        #
        # X11 is a HARD NEVER on this project: the winewayland work -- fractional
        # scale, the present path, decorations, drag-and-drop, the owned-window coordinate
        # fixes -- is where every fix of the last two months lives. Silently degrading into the
        # one configuration we have ruled out, and persisting it into the user's installation,
        # is not a fallback. It is the thing the rule exists to prevent, automated.
        #
        # So: STOP, and say exactly what is missing. Refusing is recoverable; a silently
        # re-configured prefix is discovered days later as "the app looks wrong now".
        if os.environ.get("NEUTRON_ALLOW_X11") != "1":
            die({"launched": False,
                 "reason": "no Wayland session detected, and Neutron does not fall back to X11",
                 "wayland_display": os.environ.get("WAYLAND_DISPLAY"),
                 "xdg_session_type": os.environ.get("XDG_SESSION_TYPE"),
                 "xdg_runtime_dir": os.environ.get("XDG_RUNTIME_DIR"),
                 "hint": "Neutron requires a Wayland session — every graphics fix it ships lives "
                         "in winewayland. If you ARE on Wayland, this launch surface has a "
                         "different environment from one that works: compare it with a launch "
                         "from Collider or a terminal. Set NEUTRON_ALLOW_X11=1 only if you "
                         "deliberately want the unsupported X11 path, which will also rewrite "
                         "this prefix's graphics driver."},
                EX_DEP, args.json)
        display_mode = "x11"
        log("WARNING: NEUTRON_ALLOW_X11=1 -- taking the UNSUPPORTED X11 path and setting "
            "Graphics=x11 IN THE PREFIX. Every winewayland fix is inactive here. A later "
            "Wayland launch will set the driver back.")
        reg_set(wine, prefix, r"HKCU\Software\Wine\Drivers", "Graphics", "REG_SZ", "x11")
        env["NEUTRON_PRESENT_PACE"] = "1"   # X11 software frame pacer
        env.setdefault("DISPLAY", ":0")
        log("display: x11 | software frame pacer (NEUTRON_PRESENT_PACE=1)")

    # A file to open: the --project flag (Collider passes a Windows path) or an
    # optional positional (a .desktop file association passes a Linux %f path).
    project = args.project or getattr(args, "project_file", None)
    if project and project.startswith("/"):
        # Linux path -> Windows path. Wine maps Z:\ to the filesystem root, so an
        # absolute Linux path becomes Z:\... — Adobe apps need a Windows-style path.
        project = "Z:" + project.replace("/", "\\")

    # The display fix (DS.DisableDirectXDisplay) for Premiere, After Effects and Media Encoder,
    # applied before every launch exactly as Collider does. Best-effort; never blocks.
    _display_fix_before_launch(prefix)

    # Photoshop's pen through WinTab (PS_WINTAB_LINE), also for a Photoshop installed after provisioning or started
    # by another app (Edit in Photoshop). Best-effort; never blocks.
    try:
        for name, action in ensure_photoshop_wintab(prefix):
            if action == "added":
                log("%s: pen set to WinTab (%s)" % (name, PS_WINTAB_LINE))
    except OSError as e:
        log("Photoshop pen setting not written (%s)" % e)

    # Lightroom Classic's "System" high-DPI override (LRC_LAYERS_FLAGS), also for a Lightroom installed after
    # provisioning. Best-effort; never blocks.
    try:
        if ensure_lightroom_system_dpi(wine, prefix) == "added":
            log("Lightroom Classic: System high-DPI scaling set (%s)" % LRC_LAYERS_FLAGS)
    except Exception as e:
        log("Lightroom Classic scaling setting not written (%s)" % e)

    # Each installed app's own settings, for when THIS app starts another one (Dynamic Link, Edit in
    # Photoshop). Best-effort: without the file a started app inherits this one's settings, as before.
    try:
        write_appenv_conf(prefix)
    except Exception as e:
        log("%s not written (%s); apps started by this one inherit its settings" % (APPENV_CONF, e))

    # Start the app's Adobe background services (ADS/IPCBroker) first, if any, and
    # give them a moment to bind their RPC before the app connects.
    if profile.get("daemons"):
        if _start_adobe_daemons(prefix, wine, env, profile["daemons"]):
            import time as _t
            _t.sleep(4)

    cmd = [wine, exe]
    if project:
        cmd.append(project)

    log(f"launching: {profile['name']} -> {wine} {exe} {project or ''}")

    # 🚨 CAPTURE THE APP LOG. This used to be `subprocess.DEVNULL if args.json`,
    # and Collider always passes --json -- so EVERY Collider-launched session
    # threw its wine log away. Verified on a live Premiere 2026-08-12: fd1 and
    # fd2 both /dev/null. Two user-reported bugs (the missing timeline chrome
    # and the Button Editor drag) could not be investigated at all from a normal
    # session, and the answer was always "relaunch by hand from a terminal".
    #
    # A terminal caller (no --json) still inherits the tty, so `neutron launch
    # ... > my.log 2>&1` keeps working exactly as before and does NOT get a
    # second copy. Only the --json path, which had nowhere to write, gains one.
    # 🚨 LOG UNLESS A HUMAN IS WATCHING. This used to be gated on `--json`, and the comment above
    # reasoned about exactly two callers: Collider (passes --json, gets a log) and a terminal
    # (inherits the tty, so `neutron launch ... > my.log` still works and gains no second copy).
    # `provision` later added a THIRD caller the comment could not have known about -- the
    # generated `.desktop` entries, which pass no `--json` and have no tty either. So a launch
    # from the application menu, the dock, or a double-clicked .psd wrote NO LOG, while the
    # README and the handoff both tell testers to look in ~/.local/share/neutron/logs/. The
    # output was not lost -- Plasma runs .desktop entries as systemd user scopes, so it went to
    # the journal under `app-neutron\x2dpremiere@<hash>.service`, which nobody would guess --
    # but the documented procedure found nothing. Reported from the build tester 2026-08-26, and
    # it matters because `provision` made the menu the NATURAL way to launch: the friction fix
    # turned the no-diagnostics path into the default one.
    #
    # ⛔ Not fixed by adding `--json` to the Exec line (the tester's suggestion, and it would
    # work): that overloads a flag meaning "emit machine-readable output" to also mean "write a
    # log", so the next launch surface added without it silently regresses this again. The real
    # condition is whether anyone can SEE the output. stderr-is-a-tty answers that directly.
    interactive = sys.stderr.isatty() and not args.json
    # --log forces a file even on a tty. ⭐ The reason it exists: the ONE launch surface where
    # someone is most likely to be deliberately capturing a trace -- a human typing WINEDEBUG=... in
    # a terminal -- was the one surface that kept no file, because "nobody is watching" is false
    # there. On 2026-09-14 two capture rounds were lost to it (one to a Collider launch, which
    # discards the log, and one to a terminal command with no redirect) while chasing the Premiere
    # menu cursor bug. The redirect workaround (`> file 2>&1`) works by making stderr not a tty,
    # which is a side effect nobody should have to know.
    want_log = not args.no_log and (args.log or not interactive)
    log_path, log_fh = None, None
    if want_log:
        try:
            os.makedirs(NEUTRON_LOGS_DIR, exist_ok=True)
            # Named per app AND prefix (`premiere-premiere2025-…`, `premiere-adobe2026-…`): two
            # installs of one app are two programs, and their histories are pruned separately.
            _slug = _prefix_slug(prefix)
            _prune_app_logs(NEUTRON_LOGS_DIR, args.app, _slug, keep=20)
            log_path = os.path.join(
                NEUTRON_LOGS_DIR, f"{args.app}-{_slug}-{time.strftime('%Y%m%d-%H%M%S')}.log")
            log_fh = open(log_path, "wb")
            # ⭐ MAKE THE LOG SELF-DESCRIBING. The `[neutron] launching: …` line is the PARENT's
            # stderr, so it never appears inside the child's log -- on a menu launch it goes to
            # the journal, on a Collider launch Collider captures it. Confirmed by the build
            # tester 2026-08-26: 0 of 3 real session logs contained it. That means a log someone
            # sends us has, on its own, no record of WHICH runtime, prefix or gates produced it,
            # and every one of those has been the answer to a bug at least once. Write the
            # provenance into the file itself, before the child inherits the fd.
            _gates = " ".join("%s=%s" % (k, v) for k, v in sorted(env.items())
                              if k.startswith("NEUTRON_")) or "(none)"
            _boot = boot_gpu_vendor()
            _gpus = (", ".join("%s %s" % g for g in gpus) or "(none found)") + \
                ("  (boot %s)" % _boot if _boot and len(gpus) > 1 else "") + \
                ("  (hybrid: __NV_PRIME_RENDER_OFFLOAD=%s)" % env["__NV_PRIME_RENDER_OFFLOAD"]
                 if "__NV_PRIME_RENDER_OFFLOAD" in env else "")
            # ⛔ Report the runtime we RESOLVED, never NEUTRON_WINE_VERSION. That variable is what
            # was ASKED FOR; the binary is what ran. Caught in testing 2026-08-26 when a scratch
            # XDG_DATA_HOME moved the runtimes directory, resolution fell through to the dev build
            # tree, and this header cheerfully said "11.10-63" over a completely different wine.
            # A provenance header that can be wrong about provenance is worse than none --
            # [[state-written-before-the-fact]] in the one place built to prevent it.
            _rtroot = os.path.basename(os.path.dirname(os.path.dirname(os.path.realpath(wine))))
            _rtname = (_rtroot[len("neutron-wine-"):] if _rtroot.startswith("neutron-wine-")
                       else "unrecognized layout: " + _rtroot)
            log_fh.write(("=== neutron runtime %s | %s\n"
                          "    app     : %s (%s)\n"
                          "    exe     : %s\n"
                          "    prefix  : %s  (stamp %s)\n"
                          "    wine    : %s\n"
                          "    display : %s\n"
                          "    gpus    : %s\n"
                          "    nvapi   : DXVK_ENABLE_NVAPI=%s  WINEDLLOVERRIDES=%s\n"
                          "    egl     : __EGL_VENDOR_LIBRARY_FILENAMES=%s\n"
                          "    gates   : %s\n"
                          "=== everything below this line is the application's own output\n\n"
                          % (_rtname, time.strftime("%Y-%m-%d %H:%M:%S"),
                             args.app, profile["name"], exe, prefix,
                             _prefix_stamp(prefix), wine, display_mode, _gpus,
                             env.get("DXVK_ENABLE_NVAPI", "(unset)"),
                             env.get("WINEDLLOVERRIDES", "(unset)"),
                             env.get("__EGL_VENDOR_LIBRARY_FILENAMES", "(unset: system default)"),
                             _gates)
                          ).encode("utf-8", "replace"))
            log_fh.flush()
        except OSError as e:
            # Never let logging break a launch. Fall back to the old behaviour.
            log(f"app log unavailable ({e}); output discarded")
            log_path, log_fh = None, None
    try:
        # Detach so Collider supervises via PID, not via this process.
        proc = subprocess.Popen(
            cmd, env=env,
            # log file > the caller's terminal > nowhere. Never inherit a tty we are also
            # writing to, or the log and the terminal interleave the same bytes.
            stdout=log_fh if log_fh else (None if interactive else subprocess.DEVNULL),
            stderr=(subprocess.STDOUT if log_fh
                    else (None if interactive else subprocess.DEVNULL)),
            start_new_session=True,
        )
    except Exception as e:
        die({"launched": False, "reason": f"spawn failed: {e}"}, EX_FAIL, args.json)
    finally:
        # The child holds its own dup'd fd; the parent must not keep this open or
        # the file would stay held by a process Collider does not supervise.
        if log_fh:
            log_fh.close()

    # Brief liveness check: if Premiere dies instantly (bad env, missing DLL),
    # report that rather than a misleading "launched: true".
    # (`time` is imported at module scope — a function-local `import time` here
    # would make the name local for the WHOLE function and turn the strftime
    # call above into an UnboundLocalError.)
    time.sleep(0.5)
    if proc.poll() is not None:
        die({"launched": False, "pid": proc.pid,
             "reason": f"process exited immediately (code {proc.returncode})"},
            EX_FAIL, args.json)

    # `log` is returned so Collider can surface "open log" in the UI and so a bug
    # report can name the exact file without the user hunting for it.
    emit({"ok": True, "launched": True, "app": args.app,
          "pid": proc.pid, "gpu_mode": gpu_mode, "display": display_mode,
          "neutron_wine": is_neutron, "log": log_path}, args.json)
    return EX_OK


def _app_version(exe_rel):
    """Pull the release year (e.g. "2025") from the app's path as a lightweight
    version label — no PE version-resource parsing needed."""
    for part in exe_rel.replace("\\", "/").split("/"):
        for tok in part.split():
            if len(tok) == 4 and tok.isdigit() and tok.startswith("20"):
                return tok
    return ""


# Bump whenever _pe_extract_icon_png's SELECTION changes, so already-cached icons
# are re-extracted instead of being kept because they are merely newer than the exe.
#   1 -> widest RT_ICON anywhere (picked Premiere's "LAUNCH" file-type icon)
#   2 -> lowest-numbered RT_GROUP_ICON, i.e. the application icon, as Windows does
#   3 -> no selection change; exists to FLUSH the Collider appicon cache, whose
#        hand-written "pe-v2" tag happened to collide with version 2, so the v1->v2
#        repair never reached it and Collider kept serving the LAUNCH icon from
#        ~/.cache/collider/appicons long after the files on disk were correct.
#        Both caches now key off THIS constant, so a future change invalidates both.
_ICON_EXTRACTOR_VERSION = "3"


def _pe_extract_icon_png(exe):
    """The app's largest icon as PNG BYTES, parsed straight out of the PE. NO EXTERNAL TOOLS.

    This used to shell out to `wrestool` + `icotool` and return None when they were missing — so on
    a machine without icoutils (a build tester's, say) Collider silently fell back to monogram
    badges and any .desktop we write would have no icon. The installer is user-space with no root,
    so we cannot make icoutils a dependency; parsing the PE ourselves is ~60 lines and always works.

    Adobe stores its large sizes as PNG inside the .ico, so the common path lifts those bytes
    VERBATIM — no decode, no re-encode, no quality loss. Older/smaller entries are BMP (DIB) and
    are converted with `zlib` from the standard library.

    ⚖️ We extract from the user's OWN installed copy on their OWN machine, and never redistribute
    an Adobe icon — a deliberate decision, not an accident of implementation.
    """
    import struct, zlib

    def u16(b, o): return struct.unpack_from("<H", b, o)[0]
    def u32(b, o): return struct.unpack_from("<I", b, o)[0]

    try:
        with open(exe, "rb") as f:
            d = f.read()
        pe = u32(d, 0x3c)
        if d[pe:pe + 4] != b"PE\0\0":
            return None
        nsec, optsz, opt = u16(d, pe + 6), u16(d, pe + 20), pe + 24
        ddoff = opt + (112 if u16(d, opt) == 0x20b else 96)
        res_rva = u32(d, ddoff + 2 * 8)
        if not res_rva:
            return None
        secs = [(u32(d, opt + optsz + i * 40 + 12), u32(d, opt + optsz + i * 40 + 8),
                 u32(d, opt + optsz + i * 40 + 20)) for i in range(nsec)]

        def rva2off(r):
            for va, vs, raw in secs:
                if va <= r < va + max(vs, 1):
                    return raw + (r - va)
            return None

        rbase = rva2off(res_rva)
        if rbase is None:
            return None

        def entries(off):
            n = u16(d, off + 12) + u16(d, off + 14)
            return [(u32(d, off + 16 + i * 8), u32(d, off + 16 + i * 8 + 4)) for i in range(n)]

        # 🚨 Collect BOTH icon resources and icon GROUPS, then pick the way Windows
        # does: the application icon is the LOWEST-NUMBERED RT_GROUP_ICON, and the
        # largest member OF THAT GROUP.
        #
        # Taking the widest RT_ICON anywhere in the file is wrong, and visibly so:
        # Adobe ships file-type icons in the same executable, so Premiere resolved
        # to its .prlaunch document icon -- a page with "LAUNCH" written across it --
        # which is what Collider and the dock displayed.
        icons = {}    # resource id -> (offset, size)
        groups = {}   # resource id -> (offset, size)
        for eid, eoff in entries(rbase):
            rtype = eid & 0x7fffffff
            if rtype not in (3, 14) or not (eoff & 0x80000000):   # RT_ICON, RT_GROUP_ICON
                continue
            for nid, noff in entries(rbase + (eoff & 0x7fffffff)):
                if not (noff & 0x80000000):
                    continue
                for _, loff in entries(rbase + (noff & 0x7fffffff)):
                    if loff & 0x80000000:
                        continue
                    de = rbase + loff
                    doff, size = rva2off(u32(d, de)), u32(d, de + 4)
                    if doff is None:
                        continue
                    (groups if rtype == 14 else icons)[nid & 0x7fffffff] = (doff, size)
                    break

        def decode(blob):
            """(width, bytes, kind) for one icon resource, or None."""
            if blob[:8] == b"\x89PNG\r\n\x1a\n":
                return (struct.unpack_from(">I", blob, 16)[0], blob, "png")
            if len(blob) >= 40 and u32(blob, 0) == 40 and u16(blob, 14) == 32:
                w, h = u32(blob, 4), u32(blob, 8) // 2
                if w and h:
                    return (w, blob, "dib")
            return None

        best = None   # (width, bytes, kind)
        if groups:
            gid = min(groups)                     # lowest id == the app icon group
            goff, gsize = groups[gid]
            g = d[goff:goff + gsize]
            # GRPICONDIR: reserved,type,count then count x 14-byte GRPICONDIRENTRY,
            # whose last field is the RT_ICON resource id of that member.
            count = u16(g, 4) if len(g) >= 6 else 0
            for i in range(count):
                e = 6 + i * 14
                if e + 14 > len(g):
                    break
                nid = u16(g, e + 12)
                if nid not in icons:
                    continue
                doff, size = icons[nid]
                got = decode(d[doff:doff + size])
                if got and (not best or got[0] > best[0]):
                    best = got
        if not best:
            # No usable group (or a malformed one) -> fall back to the old
            # widest-anywhere behaviour rather than losing the icon entirely.
            for doff, size in icons.values():
                got = decode(d[doff:doff + size])
                if got and (not best or got[0] > best[0]):
                    best = got
        if not best:
            return None
        w, blob, kind = best
        if kind == "png":
            return blob

        # 32-bit BGRA DIB, bottom-up, no colour table -> minimal PNG via stdlib zlib.
        h = u32(blob, 8) // 2
        px = blob[40:40 + w * h * 4]
        if len(px) < w * h * 4:
            return None
        raw = bytearray()
        for y in range(h - 1, -1, -1):          # bottom-up
            raw.append(0)                        # filter: none
            row = px[y * w * 4:(y + 1) * w * 4]
            for x in range(0, len(row), 4):
                b, g, r, a = row[x:x + 4]
                raw += bytes((r, g, b, a))
        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data
                    + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
        return (b"\x89PNG\r\n\x1a\n"
                + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(bytes(raw), 6))
                + chunk(b"IEND", b""))
    except Exception:
        return None


def _app_icon(exe):
    """The app's real logo as a PNG `data:` URI for Collider's widgets, cached under
    ~/.cache/collider/appicons. Returns None only if the PE genuinely has no icon, in which case
    the UI falls back to its monogram badge."""
    import base64, hashlib
    try:
        cache_dir = os.path.join(CACHE_HOME, "collider", "appicons")
        os.makedirs(cache_dir, exist_ok=True)
        cached = os.path.join(cache_dir,
                              hashlib.sha1(
                                  (exe + "|pe-v" + _ICON_EXTRACTOR_VERSION).encode()
                              ).hexdigest()[:16] + ".png")
        if not (os.path.isfile(cached) and os.path.getmtime(cached) >= os.path.getmtime(exe)):
            png = _pe_extract_icon_png(exe)
            if not png:
                return None
            with open(cached, "wb") as f:
                f.write(png)
        with open(cached, "rb") as f:
            return "data:image/png;base64," + base64.b64encode(f.read()).decode()
    except Exception:
        return None


# ---------------------------------------------------------------------------------------------
# Desktop integration tables + helpers.
#
# Split out of register_app_desktop_entries() on 2026-08-25 after the build tester reported all
# three of these as bugs in one pass: generic icons on a live session, file associations that
# opened the app but ignored the file, and a two-main-category warning.
# ---------------------------------------------------------------------------------------------

# ONE main category per app (Graphics or AudioVideo), plus additional ones. Two mains makes some
# menus list the app twice.
APP_CATEGORIES = {
    "premiere":     "AudioVideo;Video;AudioVideoEditing;",
    "mediaencoder": "AudioVideo;Video;AudioVideoEditing;",
    "aftereffects": "AudioVideo;Video;AudioVideoEditing;",
    "photoshop":    "Graphics;2DGraphics;RasterGraphics;Photography;",
    "illustrator":  "Graphics;2DGraphics;VectorGraphics;",
    "lightroom":    "Graphics;Photography;",
    "lightroomcc":  "Graphics;Photography;",
    "animate":      "Graphics;2DGraphics;",
    "audition":     "AudioVideo;Audio;AudioVideoEditing;",
    "indesign":     "Graphics;Publishing;",
}

# The types each app OWNS. `image/vnd.adobe.photoshop` and `application/illustrator` come from
# the system mime database; everything with an `x-neutron-` name is defined by us below, because
# freedesktop has never carried .prproj/.aep/.fla/.lrcat/.psb.
#
# ⛔ NEVER list a type the app merely CAN open. Photoshop reads .jpg and .png; claiming those
# would take the whole desktop's image handling away from the user's viewer.
# Media Encoder is deliberately absent: its inputs are ordinary media types owned by the user's
# player, and its own .epr files are presets nobody double-clicks.
APP_MIME_TYPES = {
    "photoshop":    ("image/vnd.adobe.photoshop", "image/x-neutron-psb"),
    "illustrator":  ("application/illustrator",),
    "premiere":     ("application/x-neutron-prproj",),
    "aftereffects": ("application/x-neutron-aep",),
    "animate":      ("application/x-neutron-fla",),
    "lightroom":    ("application/x-neutron-lrcat",),
}

# Our own shared-mime-info package for the Adobe project formats the system does not define.
# Glob-only (no magic): these are container formats whose signatures vary by version, and a
# wrong magic rule mis-types a file for every application on the system, not just ours.
# weight="60" beats the default 50 that Wine's own `x-wine-extension-*` packages use. Wine
# generates one per registered extension and it won .psb on a tie-break, which routed the file
# through an UNPINNED `wine start /ProgIDOpen` -- the launch path that re-stamps a prefix.
NEUTRON_MIME_XML = """<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- Written by `neutron prefix provision`. Adobe project formats that freedesktop does not
       define, so that a .desktop entry can claim them. -->
  <mime-type type="application/x-neutron-prproj">
    <comment>Adobe Premiere Pro project</comment>
    <glob pattern="*.prproj" weight="60"/>
  </mime-type>
  <mime-type type="application/x-neutron-aep">
    <comment>Adobe After Effects project</comment>
    <glob pattern="*.aep" weight="60"/>
    <glob pattern="*.aet" weight="60"/>
  </mime-type>
  <mime-type type="application/x-neutron-fla">
    <comment>Adobe Animate document</comment>
    <glob pattern="*.fla" weight="60"/>
    <glob pattern="*.xfl" weight="60"/>
  </mime-type>
  <mime-type type="application/x-neutron-lrcat">
    <comment>Lightroom Classic catalog</comment>
    <glob pattern="*.lrcat" weight="60"/>
  </mime-type>
  <mime-type type="image/x-neutron-psb">
    <comment>Adobe Photoshop large document</comment>
    <glob pattern="*.psb" weight="60"/>
  </mime-type>
</mime-info>
"""


def install_neutron_mime_package():
    """Define the Adobe project types in the user's mime database. Idempotent."""
    d = os.path.join(DATA_HOME, "mime", "packages")
    target = os.path.join(d, "neutron-adobe.xml")
    try:
        os.makedirs(d, exist_ok=True)
        prev = ""
        if os.path.isfile(target):
            with open(target) as f:
                prev = f.read()
        if prev == NEUTRON_MIME_XML:
            return False
        with open(target, "w") as f:
            f.write(NEUTRON_MIME_XML)
        subprocess.run(["update-mime-database", os.path.dirname(d)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
        return True
    except Exception as e:
        log("mime package: %s" % e)
        return False


def retire_superseded_entries(apps_dir, app_ids, prefix):
    """Remove the previous generation's `mudhut-<app>.desktop`, backing each one up first.

    Mud Hut used to write these; they point at launchers that no longer exist and reference
    `Icon=mudhut-*` names for which no icon file was ever installed, so they show a generic icon
    forever. Left in place they ALSO keep `mimeapps.list` pointed at a dead handler.

    ⛔ Only for an app we just wrote a working `neutron-<app>.desktop` for, and never without a
    backup -- these are files on the user's machine, not ours to silently delete.
    """
    out = []
    backup = os.path.join(NEUTRON_DATA_DIR, "superseded-desktop-entries")
    for app_id in app_ids:
        stale = os.path.join(apps_dir, "mudhut-%s.desktop" % app_id)
        if not os.path.isfile(stale):
            continue
        try:
            os.makedirs(backup, exist_ok=True)
            shutil.move(stale, os.path.join(backup, os.path.basename(stale)))
            out.append(os.path.basename(stale))
        except OSError as e:
            log("retire %s: %s" % (stale, e))

    # 🚨 winemenubuilder's own launchers, under applications/wine/Programs/.
    #
    # Wine mirrors the prefix's Start Menu there, and those entries run BARE `wine`
    # from PATH -- distro wine, not the pinned runtime -- so a menu or dock launch
    # fires `wineboot -u` and reverts the prefix's patched natives. That is the bug
    # LAUNCHERS.md was written for, arriving by a route the 2026-08-08 rewrite did
    # not cover because Wine generates these itself, after the fact.
    #
    # They also carry the SAME StartupWMClass as ours, so KDE cannot tell them
    # apart and one can quietly take over a dock pin: a user's pinned Premiere 2025
    # became 2026 the moment the 2026 suite was installed.
    #
    # Only ever retire an entry whose Exec names a prefix we manage, and always to
    # the backup dir -- these are files on the user's machine, not ours to delete.
    # "Adobe <profile name>" is how Adobe names both the install dir and the Start
    # Menu entry, so it matches the winemenubuilder filename.
    replaced_prefixes = {
        "Adobe " + APP_PROFILES[a]["name"] for a in app_ids if a in APP_PROFILES
    }
    wine_progs = os.path.join(apps_dir, "wine", "Programs")
    menus_dir = os.path.join(CONFIG_HOME, "menus", "applications-merged")
    if os.path.isdir(wine_progs):
        for root, _dirs, files in os.walk(wine_progs):
            for fn in files:
                if not fn.endswith(".desktop"):
                    continue
                path = os.path.join(root, fn)
                try:
                    with open(path, errors="replace") as f:
                        body = f.read()
                except OSError:
                    continue
                if ("WINEPREFIX=%s" % prefix) not in body:
                    continue           # another prefix's, or not ours at all
                # ⛔ ONLY retire an app we actually REPLACE. These entries are
                # dangerous, but a user's only launcher for something we do not
                # ship a replacement for is worse than a dangerous one: After
                # Effects bundles Cinema 4D Lite, and a first pass here retired
                # "Maxon Cinema 4D 2026" and its Team Render entries, leaving no
                # way to start them at all.
                if not any(dp.lower() in fn.lower() for dp in replaced_prefixes):
                    continue
                try:
                    os.makedirs(backup, exist_ok=True)
                    shutil.move(path, os.path.join(backup, fn))
                    out.append("wine/Programs/" + fn)
                    # KDE keys the launcher off a generated .menu file; leaving it
                    # behind keeps a dangling entry in the menu and the dock.
                    stem = os.path.splitext(fn)[0]
                    menu = os.path.join(menus_dir, "wine-Programs-%s.menu" % stem)
                    if os.path.isfile(menu):
                        os.remove(menu)
                except OSError as e:
                    log("retire %s: %s" % (path, e))
    return out



def _prefix_slug(prefix):
    """A stable, filename-safe id for a prefix, for desktop-entry naming.

    🚨 Desktop entries used to be keyed on app_id ALONE. A second prefix holding
    the same app therefore OVERWROTE the first one's launcher and icon: installing
    Premiere 2026 into a new prefix silently removed the user's working Premiere
    2025 entry from the dock and the app menu, with no error anywhere. Side-by-side
    versions are a supported layout -- Collider even defaults new prefixes to a
    sibling directory -- so the launcher identity has to say WHICH prefix it opens.
    """
    base = os.path.basename(os.path.normpath(prefix or "")) or "prefix"
    slug = re.sub(r"[^A-Za-z0-9]+", "-", base).strip("-").lower()
    return slug or "prefix"

def repair_mime_defaults(apps_dir, written):
    """Point each Adobe type at our entry -- but ONLY where nothing live already claims it.

    The rule matters. A user who set their own handler for .psd keeps it; what gets repaired is
    the DANGLING case, where `mimeapps.list` names a .desktop file that no longer exists (which
    is exactly what removing the mudhut generation leaves behind, and what the build tester had
    to fix by hand on 2026-08-25).
    """
    path = os.path.join(CONFIG_HOME, "mimeapps.list")
    want = {}
    for w in written:
        for m in w.get("mime", ()):
            want[m] = w.get("file") or ("neutron-%s.desktop" % w["app"])
    if not want:
        return []

    import configparser
    cp = configparser.RawConfigParser()
    cp.optionxform = str            # mime types are case-sensitive keys
    try:
        if os.path.isfile(path):
            cp.read(path)
    except Exception as e:
        log("mimeapps read: %s -- leaving associations alone" % e)
        return []
    section = "Default Applications"
    if not cp.has_section(section):
        cp.add_section(section)

    def live(entry_list):
        for name in entry_list.split(";"):
            name = name.strip()
            if not name:
                continue
            for root in (apps_dir, "/usr/share/applications", APPS_DIR):
                if os.path.isfile(os.path.join(root, name)):
                    return True
        return False

    claimed = []
    for mime, entry in sorted(want.items()):
        cur = cp.get(section, mime, fallback="")
        if cur and live(cur):
            continue                # someone real already handles it -- do not steal it
        cp.set(section, mime, entry)
        claimed.append(mime)

    # 🚨 2026-09-18: the dangling case above was only ever repaired for the types WE declare.
    # Mud Hut's generation claimed types of its own (`application/vnd.adobe.premiere-project`,
    # `…aftereffects.project`) that no entry of ours declares, so once provision retired
    # `mudhut-premiere.desktop` those keys pointed at a file that no longer existed -- forever,
    # because `want` never contained them. Found on the dev box with both lines still dead two
    # weeks after the retirement. Same app, same user intent: re-point a DEAD `mudhut-<app>`
    # claim, for any type, at the entry we just wrote for that app. A live one is still never
    # stolen, and an app we did not write this run is not ours to touch.
    ours = {w["app"]: (w.get("file") or ("neutron-%s.desktop" % w["app"])) for w in written}
    for mime, cur in list(cp.items(section)):
        if mime in want or not cur or live(cur):
            continue
        handlers = [h.strip() for h in cur.split(";") if h.strip()]
        for app_id, entry in ours.items():
            if ("mudhut-%s.desktop" % app_id) in handlers:
                cp.set(section, mime, entry)
                claimed.append(mime)
                break
    if not claimed:
        return []
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            cp.write(f, space_around_delimiters=False)
    except OSError as e:
        log("mimeapps write: %s" % e)
        return []
    return claimed


def refresh_desktop_caches(apps_dir):
    """Make a LIVE desktop session actually see the entries and icons we just wrote.

    🚨 This is the fix for "icon extraction is broken". It never was. Provision wrote valid
    256x256 PNGs and the desktop showed generic icons anyway, because the running shell had
    cached its icon lookups hours earlier -- on the build tester's machine, `plasmashell` had
    been up for 13 hours and there was no `icon-theme.cache` in the user's hicolor tree at all.
    Every tester who provisions inside a live session hits this and reports a bug that does not
    exist. Writing a file is not the same as the desktop knowing about it.

    All best-effort: each tool is absent on some desktops, and none of them failing is fatal.
    """
    icon_root = os.path.join(DATA_HOME, "icons", "hicolor")
    result = {}
    for cmd in (["update-desktop-database", apps_dir],
                # -t/--ignore-theme-index: our hicolor tree has no index.theme of its own.
                ["gtk-update-icon-cache", "-f", "-t", icon_root],
                ["kbuildsycoca6", "--noincremental"],
                ["kbuildsycoca5", "--noincremental"],
                ["xdg-desktop-menu", "forceupdate"],
                # KDE caches icons per-process; this tells running KDE apps to drop theirs.
                ["dbus-send", "--session", "--type=signal", "/KIconLoader",
                 "org.kde.KIconLoader.iconChanged", "int32:0"]):
        if not shutil.which(cmd[0]):
            result[cmd[0]] = "absent"
            continue
        try:
            r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=60)
            result[cmd[0]] = "ok" if r.returncode == 0 else (
                "rc=%d %s" % (r.returncode, (r.stderr or b"").decode("utf-8", "replace").strip()[:120]))
        except Exception as e:
            result[cmd[0]] = "failed: %s" % e
    # ⚠️ REPORT EACH ONE. Do not collapse this to a boolean: on the dev box
    # `gtk-update-icon-cache -f -t` exits 1 with "The generated cache was invalid" (a 20x19
    # directory in the tree) while every other refresh succeeds -- and a step that answered
    # "caches refreshed: true" over that failure would be the same mistake as the bug it fixes.
    # Harmless in this instance, because GTK compares the cache against directory mtimes and
    # ignores a stale one (verified: Gtk.IconTheme resolves neutron-* against a June cache), but
    # "harmless" is a conclusion for a reader to reach, not for this function to assume.
    return result


def register_app_desktop_entries(prefix):
    """Give every installed app its OWN desktop identity: a .desktop entry + an icon.

    TWO problems, one fix.

    1. **The dock icon.** Wine advertises a Wayland `app_id` equal to the LOWERCASED EXE BASENAME
       (`waylanddrv_main.c:wayland_init_process_name` — basename, downcased, `.exe` kept). The
       compositor matches that against installed .desktop files to choose an icon. Nothing
       matched, so an app launched from Collider was attributed to COLLIDER and wore its icon.
       `StartupWMClass` is that match.

    2. **Real menu entries**, so the suite can be launched without Collider at all. `Exec=` runs
       the same `neutron launch` Collider runs, so a menu launch and a Collider launch are the
       same launch — and Collider can adopt an app started either way (`cmd_apps` reports
       `running`/`pid`).

    ⚖️ Icons are extracted from the user's OWN installed copy, on their OWN machine, at provision
    time. We never redistribute an Adobe icon.

    Idempotent; safe to run on every provision. Returns a per-app summary.
    """
    # The runtime these entries must pin: the one resolve_wine() picks right now, taken from its
    # path so it cannot drift from reality. Falls back to the CLI default only if unparseable.
    pinned_version = NEUTRON_WINE_VERSION
    try:
        _w, _is_neutron = resolve_wine()
        if _is_neutron and _w:
            _root = os.path.basename(os.path.dirname(os.path.dirname(os.path.realpath(_w))))
            if _root.startswith("neutron-wine-"):
                pinned_version = _root[len("neutron-wine-"):]
    except Exception:
        pass

    apps_dir = APPS_DIR
    icon_dir = os.path.join(DATA_HOME, "icons", "hicolor", "256x256", "apps")
    os.makedirs(apps_dir, exist_ok=True)
    os.makedirs(icon_dir, exist_ok=True)
    # The Adobe project formats freedesktop has never heard of (.prproj, .aep, .fla, ...) have
    # to be DEFINED before an entry can claim them; only .psd and .ai ship in the system mime
    # database. Idempotent, and scoped to this user.
    install_neutron_mime_package()
    written = []
    changed = False

    for app_id, p in APP_PROFILES.items():
        exe = _resolve_app_exe(prefix, p["exe"]) if prefix else ""
        if not (exe and os.path.isfile(exe)):
            continue

        slug = _prefix_slug(prefix)
        # The app_id the compositor will see. MUST match what Wine advertises or the icon will not
        # bind -- and it must be UNIQUE PER PREFIX or the desktop environment cannot tell two
        # installs of the same app apart.
        #
        # 🚨 2026-09-18: it used to be `os.path.basename(exe).lower()` -- Wine's own default, the
        # lowercased EXE basename. That is IDENTICAL for the same app in every prefix, so with
        # Premiere installed in both ~/.premiere2025 and ~/Neutron-Prefixes/Adobe2026 both entries
        # carried `StartupWMClass=adobe premiere pro.exe`. The task manager, matching a running
        # window back to an entry, picked whichever it found first: launching from the pinned
        # .premiere2025 icon produced a task labelled "Premiere Pro (Adobe2026)" while the window's
        # own title read "Adobe Premiere Pro 2025". The app WAS in the right prefix -- launcher,
        # environment and every process had the right WINEPREFIX -- but the label lied, and window
        # grouping broke with it. It hit every app installed into more than one prefix.
        #
        # Now: the entry's own basename, which is already unique per app+prefix. An app_id equal to
        # a .desktop basename is the XDG convention and is matched to that entry directly. Wine is
        # told to advertise it via NEUTRON_WAYLAND_APP_ID in Exec= below (honoured by
        # winewayland.drv `wayland_init_process_name`); with that variable unset Wine keeps its
        # upstream EXE-name behaviour, so an older runtime still binds by the fallback below.
        wm_class = "neutron-%s-%s" % (app_id, slug)
        icon_name = "neutron-%s-%s" % (app_id, slug)
        icon_path = os.path.join(icon_dir, icon_name + ".png")
        have_icon = False
        # 🚨 The mtime guard alone is not enough. When the EXTRACTOR changes, every
        # already-cached icon is stale by logic rather than by age -- and a wrong
        # icon is exactly the case that needs replacing. Premiere shipped the
        # ".prlaunch" document icon (a page reading "LAUNCH") and no amount of
        # re-provisioning would have replaced it, because the file was newer than
        # the exe. Same lesson as CoolType's cache: invalidate the CONSUMER with
        # the repair. The stamp keeps the expensive path rare -- extraction reads
        # the whole PE, and Premiere's is ~800 MB.
        # Kept OUT of the icon theme dir: gtk-update-icon-cache and friends scan
        # that directory, and it should contain images only.
        stamp_dir = os.path.join(NEUTRON_DATA_DIR, "icon-stamps")
        stamp_path = os.path.join(stamp_dir, icon_name + ".v")
        try:
            cur_stamp = open(stamp_path).read().strip()
        except OSError:
            cur_stamp = ""
        fresh = (os.path.isfile(icon_path)
                 and os.path.getmtime(icon_path) >= os.path.getmtime(exe)
                 and cur_stamp == _ICON_EXTRACTOR_VERSION)
        try:
            if not fresh:
                png = _pe_extract_icon_png(exe)
                if png:
                    with open(icon_path, "wb") as f:
                        f.write(png)
                    try:
                        os.makedirs(stamp_dir, exist_ok=True)
                        with open(stamp_path, "w") as f:
                            f.write(_ICON_EXTRACTOR_VERSION)
                    except OSError:
                        pass
            have_icon = os.path.isfile(icon_path)
        except OSError as e:
            log("desktop entry: icon for %s failed: %s" % (app_id, e))

        entry_file = "neutron-%s-%s.desktop" % (app_id, slug)
        desktop = os.path.join(apps_dir, entry_file)
        # Another prefix already publishes this app? Then BOTH need to be
        # distinguishable, so qualify ours. The sibling keeps its own name until
        # its prefix is next provisioned -- correcting someone else's entry from
        # here would edit a launcher this run knows nothing about.
        import glob as _glob
        siblings = [f for f in _glob.glob(os.path.join(apps_dir, "neutron-%s-*.desktop" % app_id))
                    if os.path.basename(f) != entry_file]
        legacy = os.path.join(apps_dir, "neutron-%s.desktop" % app_id)
        if os.path.isfile(legacy):
            try:
                with open(legacy) as f:
                    legacy_body = f.read()
            except OSError:
                legacy_body = ""
            # Ours, superseded by the qualified name -> retire it. Another
            # prefix's -> leave it alone; it is that prefix's only launcher.
            #
            # ⛔ Match the Exec line's TOKENS, not a substring. An app with no MIME
            # types gets no trailing " %f", so its Exec ends immediately after the
            # path -- a " --prefix <path> " probe with a trailing space misses it
            # and leaves a duplicate launcher behind (Media Encoder, every time).
            def _launches_this_prefix(body, want):
                for line in body.splitlines():
                    if not line.startswith("Exec="):
                        continue
                    toks = line.split()
                    for i, t in enumerate(toks):
                        if t == "--prefix" and i + 1 < len(toks) and toks[i + 1] == want:
                            return True
                return False

            if _launches_this_prefix(legacy_body, prefix):
                try:
                    os.remove(legacy)
                except OSError as e:
                    log("desktop entry: retiring legacy %s failed: %s" % (legacy, e))
            else:
                siblings.append(legacy)
        disp_name = ("%s (%s)" % (p["name"], os.path.basename(os.path.normpath(prefix)))
                     if siblings else p["name"])
        # The file types this app OWNS, and therefore `%f`. Without both, a double-clicked .psd
        # opens Photoshop and then ignores the file -- reported from the build tester's machine
        # 2026-08-25, where the superseded mudhut entries HAD carried them. `neutron launch`
        # already accepts a positional Linux path and converts it to Z:\ (cmd_launch), so this
        # is purely the .desktop side of a capability that was always there.
        # ⛔ Only ever the app's OWN formats. Photoshop opens .jpg and .png too, but claiming
        # those would hijack the user's image viewer for the whole desktop.
        mimes = APP_MIME_TYPES.get(app_id, ())
        exec_arg = " %f" if mimes else ""
        body = (
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=%s\n"
            "Comment=%s via Neutron\n"
            # 🚨 PIN THE RUNTIME. Without NEUTRON_WINE_VERSION a menu launch uses the CLI's
            # compiled-in DEFAULT, which is generally NOT the runtime this prefix is stamped for —
            # and an unpinned launch against a different-stamp runtime fires `wineboot -u`, which
            # reverts the patched natives and reads as a mass regression (RUNBOOK, and the reason
            # the stack bundle's own wrapper pins it). Measured 2026-08-25: these entries shipped
            # unpinned for a few hours, the user launched from the menu, and the prefix was
            # re-stamped from 11.10-62 back to the CLI default 11.10-59 with dwrite/dcomp/dxcore
            # all reverted to builtins.
            "Exec=env PATH=%s/.local/bin:/usr/local/bin:/usr/bin:/bin NEUTRON_WINE_VERSION=%s NEUTRON_WAYLAND_APP_ID=%s neutron launch %s --prefix %s%s\n"
            "Icon=%s\n"
            "Terminal=false\n"
            # One MAIN category only. `Graphics;AudioVideo;` is two, which makes a menu list the
            # same app twice (desktop-file-validate flags it).
            "Categories=%s\n"
            "%s"
            # ⭐ THE LINE THAT FIXES THE DOCK ICON. Wine's app_id, verbatim.
            "StartupWMClass=%s\n"
            "StartupNotify=false\n"
            % (disp_name, p["name"], HOME, pinned_version, wm_class, app_id, prefix, exec_arg,
               icon_name if have_icon else "collider",
               APP_CATEGORIES.get(app_id, "Graphics;"),
               ("MimeType=%s\n" % "".join(m + ";" for m in mimes)) if mimes else "",
               wm_class))
        try:
            prev = ""
            if os.path.isfile(desktop):
                with open(desktop) as f:
                    prev = f.read()
            if prev != body:
                with open(desktop, "w") as f:
                    f.write(body)
                os.chmod(desktop, 0o755)
                changed = True
            written.append({"app": app_id, "wm_class": wm_class, "icon": have_icon,
                            "mime": list(mimes), "file": entry_file})
        except OSError as e:
            log("desktop entry: %s failed: %s" % (app_id, e))

    superseded = retire_superseded_entries(apps_dir, [w["app"] for w in written], prefix)
    claimed = repair_mime_defaults(apps_dir, written)
    caches = refresh_desktop_caches(apps_dir) if written else {}
    return {"entries": written, "superseded": superseded, "claimed_types": claimed,
            "rewrote": changed, "caches": caches}


def _app_running_pid(exe, prefix=None):
    """PID of a live process running `exe` IN THIS PREFIX, or None.

    🚨 2026-09-18: `prefix` used to not exist and the docstring lied. The scan matched the exe
    path only, so with the same app installed in two prefixes it returned the OTHER prefix's pid.
    MEASURED against the live known-bad: with Premiere 2025 running from ~/.premiere2025 (pid
    15856), `neutron --json apps --prefix ~/Neutron-Prefixes/Adobe2026` reported
    `premiere 2026 installed=True running=True pid=15856`. Collider adopts that snapshot, so the
    other prefix's card showed Running, offered no Launch, and its Exit would have acted on the
    wrong process. Windows does not group two installs by filename either; two exes at two paths
    are two programs.

    Pass the prefix and a candidate must ALSO carry `WINEPREFIX=<prefix>` in its environ, compared
    against whole NUL-separated entries -- a substring test makes ~/mudhut-accc match
    ~/mudhut-accc2. Omitting `prefix` keeps the old, prefix-blind behaviour for any caller that
    genuinely wants it.

    ⛔ Matches on /proc/<pid>/exe and the FULL windows path in the cmdline — never a loose
    substring of the app NAME. A cmdline match on something like "premiere" also matches the
    grep, the launcher, and this very process; that trap has cost real time before. Skips our
    own pid.
    """
    if not exe:
        return None
    want = os.path.basename(exe).lower()
    me = os.getpid()
    want_env = ("WINEPREFIX=" + prefix.rstrip("/")) if prefix else None
    try:
        pids = [d for d in os.listdir("/proc") if d.isdigit()]
    except OSError:
        return None
    for d in pids:
        pid = int(d)
        if pid == me:
            continue
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                parts = f.read().split(b"\0")
        except OSError:
            continue
        # argv[0] is the wine loader; the windows exe path is a later argument. Require the
        # BASENAME to match a full path component, not appear anywhere in the string.
        for a in parts:
            try:
                t = a.decode("utf-8", "replace").lower()
            except Exception:
                continue
            if t.endswith(want) and ("\\" in t or "/" in t):
                if want_env is not None and not _proc_has_env(pid, want_env):
                    break          # right exe, wrong prefix -- not ours
                return pid
    return None


def _proc_has_env(pid, want_env):
    """True if /proc/<pid>/environ contains exactly `want_env` as one NUL-separated entry."""
    try:
        with open("/proc/%d/environ" % pid, "rb") as f:
            entries = f.read().split(b"\0")
    except OSError:
        return False
    w = want_env.encode("utf-8", "replace")
    return any(e == w for e in entries)


def cmd_apps(args):
    """List the Adobe apps Neutron can launch + their install status in a prefix.
    Powers Collider's app catalog (one tinted widget per installed app). Never
    launches anything — pure detection (scan the prefix for each profile's exe)."""
    prefix = resolve_prefix(args.prefix) or args.prefix
    # 🚨 SAY WHY WHEN THERE IS NO PREFIX. With none resolvable this used to answer
    # {"ok": true} with all seven apps `installed: false` -- indistinguishable from "you have
    # nothing installed", which is exactly how the build tester read it on 2026-08-25 while all
    # seven WERE installed one `--prefix` away. `ok` stays true and the list stays populated
    # (Collider blanks its whole Apps view on a command failure), but the answer now carries the
    # reason and the candidate paths.
    why = None if prefix else bad_prefix_reason(getattr(args, "prefix", None))
    apps = []
    for app_id, p in APP_PROFILES.items():
        exe = _resolve_app_exe(prefix, p["exe"]) if prefix else ""
        installed = bool(exe) and os.path.isfile(exe)
        apps.append({
            "id": app_id,
            "name": p["name"],
            "accent": p["accent"],
            "version": _app_version(exe) if installed else _app_version(p["exe"]),
            "export": p.get("export", False),
            "installed": installed,
            "exe": exe,
            # Collider adopts these so an app launched from the APPLICATION MENU still shows as
            # Running in the GUI and can be force-quit there. Without it a menu launch is
            # invisible to Collider and clicking Launch would start a SECOND copy.
            "running": bool(_app_running_pid(exe, prefix)) if installed else False,
            "pid": _app_running_pid(exe, prefix) if installed else None,
            "icon": _app_icon(exe) if installed else None,   # real logo (lowest-ID group); None -> monogram
        })
    # Installed first, then alphabetical — a stable order for the widget grid.
    apps.sort(key=lambda a: (not a["installed"], a["name"]))
    out = {"ok": True, "prefix": prefix or None, "apps": apps}
    if why:
        out.update(why)
    emit(out, args.json)
    return EX_OK


def _runtime_integrity_checks(wine_path):
    """Structural checks on an installed Neutron runtime. Returns [(name, ok, detail), ...].

    Cheap on purpose -- a directory listing and one grep, so `doctor` stays fast enough for
    Collider to call on every view. Deliberately NOT a checksum of the tree: the point is to
    catch a build that came out structurally wrong, not to detect tampering.
    """
    out = []
    root = os.path.dirname(os.path.dirname(os.path.realpath(wine_path)))
    for arch, floor in (("x86_64-windows", 900), ("i386-windows", 900)):
        d = os.path.join(root, "lib", "wine", arch)
        try:
            n = len([f for f in os.listdir(d)])
        except OSError:
            n = 0
        out.append(("runtime-" + arch, n >= floor,
                    "%d PE files" % n if n >= floor else
                    "%d PE files (expected >=%d) -- this runtime is INCOMPLETE. 11.10-61 shipped "
                    "with 0 here. Reinstall the runtime; do not chase app bugs against it."
                    % (n, floor)))
    # wine.inf drives prefix creation; a truncated one produces a prefix that looks fine and is
    # missing registry content. `FileOpenAssociations` sits near the end of the file, so its
    # absence is a cheap proxy for "generation stopped early".
    inf = os.path.join(root, "share", "wine", "wine.inf")
    ok, detail = False, "wine.inf not found at " + inf
    try:
        with open(inf, "rb") as f:
            body = f.read()
        hits = body.count(b"FileOpenAssociations")
        ok = hits > 0
        detail = ("%d FileOpenAssociations sections" % hits if ok else
                  "wine.inf is TRUNCATED (0 FileOpenAssociations sections) -- prefix creation "
                  "will be incomplete. Reinstall the runtime.")
    except OSError as e:
        detail = "wine.inf unreadable: %s" % e
    out.append(("runtime-wine-inf", ok, detail))
    return out


def cmd_theme_show(args):
    """Print the default Neutron theme. Collider reads this rather than carrying its own copy."""
    emit({"ok": True, "colors": DEFAULT_THEME_COLORS, "visual_style": "disabled",
          "note": "the default Neutron theme; ThemeActive=0 is required or comctl32 v6 controls "
                  "paint from Wine's bundled Aero style and ignore the palette"}, args.json)


def cmd_theme_apply(args):
    """Write the theme into a prefix. With --colors, applies the caller's palette instead of the
    default — that is how Collider hands a user's customization to the engine."""
    prefix = resolve_prefix(args.path)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "path", None))}, EX_BADPREFIX, args.json)
    colors = None
    if args.colors:
        try:
            raw = sys.stdin.read() if args.colors == "-" else open(args.colors, encoding="utf-8").read()
            colors = json.loads(raw)
            if not isinstance(colors, dict) or not colors:
                raise ValueError("expected a non-empty object of {key: \"R G B\"}")
            bad = [k for k, v in colors.items() if not isinstance(v, str)]
            if bad:
                raise ValueError("non-string values for: %s" % ", ".join(sorted(bad)[:5]))
        except Exception as e:
            die({"ok": False, "reason": "bad --colors: %s" % e}, EX_FAIL, args.json)
    # ⛔ Never through distro wine, never through a runtime that would re-stamp the prefix (a
    # FIRST wine process into a COLD prefix whose stamp differs runs `wineboot -u` and reverts the
    # patched natives). wine_for_prefix picks a runtime that shares the prefix's stamp.
    wine, why = wine_for_prefix(prefix)
    if not wine:
        die({"ok": False, **why}, EX_DEP, args.json)

    res = apply_theme(wine, prefix, colors)
    res["prefix"] = prefix
    res["source"] = "custom" if colors else "default"
    if not res.get("ok"):
        die({"ok": False, **res}, EX_FAIL, args.json)
    emit({"ok": True, **res}, args.json)


def wine_for_prefix(prefix):
    """A Neutron wine that can start in `prefix` WITHOUT re-stamping it, for registry writes: the
    resolved runtime when its stamp matches, else the newest installed runtime that shares the
    prefix's stamp. Which of those runs a `reg import` does not matter, and none of them can
    re-stamp the prefix. (Launch is different: it must use the resolved runtime and refuses.)
    Returns (wine, None) or (None, why)."""
    wine, is_neutron = resolve_wine()
    if not wine or not is_neutron:
        return None, {"reason": NO_RUNTIME_MSG}
    mm = stamp_mismatch(prefix, wine)
    if not mm:
        return wine, None
    for ver in reversed(mm["prefix_runtimes"]):
        cand = os.path.join(NEUTRON_RUNTIMES_DIR, f"neutron-wine-{ver}", "bin", "wine")
        if os.access(cand, os.X_OK):
            return cand, None
    return None, {"reason": "no installed runtime matches this prefix's stamp, and the resolved "
                            "one would re-stamp it; run `neutron prefix provision` first",
                  **mm}


CAPTION_BUTTONS = ("close", "min", "max", "restore")


def cmd_theme_icons(args):
    """Window-button (caption) icons: the neutron-wine frame draws close/min/max/restore .ico files
    from a folder when HKCU\\Software\\Neutron\\Caption has Enabled=1 and IconDir. Copies the set
    from --from into the prefix and points the registry at it; --off goes back to Wine's glyphs.
    Collider ships the sets and passes a folder; the prefix side is the engine's."""
    prefix = resolve_prefix(args.path)
    if not prefix:
        die({"ok": False, **bad_prefix_reason(getattr(args, "path", None))}, EX_BADPREFIX, args.json)
    wine, why = wine_for_prefix(prefix)
    if not wine:
        die({"ok": False, **why}, EX_DEP, args.json)
    key = r"HKEY_CURRENT_USER\Software\Neutron\Caption"
    if args.off:
        ok = reg_import(wine, prefix, {key: {"Enabled": 0}}, tag="neutron-caption")
        emit({"ok": ok, "prefix": prefix, "enabled": False}, args.json)
        return EX_OK if ok else EX_FAIL
    if not args.from_dir or not os.path.isdir(args.from_dir):
        die({"ok": False, "reason": "--from must name a folder with close/min/max/restore .ico files"},
            EX_FAIL, args.json)
    name = re.sub(r"[^A-Za-z0-9_-]", "", args.name or "custom") or "custom"
    dst = os.path.join(prefix, "drive_c", "windows", "neutron", "caption", name)
    os.makedirs(dst, exist_ok=True)
    copied = []
    for b in CAPTION_BUTTONS:
        src = os.path.join(args.from_dir, b + ".ico")
        if os.path.isfile(src):
            shutil.copyfile(src, os.path.join(dst, b + ".ico"))
            copied.append(b)
    if not copied:
        die({"ok": False, "reason": f"no close/min/max/restore .ico files in {args.from_dir}"},
            EX_FAIL, args.json)
    ok = reg_import(wine, prefix, {key: {"Enabled": 1, "IconDir": "C:\\windows\\neutron\\caption\\" + name}},
                    tag="neutron-caption")
    emit({"ok": ok, "prefix": prefix, "enabled": True, "set": name, "buttons": copied,
          "note": "restart the app to see the change"}, args.json)
    return EX_OK if ok else EX_FAIL


# --- KWin rule: Premiere's home screen position (REMOVED in 1.0.0-beta.2) --------------------
# Earlier versions could install an optional KWin rule (`neutron window-rule premiere-home`, a
# Collider Preferences setting) meant to keep Premiere's home overlay below the menu bar. Its match
# only ever caught Premiere's splash (2026-09-01), so the setting and the command were removed
# (DECISIONS C36). What remains removes a rule an earlier version installed: `setup`/`update` run
# it once, and `uninstall` runs it. It merges into kwinrulesrc and never touches other rules.
KWIN_RULE_ID = "neutron-premiere-home"
KWIN_RULE_KEYS = ("Description", "wmclass", "wmclasscomplete", "wmclassmatch",
                  "title", "titlematch", "position", "positionrule")
# The kwin script Collider installs for the same overlay (removed by `uninstall`).
KWIN_SCRIPT_ID = "neutron-home-overlay"


def _is_kde():
    de = (os.environ.get("XDG_CURRENT_DESKTOP") or os.environ.get("XDG_SESSION_DESKTOP") or "").lower()
    return "kde" in de or "plasma" in de


def _kconfig(tool):
    return tool + "6" if have(tool + "6") else tool


def _kwin_reconfigure():
    subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path",
                    "/KWin", "--method", "org.kde.KWin.reconfigure"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)


def _kwin_rule_list():
    r = subprocess.run([_kconfig("kreadconfig"), "--file", "kwinrulesrc", "--group", "General",
                        "--key", "rules"], capture_output=True, text=True, timeout=15)
    return [x for x in r.stdout.strip().split(",") if x] if r.returncode == 0 else []


def _kwin_home_rule_remove():
    """Remove the old Premiere home-screen rule if an earlier version installed it.
    Returns True when something was removed; never touches kwinrulesrc when it is absent."""
    if not (_is_kde() and have(_kconfig("kreadconfig")) and have(_kconfig("kwriteconfig"))):
        return False
    ids = _kwin_rule_list()
    stanza = subprocess.run([_kconfig("kreadconfig"), "--file", "kwinrulesrc", "--group",
                             KWIN_RULE_ID, "--key", "positionrule"],
                            capture_output=True, text=True, timeout=15).stdout.strip()
    if KWIN_RULE_ID not in ids and not stanza:
        return False
    kw = _kconfig("kwriteconfig")
    # Delete the stanza's keys too: dropping the id alone leaves positionrule=2 on disk,
    # one `rules=` edit away from live again.
    for k in KWIN_RULE_KEYS:
        subprocess.run([kw, "--file", "kwinrulesrc", "--group", KWIN_RULE_ID, "--key", k,
                        "--delete"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=15)
    ids = [x for x in ids if x != KWIN_RULE_ID]
    for k, v in (("rules", ",".join(ids)), ("count", str(len(ids)))):
        subprocess.run([kw, "--file", "kwinrulesrc", "--group", "General", "--key", k, v],
                       check=True, timeout=15)
    _kwin_reconfigure()
    return True


def ntsync_status():
    """'active' (/dev/ntsync usable), 'available' (the kernel ships the module but it isn't loaded
    -- nothing autoloads it), or 'missing' (kernel older than 6.14 / built without it).
    Speed only: neutron-wine falls back to wineserver sync without it, much slower for Adobe apps."""
    if os.path.exists("/dev/ntsync") and os.access("/dev/ntsync", os.R_OK):
        return "active"
    rel = os.uname().release
    if glob.glob(f"/lib/modules/{rel}/kernel/drivers/misc/ntsync.ko*") or \
            glob.glob(f"/usr/lib/modules/{rel}/kernel/drivers/misc/ntsync.ko*"):
        return "available"
    try:
        with open(f"/lib/modules/{rel}/modules.builtin") as f:
            if "ntsync" in f.read():
                return "available"
    except OSError:
        pass
    return "missing"


NTSYNC_DETAIL = {
    "active": "active",
    "available": "your kernel has ntsync but it isn't turned on — run `neutron setup` to enable "
                 "it (asks for your password once). Without it Adobe apps run much slower.",
    "missing": "your kernel has no ntsync (it needs Linux 6.14 or newer). Adobe apps still run, "
               "but much slower.",
}


# --- doctor: GPU checks (AMD support audit X3, 2026-10-15) ----------------------------------------
# What each GPU needs for the Adobe apps. Every finding is at most a WARNING: the apps still start
# without any of it, and a check that misreads an unusual setup must never turn a working machine red.
# Everything is read from the filesystem (sysfs, ICD files, library directories); nothing is loaded
# or run. `root` exists so the tests can point all of it at a fake tree.
AMD_PCI_VENDOR = "0x1002"
INTEL_PCI_VENDOR = "0x8086"
GPU_VENDOR_NAMES = {NVIDIA_PCI_VENDOR: "NVIDIA", AMD_PCI_VENDOR: "AMD", INTEL_PCI_VENDOR: "Intel"}

# Vulkan drivers, recognized by the library their ICD file names: (basename prefix, PCI vendor, name).
# Order matters: hasvk before the general Intel prefix.
VULKAN_ICD_DRIVERS = (
    ("libvulkan_radeon", AMD_PCI_VENDOR, "RADV"),
    ("amdvlk", AMD_PCI_VENDOR, "AMDVLK"),
    ("libvulkan_intel_hasvk", INTEL_PCI_VENDOR, "Intel hasvk"),
    ("libvulkan_intel", INTEL_PCI_VENDOR, "Intel ANV"),
    ("libGLX_nvidia", NVIDIA_PCI_VENDOR, "NVIDIA"),
    ("libEGL_nvidia", NVIDIA_PCI_VENDOR, "NVIDIA"),
    ("libvulkan_nouveau", NVIDIA_PCI_VENDOR, "NVK"),
)
# The Vulkan loader's system search path on Linux (user directories are added from the environment).
VULKAN_ICD_DIRS = ("etc/xdg/vulkan/icd.d", "etc/vulkan/icd.d", "usr/local/etc/vulkan/icd.d",
                   "usr/local/share/vulkan/icd.d", "usr/share/vulkan/icd.d")
VULKAN_DRIVER_HINT = {
    AMD_PCI_VENDOR: "vulkan-radeon (Arch), mesa-vulkan-drivers (Fedora, Debian, Ubuntu), "
                    "libvulkan_radeon (openSUSE)",
    INTEL_PCI_VENDOR: "vulkan-intel (Arch), mesa-vulkan-drivers (Fedora, Debian, Ubuntu), "
                      "libvulkan_intel (openSUSE)",
    NVIDIA_PCI_VENDOR: "NVIDIA's driver package (nvidia-utils on Arch)",
}
VULKAN_LOADER_HINT = "vulkan-icd-loader (Arch), vulkan-loader (Fedora), libvulkan1 (Debian, Ubuntu, openSUSE)"
OPENCL_VENDORS_DIR = "etc/OpenCL/vendors"
OPENCL_LOADER_HINT = "ocl-icd (Arch, Fedora), ocl-icd-libopencl1 (Debian, Ubuntu), libOpenCL1 (openSUSE)"
ROCM_OPENCL_HINT = ("rocm-opencl-runtime (Arch, CachyOS), rocm-opencl (Fedora, openSUSE Tumbleweed), "
                    "rocm-opencl-icd (Ubuntu 25.10+, Debian 13+)")
# 64-bit library directories the dynamic linker searches, plus whatever /etc/ld.so.conf adds (ROCm
# puts libamdocl64.so in /opt/rocm/lib and adds that directory there).
LIB_DIRS = ("usr/lib64", "usr/lib/x86_64-linux-gnu", "usr/lib", "lib64", "lib/x86_64-linux-gnu", "lib",
            "usr/local/lib64", "usr/local/lib")
PCI_IDS_FILES = ("usr/share/hwdata/pci.ids", "usr/share/misc/pci.ids", "usr/share/pci.ids")

# Premiere, After Effects and Media Encoder render on an AMD GPU only through AMD's own OpenCL, ROCm:
# GPUSniffer accepts the platform vendor "Advanced Micro Devices" and refuses Mesa's Rusticl by name
# (GitHub Neutron#18). Which GPUs ROCm runs on, by shader ISA (the kernel's KFD gfx target):
#   * on AMD's ROCm 10.1.0 Linux list (Radeon, Radeon PRO, Ryzen APUs;
#     https://rocm.docs.amd.com/en/latest/compatibility/compatibility-matrix.html):
ROCM_SUPPORTED_GFX = frozenset({"gfx1030", "gfx1100", "gfx1101", "gfx1102", "gfx1103", "gfx1150",
                                "gfx1151", "gfx1152", "gfx1153", "gfx1200", "gfx1201"})
#   * the other RDNA2 chips (gfx1031-gfx1037: RX 6700/6600/6500 class, RDNA2 APUs) are not on it. ROCm
#     runs them as gfx1030 with HSA_OVERRIDE_GFX_VERSION=10.3.0, which is how the one proven AMD setup
#     runs (RX 6750 XT, gfx1031, CachyOS; Discussion #4). Nobody has run Neutron on one without it.
ROCM_RDNA2_OVERRIDE = "10.3.0"
#   * RX 5000 (gfx101x), Vega and Polaris (gfx9xx, gfx8xx) and older: no ROCm, so those three apps
#     render on the CPU, where Windows would use the GPU. Instinct targets (gfx908, gfx90a, gfx94x,
#     gfx95x) are left as unknown; doctor makes no claim about them.
HSA_OVERRIDE_VAR = "HSA_OVERRIDE_GFX_VERSION"


def _gfx_name(ver):
    """KFD's gfx_target_version (major*10000 + minor*100 + stepping) as an ISA name: 100301 -> gfx1031,
    90010 -> gfx90a."""
    return "gfx%d%d%x" % (ver // 10000, (ver // 100) % 100, ver % 100)


def rocm_gfx_support(gfx_version):
    """What ROCm does with a GPU, from KFD's gfx_target_version: "supported" (on AMD's list),
    "override" (an RDNA2 chip ROCm runs as gfx1030 with HSA_OVERRIDE_GFX_VERSION=10.3.0), "none" (no
    ROCm: RX 5000, Vega, Polaris and older) or "unknown"."""
    if not gfx_version:
        return "unknown"
    major, minor, step = gfx_version // 10000, (gfx_version // 100) % 100, gfx_version % 100
    if _gfx_name(gfx_version) in ROCM_SUPPORTED_GFX:
        return "supported"
    if (major, minor) == (10, 3):
        return "override"
    if major <= 8 or (major, minor) == (10, 1):
        return "none"
    if major == 9 and not ((minor, step) in ((0, 8), (0, 10)) or minor in (4, 5)):
        return "none"
    return "unknown"


def _read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return None


def _pci_slot_location(slot):
    """'0000:03:00.0' -> (domain, location_id) as KFD writes them (location_id = bus << 8 | devfn)."""
    m = re.fullmatch(r"([0-9a-fA-F]+):([0-9a-fA-F]{2}):([0-9a-fA-F]{2})\.([0-7])", slot or "")
    if not m:
        return None
    dom, bus, dev, fn = (int(x, 16) for x in m.groups())
    return dom, (bus << 8) | (dev << 3) | fn


def _kfd_gpu_nodes(root="/"):
    """The kernel's compute (KFD) GPU nodes: [{"gfx_version", "vendor_id", "location"}]. Readable by any
    user, and present whenever amdgpu runs with compute enabled, ROCm installed or not."""
    nodes = []
    for p in sorted(glob.glob(os.path.join(root, "sys/class/kfd/kfd/topology/nodes/*/properties"))):
        props = {}
        for ln in (_read_text(p) or "").splitlines():
            k, _, v = ln.strip().partition(" ")
            props[k] = v.strip()
        try:
            ver = int(props.get("gfx_target_version", "0"))
            vendor = int(props.get("vendor_id", "0"))
            loc = (int(props.get("domain", "0")), int(props.get("location_id", "-1")))
        except ValueError:
            continue
        if ver > 0:                              # CPU nodes have none
            nodes.append({"gfx_version": ver, "vendor_id": "0x%04x" % vendor, "location": loc})
    return nodes


def _pci_device_name(vendor_id, device_id, root="/"):
    """The device's name from the system's pci.ids ('Navi 22 [Radeon RX 6700/6700 XT/6750 XT ...]' ->
    the bracketed part), or None."""
    v, d = (vendor_id or "")[2:].lower(), (device_id or "")[2:].lower()
    if not v or not d:
        return None
    for rel in PCI_IDS_FILES:
        try:
            with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
                in_vendor = False
                for ln in f:
                    if ln.startswith("#") or not ln.strip():
                        continue
                    if not ln.startswith("\t"):
                        if in_vendor:
                            return None
                        in_vendor = ln[:4].lower() == v
                    elif in_vendor and not ln.startswith("\t\t") and ln[1:5].lower() == d:
                        name = ln[5:].strip()
                        m = re.search(r"\[(.+)\]\s*$", name)
                        return m.group(1) if m else name
        except OSError:
            continue
    return None


def host_gpus(root="/"):
    """Every GPU the kernel exposes, for doctor: [{"pci", "vendor_id", "device_id", "vendor", "name",
    "driver", "gfx", "gfx_version"}]. `gfx` (AMD only) is the shader ISA from the kernel's KFD topology,
    None when the kernel has no compute node for the card. A GPU NVIDIA's driver has bound with no DRM
    node (nvidia-drm not loaded) is listed from /proc/driver/nvidia/gpus."""
    out = []
    for d in sorted(glob.glob(os.path.join(root, "sys/class/drm/card[0-9]*"))):
        if "-" in os.path.basename(d):
            continue
        dev = os.path.join(d, "device")
        vendor = (_read_text(os.path.join(dev, "vendor")) or "").lower()
        if not vendor:
            continue                             # simpledrm and friends: no PCI device
        drv = os.path.join(dev, "driver")
        device_id = (_read_text(os.path.join(dev, "device")) or "").lower() or None
        out.append({"pci": os.path.basename(os.path.realpath(dev)), "vendor_id": vendor,
                    "device_id": device_id, "vendor": GPU_VENDOR_NAMES.get(vendor, vendor),
                    "name": _pci_device_name(vendor, device_id, root),
                    "driver": os.path.basename(os.path.realpath(drv)) if os.path.exists(drv) else None,
                    "gfx": None, "gfx_version": None})
    # AMD cards get their gfx target from the KFD node at the same PCI address (with one AMD card and
    # one AMD node, from that node whatever its address says).
    amd = [g for g in out if g["vendor_id"] == AMD_PCI_VENDOR]
    nodes = [n for n in _kfd_gpu_nodes(root) if n["vendor_id"] == AMD_PCI_VENDOR]
    for g in amd:
        loc = _pci_slot_location(g["pci"])
        node = next((n for n in nodes if loc and n["location"] == loc), None)
        if node is None and len(amd) == 1 and len(nodes) == 1:
            node = nodes[0]
        if node:
            g["gfx_version"] = node["gfx_version"]
            g["gfx"] = _gfx_name(node["gfx_version"])
    try:
        nv_proc = sorted(os.listdir(os.path.join(root, NVIDIA_PROC_GPUS.lstrip("/"))))
    except OSError:
        nv_proc = []
    for slot in nv_proc:
        if not any(g["pci"].lower() == slot.lower() for g in out):
            out.append({"pci": slot, "vendor_id": NVIDIA_PCI_VENDOR, "device_id": None, "vendor": "NVIDIA",
                        "name": None, "driver": "nvidia", "gfx": None, "gfx_version": None})
    return out


def _ld_so_conf_dirs(root="/"):
    """Library directories /etc/ld.so.conf adds (following `include` globs)."""
    out, seen = [], set()

    def read(path):
        if path in seen:
            return
        seen.add(path)
        for ln in (_read_text(path) or "").splitlines():
            ln = ln.split("#", 1)[0].strip()
            if ln.startswith("include "):
                for p in sorted(glob.glob(os.path.join(root, ln[8:].strip().lstrip("/")))):
                    read(p)
            elif ln.startswith("/"):
                out.append(ln.lstrip("/"))
    read(os.path.join(root, "etc/ld.so.conf"))
    return out


def _is_elf64(path):
    try:
        with open(path, "rb") as f:
            head = f.read(5)
    except OSError:
        return False
    return head[:4] == b"\x7fELF" and head[4:5] == b"\x02"


def find_shared_lib(name, root="/"):
    """Where the dynamic linker would find a 64-bit library: `name` itself when it is a path, else the
    first 64-bit match in the standard and ld.so.conf directories. None when there is none (a 32-bit
    copy in Fedora's /usr/lib does not count)."""
    if "/" in name:
        p = os.path.join(root, name.lstrip("/"))
        return p if _is_elf64(p) else None
    for d in list(LIB_DIRS) + _ld_so_conf_dirs(root):
        p = os.path.join(root, d, name)
        if _is_elf64(p):
            return p
    return None


def vulkan_drivers(root="/", env=None):
    """{pci_vendor: [driver names]} for every Vulkan driver the loader can find whose library exists.
    VK_DRIVER_FILES / VK_ICD_FILENAMES replace the search, VK_ADD_DRIVER_FILES adds to it, as in the
    Vulkan loader."""
    env = os.environ if env is None else env
    explicit = env.get("VK_DRIVER_FILES") or env.get("VK_ICD_FILENAMES")
    if explicit:
        paths = explicit.split(":")
    else:
        home = env.get("HOME", "")
        dirs = [os.path.join(root, d) for d in VULKAN_ICD_DIRS]
        for var, default in (("XDG_CONFIG_HOME", ".config"), ("XDG_DATA_HOME", ".local/share")):
            base = env.get(var) or (os.path.join(home, default) if home else "")
            if base:
                dirs.append(os.path.join(base, "vulkan", "icd.d"))
        for d in (env.get("XDG_DATA_DIRS") or "").split(":"):
            if d:
                dirs.append(os.path.join(root, d.lstrip("/"), "vulkan", "icd.d"))
        paths = dirs
    paths += [p for p in (env.get("VK_ADD_DRIVER_FILES") or "").split(":") if p]
    files = []
    for p in paths:
        files += sorted(glob.glob(os.path.join(p, "*.json"))) if os.path.isdir(p) else [p]
    found = {}
    for fpath in files:
        try:
            with open(fpath, encoding="utf-8") as f:
                lib = (json.load(f).get("ICD") or {}).get("library_path") or ""
        except (OSError, ValueError, AttributeError):
            continue
        if "/" in lib and not lib.startswith("/"):
            present = _is_elf64(os.path.join(os.path.dirname(fpath), lib))   # relative to the ICD file
        else:
            present = bool(find_shared_lib(lib, root)) if lib else False
        base = os.path.basename(lib)
        for prefix, vendor, name in VULKAN_ICD_DRIVERS:
            if base.startswith(prefix):
                if present and name not in found.setdefault(vendor, []):
                    found[vendor].append(name)
                break
    return found


def opencl_icds(root="/"):
    """Every OpenCL driver registered in /etc/OpenCL/vendors: [{"icd", "library", "path", "kind"}].
    `path` is where the library was found (None if it is missing); `kind` is "rocm" for AMD's own
    (libamdocl64.so), "rusticl" or "clover" for Mesa's, else "other"."""
    out = []
    for icd in sorted(glob.glob(os.path.join(root, OPENCL_VENDORS_DIR, "*.icd"))):
        lib = (_read_text(icd) or "").splitlines()
        lib = lib[0].strip() if lib else ""
        base = os.path.basename(lib).lower()
        kind = ("rocm" if base.startswith("libamdocl") else "rusticl" if "rusticl" in base
                else "clover" if base.startswith("libmesaopencl") else "other")
        out.append({"icd": icd, "library": lib, "path": find_shared_lib(lib, root) if lib else None,
                    "kind": kind})
    return out


def _shown(path, root):
    """A path under `root` as the user would see it on the real system."""
    r = root.rstrip("/")
    return path[len(r):] if r and path.startswith(r + "/") else path


def _gpu_label(g, gfx=False):
    """'AMD Radeon RX 6700/6700 XT/6750 XT / 6800M/6850M XT (1002:73df)', with `gfx` '(1002:73df, gfx1031)'."""
    ids = "%s:%s" % (g["vendor_id"][2:], (g["device_id"] or "0x????")[2:])
    if gfx and g.get("gfx"):
        ids += ", " + g["gfx"]
    return "%s %s(%s)" % (g["vendor"], (g["name"] + " ") if g.get("name") else "", ids)


def gpu_checks(gpus, root="/", env=None):
    """The machine-level GPU checks for `neutron doctor`, as check dicts: `gpu` (each GPU's vendor,
    kernel driver and Vulkan driver) and, on a machine whose GPUs are AMD's with no NVIDIA one, the
    OpenCL that Premiere, After Effects and Media Encoder need (`amd-rocm-opencl`, `opencl-loader`).
    On an NVIDIA machine those apps use CUDA, so the AMD checks do not apply and are left out."""
    env = os.environ if env is None else env
    checks = []
    vk = vulkan_drivers(root, env)
    loader = find_shared_lib("libvulkan.so.1", root)
    parts, warn, listed = [], [], []
    for g in gpus:
        names = vk.get(g["vendor_id"], [])
        if g["vendor_id"] == NVIDIA_PCI_VENDOR:   # NVIDIA's driver and NVK each serve only their kernel driver
            names = [n for n in names if (n == "NVK") == (g["driver"] == "nouveau")]
        if g["vendor_id"] == AMD_PCI_VENDOR and g["driver"] == "radeon":
            names = []                           # neither RADV nor AMDVLK runs on the old radeon driver
        listed.append(dict(g, vulkan=names))
        parts.append("%s on %s%s, Vulkan: %s" % (
            _gpu_label(g), g["driver"] or "no kernel driver",
            (", " + g["gfx"]) if g.get("gfx") else "", ", ".join(names) if names else "none"))
        if not names:
            if g["vendor_id"] == AMD_PCI_VENDOR and g["driver"] == "radeon":
                warn.append("%s runs on the old radeon kernel driver, which has no Vulkan driver, so "
                            "DirectX apps cannot use it" % _gpu_label(g))
            elif g["vendor_id"] in VULKAN_DRIVER_HINT:
                warn.append("no Vulkan driver for the %s GPU: install %s"
                            % (g["vendor"], VULKAN_DRIVER_HINT[g["vendor_id"]]))
    if not gpus:
        warn.append("the kernel lists no GPU in /sys/class/drm")
    if not loader:
        warn.append("the Vulkan loader libvulkan.so.1 is missing, so no app can use the GPU: install "
                    + VULKAN_LOADER_HINT)
    c = {"name": "gpu", "ok": True, "detail": "; ".join(parts + warn) or "no GPU found",
         "gpus": listed}
    if warn:
        c["warning"] = True
    checks.append(c)

    amd = [g for g in gpus if g["vendor_id"] == AMD_PCI_VENDOR]
    if not amd or any(g["vendor_id"] == NVIDIA_PCI_VENDOR for g in gpus):
        return checks

    # --- AMD's ROCm OpenCL: the only GPU path of Premiere, After Effects and Media Encoder on AMD ---
    apps = "Premiere, After Effects and Media Encoder"
    status = {id(g): ("radeon" if g["driver"] == "radeon" else "no-kfd" if not g["gfx_version"]
                      else rocm_gfx_support(g["gfx_version"])) for g in amd}
    usable = [g for g in amd if status[id(g)] in ("supported", "override", "unknown")]
    icds = opencl_icds(root)
    rocm = [i for i in icds if i["kind"] == "rocm"]
    rocm_ok = [i for i in rocm if i["path"]]

    def why_not(g):
        s = status[id(g)]
        if s == "radeon":
            return "%s runs on the old radeon kernel driver, which ROCm does not support" % _gpu_label(g)
        if s == "no-kfd":
            return ("the kernel offers no ROCm compute device for %s (no KFD node in "
                    "/sys/class/kfd)" % _gpu_label(g))
        return "AMD's ROCm does not support %s" % _gpu_label(g, gfx=True)

    if not usable:
        c = {"name": "amd-rocm-opencl", "ok": True, "warning": True,
             "detail": "; ".join(why_not(g) for g in amd) +
                       ", so %s render on the CPU, not on the GPU" % apps}
    elif not rocm:
        others = sorted({{"rusticl": "Mesa's Rusticl", "clover": "Mesa's Clover"}.get(i["kind"],
                         os.path.basename(i["library"]) or os.path.basename(i["icd"])) for i in icds})
        c = {"name": "amd-rocm-opencl", "ok": True, "warning": True,
             "detail": "AMD's ROCm OpenCL is not installed, so %s render on the CPU: they accept only "
                       "AMD's own OpenCL%s. Install %s"
                       % (apps, (" (found: %s)" % ", ".join(others)) if others else "",
                          ROCM_OPENCL_HINT)}
    elif not rocm_ok:
        c = {"name": "amd-rocm-opencl", "ok": True, "warning": True,
             "detail": "%s names %s, which is not installed, so %s render on the CPU. Reinstall %s"
                       % (_shown(rocm[0]["icd"], root), rocm[0]["library"], apps, ROCM_OPENCL_HINT)}
    else:
        kfd = os.path.join(root, "dev/kfd")
        detail = "AMD's ROCm OpenCL: %s (%s)" % (_shown(rocm_ok[0]["icd"], root),
                                                 _shown(rocm_ok[0]["path"], root))
        c = {"name": "amd-rocm-opencl", "ok": True, "detail": detail}
        if os.path.exists(kfd) and not os.access(kfd, os.R_OK | os.W_OK):
            c["warning"] = True
            c["detail"] = (detail + " -- but you cannot open /dev/kfd, so it finds no GPU and %s "
                           "render on the CPU. Add yourself to the render and video groups (sudo "
                           "usermod -a -G render,video $LOGNAME), then log out and back in" % apps)
        elif len(usable) < len(amd):
            c["detail"] = detail + "; " + "; ".join(why_not(g) for g in amd
                                                    if all(g is not u for u in usable))
    checks.append(c)

    # --- the OpenCL ICD loader: Neutron's OpenCL.dll links libOpenCL.so.1 and cannot load without it ---
    ocl = find_shared_lib("libOpenCL.so.1", root)
    if ocl:
        checks.append({"name": "opencl-loader", "ok": True, "detail": _shown(ocl, root)})
    else:
        checks.append({"name": "opencl-loader", "ok": True, "warning": True,
                       "detail": "the OpenCL loader libOpenCL.so.1 is missing, so Wine's OpenCL.dll "
                                 "cannot load and no app gets OpenCL. Install " + OPENCL_LOADER_HINT})
    return checks


def gfx_override_check(gpus, prefix, env=None):
    """`amd-gfx-override`: HSA_OVERRIDE_GFX_VERSION for this prefix, from the caller's environment
    (which wins at launch) or <prefix>/neutron-env.conf (which reaches every launch surface). A check
    dict, or None when it does not apply (no AMD GPU, an NVIDIA GPU present, or nothing to say)."""
    env = os.environ if env is None else env
    amd = [g for g in gpus if g["vendor_id"] == AMD_PCI_VENDOR and g["driver"] != "radeon"]
    if not amd or any(g["vendor_id"] == NVIDIA_PCI_VENDOR for g in gpus):
        return None
    conf_path = os.path.join(prefix, "neutron-env.conf")
    conf_v = (_read_env_conf(prefix).get(HSA_OVERRIDE_VAR) or "").strip() or None
    env_v = (env.get(HSA_OVERRIDE_VAR) or "").strip() or None
    value = conf_v or env_v
    where = (conf_path if conf_v else "this environment") if value else None
    status = {id(g): rocm_gfx_support(g["gfx_version"]) if g["gfx_version"] else "no-kfd" for g in amd}
    native = [g for g in amd if status[id(g)] == "supported"]
    need = [g for g in amd if status[id(g)] == "override"]
    # the override applies to every GPU ROCm sees: these would be affected too
    others = [g for g in amd if status[id(g)] in ("none", "unknown")]

    def labels(gs):
        return ", ".join(_gpu_label(g, gfx=True) for g in gs)

    def warn(detail):
        return {"name": "amd-gfx-override", "ok": True, "warning": True, "detail": detail}

    if native:
        if value:
            return warn("%s=%s (%s) applies to every AMD GPU, and ROCm supports %s as it is: remove it"
                        % (HSA_OVERRIDE_VAR, value, where, labels(native)))
        return None
    if need and others:
        return warn("%s needs %s=%s for ROCm, but the override would also apply to %s; Neutron has not "
                    "been tested on this combination%s"
                    % (labels(need), HSA_OVERRIDE_VAR, ROCM_RDNA2_OVERRIDE, labels(others),
                       (" (currently %s, from %s)" % (value, where)) if value else ""))
    if need:
        line = "%s=%s" % (HSA_OVERRIDE_VAR, ROCM_RDNA2_OVERRIDE)
        if conf_v == ROCM_RDNA2_OVERRIDE:
            return {"name": "amd-gfx-override", "ok": True,
                    "detail": "%s in %s, so ROCm treats %s as gfx1030" % (line, conf_path, labels(need))}
        if env_v == ROCM_RDNA2_OVERRIDE and not conf_v:
            return warn("%s is set in this environment only: add that line to %s so launches from the "
                        "app menu and Collider get it too" % (line, conf_path))
        if value:
            return warn("%s=%s (%s) is not the RDNA2 setting: put %s in %s"
                        % (HSA_OVERRIDE_VAR, value, where, line, conf_path))
        return warn("%s is not on ROCm's supported list; the tested setup (RX 6750 XT) runs it with %s. "
                    "Add that line to %s" % (labels(need), line, conf_path))
    if value and others:
        return warn("%s=%s (%s) is set, but ROCm does not support %s; Neutron has not been tested with "
                    "an override on it" % (HSA_OVERRIDE_VAR, value, where, labels(others)))
    return None


# --- doctor: AMD hardware encoding (amfrt64.dll, neutron-wine 11.10-128 and later) ------------------
# Our amfrt64.dll answers the AMF calls Premiere, Media Encoder and After Effects make on an AMD GPU and
# encodes H.264/HEVC through Mesa (Vulkan Video on RADV, or VA-API). When one of those apps loads it, it
# writes what it found to <prefix>/neutron-amf.json (format 1):
#   {"format": 1, "time": "<UTC ISO 8601>", "gpu": {"vendor": "0x1002", "device": "0x73df", "name": ...},
#    "codecs": {"h264": {"available": true, "backend": "vulkan|vaapi|none", "max_width": 4096,
#                        "max_height": 2304, "tenbit": false, "reason": ""}, "hevc": {...}}}
# Doctor only reads that file. Without H.264 the apps export with Software Encoding, as on Windows
# without a hardware encoder: a warning with the fix, never a failure.
AMF_REPORT = "neutron-amf.json"
AMF_APPS = ("premiere", "mediaencoder", "aftereffects")
AMF_BACKENDS = {"vulkan": "Vulkan Video", "vaapi": "VA-API"}
# Premiere offers Hardware Encoding only while its GPU acceleration is on, which on AMD is ROCm's OpenCL.
AMF_GPU_ACCEL_CHECKS = ("amd-rocm-opencl", "opencl-loader", "amd-gfx-override")
# Fedora strips H.264/HEVC from Mesa; RPM Fusion's freeworld builds put them back
# (https://rpmfusion.org/Howto/Multimedia, "Hardware codecs with AMD (mesa)", read 2026-10-16).
RPMFUSION_FREE_ENABLE = ("sudo dnf install https://mirrors.rpmfusion.org/free/fedora/"
                         "rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm")
RPMFUSION_MESA = ("sudo dnf install mesa-va-drivers-freeworld",
                  "sudo dnf swap mesa-vulkan-drivers mesa-vulkan-drivers-freeworld")


def os_release(root="/"):
    """/etc/os-release (or /usr/lib/os-release) as a dict, {} when neither is readable."""
    for rel in ("etc/os-release", "usr/lib/os-release"):
        text = _read_text(os.path.join(root, rel))
        if text is not None:
            out = {}
            for ln in text.splitlines():
                k, sep, v = ln.partition("=")
                if sep and k.strip() and not k.lstrip().startswith("#"):
                    out[k.strip()] = v.strip().strip('"').strip("'")
            return out
    return {}


def _distro_family(osr):
    """'fedora', 'opensuse', 'arch', 'debian' or None, from ID and ID_LIKE."""
    ids = [osr.get("ID", "").lower()] + osr.get("ID_LIKE", "").lower().split()
    for fam, names in (("fedora", ("fedora",)), ("opensuse", ("opensuse", "suse")),
                       ("arch", ("arch",)), ("debian", ("debian", "ubuntu"))):
        if any(i in names or (fam == "opensuse" and i.startswith("opensuse")) for i in ids):
            return fam
    return None


def _system_update_command(osr, root="/"):
    """The command that updates the whole system (and with it Mesa and linux-firmware), or None."""
    fam = _distro_family(osr)
    if fam == "fedora":
        return "rpm-ostree upgrade" if os.path.exists(os.path.join(root, "run/ostree-booted")) \
            else "sudo dnf upgrade --refresh"
    if fam == "opensuse":
        return "sudo zypper update" if "leap" in osr.get("ID", "").lower() else "sudo zypper dup"
    return {"arch": "sudo pacman -Syu", "debian": "sudo apt update && sudo apt full-upgrade"}.get(fam)


def _amf_reason_kind(reason):
    """What an amfrt64 reason sentence comes down to: 'codecs' (Mesa built without H.264/HEVC),
    'firmware' (the encoder is hidden: VCN firmware or Mesa too old), 'vulkan-loader',
    'vulkan-driver', 'update' (a component too old), or None."""
    r = (reason or "").lower()
    if re.search(r"without (h\.?264|hevc|h\.?265)|no (h\.?264|hevc|h\.?265) encoder|all_free|patent", r):
        return "codecs"
    if "firmware" in r or "does not offer video encoding" in r:
        return "firmware"
    if "libvulkan" in r or "vulkan is not installed" in r:
        return "vulkan-loader"
    if "too old" in r:
        return "update"
    if re.search(r"no vulkan( 1\.3)? driver|no gpu with a working vulkan driver|no amd gpu", r):
        return "vulkan-driver"
    return None


def _amf_fix(kind, osr, root="/"):
    """The one fix for a reason kind, as a sentence without its final period, or None."""
    upd = _system_update_command(osr, root)
    update = "update your system (%s)" % upd if upd else "update your system"
    if kind == "codecs":
        fam = _distro_family(osr)
        if fam == "fedora" and os.path.exists(os.path.join(root, "run/ostree-booted")):
            return ("This system's Mesa is built without H.264 and HEVC. On an image-based Fedora, layer "
                    "RPM Fusion's mesa-va-drivers-freeworld and mesa-vulkan-drivers-freeworld "
                    "(rpmfusion.org/Howto/Multimedia), then restart the computer")
        if fam == "fedora":
            cmds = list(RPMFUSION_MESA)
            if not glob.glob(os.path.join(root, "etc/yum.repos.d/rpmfusion-free*.repo")):
                cmds.insert(0, RPMFUSION_FREE_ENABLE)
            return ("This system's Mesa is built without H.264 and HEVC. Install RPM Fusion's full "
                    "build: %s, then restart the app" % ", then ".join(cmds))
        if fam == "opensuse":
            cmds = ["opi codecs"]
            if not any(os.path.exists(os.path.join(root, d, "opi")) for d in ("usr/bin", "bin")):
                cmds.insert(0, "sudo zypper install opi")
            return ("This system's Mesa is built without H.264 and HEVC. Install Packman's full build: "
                    "%s, then restart the app" % ", then ".join(cmds))
        return ("This system's Mesa is built without H.264 and HEVC: install your distribution's Mesa "
                "build that includes them")
    if kind == "firmware":
        return ("The GPU's video encoder needs a newer linux-firmware and Mesa: %s, then restart the "
                "computer" % update)
    if kind == "update":
        return update[0].upper() + update[1:] + ", then restart the app"
    if kind == "vulkan-loader":
        return "Install the Vulkan loader: " + VULKAN_LOADER_HINT
    if kind == "vulkan-driver":
        return "Install AMD's Vulkan driver: " + VULKAN_DRIVER_HINT[AMD_PCI_VENDOR]
    return None


def amd_hw_encode_check(gpus, prefix, checks=(), root="/"):
    """`amd-hw-encode`: whether Premiere, Media Encoder and After Effects can encode H.264/HEVC on the
    AMD GPU, from what amfrt64.dll recorded in <prefix>/neutron-amf.json. `checks` are the doctor checks
    so far (the GPU-acceleration ones are cited when they warn). A check dict, or None when it does not
    apply: no AMD GPU, an NVIDIA GPU present (those apps encode with NVENC there), a runtime without
    amfrt64.dll, or no app that uses it and nothing recorded yet."""
    amd = [g for g in gpus if g["vendor_id"] == AMD_PCI_VENDOR]
    if not amd or any(g["vendor_id"] == NVIDIA_PCI_VENDOR for g in gpus):
        return None
    if not os.path.isfile(os.path.join(prefix, "drive_c", "windows", "system32", "amfrt64.dll")):
        return None
    name = "amd-hw-encode"
    apps = "Premiere Pro, Media Encoder or After Effects"
    path = os.path.join(prefix, AMF_REPORT)
    if not os.path.exists(path):
        if not any(os.path.isfile(_resolve_app_exe(prefix, APP_PROFILES[a]["exe"])) for a in AMF_APPS):
            return None
        return {"name": name, "ok": True, "pending": True,
                "detail": "pending — start %s once, and it records whether AMD hardware encoding works" % apps}
    try:
        with open(path, encoding="utf-8") as f:
            rep = json.load(f)
        if not isinstance(rep, dict) or rep.get("format") != 1 or not isinstance(rep.get("codecs"), dict):
            raise ValueError("not a format-1 report")
    except (OSError, ValueError) as e:
        return {"name": name, "ok": True, "warning": True,
                "detail": "could not read %s (%s): start %s again to write it anew" % (path, e, apps)}

    def codec(key):
        c = rep["codecs"].get(key)
        return c if isinstance(c, dict) else {}

    def size(c):
        w, h = c.get("max_width"), c.get("max_height")
        return ", up to %sx%s" % (w, h) if isinstance(w, int) and isinstance(h, int) and w and h else ""

    def reason(c):
        return (c.get("reason") or "no reason given").strip().rstrip(".")

    gpu = rep.get("gpu") if isinstance(rep.get("gpu"), dict) else {}
    on = (" on " + gpu["name"]) if gpu.get("name") else ""
    when = ("checked %s UTC; " % str(rep["time"])[:16].replace("T", " ")) if rep.get("time") else ""
    h264, hevc = codec("h264"), codec("hevc")
    if h264.get("available") is not True:
        fix = _amf_fix(_amf_reason_kind(h264.get("reason")), os_release(root), root)
        return {"name": name, "ok": True, "warning": True,
                "detail": "no H.264 hardware encoding%s: %s.%s Until then %s export with Software "
                          "Encoding (%sstart one of them again after the fix to check again)"
                          % (on, reason(h264), (" %s." % fix) if fix else "",
                             apps.replace(" or ", " and "), when)}
    parts = []
    for label, c in (("H.264", h264), ("HEVC", hevc)):
        if c.get("available") is True:
            parts.append("%s (%s, %s%s)" % (label, AMF_BACKENDS.get(c.get("backend"), c.get("backend") or "?"),
                                            "10-bit" if c.get("tenbit") else "8-bit", size(c)))
        else:
            parts.append("%s not available (%s)" % (label, reason(c)))
    c = {"name": name, "ok": True, "detail": "hardware encoding%s: %s" % (on, ", ".join(parts))}
    accel = [x["name"] for x in checks if x.get("name") in AMF_GPU_ACCEL_CHECKS and x.get("warning")]
    if accel:
        c["warning"] = True
        c["detail"] += (" -- but Premiere offers Hardware Encoding only while its GPU acceleration is on, "
                        "and that needs AMD's ROCm OpenCL: fix the %s warning%s first"
                        % (" and ".join(accel), "s" if len(accel) > 1 else ""))
    return c


def cmd_doctor(args):
    """Health check. Powers Collider's prefix-health status surface.

    NOTE: schema PROVISIONAL (v0-unstable), same ordering caveat as prefix info.
    """
    checks = []

    # Doctor checks ONLY what can affect launching and running the apps. A step that simply has
    # not happened yet (e.g. the display fix before an app's first launch) is `pending`, not a
    # failure: ok stays True so a fresh install reads healthy.
    def check(name, ok, detail=None, pending=False):
        c = {"name": name, "ok": bool(ok)}
        if pending:
            c["pending"] = True
        if detail:
            c["detail"] = detail
        checks.append(c)

    # ⚠️ Check the wine NEUTRON WILL ACTUALLY USE, not `wine` on PATH. Neutron ships its own
    # runtime and deliberately does not require a distro wine package, so `shutil.which("wine")`
    # is False on a clean machine — every build tester failed this check, doctor returned
    # "unhealthy" (exit 1), and Collider treated that as a command failure and blanked its entire
    # Apps view. The dev box happened to have /usr/bin/wine installed, which is why it never
    # reproduced here.
    _wine, _wine_is_neutron = resolve_wine()
    check("wine", bool(_wine),
          (_wine + "  (Neutron runtime)") if _wine
          else NO_RUNTIME_MSG)

    # 🚨 IS THE RUNTIME ITSELF INTACT? Reported from the build tester 2026-08-25: doctor returned
    # {"ok": true, "healthy": true} against 11.10-61, a build we KNOW is defective. Resolving a
    # wine binary was its only unconditional check, and 61's `wine` binary was fine -- what was
    # missing was everything around it. Both defects below are what 61 actually shipped with,
    # caused by cutting a release from an incremental make on a tree wine-tkg partially reverts:
    #   * an EMPTY 32-bit PE tree (0 files vs 1101) -- every 32-bit Adobe helper fails to start;
    #   * a HALF-APPLIED wine.inf -- the prefix comes out missing registry content.
    # A check that cannot fail on a build known to be broken is worse than no check: it is the
    # sentence "doctor says healthy" doing work it never earned.
    if _wine and _wine_is_neutron:
        for c in _runtime_integrity_checks(_wine):
            check(c[0], c[1], c[2])

    # ntsync: speed, not correctness -- reported, never a failure.
    _nts = ntsync_status()
    check("ntsync", True, NTSYNC_DETAIL[_nts])
    if _nts != "active":
        checks[-1]["warning"] = True

    # GPUs: each one's vendor, kernel driver and Vulkan driver, and on an AMD machine the OpenCL that
    # Premiere, After Effects and Media Encoder need. Warnings at most, and a check that trips over an
    # unusual system reports that instead of taking the rest of doctor down with it.
    try:
        _gpus = host_gpus()
        checks.extend(gpu_checks(_gpus))
    except Exception as e:
        _gpus = []
        check("gpu", True, "could not read the GPUs: %s" % e)
        checks[-1]["warning"] = True

    if args.prefix:
        prefix = resolve_prefix(args.prefix)
        if not prefix:
            check("prefix", False, "drive_c not found")
        else:
            user = prefix_user(prefix)
            check("prefix", True, prefix)
            _pf = _prefix_file_problems(prefix)
            check("prefix-files", not _pf,
                  "; ".join(_pf) if _pf else "system.reg, user.reg and .update-timestamp are yours")
            # Would launching this prefix on the runtime we just resolved re-stamp it? Same test
            # `launch` refuses on, surfaced here so Collider shows it BEFORE someone clicks
            # Launch. Silent when the prefix has never been booted.
            # 🚨 IS THIS PREFIX STILL ON THE WAYLAND DRIVER? Every graphics fix Neutron ships
            # lives in winewayland, and until 2026-08-27 a launch from a surface whose
            # environment lacked XDG_SESSION_TYPE would silently write Graphics=x11 here. A
            # prefix can therefore already be in that state from a menu launch, and the symptom
            # is "the app looks wrong now" days later with nothing to point at. The automatic
            # fallback is gone; this is how an existing casualty is found.
            try:
                with open(os.path.join(prefix, "user.reg"), encoding="utf-8",
                          errors="replace") as _f:
                    _reg = _f.read()
                _m = re.search(r'\[Software\\\\Wine\\\\Drivers\](.*?)(\n\[|\Z)', _reg, re.S)
                _gfx = None
                if _m:
                    _g = re.search(r'"Graphics"="([^"]*)"', _m.group(1))
                    _gfx = _g.group(1) if _g else None
                if _gfx is not None:
                    check("graphics-driver", "wayland" in _gfx,
                          _gfx if "wayland" in _gfx else
                          "prefix is set to %r, not wayland -- every winewayland fix is INACTIVE. "
                          "A Wayland launch sets it back; `neutron launch` no longer falls back "
                          "to X11 automatically." % _gfx)
            except OSError:
                pass
            _mm = stamp_mismatch(prefix, _wine)
            if _mm is not None:
                _also = _mm["prefix_runtimes"]
                check("runtime-prefix-stamp", False,
                      "this prefix is stamped for %s but the resolved runtime is %s — launching "
                      "would run `wineboot -u` and REVERT the patched natives. Run "
                      "`neutron prefix provision %s`."
                      % (", ".join(_also) if _also else "stamp %d (no installed runtime)"
                         % _mm["prefix_stamp"], os.path.basename(_mm["runtime"]), prefix))
            elif _prefix_stamp(prefix) is not None:
                check("runtime-prefix-stamp", True,
                      "prefix and runtime agree (stamp %d)" % _prefix_stamp(prefix))
            # App-agnostic health: a prefix is usable if ANY known Adobe app is
            # installed (not Premiere specifically) — else a Photoshop-only prefix
            # would read as "unhealthy" and gate the whole UI.
            installed = [p["name"] for p in APP_PROFILES.values()
                         if os.path.isfile(_resolve_app_exe(prefix, p["exe"]))]
            check("adobe-app", bool(installed),
                  ", ".join(installed) if installed else "no known Adobe app found")
            # The ROCm override some AMD GPUs need, from this prefix's neutron-env.conf (or the caller's
            # environment). Only on AMD machines, and only when there is something to say.
            try:
                _ovr = gfx_override_check(_gpus, prefix)
            except Exception as e:
                _ovr = {"name": "amd-gfx-override", "ok": True, "warning": True,
                        "detail": "could not check %s: %s" % (HSA_OVERRIDE_VAR, e)}
            if _ovr:
                checks.append(_ovr)
            # AMD hardware encoding, from what amfrt64.dll recorded when Premiere, Media Encoder or
            # After Effects loaded it. AMD machines with no NVIDIA GPU only.
            try:
                _amf = amd_hw_encode_check(_gpus, prefix, checks)
            except Exception as e:
                _amf = {"name": "amd-hw-encode", "ok": True, "warning": True,
                        "detail": "could not check AMD hardware encoding: %s" % e}
            if _amf:
                checks.append(_amf)
            # Adobe's CC-desktop IPC broker -- a PHOTOSHOP prerequisite, not a suite-wide one.
            # Only the `photoshop` profile declares `daemons` (ADOBE_DAEMONS); Premiere, LrC,
            # Animate, AME, AE and Illustrator all launch without the broker running, which is why
            # Premiere works on the dev box where `neutron launch premiere` never starts it.
            # ⚠️ An earlier version of this check claimed "every Adobe app fails at launch" -- that
            # came from a build-test report and is CONTRADICTED by our own profiles. Scoped here to
            # the app that actually needs it, and only raised when that app is installed.
            #
            # Worth checking at all because `mudhut --method windows` copies whatever the source
            # Windows install happens to contain: if that machine never had CC Desktop, the prefix
            # comes out app-complete with no broker and the install still reports success.
            # Photoshop then fatals with "unable to communicate with Creative Cloud Desktop".
            ps_exe = _resolve_app_exe(prefix, APP_PROFILES["photoshop"]["exe"])
            if ps_exe and os.path.isfile(ps_exe):
                broker = os.path.join(prefix, "drive_c", "Program Files (x86)", "Common Files",
                                      "Adobe", "Adobe Desktop Common", "IPCBox",
                                      "AdobeIPCBroker.exe")
                check("cc-desktop-ipc", os.path.isfile(broker),
                      broker if os.path.isfile(broker)
                      else "AdobeIPCBroker.exe missing - PHOTOSHOP will fail with 'unable to "
                           "communicate with Creative Cloud Desktop'. Other apps are unaffected. "
                           "The Adobe Desktop Common runtime was never staged into this prefix.")
            # 🚨 nvcuda MUST be the GATED build. The diag build contains `neutron_live_thread`,
            # which samples 8 KB out of every CUDA allocation >=4 MB on a 1 s timer and never
            # drops freed pointers -- during an export it reads a freed buffer and libcuda page
            # faults, killing the app. The gate (`NEUTRON_CUDA_PLAYBACK_EXPERIMENT`, default off)
            # was written and built 2026-08-03 and never installed; the ungated build then went
            # into the runtime bundle and cost the user a day of editing (2026-08-08).
            # Presence of nvcuda.dll proves nothing -- the gate string is the only evidence.
            nvcuda = os.path.join(prefix, "drive_c", "windows", "system32", "nvcuda.dll")
            if os.path.isfile(nvcuda):
                check("nvcuda-gated", _has_marker(nvcuda, b"NEUTRON_CUDA_PLAYBACK_EXPERIMENT"),
                      "gated release build" if _has_marker(
                          nvcuda, b"NEUTRON_CUDA_PLAYBACK_EXPERIMENT")
                      else "UNGATED DIAG BUILD - CUDA exports will crash in libcuda. Run "
                           "`neutron prefix provision <prefix>` to restage the runtime's build.")
            # Microsoft's components, by checksum: a same-named Wine builtin or a different build
            # would pass a presence test. Without them Adobe's installers and apps fail to start.
            _win = os.path.join(prefix, "drive_c", "windows")
            _bad = [f"{d}/{n}" for (_dl, _m, sha, d, n) in MS_FILES.values()
                    if d and _sha256_file(os.path.join(_win, d, n)) != sha]
            check("microsoft-components", not _bad,
                  "VC++ runtimes, UCRT, d3dcompiler_47, GDI+ and core fonts in place" if not _bad
                  else "%d missing or different (%s%s). Run `neutron prefix provision <prefix>`."
                       % (len(_bad), ", ".join(_bad[:4]), ", ..." if len(_bad) > 4 else ""))
            # WebView2 renders Adobe's sign-in window.
            _wv = _webview2_version(os.path.join(prefix, "drive_c", "Program Files (x86)",
                                                 "Microsoft", "EdgeWebView", "Application"))
            check("webview2", bool(_wv),
                  (f"{_wv}" + (" -- untested under neutron-wine (tested: "
                               + ", ".join(map(str, WEBVIEW2_TESTED_MAJORS)) + ")"
                               if webview2_untested(_wv) else "")) if _wv
                  else "no registered WebView2 runtime: Adobe's sign-in window will be blank. "
                       "Run `neutron prefix provision <prefix>`.")
            if webview2_untested(_wv):
                checks[-1]["warning"] = True
            # Wine's browser engine has to be registered, or embedded browsers stay empty.
            _mh = _mshtml_protocols_registered(prefix)
            check("browser-engine", _mh is not False,
                  "Wine's browser engine registered" if _mh else
                  "system.reg unreadable; cannot tell" if _mh is None else
                  "Wine's browser engine is not registered: embedded web panels (Lightroom Classic's "
                  "About box) stay empty. Run `neutron prefix provision <prefix>`.")
            # 🚨 CoolType's default Roman face. Adobe resolves it by PostScript
            # name, and Wine ships a substitute for all three candidate files
            # under the same Microsoft filenames -- so a prefix can hold
            # times/arial/cour, pass every presence check, and still leave
            # CoolType with nothing to select. When all three are fake,
            # CoolType THROWS and After Effects dies at startup with
            # `EGG Constructor IEggApp failed` behind a boilerplate "check your
            # permissions" message. Reproduced and reversed in the clean room
            # 2026-08-11. Premiere and AME share CoolType and are at risk of the
            # same class of failure, so this is a suite-wide check.
            roman = _roman_default_status(prefix)
            genuine = [r for r in roman if r[1] == "real"]
            # ⚠️ The FILES being genuine is not sufficient — CoolType may never read
            # them. Its cache is keyed on filename, so `winetricks corefonts`
            # (which overwrites in place) leaves the three Regular records
            # pointing at Wine substitutes forever. A files-only check reports
            # PASS on exactly the state our own remedy creates.
            stale = _stale_roman_cache_records(prefix)
            detail = ", ".join(f"{fn}={state}" for fn, state, _ in roman)
            if not genuine:
                check("cooltype-roman-default", False, detail +
                      "  — NO genuine Roman face: CoolType will throw and "
                      "After Effects will fail at startup with 'EGG Constructor IEggApp failed'. "
                      "Run `neutron fonts repair --prefix <prefix>` (restores a genuine face "
                      "from this machine, or installs the real Microsoft core fonts).")
            elif stale:
                check("cooltype-roman-default", False, detail +
                      "  — a genuine file is present but CoolType's CACHE offers NO genuine "
                      "Roman face (it serves " +
                      ", ".join(sorted({s[1] for s in stale})) +
                      "). AE will fail at startup regardless of the files. Fix: delete " +
                      os.path.dirname(stale[0][2]) + " (Adobe rebuilds it), or run "
                      "`neutron fonts repair --prefix <prefix>`, which does it for you.")
            else:
                check("cooltype-roman-default", True, detail)
            # The video trio's other startup requirement: the REAL Microsoft core fonts.
            # Discriminated by the six names Wine ships nothing under -- a presence test by
            # design, complementary to the authenticity test above (never a replacement for
            # it: this one reports 6/6 on a prefix whose times/arial/cour are all fake).
            # Until 2026-09-13 this check lived only in comments and a snapshot script.
            _present, _missing = _ms_core_fonts_status(prefix)
            check("ms-core-fonts", not _missing,
                  "%d/6 present" % len(_present) if not _missing else
                  "%d/6 present, missing %s -- Premiere, After Effects and Media Encoder "
                  "will not start without the real Microsoft core fonts (Wine's substitutes "
                  "do not count). Run `neutron fonts repair --prefix <prefix>`."
                  % (len(_present), ", ".join(_missing)))
            # The font replacement map, from the same engine `fonts check` uses (2026-09-13).
            _rep = next(c for c in fonts_verdict(prefix)["checks"] if c["name"] == "replacements")
            check("font-replacements", _rep["status"] != "bad",
                  _rep["detail"] + ("" if _rep["status"] != "bad" else
                                    "  Run `neutron fonts repair --prefix <prefix>`."))
            # CEP extension signatures. CEP refuses an extension whose signed files are missing or
            # changed, and the only trace is "Signature verification failed" in CEP12-<HOST>.log:
            # the panel never opens (Light Equalizer, 119 signed files missing, 2026-10-12).
            # Damage to Adobe's own extensions, or to a manifest an older Neutron edited, is a
            # prefix problem (`cep-signatures`). Damage to a third-party extension is its vendor's
            # install, so it gets its own flagged warning (`cep-third-party`) and does not make
            # the prefix unhealthy.
            exts = _cep_manifests(prefix)
            debug = _cep_debug_mode(prefix)
            ours, vendor = cep_extension_damage(prefix)

            def _damage(e):
                return "%s (%s): %s" % (e["name"], e["id"], ", ".join(filter(None, [
                    "%d signed file(s) missing" % e["missing"] if e["missing"] else "",
                    "%d changed" % e["changed"] if e["changed"] else ""])))
            loads_anyway = ("  — loads here only because PlayerDebugMode is on (CSXS.%s), which "
                            "skips CEP's signature check" % ", CSXS.".join(debug)) if debug else ""
            if not ours:
                check("cep-signatures", True,
                      "%d CEP extension(s), none damaged%s" % (len(exts) - len(vendor),
                                                               " apart from third-party ones"
                                                               if vendor else ""))
            elif debug:
                check("cep-signatures", True, "; ".join(map(_damage, ours)) + loads_anyway)
                checks[-1]["warning"] = True
            else:
                check("cep-signatures", False,
                      "; ".join(map(_damage, ours)) + "  — CEP refuses these, so their panels never "
                      "open. " + ("Run `neutron prefix provision <prefix>` to restore the manifests "
                                  "an older Neutron edited." if any(e["edited_by_neutron"] for e in ours)
                                  else "Reinstall the Adobe app that ships them."))
            if vendor:
                check("cep-third-party", True,
                      "; ".join(map(_damage, vendor)) + (loads_anyway or
                      "  — CEP refuses %s, so %s panel never opens. The extension's own install is "
                      "damaged, not Neutron: reinstall it from its vendor."
                      % (("it", "its") if len(vendor) == 1 else ("them", "their"))))
                checks[-1].update({"warning": True, "third_party": True, "extensions": vendor})
            # Premiere-only checks (Debug Database display fix) apply ONLY when
            # Premiere is installed; they must not fail a Photoshop/other prefix.
            if os.path.isfile(os.path.join(prefix, PREMIERE_SUBPATH)):
                dbg = find_debug_database(prefix, user) if user else None
                if not (dbg and os.path.isfile(dbg)):
                    # Premiere writes its Debug Database on first launch; the display fix is
                    # applied right after. Nothing is wrong yet.
                    _p = "pending — applied automatically on Premiere's first launch"
                    check("debug-database", True, _p, pending=True)
                    check("display_fix", True, _p, pending=True)
                else:
                    check("debug-database", True, dbg)
                    try:
                        with open(dbg, "r", encoding="utf-8", errors="replace") as f:
                            applied = _display_fix_matches(f.read(), _display_fix_wanted("premiere", dbg, prefix))
                    except OSError:
                        applied = False
                    check("display_fix", applied, None if applied else
                          "Premiere has run but the display fix is missing — run "
                          "`neutron prefix apply-display-fix <prefix>`")

    healthy = all(c["ok"] for c in checks
                  if c["name"] not in ("exiftool",))  # exiftool is optional
    emit({"ok": True, "healthy": healthy, "checks": checks,
          "_schema": "provisional-v0"}, args.json)
    return EX_OK if healthy else EX_FAIL


def _runtime_version_of(wine):
    """`11.10-97` for a runtime's bin/wine, else None."""
    if not wine:
        return None
    root = os.path.basename(os.path.dirname(os.path.dirname(os.path.realpath(wine))))
    return root[len("neutron-wine-"):] if root.startswith("neutron-wine-") else None


def cmd_display(args):
    """The display scale Neutron will use for Adobe apps, where it came from, and every output."""
    info = detect_scale_info()
    # `scale`/`dpi`/`source` stay the DESKTOP's scale (Collider's "Auto" readout shows them);
    # `collider_scale` is Collider's manual setting, which every launch uses when set.
    setting = collider_manual_scale()
    out = {"ok": bool(info), **(info or {}), "outputs": _wayland_outputs() or [],
           "warning": windows_step_warning(info["dpi"]) if info else None,
           "collider_scale": setting}
    if not info:
        out["reason"] = ("could not detect the display scale; pass --scale to `neutron launch` "
                         "or set it in Collider")
    if args.json:
        emit(out, True)
    else:
        if info:
            print("scale %s%%  (%d dpi)  on %s  via %s" % (round(info["scale"] * 100, 2),
                  info["dpi"], info.get("output") or "?", info["source"]))
        else:
            print(out["reason"])
        if setting:
            print("launches use %s%% (%d dpi): set in Collider's Preferences" %
                  (round(setting * 100, 2), round(96 * setting)))
        for o in out["outputs"]:
            print("  output %-12s %-10s %s%%  at %s" % (o["output"], "%dx%d" % tuple(o["size"]),
                                                       round(o["scale"] * 100, 2), o["pos"]))
        if out["warning"]:
            print("⚠️  " + out["warning"])
    return EX_OK if info else EX_FAIL


def cmd_version(args):
    """Every piece's version in one place, for bug reports."""
    cli = CLI_VERSION
    try:
        sha = subprocess.run(["git", "-C", NEUTRON_REPO, "rev-parse", "--short", "HEAD"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if sha:
            cli += " (" + sha + ")"
    except Exception:
        pass
    wine, _ = resolve_wine()
    installed = {}
    try:
        with open(NEUTRON_INSTALLED_JSON) as f:
            installed = json.load(f)
    except (OSError, ValueError):
        pass
    mudhut = None
    if shutil.which("mudhut"):
        try:
            mudhut = subprocess.run(["mudhut", "--version"], capture_output=True, text=True,
                                    timeout=5).stdout.strip().removeprefix("mudhut ") or None
        except Exception:
            mudhut = None
    out = {"ok": True, "cli": cli,
           "neutron_wine": _runtime_version_of(wine),
           "neutron_wine_installed": _installed_runtime_versions(),
           "mudhut": mudhut or installed.get("mudhut"),
           "collider": installed.get("collider")}
    if args.json:
        emit(out, True)
    else:
        print("neutron CLI    " + out["cli"])
        print("neutron-wine   " + (out["neutron_wine"] or "not installed")
              + ("   (%d versions installed)" % len(out["neutron_wine_installed"])
                 if len(out["neutron_wine_installed"]) > 1 else ""))
        print("Mud Hut        " + (out["mudhut"] or "not installed"))
        print("Collider       " + (out["collider"] or "unknown"))
    return EX_OK


# --- setup / update / uninstall ------------------------------------------------------------------
# One command installs everything (DECISIONS G1): our builds come from our GitHub releases,
# Microsoft's files from Microsoft, Adobe's ACCCx from Adobe (through Mud Hut). Every download is
# checked: the runtime against its manifest's sha256, the others against their release's
# SHA256SUMS, Microsoft's files against MS_FILES. Collider's "Set up" button runs `neutron setup`.
GITHUB_OWNER = os.environ.get("NEUTRON_GITHUB_OWNER", "Nico-LaFoucate")
NEUTRON_BIN_DIR = os.path.join(NEUTRON_DATA_DIR, "bin")          # the installed CLI + mudhut
NEUTRON_COLLIDER_DIR = os.path.join(NEUTRON_DATA_DIR, "collider")
LOCAL_BIN = os.path.join(HOME, ".local", "bin")
APPS_DIR = os.path.join(DATA_HOME, "applications")
# piece -> (GitHub repo, how to recognize its release asset)
RELEASE_PIECES = {
    "cli": ("neutron", lambda n: n == "neutron"),
    "mudhut": ("Mud-Hut", lambda n: n == "mudhut"),
    "collider": ("Collider", lambda n: n.endswith(".AppImage")),
}


def _installed():
    try:
        with open(NEUTRON_INSTALLED_JSON) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def _save_installed(data):
    os.makedirs(NEUTRON_DATA_DIR, exist_ok=True)
    tmp = NEUTRON_INSTALLED_JSON + ".part"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, NEUTRON_INSTALLED_JSON)


def _gh_latest(repo):
    """The release GitHub marks Latest for <owner>/<repo> (pre-releases never are):
    {"version", "assets": {name: url}}. Raises RuntimeError with a readable reason."""
    import urllib.error, urllib.request
    url = f"https://api.github.com/repos/{GITHUB_OWNER}/{repo}/releases/latest"
    req = urllib.request.Request(url, headers={"User-Agent": "neutron-cli",
                                               "Accept": "application/vnd.github+json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            rel = json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            raise RuntimeError(f"{GITHUB_OWNER}/{repo} has no published release yet")
        raise RuntimeError(f"GitHub answered {e.code} for {GITHUB_OWNER}/{repo}")
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise RuntimeError(f"could not reach GitHub ({e})")
    return {"version": rel.get("tag_name", "").lstrip("v"),
            "assets": {a["name"]: a["browser_download_url"] for a in rel.get("assets", [])}}


def _local_release(src_dir, match):
    """--from DIR: the same shape as _gh_latest, from files in a directory."""
    names = sorted(os.listdir(src_dir))
    assets = {n: "file://" + os.path.abspath(os.path.join(src_dir, n)) for n in names}
    hit = next((n for n in names if match(n)), None)
    return {"version": None, "assets": assets, "hit": hit}


def _sha256sums(assets):
    """{name: sha256} from a release's SHA256SUMS asset, or {} when it has none."""
    import tempfile
    url = assets.get("SHA256SUMS")
    if not url:
        return {}
    with tempfile.TemporaryDirectory() as d:
        p = os.path.join(d, "SHA256SUMS")
        _download(url, p, as_json=True)
        out = {}
        with open(p) as f:
            for line in f:
                parts = line.split()
                if len(parts) == 2:
                    out[parts[1].lstrip("*")] = parts[0].lower()
        return out


def _fetch_piece(piece, dest, as_json, src_dir=None):
    """Download one piece's release asset to `dest`, verified. Returns its version (None when it
    came from --from without one)."""
    repo, match = RELEASE_PIECES[piece]
    rel = _local_release(src_dir, match) if src_dir else _gh_latest(repo)
    name = rel.get("hit") or next((n for n in rel["assets"] if match(n)), None)
    if not name:
        raise RuntimeError(f"the {repo} release has no {piece} file")
    sums = _sha256sums(rel["assets"])
    if not sums.get(name) and not src_dir:
        raise RuntimeError(f"the {repo} release lists no checksum for {name}")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part"
    if not as_json:
        log(f"downloading {name}" + (f" {rel['version']}" if rel["version"] else ""))
    _download(rel["assets"][name], part, as_json)
    if sums.get(name) and _sha256_file(part) != sums[name]:
        os.remove(part)
        raise RuntimeError(f"{name}: checksum mismatch (corrupt or tampered download)")
    os.chmod(part, 0o755)
    os.replace(part, dest)
    return rel["version"]


def _link_on_path(name, target):
    """~/.local/bin/<name> -> target. Never replaces a file that is not a symlink (someone's own
    wrapper); says so instead. Returns a short status string."""
    os.makedirs(LOCAL_BIN, exist_ok=True)
    link = os.path.join(LOCAL_BIN, name)
    if os.path.lexists(link) and not os.path.islink(link):
        return f"kept your own {link} (not a link); it is used instead of Neutron's"
    if os.path.islink(link) and os.path.realpath(link) == os.path.realpath(target):
        return f"{link} ok"
    tmp = link + ".neutron-tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, link)
    return f"{link} -> {target}"


def _install_cli(as_json):
    """Put this CLI where setup keeps it. A git checkout (development) is linked, not copied, so
    `git pull` keeps updating it; anything else is copied into NEUTRON_BIN_DIR."""
    this = os.path.realpath(__file__)
    if os.path.isdir(os.path.join(NEUTRON_REPO, ".git")):
        return this, "git checkout (update it with git pull)"
    dest = os.path.join(NEUTRON_BIN_DIR, "neutron")
    if os.path.realpath(dest) != this:
        os.makedirs(NEUTRON_BIN_DIR, exist_ok=True)
        shutil.copyfile(this, dest + ".part")
        os.chmod(dest + ".part", 0o755)
        os.replace(dest + ".part", dest)
    return dest, CLI_VERSION


def _install_runtime(args, src_dir=None, version=None):
    """Install a neutron-wine runtime through cmd_runtime_install: the release GitHub marks Latest,
    a named version (testers: pre-releases), or the newest manifest in --from DIR."""
    import tempfile, types
    ns = types.SimpleNamespace(version=version, repo=None, manifest=None, force=False,
                               json=True, show_progress=not args.json)
    if src_dir:
        mans = sorted((n for n in os.listdir(src_dir) if n.endswith(".manifest.json")),
                      key=lambda n: [int(x) if x.isdigit() else x
                                     for x in re.split(r"[.-]", n)])
        if not mans:
            raise RuntimeError(f"no neutron-wine-*.manifest.json in {src_dir}")
        with open(os.path.join(src_dir, mans[-1])) as f:
            man = json.load(f)
        man["url"] = "file://" + os.path.abspath(os.path.join(src_dir, man["artifact"]))
        tmp = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
        json.dump(man, tmp)
        tmp.close()
        ns.manifest, ns.version = tmp.name, str(man["version"])
    elif not version:
        rel = _gh_latest(NEUTRON_WINE_REPO.split("/", 1)[1])
        man = next((n for n in rel["assets"] if n.endswith(".manifest.json")), None)
        if not man:
            raise RuntimeError("the latest neutron-wine release has no manifest")
        ns.manifest, ns.version = rel["assets"][man], rel["version"]
    import io, contextlib
    buf = io.StringIO()
    try:
        with contextlib.redirect_stdout(buf):
            cmd_runtime_install(ns)
    except SystemExit:
        pass
    finally:
        if src_dir:
            os.remove(ns.manifest)
    try:
        res = json.loads(buf.getvalue().strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise RuntimeError("runtime install produced no result")
    if not res.get("ok"):
        raise RuntimeError(res.get("reason", "runtime install failed"))
    return res["version"], res["status"]


def _collider_desktop_entry(appimage):
    """Neutron Collider in the application menu. PATH is spelled out because a menu launch may
    not include ~/.local/bin, and Collider runs `neutron` and `mudhut` from PATH."""
    import tempfile
    if os.path.exists(os.path.join(APPS_DIR, "collider.desktop")):
        return "kept the existing collider.desktop"
    icon = "neutron-collider"
    icon_dir = os.path.join(os.path.dirname(APPS_DIR), "icons", "hicolor", "256x256", "apps")
    with tempfile.TemporaryDirectory() as d:
        try:
            subprocess.run([appimage, "--appimage-extract", "*.png"], cwd=d, timeout=60,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            pngs = sorted((p for p in glob.glob(os.path.join(d, "squashfs-root", "*.png"))
                           if os.path.isfile(p)), key=os.path.getsize)   # skips dangling links
            if pngs:
                os.makedirs(icon_dir, exist_ok=True)
                shutil.copyfile(pngs[-1], os.path.join(icon_dir, icon + ".png"))
        except (OSError, subprocess.SubprocessError):
            pass
    path = ":".join([LOCAL_BIN, "/usr/local/bin", "/usr/bin", "/bin"])
    os.makedirs(APPS_DIR, exist_ok=True)
    with open(os.path.join(APPS_DIR, "neutron-collider.desktop"), "w") as f:
        f.write("[Desktop Entry]\nType=Application\nName=Neutron Collider\n"
                "GenericName=Adobe Creative Cloud\n"
                "Comment=Install and run Adobe Creative Cloud apps on Linux\n"
                f"Exec=env PATH={path} {appimage}\nIcon={icon}\nTerminal=false\n"
                "Categories=Graphics;Photography;AudioVideo;\n")
    refresh_desktop_caches(APPS_DIR)
    return "menu entry added"


def _enable_ntsync(as_json, assume_yes):
    """Turn on ntsync permanently if the kernel has it (DECISIONS G9). Neutron works without it,
    just much slower. One root step: Fedora's ntsync-autoload package, else a modules-load.d entry
    plus modprobe. Asks for the password through sudo in a terminal, pkexec otherwise."""
    st = ntsync_status()
    if st != "available":
        return st
    distro = ""
    try:
        with open("/etc/os-release") as f:
            distro = dict(l.rstrip("\n").split("=", 1) for l in f if "=" in l).get("ID", "").strip('"')
    except OSError:
        pass
    if distro == "fedora" and have("dnf"):
        cmd = "dnf install -y ntsync-autoload && modprobe ntsync"
    else:
        cmd = "echo ntsync > /etc/modules-load.d/ntsync.conf && modprobe ntsync"
    tty = sys.stdin.isatty() and not as_json
    if tty and not assume_yes:
        print("[neutron] Your kernel has ntsync, which makes the Adobe apps much faster, but it is "
              "off.\n[neutron] Turning it on permanently needs your password once:\n"
              f"[neutron]     {cmd}", file=sys.stderr)
    runner = ["sudo", "sh", "-c", cmd] if tty else (["pkexec", "sh", "-c", cmd] if have("pkexec") else None)
    if not runner:
        return "available"
    try:
        subprocess.run(runner, timeout=300)
    except (OSError, subprocess.SubprocessError) as e:
        log(f"could not enable ntsync: {e}")
    return ntsync_status()


def _setup_checks():
    """Problems that stop setup, and warnings that don't."""
    problems, warnings = [], []
    if os.uname().machine != "x86_64":
        problems.append(f"Neutron needs an x86_64 PC (this is {os.uname().machine})")
    try:
        libc = os.confstr("CS_GNU_LIBC_VERSION").split()[-1]
        if tuple(int(x) for x in libc.split(".")[:2]) < (2, 39):
            problems.append(f"glibc {libc} is too old; Neutron needs 2.39 or newer "
                            "(Ubuntu 24.04, Fedora 40, current Arch, or newer)")
    except (ValueError, OSError, IndexError):
        pass
    if not have("cabextract"):
        problems.append("cabextract is missing (it unpacks Microsoft's installers). Install it: "
                        "`sudo pacman -S cabextract`, `sudo apt install cabextract`, "
                        "`sudo dnf install cabextract` or `sudo zypper install cabextract`")
    if not session_is_wayland():
        warnings.append("this is not a Wayland session. Neutron supports Wayland only; on X11 you "
                        "are on your own")
    if LOCAL_BIN not in os.environ.get("PATH", "").split(":"):
        warnings.append(f"{LOCAL_BIN} is not on your PATH; add it so `neutron` and `mudhut` work "
                        "in a terminal")
    return problems, warnings


def cmd_setup(args, updating=False):
    """Install or update everything: the CLI, neutron-wine, Microsoft's components, Mud Hut (and
    Adobe's ACCCx through it), Collider, menu entries, ntsync."""
    what = "update" if updating else "setup"
    problems, warnings = _setup_checks()
    if problems:
        die({"ok": False, "reason": "; ".join(problems), "warnings": warnings}, EX_DEP, args.json)
    for w in warnings:
        log("⚠️  " + w)
    src = os.path.abspath(args.from_dir) if getattr(args, "from_dir", None) else None
    inst = _installed()
    steps = []

    def step(name, fn):
        event(args, event="progress", stage=name, msg=f"{what}: {name}")
        try:
            res = fn()
            steps.append({"step": name, "ok": True, **(res or {})})
        except Exception as e:                        # report every piece, never stop half-way
            steps.append({"step": name, "ok": False, "detail": str(e)})
            log(f"{name}: {e}")

    def do_cli():
        if updating and not src and not os.path.isdir(os.path.join(NEUTRON_REPO, ".git")):
            latest = _gh_latest("neutron")["version"]
            if latest and latest != CLI_VERSION:
                dest = os.path.join(NEUTRON_BIN_DIR, "neutron")
                _fetch_piece("cli", dest, args.json)
                inst["cli"] = latest
                return {"version": latest, "path": dest, "link": _link_on_path("neutron", dest),
                        "note": "updated; this run finishes with the old version"}
        if src and os.path.isfile(os.path.join(src, "neutron")):
            dest = os.path.join(NEUTRON_BIN_DIR, "neutron")
            _fetch_piece("cli", dest, args.json, src)
            path, ver = dest, CLI_VERSION
        else:
            path, ver = _install_cli(args.json)
        inst["cli"] = CLI_VERSION
        return {"version": ver, "path": path, "link": _link_on_path("neutron", path)}

    def do_runtime():
        ver, status = _install_runtime(args, src, getattr(args, "runtime_version", None))
        inst["neutron_wine"] = ver
        return {"version": ver, "status": status}

    def do_microsoft():
        r = ms_fetch(args.json)
        if not r["ok"]:
            raise RuntimeError("; ".join(f"{k}: {v}" for k, v in r["failed"].items()))
        return {"downloaded": len(r["fetched"]), "already": len(r["present"])}

    def do_mudhut():
        dest = os.path.join(NEUTRON_BIN_DIR, "mudhut")
        latest = None if src else _gh_latest("Mud-Hut")["version"]
        if not (updating and latest and inst.get("mudhut") == latest and os.path.isfile(dest)):
            ver = _fetch_piece("mudhut", dest, args.json, src)
            inst["mudhut"] = ver or "local"
        link = _link_on_path("mudhut", dest)
        r = subprocess.run([dest, "accc"], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                           text=True, timeout=900)
        if r.returncode != 0:
            raise RuntimeError("Adobe's Creative Cloud package could not be downloaded: "
                               + (r.stderr.strip().splitlines() or ["unknown error"])[-1])
        return {"version": inst["mudhut"], "path": dest, "link": link, "accc": "ready"}

    def do_collider():
        dest = os.path.join(NEUTRON_COLLIDER_DIR, "Collider.AppImage")
        latest = None if src else _gh_latest("Collider")["version"]
        if not (updating and latest and inst.get("collider") == latest and os.path.isfile(dest)):
            ver = _fetch_piece("collider", dest, args.json, src)
            inst["collider"] = ver or "local"
        return {"version": inst["collider"], "path": dest, "menu": _collider_desktop_entry(dest)}

    step("cli", do_cli)
    step("neutron-wine", do_runtime)
    step("microsoft", do_microsoft)
    if not getattr(args, "no_mudhut", False):
        step("mudhut", do_mudhut)
    if not getattr(args, "no_collider", False):
        step("collider", do_collider)
    # The Premiere home-screen window rule and its setting were removed in 1.0.0-beta.2: take down
    # a rule an earlier version installed. Silent when there is none.
    try:
        if _kwin_home_rule_remove():
            steps.append({"step": "kwin_rule", "ok": True,
                          "detail": "removed the old Premiere home-screen window rule"})
    except (OSError, subprocess.SubprocessError):
        pass
    if not getattr(args, "no_ntsync", False):
        st = _enable_ntsync(args.json, getattr(args, "yes", False))
        steps.append({"step": "ntsync", "ok": True, "status": st, "detail": NTSYNC_DETAIL.get(st)})
    if updating and inst.get("neutron_wine"):
        event(args, event="progress", stage="prefixes", msg="update: moving prefixes to the new runtime")
        steps.append(_reprovision_prefixes(inst["neutron_wine"], args.json))
    inst["updated_at" if updating else "installed_at"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    _save_installed(inst)

    out = {"ok": all(s["ok"] for s in steps), "steps": steps, "warnings": warnings}
    if updating:
        out["prefixes_on_older_runtimes"] = _prefixes_behind(inst.get("neutron_wine"))
    if args.json:
        emit(out, True, streaming=getattr(args, "progress", False))
    else:
        for s in steps:
            mark = "✓" if s["ok"] else "✗"
            info = s.get("version") or s.get("status") or ""
            print(f"[neutron] {mark} {s['step']:<13} {info}  {s.get('detail') or s.get('note') or ''}".rstrip())
        if not out["ok"]:
            print("[neutron] " + setup_rerun_hint(updating))
        for p in out.get("prefixes_on_older_runtimes", []):
            print(f"[neutron]   {p['prefix']} still runs neutron-wine {p['runtime']}; move it to "
                  f"{p['latest']} with: {p['command']}")
        if out["ok"] and not updating:
            print("[neutron] Done. Open Neutron Collider from your application menu to install "
                  "the Adobe apps.")
    return EX_OK if out["ok"] else EX_FAIL


def setup_rerun_hint(updating):
    """The line under a failed setup/update summary. A second run is safe (the runtime and the
    Microsoft files are skipped when present, Mud Hut and Collider are replaced) and usually
    enough, since a failed download is mostly a passing error."""
    cmd = "neutron update" if updating else "neutron setup"
    return (f"Run `{cmd}` again. A failed download is usually a temporary network or server "
            "error.")


def _reprovision_prefixes(version, as_json):
    """`neutron update` moves every Neutron prefix onto the new runtime (DECISIONS C16): a
    provision under that version re-stamps the prefix, restages the runtime's DLLs and re-pins its
    menu entries. A prefix with an Adobe app running is skipped (provisioning boots wine in it)
    and named, so the user can close the app and update again."""
    moved, skipped, failed = [], [], []
    newest = os.path.join(NEUTRON_RUNTIMES_DIR, f"neutron-wine-{version}", "bin", "wine")
    for p in neutron_prefixes():
        if not stamp_mismatch(p, newest):
            continue
        running = _running_app_ids(p)
        if running:
            skipped.append({"prefix": p, "running": running})
            continue
        # Mud Hut is updating Adobe apps in it: provisioning would boot wine beside the installer.
        _mh = mudhut_busy(p)
        if _mh is not None:
            skipped.append({"prefix": p, "running": ["Mud Hut " + (_mh.get("command") or "update")]})
            continue
        if not as_json:
            log(f"moving {p} to neutron-wine {version}")
        r = subprocess.run([sys.executable, os.path.realpath(__file__), "--json", "prefix",
                            "provision", p], env={**os.environ, "NEUTRON_WINE_VERSION": version},
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1800)
        (moved if r.returncode == 0 else failed).append(p)
    step = {"step": "prefixes", "ok": not failed, "moved": moved, "skipped": skipped,
            "failed": failed}
    if skipped:
        step["detail"] = ("not moved while an app runs in them: "
                          + "; ".join(f'{x["prefix"]} ({", ".join(x["running"])})' for x in skipped)
                          + ". Close the apps and run `neutron update` again.")
    return step


def _prefixes_behind(version=None):
    """Discovered prefixes whose stamp is not that of `version`: the runtime `neutron update` just
    installed and moved the prefixes to (the release GitHub marks Latest, or --runtime-version).
    Default, or when that runtime is not installed: the CLI's default runtime.

    ⛔ Not simply the newest runtime on disk. After going back from a pre-release (a tester's
    11.10-128, then plain `neutron update` to the Latest 11.10-127), the pre-release is still
    installed and newer, and this used to tell the user to move every prefix the update had just
    moved back onto it again. `command` pins the version whenever a plain `neutron prefix
    provision` would pick a different runtime (it takes the newest installed)."""
    latest = version
    if not latest or not os.path.isfile(os.path.join(NEUTRON_RUNTIMES_DIR, f"neutron-wine-{latest}",
                                                     "bin", "wine")):
        latest = _default_wine_version()
    if not latest:
        return []
    newest = os.path.join(NEUTRON_RUNTIMES_DIR, f"neutron-wine-{latest}", "bin", "wine")
    installed = _installed_runtime_versions()
    pin = "" if installed[:1] == [latest] else f"NEUTRON_WINE_VERSION={latest} "
    out = []
    for p in neutron_prefixes():
        mm = stamp_mismatch(p, newest)
        if mm:
            out.append({"prefix": p, "runtime": ", ".join(mm["prefix_runtimes"]) or "older",
                        "latest": latest, "command": f"{pin}neutron prefix provision {p}"})
    return out


def cmd_update(args):
    """Update every installed piece to its latest release, then move every prefix onto the new
    runtime (DECISIONS C16)."""
    return cmd_setup(args, updating=True)


def cmd_uninstall(args):
    """Remove what `neutron setup` installed (DECISIONS C17): runtimes, downloads and caches,
    logs, menu entries and icons, file associations, Collider's settings, the KWin script and rule,
    the `neutron`/`mudhut` commands. Prefixes -- the Adobe apps and their settings -- only when
    asked (a separate question; default keep). ntsync stays enabled."""
    owned = [os.path.join(NEUTRON_DATA_DIR, d) for d in
             ("runtimes", "microsoft", "bin", "collider", "accc", "logs", "icon-stamps",
              "prefs-check", "superseded-desktop-entries")]
    owned.append(NEUTRON_INSTALLED_JSON)
    owned.append(NEUTRON_PREFIXES_JSON)
    owned.append(os.path.join(CACHE_HOME, "neutron"))
    owned.append(collider_config_dir())                                    # Collider's settings
    owned.append(os.path.join(os.path.dirname(APPS_DIR), "kwin", "scripts", KWIN_SCRIPT_ID))
    # Only Neutron's own prefixes are offered for deletion (see neutron_prefixes); but never delete
    # a directory that holds ANY prefix, whatever it is called.
    prefixes = neutron_prefixes()
    keep = [d for d in owned if any(os.path.realpath(p).startswith(os.path.realpath(d) + os.sep)
                                    for p in discover_prefixes() + prefixes)]
    remove = [d for d in owned if d not in keep and os.path.lexists(d)]
    links = [os.path.join(LOCAL_BIN, n) for n in ("neutron", "mudhut")
             if os.path.islink(os.path.join(LOCAL_BIN, n))
             and os.path.realpath(os.path.join(LOCAL_BIN, n)).startswith(
                 os.path.realpath(NEUTRON_DATA_DIR) + os.sep)]
    entries = sorted(glob.glob(os.path.join(APPS_DIR, "neutron-*.desktop")))
    icons = sorted(glob.glob(os.path.join(DATA_HOME, "icons", "hicolor", "*", "apps", "neutron-*.png")))
    mime = os.path.join(DATA_HOME, "mime", "packages", "neutron-adobe.xml")
    plan = {"remove": remove + links + entries + icons + ([mime] if os.path.exists(mime) else []),
            "kept_because_a_prefix_is_inside": keep}
    del_prefixes = bool(getattr(args, "delete_prefixes", False))
    if not getattr(args, "yes", False):
        if args.json or not sys.stdin.isatty():
            die({"ok": False, "reason": "pass --yes to uninstall", **plan,
                 "prefixes": prefixes}, EX_FAIL, args.json)
        print("[neutron] This removes:")
        for p in plan["remove"]:
            print("    " + p)
        if input("[neutron] Uninstall Neutron? [y/N] ").strip().lower() not in ("y", "yes"):
            return EX_FAIL
        if prefixes and not del_prefixes:
            print("[neutron] Your prefixes hold the Adobe apps and their settings:")
            for p in prefixes:
                print("    " + p)
            del_prefixes = input("[neutron] Delete them too? [y/N] ").strip().lower() in ("y", "yes")
    if del_prefixes:
        busy = [p for p in prefixes if _running_app_ids(p)]
        if busy:
            die({"ok": False, "reason": "close the Adobe apps first; they are running in "
                 + ", ".join(busy)}, EX_RUNNING, args.json)
        plan["remove"] += prefixes
    # The KWin rule lives in kwinrulesrc next to the user's own rules: removed key by key.
    try:
        _kwin_home_rule_remove()
    except (OSError, subprocess.SubprocessError):
        pass
    if _is_kde() and have(_kconfig("kwriteconfig")):
        subprocess.run([_kconfig("kwriteconfig"), "--file", "kwinrc", "--group", "Plugins", "--key",
                        KWIN_SCRIPT_ID + "Enabled", "--delete"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    failed = []
    for p in plan["remove"]:
        try:
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p)
            else:
                os.remove(p)
        except OSError as e:
            failed.append(f"{p}: {e}")
    if os.path.isdir(APPS_DIR):
        refresh_desktop_caches(APPS_DIR)
    if have("update-mime-database"):
        subprocess.run(["update-mime-database", os.path.join(DATA_HOME, "mime")],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    kept = [] if del_prefixes else prefixes
    out = {"ok": not failed, "removed": len(plan["remove"]) - len(failed), "failed": failed,
           "prefixes_not_removed": kept,
           "note": "ntsync stays enabled (it is a system setting other Wine programs use too)"}
    if args.json:
        emit(out, True)
    else:
        print(f"[neutron] Removed {out['removed']} items." + (f" Failed: {failed}" if failed else ""))
        for p in kept:
            print(f"[neutron] Kept prefix {p}.")
        print("[neutron] " + out["note"] + ".")
    return EX_OK if out["ok"] else EX_FAIL


# --- argument plumbing -----------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="neutron",
        description="Neutron CLI — the engine front door Collider drives.",
    )
    p.add_argument("--json", action="store_true",
                   help="structured JSON to stdout (Collider mode)")
    p.add_argument("--progress", action="store_true",
                   help="with --json, stream newline-delimited progress events before the terminal "
                        "result (same NDJSON contract Mud Hut uses: {event:progress|note|error|result}). "
                        "OPT-IN on purpose: Mud Hut runs `neutron prefix provision` with INHERITED "
                        "stdout, so streaming by default would inject these lines into Mud Hut's own "
                        "event stream and Collider would read our result as Mud Hut's.")
    p.add_argument("--version", action="store_true", dest="show_version",
                   help="print the version of every Neutron piece and exit")
    sub = p.add_subparsers(dest="cmd")

    dp = sub.add_parser("display", help="show the display scale Neutron will use")
    dp.set_defaults(func=cmd_display)

    # prefix
    pp = sub.add_parser("prefix", help="prefix inspection / provisioning")
    psub = pp.add_subparsers(dest="subcmd", required=True)

    pls = psub.add_parser("list", help="Neutron's prefixes (recorded by provision, or named by "
                                       "a Neutron menu entry); what `update` acts on")
    pls.set_defaults(func=cmd_prefix_list)

    pi = psub.add_parser("info", help="report paths Collider needs")
    pi.add_argument("path", nargs="?", default=None)
    pi.set_defaults(func=cmd_prefix_info)

    pa = psub.add_parser("apply-display-fix",
                         help="write DS.DisableDirectXDisplay=true (idempotent)")
    pa.add_argument("path", nargs="?", default=None)
    pa.set_defaults(func=cmd_apply_display_fix)

    pv = psub.add_parser("provision",
                         help="make a staged prefix Neutron-ready (idempotent)")
    pv.add_argument("path", nargs="?", default=None)
    pv.add_argument("--microsoft-only", action="store_true",
                    help="only install Microsoft's components (VC++ 2013 and 2015-2022, UCRT, "
                         "d3dcompiler_47, GDI+, core fonts); Mud Hut runs this before Adobe's "
                         "installer")
    pv.set_defaults(func=cmd_prefix_provision)

    # launch
    pl = sub.add_parser("launch", help="launch an app through the Neutron stack")
    pl.add_argument("app", help="app to launch (" + ", ".join(APP_PROFILES) + ")")
    pl.add_argument("--prefix", default=None)
    pl.add_argument("--project", default=None,
                    help="optional project path (Windows-style, e.g. C:\\...\\x.prproj)")
    pl.add_argument("--without", action="append", metavar="GATE",
                    help="turn a shipped fix OFF for this launch (repeatable). "
                         "`neutron gates` lists them. An unknown name is an error, never a "
                         "silent no-op.")
    pl.add_argument("--with", dest="with_", action="append", metavar="GATE",
                    help="turn a gate ON for this launch (repeatable) -- for the ones that ship "
                         "off by default.")
    pl.add_argument("--log", action="store_true",
                    help="ALWAYS write a session log, even from an interactive terminal. Use this "
                         "when capturing a WINEDEBUG trace: without it a terminal launch keeps the "
                         "tty and no file is kept, which cost two capture rounds on 2026-09-14.")
    pl.add_argument("--no-log", action="store_true",
                    help="do not write a session log to ~/.local/share/neutron/logs/. By default "
                         "a log is written whenever nobody is watching the output live (menu, "
                         "dock, Collider, file association); an interactive terminal keeps "
                         "inheriting the tty as before.")
    pl.add_argument("--allow-restamp", action="store_true",
                    help="launch even when this runtime's stamp differs from the prefix's. Wine "
                         "will run `wineboot -u` and REVERT the prefix's patched natives. To "
                         "move a prefix to a new runtime, run `neutron update` or `neutron "
                         "prefix provision <prefix>` instead.")
    pl.add_argument("project_file", nargs="?", default=None,
                    help="optional file to open, e.g. from a .desktop file association "
                         "(a Linux path is translated to a Windows Z:\\ path)")
    pl.add_argument("--scale", type=float, default=None,
                    help="display scale (e.g. 1.75); on Wayland Neutron sets "
                         "LogPixels=round(96*scale). Collider passes this; else auto-detect.")
    grp = pl.add_mutually_exclusive_group()
    grp.add_argument("--gpu", action="store_true", help="GPU/Mercury (default)")
    grp.add_argument("--software", action="store_true",
                     help="software render (not implemented)")
    pl.set_defaults(func=cmd_launch)

    # apps: catalog + install status for Collider's per-app widgets
    pap = sub.add_parser("apps", help="list apps + install status in a prefix")
    pap.add_argument("--prefix", default=None)
    pap.set_defaults(func=cmd_apps)

    # teardown
    pt = sub.add_parser("teardown",
                        help="close a prefix cleanly (apps save prefs) and leave nothing running")
    pt.add_argument("--prefix", default=None)
    pt.add_argument("--app", default=None,
                    help="close ONLY this app (e.g. premiere), leaving the prefix's other apps "
                         "running. This is the routine case -- all apps share one prefix, so the "
                         "default full teardown would take them all down. When the last app exits, "
                         "the shared daemons + wineserver are swept automatically.")
    pt.add_argument("--grace", type=int, default=25,
                    help="seconds to wait for apps to exit after WM_CLOSE (default 25)")
    pt.add_argument("--force", action="store_true",
                    help="skip the graceful close; apps will LOSE unsaved preferences")
    pt.set_defaults(func=cmd_teardown)

    # doctor
    pg = sub.add_parser("gates",
                        help="list the shipped fixes that can be turned off, and how")
    pg.set_defaults(func=cmd_gates)

    # theme: the DEFAULT NEUTRON THEME. `provision` applies it automatically; these exist so
    # Collider can drive the engine rather than reimplementing it, and so it can be re-applied or
    # inspected without a full provision.
    pt = sub.add_parser("theme", help="the default Neutron theme (Collider drives this, "
                                      "it does not reimplement it)")
    tsub = pt.add_subparsers(dest="subcmd", required=True)
    ta = tsub.add_parser("apply", help="write the theme into a prefix (palette + visual-style off)")
    ta.add_argument("--prefix", dest="path", default=None)
    ta.add_argument("--allow-restamp", action="store_true",
                    help="proceed even if the runtime would re-stamp the prefix (it will "
                         "wineboot -u and revert patched natives)")
    ta.add_argument("--colors", default=None,
                    help="JSON file of {key: \"R G B\"} overrides, or - for stdin; "
                         "omit for the default theme")
    ta.set_defaults(func=cmd_theme_apply)
    ts = tsub.add_parser("show", help="print the default theme")
    ts.set_defaults(func=cmd_theme_show)
    ti = tsub.add_parser("icons", help="window-button icons: install a set into a prefix, or --off")
    ti.add_argument("--prefix", dest="path", default=None)
    ti.add_argument("--from", dest="from_dir", default=None,
                    help="folder with close.ico, min.ico, max.ico, restore.ico")
    ti.add_argument("--name", default=None, help="the set's name (folder name inside the prefix)")
    ti.add_argument("--off", action="store_true", help="back to Wine's own button glyphs")
    ti.set_defaults(func=cmd_theme_icons)

    # fonts: re-verify + repair. The engine half predates this command (it ran inside doctor
    # and provision); this is the first-class surface Collider's Fonts row drives.
    pf = sub.add_parser("fonts", help="re-verify a prefix's fonts, and repair them")
    fsub = pf.add_subparsers(dest="subcmd", required=True)
    fc = fsub.add_parser("check", help="verdict good/warn/bad with the reason; read-only, "
                                       "never starts wine")
    fc.add_argument("--prefix", default=None)
    fc.set_defaults(func=cmd_fonts_check)
    fr = fsub.add_parser("repair", help="restore genuine core fonts, register staged fonts, "
                                        "and invalidate CoolType's cache; then re-verify")
    fr.add_argument("--prefix", default=None)
    fr.add_argument("--allow-restamp", action="store_true",
                    help="proceed even if the runtime would re-stamp the prefix (it will "
                         "wineboot -u and revert patched natives)")
    fr.set_defaults(func=cmd_fonts_repair)

    pd = sub.add_parser("doctor", help="health check")
    pd.add_argument("--prefix", default=None)
    pd.set_defaults(func=cmd_doctor)

    # setup / update / uninstall
    for name, fn, hlp in (("setup", cmd_setup, "install everything Neutron needs: neutron-wine, "
                           "Microsoft's components, Mud Hut, Collider, menu entries"),
                          ("update", cmd_update, "update every installed piece to its latest release")):
        su = sub.add_parser(name, help=hlp)
        su.add_argument("--from", dest="from_dir", default=None,
                        help="use release files from this directory instead of GitHub")
        su.add_argument("--runtime-version", default=None,
                        help="install this neutron-wine version (e.g. a pre-release) instead of "
                             "the latest")
        su.add_argument("--no-collider", action="store_true", help="skip Collider")
        su.add_argument("--no-mudhut", action="store_true", help="skip Mud Hut")
        su.add_argument("--no-ntsync", action="store_true", help="do not offer to turn on ntsync")
        su.add_argument("--yes", action="store_true", help="do not ask before enabling ntsync")
        su.set_defaults(func=fn)
    un = sub.add_parser("uninstall", help="remove what `neutron setup` installed; prefixes only "
                                          "if you say so")
    un.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    un.add_argument("--delete-prefixes", action="store_true",
                    help="also delete every Neutron prefix (the Adobe apps and their settings)")
    un.set_defaults(func=cmd_uninstall)

    # runtime: the neutron-wine runtimes
    prt = sub.add_parser("runtime", help="neutron-wine runtimes")
    rsub = prt.add_subparsers(dest="subcmd", required=True)

    ri = rsub.add_parser("install",
                         help="download + verify + unpack a neutron-wine release")
    ri.add_argument("--version", default=None,
                    help="release version (default: newest installed runtime)")
    ri.add_argument("--repo", default=None,
                    help=f"GitHub owner/repo (default: {NEUTRON_WINE_REPO})")
    ri.add_argument("--manifest", default=None,
                    help="manifest URL or local path (overrides --version/--repo)")
    ri.add_argument("--force", action="store_true",
                    help="reinstall even if this version is already present")
    ri.set_defaults(func=cmd_runtime_install)

    rw = rsub.add_parser("which",
                         help="the wine this CLI would use (so other tools can agree with it)")
    rw.add_argument("--prefix", default=None,
                    help="also report whether launching this prefix would re-stamp it")
    rw.set_defaults(func=cmd_runtime_which)

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.show_version:
        return cmd_version(args)
    if not args.cmd:
        parser.error("a command is required (or --version)")
    try:
        return args.func(args)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_FAIL


if __name__ == "__main__":
    sys.exit(main())
